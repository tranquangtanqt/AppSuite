<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MeRon.Views.ExportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MeRon.Views">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24,12,24,24" Spacing="14" MaxWidth="1000" HorizontalAlignment="Left">
            <TextBlock Text="Xuất / Xoá dữ liệu" Style="{StaticResource TitleTextBlockStyle}" />
            <!-- Số dòng đang có: nhãn tròn xám -->
            <Border HorizontalAlignment="Left" CornerRadius="12" Padding="12,4,12,5" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                <TextBlock Text="{x:Bind ViewModel.CurrentData, Mode=OneWay}" TextWrapping="Wrap" Opacity="0.85" AutomationProperties.AutomationId="CurrentData" />
            </Border>

            <!-- Xuất -->
            <Border Padding="18,16" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="32" Height="32" CornerRadius="16" Background="#26E8590C">
                            <FontIcon Glyph="&#xE8B7;" FontSize="15" Foreground="#E8590C" />
                        </Border>
                        <TextBlock Text="Xuất bộ backup TSV" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" Opacity="0.8"
                               Text="Tạo thư mục yyyyMMdd_HHmmss chứa 8 file .tsv đúng định dạng app điện thoại (address_…, users_…, orders_…). Dùng để: chép sang điện thoại rồi nhập (Cài đặt → Sao lưu → Nhập dữ liệu từ tệp sao lưu, từng bảng), chuyển sang máy tính khác (trang Nhập dữ liệu), hoặc cất làm bản lưu." />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{x:Bind ViewModel.FolderPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Thư mục lưu"
                                 AutomationProperties.Name="Thư mục xuất" AutomationProperties.AutomationId="ExportFolderBox" />
                        <Button Grid.Column="1" Content="Chọn thư mục..." Click="Pick_Click" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Style="{StaticResource AccentButtonStyle}" Click="Export_Click" IsEnabled="{x:Bind local:Ui.Not(ViewModel.IsBusy), Mode=OneWay}"
                                AutomationProperties.Name="Xuất TSV">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <SymbolIcon Symbol="Upload" />
                                <TextBlock Text="Xuất TSV" />
                            </StackPanel>
                        </Button>
                        <Button Content="Mở thư mục vừa xuất" Click="OpenExport_Click" Visibility="{x:Bind local:Ui.VisibleIf(ViewModel.HasExport), Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.ExportStatus, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                               AutomationProperties.AutomationId="ExportStatus" />
                </StackPanel>
            </Border>

            <!-- Google Drive: đăng nhập + tải bộ backup lên -->
            <Border Padding="18,16" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="32" Height="32" CornerRadius="16" Background="#261C7ED6">
                            <FontIcon Glyph="&#xE753;" FontSize="15" Foreground="#1C7ED6" />
                        </Border>
                        <TextBlock Text="Tải bộ backup lên Google Drive" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" Opacity="0.8"
                               Text="Xuất bộ TSV như nút Xuất TSV (vào thư mục bên trên) rồi tải lên Google Drive thành 1 thư mục yyyyMMdd_HHmmss, giống app điện thoại. Đăng nhập 1 lần, lần sau app tự nhớ (cất trong Thông tin xác thực Windows). App chỉ được thấy file do chính nó / app điện thoại tạo trên Drive." />
                    <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind local:Ui.VisibleIf(ViewModel.IsSignedOut), Mode=OneWay}">
                        <Button Style="{StaticResource AccentButtonStyle}" Click="SignIn_Click" IsEnabled="{x:Bind local:Ui.Not(ViewModel.IsBusy), Mode=OneWay}"
                                AutomationProperties.Name="Đăng nhập Google">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <SymbolIcon Symbol="Contact" />
                                <TextBlock Text="Đăng nhập Google..." />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel Spacing="10" Visibility="{x:Bind local:Ui.VisibleIf(ViewModel.IsSignedIn), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="{ThemeResource SystemFillColorSuccessBrush}" VerticalAlignment="Center" />
                            <TextBlock VerticalAlignment="Center" AutomationProperties.AutomationId="GoogleEmail">
                                <Run Text="Đã đăng nhập:" /> <Run Text="{x:Bind ViewModel.GoogleEmail, Mode=OneWay}" FontWeight="SemiBold" />
                            </TextBlock>
                            <HyperlinkButton Content="Đăng xuất" Click="SignOut_Click" AutomationProperties.Name="Đăng xuất Google" />
                        </StackPanel>
                        <TextBox Header="Folder trên Google Drive" Style="{StaticResource DefaultTextBoxStyle}"
                                 Text="{x:Bind ViewModel.DriveFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="Để trống = folder riêng &quot;MeRon backup&quot; ở My Drive; hoặc dán link folder điện thoại đang dùng"
                                 AutomationProperties.Name="Folder Google Drive" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Style="{StaticResource AccentButtonStyle}" Click="Upload_Click" IsEnabled="{x:Bind local:Ui.Not(ViewModel.IsBusy), Mode=OneWay}"
                                    AutomationProperties.Name="Xuất lên Google Drive">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE753;" FontSize="16" />
                                    <TextBlock Text="Xuất lên Google Drive" />
                                </StackPanel>
                            </Button>
                            <Button Content="Mở trên Google Drive" Click="OpenDrive_Click" Visibility="{x:Bind local:Ui.VisibleIf(ViewModel.HasDriveLink), Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.DriveStatus, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                               AutomationProperties.AutomationId="DriveStatus" />
                </StackPanel>
            </Border>

            <!-- Xoá -->
            <Border Padding="18,16" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource SystemFillColorCriticalBrush}"
                    Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="32" Height="32" CornerRadius="16" Background="#26E03131">
                            <FontIcon Glyph="&#xE74D;" FontSize="15" Foreground="#E03131" />
                        </Border>
                        <TextBlock Text="Xoá toàn bộ dữ liệu ở máy" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" Opacity="0.85"
                               Text="Xoá sạch đơn hàng, khách hàng, món ăn, danh mục, địa chỉ, phiếu nhập trên máy này (không đụng gì tới điện thoại hay Google Drive). Hỏi xác nhận 2 lần. Bản trước khi xoá luôn được lưu trong thư mục Backups - lấy lại: đóng app, chép bản đó đè lên me_ron.db." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="Wipe_Click" AutomationProperties.Name="Xoá toàn bộ dữ liệu">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <SymbolIcon Symbol="Delete" />
                                <TextBlock Text="Xoá toàn bộ dữ liệu..." />
                            </StackPanel>
                        </Button>
                        <Button Content="Mở thư mục Backups" Click="OpenBackups_Click" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.WipeStatus, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                               AutomationProperties.AutomationId="WipeStatus" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Unit test cho FileTools: lõi đọc/ghi (nhận encoding, đọc dòng giữ nguyên xuống dòng, ghi an toàn, CSV) và các
    thao tác nối / tách / trích dòng... File thử được sinh ngay trong test.

    Giống CsvEditor.Tests: FileTools là app WinUI nên biên dịch kèm trực tiếp Core\ (không phụ thuộc WinUI).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>FileTools.Tests</RootNamespace>
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\Modules\FileTools\Core\**\*.cs" Link="FileTools\Core\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
    <PackageReference Include="System.IO.Hashing" Version="8.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit.v3" Version="1.0.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>

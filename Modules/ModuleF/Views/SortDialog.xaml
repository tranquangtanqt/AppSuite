<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="ModuleF.Views.SortDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:ModuleF.ViewModels"
    mc:Ignorable="d"
    x:Name="Root"
    Title="Sắp xếp"
    PrimaryButtonText="Áp dụng"
    SecondaryButtonText="Bỏ sắp xếp"
    CloseButtonText="Hủy"
    DefaultButton="Primary">

    <StackPanel Spacing="10" MinWidth="440" MaxHeight="420">
        <TextBlock TextWrapping="Wrap" Opacity="0.8"
                   Text="Cột ở trên có độ ưu tiên cao hơn (sắp xếp theo cột đó trước, cột dưới dùng để phân định khi bằng nhau)." />

        <Button Content="+ Thêm cột sắp xếp" Click="AddColumnButton_Click" HorizontalAlignment="Left" />

        <ListView x:Name="ColumnsListView" ItemsSource="{x:Bind SortColumns}" MaxHeight="280" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:SortColumnRow">
                    <Grid ColumnSpacing="6" Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Column="0" ItemsSource="{Binding ColumnNames, ElementName=Root}"
                                  SelectedIndex="{x:Bind ColumnIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                        <CheckBox Grid.Column="1" Content="Giảm dần" IsChecked="{x:Bind Descending, Mode=TwoWay}" />
                        <Button Grid.Column="2" Content="↑" Click="MoveUpButton_Click" Tag="{x:Bind}" />
                        <Button Grid.Column="3" Content="↓" Click="MoveDownButton_Click" Tag="{x:Bind}" />
                        <Button Grid.Column="4" Content="✕" Click="RemoveColumnButton_Click" Tag="{x:Bind}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </StackPanel>
</ContentDialog>

<?xml version="1.0" encoding="utf-8"?>
<!-- "Xem file" (gộp 2 trang cũ Thông tin file + Trích dòng): thông tin file ở trên, trích 1 đoạn dòng ra file tạm ở dưới. -->
<Page
    x:Class="FileTools.Views.InfoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:FileTools.Views"
    xmlns:vm="using:FileTools.ViewModels"
    NavigationCacheMode="Required">

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
    <Grid x:Name="Root" Padding="24,16" RowSpacing="12" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" MinHeight="200" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="2">
            <TextBlock Text="Xem file" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock Opacity="0.7" TextWrapping="Wrap"
                       Text="Số dòng, encoding, kiểu xuống dòng, dòng dài nhất; file dạng bảng thêm dấu phân cách, số cột và các bản ghi lệch số cột - chọn hoặc kéo-thả file là tự phân tích. Bên dưới: lấy 1 đoạn dòng của file lớn ra file tạm để mở xem (chỉ đọc đúng phần cần - file vài GB vẫn gần như tức thì)." />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="4">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Header="File" Text="{x:Bind ViewModel.SourcePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="1" VerticalAlignment="Bottom" Content="Chọn..." Command="{x:Bind ViewModel.BrowseSourceCommand}" />
                <Button Grid.Column="2" VerticalAlignment="Bottom" Content="Phân tích lại" Command="{x:Bind ViewModel.InspectCommand}" />
            </Grid>
        </StackPanel>

        <Border Grid.Row="2" BorderThickness="1" CornerRadius="4" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <ListView ItemsSource="{x:Bind ViewModel.Rows}" SelectionMode="None" Padding="0,4">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:InfoRow">
                        <Grid ColumnSpacing="16" Padding="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Label}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Value}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- Trích dòng ra file tạm -->
        <Border Grid.Row="3" BorderThickness="1" CornerRadius="4" Padding="12,8,12,12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <StackPanel Spacing="10">
                <TextBlock Text="Trích dòng ra file tạm" FontWeight="SemiBold" />
                <!-- Mỗi lựa chọn cùng hàng với ô số của nó; chỉ ô của lựa chọn đang chọn sửa được. N dùng chung cho đầu / cuối. -->
                <Grid ColumnSpacing="12" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="130" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <RadioButton GroupName="ExtractMode" Tag="0" Content="Lấy đầu file" Checked="Mode_Checked"
                                 IsChecked="{x:Bind views:ModeChoice.Is(ViewModel.ModeIndex, 0), Mode=OneWay}" />
                    <NumberBox Grid.Column="1" Width="160" VerticalAlignment="Center" Minimum="1" SmallChange="1000" SpinButtonPlacementMode="Compact"
                               AutomationProperties.Name="N dòng đầu" Value="{x:Bind ViewModel.Count, Mode=TwoWay}"
                               IsEnabled="{x:Bind views:ModeChoice.Is(ViewModel.ModeIndex, 0), Mode=OneWay}" />
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="dòng đầu" />

                    <RadioButton Grid.Row="1" GroupName="ExtractMode" Tag="1" Content="Từ dòng" Checked="Mode_Checked"
                                 IsChecked="{x:Bind views:ModeChoice.Is(ViewModel.ModeIndex, 1), Mode=OneWay}" />
                    <NumberBox Grid.Row="1" Grid.Column="1" Width="160" VerticalAlignment="Center" Minimum="1" SpinButtonPlacementMode="Compact"
                               AutomationProperties.Name="Từ dòng X" Value="{x:Bind ViewModel.From, Mode=TwoWay}"
                               IsEnabled="{x:Bind views:ModeChoice.Is(ViewModel.ModeIndex, 1), Mode=OneWay}" />
                    <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Text="đến dòng" />
                    <NumberBox Grid.Row="1" Grid.Column="3" Width="160" VerticalAlignment="Center" Minimum="1" SpinButtonPlacementMode="Compact"
                               AutomationProperties.Name="Đến dòng Y" Value="{x:Bind ViewModel.To, Mode=TwoWay}"
                               IsEnabled="{x:Bind views:ModeChoice.Is(ViewModel.ModeIndex, 1), Mode=OneWay}" />

                    <RadioButton Grid.Row="2" GroupName="ExtractMode" Tag="2" Content="Lấy cuối file" Checked="Mode_Checked"
                                 IsChecked="{x:Bind views:ModeChoice.Is(ViewModel.ModeIndex, 2), Mode=OneWay}" />
                    <NumberBox Grid.Row="2" Grid.Column="1" Width="160" VerticalAlignment="Center" Minimum="1" SmallChange="1000" SpinButtonPlacementMode="Compact"
                               AutomationProperties.Name="N dòng cuối" Value="{x:Bind ViewModel.Count, Mode=TwoWay}"
                               IsEnabled="{x:Bind views:ModeChoice.Is(ViewModel.ModeIndex, 2), Mode=OneWay}" />
                    <TextBlock Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" Text="dòng cuối" />
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="24">
                    <CheckBox Content="Kèm dòng tiêu đề (dòng 1)" IsChecked="{x:Bind ViewModel.IncludeHeader, Mode=TwoWay}" />
                    <CheckBox Content="Mở file sau khi trích" IsChecked="{x:Bind ViewModel.OpenAfter, Mode=TwoWay}" />
                </StackPanel>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Header="Lưu vào thư mục tạm" Text="{x:Bind ViewModel.TempFolder}" IsReadOnly="True" />
                    <Button Grid.Column="1" VerticalAlignment="Bottom" Content="Mở thư mục tạm" Command="{x:Bind ViewModel.OpenTempFolderCommand}" />
                    <views:OutputPanel Grid.Column="2" Settings="{x:Bind ViewModel.Output}" />
                    <Button Grid.Column="3" VerticalAlignment="Bottom" Content="Trích dòng" MinWidth="110"
                            Style="{StaticResource CompactAccentButtonStyle}" Command="{x:Bind ViewModel.ExtractCommand}" />
                </Grid>
            </StackPanel>
        </Border>

        <views:JobPanel Grid.Row="4" Job="{x:Bind ViewModel}" />
    </Grid>
    </ScrollViewer>
</Page>

<?xml version="1.0" encoding="utf-8"?>
<!-- Nút "Ẩn / hiện" + flyout ô tích từng module - dùng chung ở Dashboard và Module List (cùng 1 lựa chọn, lưu
     Config\launcher-settings.json qua DashboardViewModel). -->
<UserControl
    x:Class="MainLauncher.Controls.ModuleVisibilityButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MainLauncher.ViewModels">

    <StackPanel Orientation="Horizontal" Spacing="12">
        <TextBlock Text="{x:Bind ViewModel.VisibleSummary, Mode=OneWay}" VerticalAlignment="Center" Opacity="0.6" FontSize="12" />
        <DropDownButton Padding="10,4" VerticalAlignment="Center" AutomationProperties.Name="Ẩn / hiện module"
                        ToolTipService.ToolTip="Chọn module hiện trên màn hình (Dashboard và Module List)">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon Glyph="&#xE7B3;" FontSize="12" />
                <TextBlock Text="Ẩn / hiện" FontSize="12" />
            </StackPanel>
            <DropDownButton.Flyout>
                <Flyout Placement="BottomEdgeAlignedLeft">
                    <StackPanel Width="300" Spacing="8">
                        <TextBlock Text="Module hiện trên màn hình" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.VisibilityItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ModuleVisibilityItem">
                                        <CheckBox Content="{x:Bind Name}" IsChecked="{x:Bind IsVisible, Mode=TwoWay}"
                                                  ToolTipService.ToolTip="{x:Bind Description}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Text="Áp dụng cho Dashboard và Module List. Module đang ẩn mà đang chạy vẫn hiện tạm để bấm Stop được."
                                   TextWrapping="Wrap" Opacity="0.6" FontSize="12" />
                        <Button Content="Hiện tất cả" Command="{x:Bind ViewModel.ShowAllModulesCommand}" HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Flyout>
            </DropDownButton.Flyout>
        </DropDownButton>
    </StackPanel>
</UserControl>

<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MeRon.Views.ProductsPage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MeRon.ViewModels"
    xmlns:local="using:MeRon.Views">

    <Grid Padding="24,12,24,16" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="8">
            <!-- Ô tìm co lại khi cửa sổ hẹp (tối đa 320), không che tên trang / số mục. -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" MaxWidth="320" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Món ăn" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.CountText, Mode=OneWay}" AutomationProperties.AutomationId="CountText" Opacity="0.7" VerticalAlignment="Center" Margin="12,0,0,0" />
            <TextBox x:Name="SearchBox" Grid.Column="3" PlaceholderText="Tìm theo tên món" AutomationProperties.Name="Tìm món ăn"
                     Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="4" Style="{StaticResource AccentButtonStyle}" Click="Add_Click" AutomationProperties.Name="Thêm món ăn">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <SymbolIcon Symbol="Add" />
                    <TextBlock Text="Thêm" />
                </StackPanel>
            </Button>
        </Grid>

        <InfoBar Grid.Row="1" Severity="Error" IsClosable="False" Message="{x:Bind ViewModel.LoadError, Mode=OneWay}"
                 IsOpen="{x:Bind local:Ui.HasText(ViewModel.LoadError), Mode=OneWay}" />

        <Grid Grid.Row="2" RowSpacing="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Padding="12,6" ColumnSpacing="12" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="STT" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="Tên" FontWeight="SemiBold" />
                <TextBlock Grid.Column="2" Text="Giá" FontWeight="SemiBold" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="3" Text="Danh mục" FontWeight="SemiBold" />
                <TextBlock Grid.Column="4" Text="Mô tả" FontWeight="SemiBold" />
            </Grid>
            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Items}" SelectionMode="Single"
                      IsItemClickEnabled="True" ItemClick="List_ItemClick" AutomationProperties.Name="Danh sách món ăn">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="Padding" Value="12,0" />
                        <Setter Property="MinHeight" Value="34" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProductRow">
                        <Grid ColumnSpacing="12" AutomationProperties.Name="{x:Bind Item.Name}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Index}" Opacity="0.6" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Item.Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{x:Bind local:Format.Money(Item.Price)}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{x:Bind CategoryName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="{x:Bind Item.Description}" TextTrimming="CharacterEllipsis" Opacity="0.8" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>

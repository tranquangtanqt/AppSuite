<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MeRon.Views.ReportProductPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MeRon.ViewModels"
    xmlns:local="using:MeRon.Views"
    NavigationCacheMode="Enabled">

    <Grid Padding="24,12,24,0" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Thống kê theo món ăn" Style="{StaticResource TitleTextBlockStyle}" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <ComboBox ItemsSource="{x:Bind ViewModel.ProductOptions, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.Product, Mode=TwoWay}"
                      DisplayMemberPath="Name" MinWidth="240" AutomationProperties.Name="Món ăn" PlaceholderText="(Tất cả món)" />
            <local:DateRangeBar x:Name="RangeBar" Filter="{x:Bind ViewModel.Range}" />
        </StackPanel>

        <InfoBar Grid.Row="2" Severity="Error" IsClosable="False" Message="{x:Bind ViewModel.Error, Mode=OneWay}"
                 IsOpen="{x:Bind local:Ui.HasText(ViewModel.Error), Mode=OneWay}" />

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="18" Padding="0,0,12,24" MaxWidth="1100" HorizontalAlignment="Stretch">
                <TextBlock Text="Không có món nào được bán trong khoảng ngày này (không tính đơn Huỷ)." Opacity="0.7"
                           Visibility="{x:Bind local:Ui.VisibleIfNot(ViewModel.HasData), Mode=OneWay}" />

                <!-- 3 ô số liệu cùng kiểu trang Theo đơn hàng -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1.3*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Padding="16,14" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Width="32" Height="32" CornerRadius="16" Background="#26E8590C">
                                    <FontIcon Glyph="&#xED56;" FontSize="15" Foreground="#E8590C" />
                                </Border>
                                <TextBlock Text="Tổng số món" Opacity="0.75" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.TotalQuantity, Mode=OneWay}" FontSize="30" FontWeight="Bold"
                                       AutomationProperties.AutomationId="ProductTotalQuantity" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Padding="16,14" CornerRadius="10" Background="{ThemeResource AccentFillColorDefaultBrush}">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Width="32" Height="32" CornerRadius="16" Background="#33FFFFFF">
                                    <FontIcon Glyph="&#xE8C7;" FontSize="15" Foreground="White" />
                                </Border>
                                <TextBlock Text="Tổng thành tiền" Foreground="White" Opacity="0.9" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.TotalAmount, Mode=OneWay}" FontSize="30" FontWeight="Bold" Foreground="White" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Padding="16,14" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Width="32" Height="32" CornerRadius="16" Background="#261C7ED6">
                                    <FontIcon Glyph="&#xE8FD;" FontSize="15" Foreground="#1C7ED6" />
                                </Border>
                                <TextBlock Text="Số món khác nhau" Opacity="0.75" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.ProductCount, Mode=OneWay}" FontSize="30" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                </Grid>

                <StackPanel Spacing="6">
                    <TextBlock Text="Theo từng món (số lượng giảm dần; món tự do gộp theo tên)" FontWeight="SemiBold" />
                    <local:ReportTable Lines="{x:Bind ViewModel.Products}" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="{x:Bind ViewModel.OrdersTitle, Mode=OneWay}" FontWeight="SemiBold" AutomationProperties.AutomationId="ProductOrdersTitle" />
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Orders}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="6" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:OrderCardViewModel">
                                <Button Click="Order_Click" Tag="{x:Bind}" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                        Background="Transparent" BorderThickness="0" AutomationProperties.Name="{x:Bind AccessibleName}">
                                    <local:OrderCard Card="{x:Bind}" />
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

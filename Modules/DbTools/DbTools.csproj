<Project Sdk="Microsoft.NET.Sdk">
  <!--
    DbTools is a fully standalone WinUI 3 app: it opens, builds and runs on its own (right-click
    DbTools.csproj > Set as Startup Project, or `dotnet run` from this folder). It only references
    Common for the shared IModuleInfo-style contracts/logging - never MainLauncher.
  -->

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Common\Common.csproj" />
    <ProjectReference Include="..\..\SharedUI\SharedUI.csproj" />
  </ItemGroup>
</Project>

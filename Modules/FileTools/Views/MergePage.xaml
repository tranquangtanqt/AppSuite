<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FileTools.Views.MergePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:FileTools.Views"
    xmlns:vm="using:FileTools.ViewModels"
    NavigationCacheMode="Required">

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
    <Grid x:Name="Root" Padding="24,16" RowSpacing="12" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" MinHeight="160" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="2">
            <TextBlock Text="Nối file trong thư mục" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock Opacity="0.7" TextWrapping="Wrap"
                       Text="Nối nội dung nhiều file thành 1. Mỗi file tự nhận encoding, ghi ra 1 encoding thống nhất. Kéo-thả thư mục hoặc file vào đây." />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Header="Thư mục nguồn" Text="{x:Bind ViewModel.SourceFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="C:\du-lieu\log" />
            <Button Grid.Column="1" VerticalAlignment="Bottom" Content="Chọn..." Command="{x:Bind ViewModel.BrowseFolderCommand}" />
            <TextBox Grid.Column="2" Header="Mẫu lọc" Text="{x:Bind ViewModel.Patterns, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <CheckBox Grid.Column="3" VerticalAlignment="Bottom" Content="Gồm thư mục con" IsChecked="{x:Bind ViewModel.Recursive, Mode=TwoWay}" />
            <Button Grid.Column="4" VerticalAlignment="Bottom" Content="Liệt kê file" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.ListFilesCommand}" />
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border BorderThickness="1" CornerRadius="4" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Padding="12,6" ColumnSpacing="12" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="130" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="Dung lượng" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="2" Text="Ngày sửa" FontWeight="SemiBold" />
                    </Grid>
                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Files}" SelectedItem="{x:Bind ViewModel.SelectedFile, Mode=TwoWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:FileItem">
                                <Grid ColumnSpacing="12" ToolTipService.ToolTip="{x:Bind FullName}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="130" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind SizeText}" HorizontalAlignment="Right" Opacity="0.8" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Modified}" Opacity="0.8" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
            <StackPanel Grid.Column="1" Spacing="8" Width="190">
                <ComboBox Header="Thứ tự nối" HorizontalAlignment="Stretch" ItemsSource="{x:Bind vm:MergeViewModel.SortNames}" SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}" />
                <Button HorizontalAlignment="Stretch" Content="Sắp xếp lại" Command="{x:Bind ViewModel.ResortCommand}" />
                <Button HorizontalAlignment="Stretch" Content="▲ Lên" Command="{x:Bind ViewModel.MoveUpCommand}" />
                <Button HorizontalAlignment="Stretch" Content="▼ Xuống" Command="{x:Bind ViewModel.MoveDownCommand}" />
                <Button HorizontalAlignment="Stretch" Content="Bỏ khỏi danh sách" Command="{x:Bind ViewModel.RemoveCommand}" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="20">
            <CheckBox Content="Chèn tên file trước mỗi phần" IsChecked="{x:Bind ViewModel.FileNameHeader, Mode=TwoWay}" />
            <CheckBox Content="Dòng trống giữa 2 file" IsChecked="{x:Bind ViewModel.BlankLineBetween, Mode=TwoWay}" />
            <CheckBox Content="CSV: giữ dòng tiêu đề 1 lần" IsChecked="{x:Bind ViewModel.CsvHeaderOnce, Mode=TwoWay}" />
        </StackPanel>

        <Grid Grid.Row="4" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Header="File kết quả" Text="{x:Bind ViewModel.OutputPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="1" VerticalAlignment="Bottom" Content="Chọn..." Command="{x:Bind ViewModel.BrowseOutputCommand}" />
            <views:OutputPanel Grid.Column="2" Settings="{x:Bind ViewModel.Output}" />
            <Button Grid.Column="3" VerticalAlignment="Bottom" Content="Nối file" MinWidth="110" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.MergeCommand}" />
        </Grid>

        <views:JobPanel Grid.Row="5" Job="{x:Bind ViewModel}" />
    </Grid>
    </ScrollViewer>
</Page>

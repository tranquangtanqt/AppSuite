<Project>
  <!--
    Central Package Management: version của MỌI NuGet package trong solution khai báo tại đây (một chỗ duy nhất).
    Trong csproj chỉ ghi <PackageReference Include="..." /> - không có Version (NuGet báo lỗi NU1008 nếu có).
    Nâng version = sửa 1 dòng ở đây, mọi project dùng package đó cùng nâng theo.

    Tách 1 module ra khỏi repo: mang file này + Directory.Build.props + Modules\Directory.Build.props theo
    (xem build\Export-Module.ps1).
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Windows App SDK: component package thay cho metapackage (metapackage kéo AI/ML: onnxruntime + DirectML). -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.WindowsAppSDK.WinUI" Version="2.2.1" />
    <PackageVersion Include="Microsoft.WindowsAppSDK.Runtime" Version="2.2.0" />
    <PackageVersion Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2270" />
    <!--
      Metapackage CHỈ để ghim kèm ExcludeAssets="all" khi một package bên thứ ba kéo bản cũ theo transitive
      (SkiaSharp.Views.WinUI -> >= 1.1.5, CommunityToolkit DataGrid -> >= 1.0.0). Không bao giờ reference nó bình thường.
    -->
    <PackageVersion Include="Microsoft.WindowsAppSDK" Version="1.1.5" />
  </ItemGroup>

  <!-- UI / MVVM -->
  <ItemGroup>
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageVersion Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.1.240821" />
    <PackageVersion Include="CommunityToolkit.WinUI.UI.Controls.DataGrid" Version="7.1.2" />
    <PackageVersion Include="SkiaSharp" Version="2.88.8" />
    <PackageVersion Include="SkiaSharp.Views.WinUI" Version="2.88.8" />
  </ItemGroup>

  <!-- Microsoft.Extensions -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.2" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
  </ItemGroup>

  <!-- Dữ liệu / file -->
  <ItemGroup>
    <PackageVersion Include="DocumentFormat.OpenXml" Version="3.1.1" />
    <PackageVersion Include="EPPlus" Version="4.5.3.3" />
    <PackageVersion Include="Microsoft.CSharp" Version="4.7.0" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageVersion Include="MySqlConnector" Version="2.6.2" />
    <PackageVersion Include="Npgsql" Version="8.0.5" />
    <PackageVersion Include="Oracle.ManagedDataAccess.Core" Version="23.6.1" />
    <PackageVersion Include="System.IO.Hashing" Version="8.0.0" />
    <PackageVersion Include="System.Text.Encoding.CodePages" Version="8.0.0" />
    <PackageVersion Include="Tesseract" Version="5.2.0" />
  </ItemGroup>

  <!-- Test -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="xunit.v3" Version="1.0.1" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.0.1" />
  </ItemGroup>
</Project>

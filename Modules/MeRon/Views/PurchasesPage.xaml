<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MeRon.Views.PurchasesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MeRon.ViewModels"
    xmlns:local="using:MeRon.Views"
    NavigationCacheMode="Enabled">

    <Grid Padding="24,12,24,16" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Mua hàng" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <!-- Số phiếu + tổng tiền thành nhãn tròn xanh dương (mua = chi, khác màu cam của bán) -->
            <Border Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,4,0,0" CornerRadius="14" Padding="12,4,12,5"
                    Background="{x:Bind local:Ui.PurchasePillBackground(ViewModel.IsEmpty), Mode=OneWay}">
                <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" AutomationProperties.AutomationId="PurchasesSummary" FontWeight="SemiBold"
                           Foreground="{x:Bind local:Ui.PurchasePillForeground(ViewModel.IsEmpty), Mode=OneWay}" TextTrimming="CharacterEllipsis" />
            </Border>
            <Button Grid.Column="2" Style="{StaticResource AccentButtonStyle}" Click="Add_Click" AutomationProperties.Name="Thêm phiếu nhập">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <SymbolIcon Symbol="Add" />
                    <TextBlock Text="Thêm" />
                </StackPanel>
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Control" Key="N" />
                </Button.KeyboardAccelerators>
            </Button>
        </Grid>

        <local:DateRangeBar x:Name="RangeBar" Grid.Row="1" Filter="{x:Bind ViewModel.Range}" />

        <InfoBar Grid.Row="2" Severity="Error" IsClosable="False" Message="{x:Bind ViewModel.Error, Mode=OneWay}"
                 IsOpen="{x:Bind local:Ui.HasText(ViewModel.Error), Mode=OneWay}" />

        <Grid Grid.Row="3">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Cards}" AutomationProperties.Name="Danh sách phiếu nhập">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="10" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:PurchaseCardViewModel">
                            <Button Click="Card_Click" Tag="{x:Bind}" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                    Background="Transparent" BorderThickness="0" AutomationProperties.Name="{x:Bind AccessibleName}">
                                <!-- Thẻ phiếu nhập cùng kiểu thẻ đơn: vạch xanh dương bên trái, ngày có icon, nhãn số khoản, Tổng to -->
                                <Grid CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="5" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Fill="#1C7ED6" />
                                    <StackPanel Grid.Column="1" Spacing="6" Padding="16,12">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE787;" FontSize="15" Opacity="0.75" />
                                                <TextBlock Text="{x:Bind DateText}" FontWeight="SemiBold" FontSize="16" />
                                            </StackPanel>
                                            <Border Grid.Column="1" CornerRadius="11" Padding="10,2,10,3" Background="#261C7ED6" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind CountText}" FontSize="12" FontWeight="SemiBold" Foreground="#1C7ED6" />
                                            </Border>
                                        </Grid>
                                        <ItemsControl ItemsSource="{x:Bind Lines}" IsTabStop="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:PurchaseCardLine">
                                                    <Grid ColumnSpacing="12" Padding="0,1">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="110" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{x:Bind Name}" FontSize="14" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="1" Text="{x:Bind Price}" FontSize="14" HorizontalAlignment="Right" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,2,0,0" />
                                        <TextBlock HorizontalAlignment="Right">
                                            <Run Text="Tổng  " FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><Run Text="{x:Bind TotalText}" FontSize="17" FontWeight="Bold" Foreground="#1C7ED6" />
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10"
                        Visibility="{x:Bind local:Ui.VisibleIf(ViewModel.IsEmpty), Mode=OneWay}">
                <TextBlock Text="Không có phiếu nhập nào trong khoảng ngày này." HorizontalAlignment="Center" Opacity="0.7" />
                <Button Content="Thêm phiếu nhập" HorizontalAlignment="Center" Click="Add_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>

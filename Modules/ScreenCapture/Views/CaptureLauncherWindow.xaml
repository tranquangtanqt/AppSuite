<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ScreenCapture.Views.CaptureLauncherWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ScreenCapture.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="ScreenCapture">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!-- Kéo-thả file ảnh vào cửa sổ chính → mở trong Editor. -->
    <Grid Padding="24,20,24,20" RowSpacing="20" Background="Transparent" AllowDrop="True" DragOver="Root_DragOver" Drop="Root_Drop">
        <Grid.Resources>
            <!-- Màu nhấn trùng màu Number Stamp mặc định (#D86445) để launcher và editor cùng tông. -->
            <SolidColorBrush x:Key="LauncherAccentBrush" Color="#D86445" />
            <SolidColorBrush x:Key="LauncherAccentSoftBrush" Color="#D86445" Opacity="0.14" />

            <!-- Thẻ chế độ chụp: nền Card của Fluent, căn trái, cả thẻ là vùng bấm. -->
            <Style x:Key="CaptureCardStyle" TargetType="Button">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Padding" Value="16,14" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            </Style>
            <Style x:Key="CardIconBadgeStyle" TargetType="Border">
                <Setter Property="Width" Value="44" />
                <Setter Property="Height" Value="44" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Background" Value="{StaticResource LauncherAccentSoftBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="CardTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="CardDescriptionStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: tiêu đề (cột co giãn, cắt "…" khi cửa sổ hẹp) + hàng nút góc phải (giữ nguyên cỡ). Trước đây tiêu đề
             chừa lề phải cố định cho hàng nút → thêm nút là tiêu đề bị mất hẳn khi cửa sổ hẹp (đã gặp). -->
        <Grid Grid.Row="0" ColumnSpacing="16" RowSpacing="12" SizeChanged="Header_SizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- Cửa sổ hẹp (Header_SizeChanged) → hàng nút xuống dòng dưới tiêu đề. -->
        <StackPanel x:Name="HeaderButtons" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
            <Button x:Name="OpenImageButton" Click="OpenImageButton_Click"
                    ToolTipService.ToolTip="Mở ảnh có sẵn (PNG, JPG, BMP, GIF, WEBP) trong trình chỉnh sửa để ghi chú - hoặc kéo-thả file vào cửa sổ này">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                    <TextBlock Text="Mở ảnh" />
                </StackPanel>
            </Button>
            <Button x:Name="NewImageButton" Click="NewImageButton_Click"
                    ToolTipService.ToolTip="Tạo ảnh trống (chọn cỡ, màu nền) và mở trong trình chỉnh sửa">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE8A5;" FontSize="14" />
                    <TextBlock Text="Ảnh mới" />
                </StackPanel>
            </Button>
            <Button x:Name="HelpButton" Click="HelpButton_Click"
                    ToolTipService.ToolTip="Hướng dẫn: tất cả tính năng và phím tắt của ScreenCapture (F1)">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE897;" FontSize="14" />
                    <TextBlock Text="Hướng dẫn" />
                </StackPanel>
            </Button>
            <Button x:Name="SettingsButton" Click="SettingsButton_Click"
                    ToolTipService.ToolTip="Cài đặt: phím tắt, hẹn giờ, tự động lưu, phiên làm việc">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE713;" FontSize="14" />
                    <TextBlock Text="Cài đặt" />
                </StackPanel>
            </Button>
        </StackPanel>

        <Grid Grid.Column="0" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="48" Height="48" CornerRadius="12" Background="{StaticResource LauncherAccentBrush}">
                <FontIcon Glyph="&#xE722;" FontSize="22" Foreground="White" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="Chụp màn hình" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="Chọn chế độ chụp - ảnh sẽ mở trong trình chỉnh sửa để ghi chú, lưu hoặc sao chép."
                           Style="{StaticResource CardDescriptionStyle}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>
        </Grid>

        <!-- Lưới thẻ chế độ chụp -->
        <Grid Grid.Row="1" ColumnSpacing="12" RowSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Button x:Name="MonitorButton" Grid.Row="0" Grid.Column="1" Style="{StaticResource CaptureCardStyle}"
                    Click="MonitorButton_Click">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardIconBadgeStyle}">
                        <FontIcon Glyph="&#xE7F4;" FontSize="20" Foreground="{StaticResource LauncherAccentBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Màn hình hiện tại" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Text="Chụp 1 màn hình - màn đang có con trỏ chuột." Style="{StaticResource CardDescriptionStyle}" />
                    </StackPanel>
                </Grid>
            </Button>

            <Button x:Name="RepeatLastButton" Grid.Row="3" Grid.Column="1" Style="{StaticResource CaptureCardStyle}"
                    Click="RepeatLastButton_Click">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardIconBadgeStyle}">
                        <FontIcon Glyph="&#xE72C;" FontSize="20" Foreground="{StaticResource LauncherAccentBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Chụp lại lần trước" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Text="Lặp lại kiểu chụp gần nhất (vùng chọn: đúng vùng đó)." Style="{StaticResource CardDescriptionStyle}" />
                    </StackPanel>
                </Grid>
            </Button>

            <Button x:Name="FullScreenButton" Grid.Row="0" Grid.Column="0" Style="{StaticResource CaptureCardStyle}"
                    Click="FullScreenButton_Click">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardIconBadgeStyle}">
                        <FontIcon Glyph="&#xE740;" FontSize="20" Foreground="{StaticResource LauncherAccentBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Toàn màn hình" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Text="Chụp toàn bộ các màn hình đang kết nối." Style="{StaticResource CardDescriptionStyle}" />
                    </StackPanel>
                </Grid>
            </Button>

            <Button x:Name="WindowButton" Grid.Row="1" Grid.Column="0" Style="{StaticResource CaptureCardStyle}"
                    Click="WindowButton_Click">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardIconBadgeStyle}">
                        <FontIcon Glyph="&#xE8A7;" FontSize="20" Foreground="{StaticResource LauncherAccentBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Cửa sổ hiện tại" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Text="Chụp cửa sổ đang hoạt động phía sau." Style="{StaticResource CardDescriptionStyle}" />
                    </StackPanel>
                </Grid>
            </Button>

            <Button x:Name="RegionButton" Grid.Row="1" Grid.Column="1" Style="{StaticResource CaptureCardStyle}"
                    Click="RegionButton_Click">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardIconBadgeStyle}">
                        <FontIcon Glyph="&#xE7A8;" FontSize="20" Foreground="{StaticResource LauncherAccentBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Vùng chọn" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Text="Kéo chuột để chọn một vùng bất kỳ." Style="{StaticResource CardDescriptionStyle}" />
                    </StackPanel>
                </Grid>
            </Button>

            <Button x:Name="FixedRegionButton" Grid.Row="2" Grid.Column="0" Style="{StaticResource CaptureCardStyle}"
                    Click="FixedRegionButton_Click">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardIconBadgeStyle}">
                        <FontIcon Glyph="&#xE718;" FontSize="20" Foreground="{StaticResource LauncherAccentBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Vùng cố định" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Text="Chụp lại đúng vùng đã chọn lần trước." Style="{StaticResource CardDescriptionStyle}" />
                    </StackPanel>
                </Grid>
            </Button>

            <Button x:Name="ScrollButton" Grid.Row="2" Grid.Column="1" Style="{StaticResource CaptureCardStyle}"
                    Click="ScrollButton_Click">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardIconBadgeStyle}">
                        <FontIcon Glyph="&#xEC8F;" FontSize="20" Foreground="{StaticResource LauncherAccentBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Cuộn dọc" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Text="Tự cuộn xuống và ghép thành ảnh dài (trang web, tài liệu). Esc để dừng." Style="{StaticResource CardDescriptionStyle}" />
                    </StackPanel>
                </Grid>
            </Button>

            <Button x:Name="ScrollHorizontalButton" Grid.Row="3" Grid.Column="0" Style="{StaticResource CaptureCardStyle}"
                    Click="ScrollHorizontalButton_Click">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardIconBadgeStyle}">
                        <!-- Cùng icon cuộn với thẻ dọc, xoay 90° thành mũi tên trái-phải. -->
                        <FontIcon Glyph="&#xEC8F;" FontSize="20" Foreground="{StaticResource LauncherAccentBrush}"
                                  RenderTransformOrigin="0.5,0.5">
                            <FontIcon.RenderTransform>
                                <RotateTransform Angle="90" />
                            </FontIcon.RenderTransform>
                        </FontIcon>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Cuộn ngang" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Text="Tự cuộn sang phải và ghép thành ảnh rộng (bảng tính, timeline...). Esc để dừng." Style="{StaticResource CardDescriptionStyle}" />
                    </StackPanel>
                </Grid>
            </Button>
        </Grid>

        <!-- Status: chỉ hiện khi có thông báo (huỷ chọn vùng, không tìm thấy cửa sổ...). -->
        <InfoBar x:Name="StatusInfoBar" Grid.Row="2" Severity="Informational" IsClosable="True" IsOpen="False" />
    </Grid>
</Window>

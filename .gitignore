## Visual Studio / .NET .gitignore

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.pubxml.user

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Oo]ut/
msbuild.log
msbuild.err
msbuild.wrn

# Visual Studio 2015/2017 cache/options directory
.vs/

# Publish output (see build/Publish-AppSuite.ps1)
/Application/

# ModuleD source workbooks (large, internal DBDef data - not meant to be committed)
/Modules/ModuleD/Data/Excel/*.xlsm

# Visual Studio profiler
*.psess
*.vsp
*.vspx
*.sap

# ReSharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# NuGet
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets

# Build/upgrade logs
UpgradeLog*.htm
UpgradeLog*.XML

# Others
*.log
*.tmp
*.bak
*.cache
*.DS_Store
Thumbs.db

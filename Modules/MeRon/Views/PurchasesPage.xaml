<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MeRon.Views.PurchasesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MeRon.ViewModels"
    xmlns:local="using:MeRon.Views"
    NavigationCacheMode="Enabled">

    <Grid Padding="24,12,24,16" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Mua hàng" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Summary, Mode=OneWay}" AutomationProperties.AutomationId="PurchasesSummary"
                       Opacity="0.75" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="2" Style="{StaticResource AccentButtonStyle}" Click="Add_Click" AutomationProperties.Name="Thêm phiếu nhập">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <SymbolIcon Symbol="Add" />
                    <TextBlock Text="Thêm" />
                </StackPanel>
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Control" Key="N" />
                </Button.KeyboardAccelerators>
            </Button>
        </Grid>

        <local:DateRangeBar x:Name="RangeBar" Grid.Row="1" Filter="{x:Bind ViewModel.Range}" />

        <InfoBar Grid.Row="2" Severity="Error" IsClosable="False" Message="{x:Bind ViewModel.Error, Mode=OneWay}"
                 IsOpen="{x:Bind local:Ui.HasText(ViewModel.Error), Mode=OneWay}" />

        <Grid Grid.Row="3">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Cards}" AutomationProperties.Name="Danh sách phiếu nhập">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="6" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:PurchaseCardViewModel">
                            <Button Click="Card_Click" Tag="{x:Bind}" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                    Background="Transparent" BorderThickness="0" AutomationProperties.Name="{x:Bind AccessibleName}">
                                <Border Padding="12,10" CornerRadius="6" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="{x:Bind DateText}" FontWeight="SemiBold" FontSize="15" />
                                        <ItemsControl ItemsSource="{x:Bind Lines}" IsTabStop="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:PurchaseCardLine">
                                                    <Grid ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="12" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="110" />
                                                        </Grid.ColumnDefinitions>
                                                        <Ellipse Width="4" Height="4" Fill="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="2" Text="{x:Bind Price}" FontSize="13" HorizontalAlignment="Right" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock HorizontalAlignment="Right">
                                            <Run Text="Tổng: " FontWeight="SemiBold" /><Run Text="{x:Bind TotalText}" FontWeight="SemiBold"
                                                                                                 Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10"
                        Visibility="{x:Bind local:Ui.VisibleIf(ViewModel.IsEmpty), Mode=OneWay}">
                <TextBlock Text="Không có phiếu nhập nào trong khoảng ngày này." HorizontalAlignment="Center" Opacity="0.7" />
                <Button Content="Thêm phiếu nhập" HorizontalAlignment="Center" Click="Add_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>

<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MainLauncher.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:MainLauncher.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Padding="36,20,36,24" Spacing="16" MaxWidth="760" HorizontalAlignment="Left">
        <TextBlock Text="Cài đặt" Style="{StaticResource TitleTextBlockStyle}" />

        <StackPanel Spacing="4">
            <TextBlock Text="Thư mục cài đặt" FontWeight="SemiBold" />
            <TextBlock Text="{x:Bind ViewModel.BaseDirectory}" TextWrapping="Wrap" Opacity="0.8" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="File cấu hình module" FontWeight="SemiBold" />
            <TextBlock Text="{x:Bind ViewModel.ModulesConfigPath}" TextWrapping="Wrap" Opacity="0.8" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Tải lại modules.json" Command="{x:Bind ViewModel.ReloadModulesCommand}" />
            <!-- Thứ tự kéo thả thẻ (launcher-settings.json) → quay về thứ tự trong modules.json -->
            <Button Content="Sắp xếp lại theo modules.json" Command="{x:Bind ViewModel.ResetOrderCommand}"
                    ToolTipService.ToolTip="Bỏ thứ tự đã kéo thả, xếp module theo thứ tự trong modules.json" />
        </StackPanel>

        <!-- Khởi động cùng Windows: registry HKCU Run (Services\StartupRegistration), đọc lại mỗi lần mở trang -->
        <StackPanel Spacing="4" Margin="0,8,0,0">
            <ToggleSwitch x:Name="StartWithWindowsSwitch" Header="Khởi động cùng Windows" OffContent="Tắt" OnContent="Bật"
                          IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}" AutomationProperties.Name="Khởi động cùng Windows" />
            <TextBlock x:Name="StartupStatusText" Text="{x:Bind ViewModel.StartupStatus, Mode=OneWay}" TextWrapping="Wrap"
                       Opacity="0.7" FontSize="12" AutomationProperties.AutomationId="StartupStatusText" />
            <CheckBox x:Name="StartMinimizedCheckBox" Content="Khi khởi động cùng Windows: không mở cửa sổ (nằm sẵn ở khay hệ thống, hoặc thanh tác vụ nếu tắt mục dưới)"
                      IsChecked="{x:Bind ViewModel.StartMinimized, Mode=TwoWay}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Bấm X → ẩn xuống khay hệ thống (Services\TrayIcon); thoát hẳn bằng menu chuột phải ở icon -->
        <StackPanel Spacing="4" Margin="0,8,0,0">
            <ToggleSwitch x:Name="CloseToTraySwitch" Header="Khi bấm X: thu xuống khay hệ thống (không thoát)" OffContent="Tắt - bấm X là thoát"
                          OnContent="Bật" IsOn="{x:Bind ViewModel.CloseToTray, Mode=TwoWay}"
                          AutomationProperties.Name="Khi bấm X: thu xuống khay hệ thống" />
            <TextBlock Text="Bật: bấm X thì cửa sổ ẩn đi, các module vẫn chạy, biểu tượng AppSuite nằm ở khay hệ thống (góc phải thanh tác vụ, có thể trong nút ^). Bấm biểu tượng để mở lại; chuột phải → Thoát AppSuite để tắt hẳn."
                       TextWrapping="Wrap" Opacity="0.7" FontSize="12" />
        </StackPanel>

        <!-- Đóng MainLauncher mà còn module đang chạy (thứ tự mục = enum CloseModulesOnExit) -->
        <RadioButtons x:Name="CloseModulesOnExitRadio" Header="Khi đóng MainLauncher mà còn module đang chạy" Margin="0,8,0,0"
                      SelectedIndex="{x:Bind ViewModel.CloseModulesOnExitIndex, Mode=TwoWay}">
            <x:String>Hỏi mỗi lần (Đóng hết / Để chạy tiếp)</x:String>
            <x:String>Luôn đóng hết các module</x:String>
            <x:String>Luôn để các module chạy tiếp</x:String>
        </RadioButtons>

        <!-- Ẩn / hiện module ở Dashboard và Module List (cùng lựa chọn với nút "Ẩn / hiện" ở 2 trang đó) -->
        <StackPanel Spacing="6" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="Module hiện trên màn hình" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text="{x:Bind ViewModel.Dashboard.VisibleSummary, Mode=OneWay}" Opacity="0.6" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="Bỏ tích để ẩn module khỏi trang Tổng quan và Danh sách module (danh sách này luôn đủ để bật lại). Lưu ngay vào Config\launcher-settings.json; module đang ẩn mà đang chạy vẫn hiện tạm để bấm Dừng được."
                       TextWrapping="Wrap" Opacity="0.7" FontSize="12" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.Dashboard.VisibilityItems}" Margin="0,4,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ModuleVisibilityItem">
                        <CheckBox IsChecked="{x:Bind IsVisible, Mode=TwoWay}" AutomationProperties.Name="{x:Bind Name}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{x:Bind Name}" />
                                <TextBlock Text="{x:Bind Description}" Opacity="0.6" TextTrimming="CharacterEllipsis" MaxWidth="360" />
                            </StackPanel>
                        </CheckBox>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="Hiện tất cả" Command="{x:Bind ViewModel.Dashboard.ShowAllModulesCommand}" />
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</Page>

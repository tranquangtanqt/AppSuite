<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MainLauncher.Views.ModuleListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:MainLauncher.Controls"
    xmlns:vm="using:MainLauncher.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12" Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Module List" Style="{StaticResource TitleLargeTextBlockStyle}" VerticalAlignment="Center" />
            <Button Content="Reload" Command="{x:Bind ViewModel.LoadModulesCommand}" VerticalAlignment="Center" />
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="20" Height="20" VerticalAlignment="Center" />
        </StackPanel>

        <GridView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Modules}" SelectionMode="None" IsItemClickEnabled="False">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="vm:ModuleViewModel">
                    <controls:ModuleCard Module="{x:Bind}" />
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</Page>

<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FileTools.Views.CsvSplitPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:FileTools.Views"
    xmlns:vm="using:FileTools.ViewModels"
    NavigationCacheMode="Required">

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
    <Grid x:Name="Root" Padding="24,16" RowSpacing="12" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="140" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="2">
            <TextBlock Text="Tách CSV theo giá trị cột" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock Opacity="0.7" TextWrapping="Wrap"
                       Text="Mỗi giá trị của cột được chọn → 1 file riêng (vd mỗi mã khách hàng / mỗi tháng 1 file), giữ thứ tự bản ghi, lặp dòng tiêu đề ở mọi file. Kéo-thả file vào đây." />
        </StackPanel>

        <views:CsvSourcePanel Grid.Row="1" Source="{x:Bind ViewModel}" />

        <ComboBox Grid.Row="2" Header="Tách theo cột" MinWidth="320" ItemsSource="{x:Bind ViewModel.Columns}"
                  SelectedIndex="{x:Bind ViewModel.SelectedColumnIndex, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:CsvColumnItem">
                    <TextBlock Text="{x:Bind Label}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <Grid Grid.Row="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Header="Thư mục chứa các file" Text="{x:Bind ViewModel.OutputPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="1" VerticalAlignment="Bottom" Content="Chọn..." Command="{x:Bind ViewModel.BrowseFolderCommand}" />
            <views:OutputPanel Grid.Column="2" Settings="{x:Bind ViewModel.Output}" />
        </Grid>

        <Button Grid.Row="4" Content="Tách theo cột" MinWidth="120" Style="{StaticResource CompactAccentButtonStyle}" Command="{x:Bind ViewModel.RunCommand}" />

        <views:JobPanel Grid.Row="5" Job="{x:Bind ViewModel}" />
    </Grid>
    </ScrollViewer>
</Page>

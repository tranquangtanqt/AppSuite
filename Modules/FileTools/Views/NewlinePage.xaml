<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FileTools.Views.NewlinePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:FileTools.Views"
    NavigationCacheMode="Required">

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
    <Grid x:Name="Root" Padding="24,16" RowSpacing="12" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" MinHeight="440" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="2">
            <TextBlock Text="Đổi xuống dòng (hàng loạt)" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock Opacity="0.7" TextWrapping="Wrap"
                       Text="Đổi ký tự xuống dòng CRLF (Windows) ↔ LF (Unix / Linux) cho nhiều file, giữ nguyên encoding. File đã đúng kiểu sẽ được bỏ qua. Cột bên phải xem trước từ 64 KB đầu file." />
        </StackPanel>

        <views:BatchFilesPanel Grid.Row="1" Batch="{x:Bind ViewModel}" DetailHeader="Xuống dòng hiện tại" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="24">
            <RadioButtons Header="Đổi thành" MaxColumns="2" SelectedIndex="{x:Bind ViewModel.TargetIndex, Mode=TwoWay}">
                <x:String>CRLF (Windows)</x:String>
                <x:String>LF (Unix / Linux)</x:String>
            </RadioButtons>
            <Button VerticalAlignment="Bottom" Content="Đổi xuống dòng" MinWidth="120" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.ConvertCommand}" />
        </StackPanel>

        <views:JobPanel Grid.Row="3" Job="{x:Bind ViewModel}" />
    </Grid>
    </ScrollViewer>
</Page>

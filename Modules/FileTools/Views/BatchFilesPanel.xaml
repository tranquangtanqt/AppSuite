<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FileTools.Views.BatchFilesPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:FileTools.ViewModels">

    <!-- Danh sách file xử lý hàng loạt + nơi ghi kết quả (dùng chung cho Đổi encoding / Đổi xuống dòng). -->
    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="8" RowSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBox PlaceholderText="Dán đường dẫn file / thư mục (nhiều: cách nhau bằng ;)" ToolTipService.ToolTip="Đường dẫn cần thêm" AutomationProperties.Name="Đường dẫn cần thêm"
                     Text="{x:Bind Batch.TypedPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=''}" />
            <Button Grid.Column="1" Content="Thêm" Command="{x:Bind Batch.AddTypedPathCommand, Mode=OneWay}" />
            <Button Grid.Column="2" Content="Thêm file..." Command="{x:Bind Batch.AddFilesCommand, Mode=OneWay}" />
            <Button Grid.Column="3" Content="Thêm thư mục..." Command="{x:Bind Batch.AddFolderCommand, Mode=OneWay}" />
            <StackPanel Grid.Row="1" Grid.ColumnSpan="4" Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Khi thêm thư mục, lấy file:" VerticalAlignment="Center" Opacity="0.8" />
                <TextBox Width="220" ToolTipService.ToolTip="Mẫu lọc khi thêm thư mục" AutomationProperties.Name="Mẫu lọc khi thêm thư mục"
                         Text="{x:Bind Batch.Patterns, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=''}" />
                <CheckBox Content="Gồm thư mục con" IsChecked="{x:Bind Batch.Recursive, Mode=TwoWay, FallbackValue=False}" />
                <Button Content="Bỏ file đang chọn" Command="{x:Bind Batch.RemoveCommand, Mode=OneWay}" />
                <Button Content="Xoá danh sách" Command="{x:Bind Batch.ClearCommand, Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" MinHeight="140" BorderThickness="1" CornerRadius="4" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Padding="12,6" ColumnSpacing="12" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="260" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind Batch.Summary, Mode=OneWay, FallbackValue=''}" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="Dung lượng" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="2" Text="{x:Bind DetailHeader, Mode=OneWay}" FontWeight="SemiBold" />
                </Grid>
                <ListView Grid.Row="1" ItemsSource="{x:Bind Batch.Files, Mode=OneWay}" SelectedItem="{x:Bind Batch.SelectedFile, Mode=TwoWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:BatchFileItem">
                            <Grid ColumnSpacing="12" ToolTipService.ToolTip="{x:Bind FullName}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="260" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{x:Bind SizeText}" HorizontalAlignment="Right" Opacity="0.8" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Detail, Mode=OneWay}" Opacity="0.8" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <RadioButtons Header="Ghi kết quả" SelectedIndex="{x:Bind Batch.OutputModeIndex, Mode=TwoWay, FallbackValue=0}">
                <x:String>Ra thư mục khác (giữ nguyên file gốc)</x:String>
                <x:String>Ghi đè file gốc (bản cũ giữ thành .bak)</x:String>
            </RadioButtons>
            <TextBox Grid.Column="1" VerticalAlignment="Bottom" Header="Thư mục kết quả"
                     IsEnabled="{x:Bind Batch.UsesOutputFolder, Mode=OneWay, FallbackValue=True}"
                     Text="{x:Bind Batch.OutputFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=''}" />
            <Button Grid.Column="2" VerticalAlignment="Bottom" Content="Chọn..."
                    IsEnabled="{x:Bind Batch.UsesOutputFolder, Mode=OneWay, FallbackValue=True}"
                    Command="{x:Bind Batch.BrowseOutputCommand, Mode=OneWay}" />
        </Grid>
    </Grid>
</UserControl>

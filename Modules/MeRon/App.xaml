<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="MeRon.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MeRon">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Compact sizing (Button/TextBox/ComboBox/TextBlock/...) applied suite-wide -->
                <ResourceDictionary Source="ms-appx:///SharedUI/Themes/CompactStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Cỡ chữ của MeRon: chỉ dùng 5 cỡ này, đổi cỡ sửa 1 chỗ này. Icon dùng chung các cỡ 12 / 14 / 16 -->
            <x:Double x:Key="FontSizeCaption">12</x:Double>   <!-- chú thích, nhãn phụ, trục biểu đồ -->
            <x:Double x:Key="FontSizeBody">14</x:Double>      <!-- nội dung, nút, dòng trong bảng -->
            <x:Double x:Key="FontSizeEmphasis">16</x:Double>  <!-- tên khách, tổng tiền trên thẻ, tiêu đề nhóm -->
            <x:Double x:Key="FontSizeNumber">20</x:Double>    <!-- số trong thẻ nhỏ -->
            <x:Double x:Key="FontSizeDisplay">28</x:Double>   <!-- số lớn báo cáo; tiêu đề trang là TitleTextBlockStyle, cũng 28 -->
            <Style x:Key="GroupTitleTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="FontSize" Value="{StaticResource FontSizeEmphasis}" />
            </Style>

            <!-- Màu riêng của MeRon cho thẻ thống kê, chấm nhóm...: đổi màu sửa 1 chỗ này -->
            <SolidColorBrush x:Key="BlueBrush" Color="#1C7ED6" />
            <SolidColorBrush x:Key="BlueSoftBrush" Color="#261C7ED6" />
            <SolidColorBrush x:Key="GreenBrush" Color="#2F9E44" />
            <SolidColorBrush x:Key="GreenSoftBrush" Color="#262F9E44" />
            <SolidColorBrush x:Key="OnColorOverlayBrush" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="OrangeBrush" Color="#E8590C" />
            <SolidColorBrush x:Key="OrangeSoftBrush" Color="#26E8590C" />
            <SolidColorBrush x:Key="RedBrush" Color="#E03131" />
            <SolidColorBrush x:Key="RedSoftBrush" Color="#26E03131" />

            <!-- Giao diện 2026-10-15: màu chủ đạo cam của MeRon thay màu nhấn Windows (nút Thêm, tab, số tiền...). -->
            <Color x:Key="SystemAccentColor">#E8590C</Color>
            <Color x:Key="SystemAccentColorLight1">#F76707</Color>
            <Color x:Key="SystemAccentColorLight2">#FD7E14</Color>
            <Color x:Key="SystemAccentColorLight3">#FFA94D</Color>
            <Color x:Key="SystemAccentColorDark1">#D9480F</Color>
            <Color x:Key="SystemAccentColorDark2">#C2410C</Color>
            <Color x:Key="SystemAccentColorDark3">#9A3412</Color>
        </ResourceDictionary>
    </Application.Resources>
</Application>

<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MeRon.Views.ReportTable"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MeRon.ViewModels"
    xmlns:local="using:MeRon.Views">

    <!-- Bảng 3 cột Tên / Số lượng / Thành tiền dùng trong các báo cáo; ShowTrend: thêm cột ▲▼ so với kỳ trước (Theo món ăn). -->
    <UserControl.Resources>
        <x:Double x:Key="ReportTrendWidth">110</x:Double>
    </UserControl.Resources>
    <Border CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
        <StackPanel>
            <Grid Padding="12,6" ColumnSpacing="12" Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="130" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind NameHeader, Mode=OneWay}" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="{x:Bind QuantityHeader, Mode=OneWay}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="2" Text="So với kỳ trước" Width="{StaticResource ReportTrendWidth}" FontWeight="SemiBold" TextAlignment="Right"
                           Visibility="{x:Bind ShowTrend, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind TrendHeaderTip, Mode=OneWay}" />
                <TextBlock Grid.Column="3" Text="Thành tiền" FontWeight="SemiBold" HorizontalAlignment="Right" />
            </Grid>
            <TextBlock x:Name="EmptyText" Text="Chưa có dữ liệu trong khoảng ngày này." Margin="12,10" Visibility="Collapsed"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <ItemsControl ItemsSource="{x:Bind Lines, Mode=OneWay}" IsTabStop="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ReportLine">
                        <Grid Padding="12,5" ColumnSpacing="12" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="130" />
                            </Grid.ColumnDefinitions>
                            <!-- Giao diện 2026-10-15: thanh tỷ lệ so với món bán nhiều nhất -->
                            <StackPanel Spacing="3">
                                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" Opacity="{x:Bind LineOpacity}" />
                                <ProgressBar Value="{x:Bind Share}" Maximum="100" MinHeight="4" CornerRadius="2" MaxWidth="320" HorizontalAlignment="Left" Width="320"
                                             Visibility="{x:Bind HasShare}" IsTabStop="False" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{x:Bind Quantity}" HorizontalAlignment="Right" Opacity="{x:Bind LineOpacity}" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Trend}" Width="{StaticResource ReportTrendWidth}" TextAlignment="Right" FontWeight="SemiBold"
                                       Foreground="{x:Bind local:ReportTable.TrendBrush(TrendKind)}" Visibility="{x:Bind HasTrend}"
                                       ToolTipService.ToolTip="{x:Bind TrendTip}" />
                            <TextBlock Grid.Column="3" Text="{x:Bind Amount}" HorizontalAlignment="Right" Opacity="{x:Bind LineOpacity}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>

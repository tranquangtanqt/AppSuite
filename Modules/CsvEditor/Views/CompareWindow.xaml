<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CsvEditor.Views.CompareWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:CsvEditor.Views"
    Title="So sánh - CsvEditor">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!-- Kết quả So sánh 2 file (CompareWindow.xaml.cs). Không đặt x:Name trùng tên thuộc tính của CompareRow (StatusText...):
         XAML compiler báo lỗi WMC9999 không rõ nguyên nhân. -->
    <Grid x:Name="Root" Padding="12" RowSpacing="8" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F8" Invoked="NextDifference_Invoked" />
            <KeyboardAccelerator Key="F8" Modifiers="Shift" Invoked="PreviousDifference_Invoked" />
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="FocusSearch_Invoked" />
        </Grid.KeyboardAccelerators>
        <Grid.Resources>
            <Style x:Key="TileStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            </Style>
            <Style x:Key="TileNumber" TargetType="TextBlock">
                <Setter Property="FontSize" Value="22" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="TileLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
            <Style x:Key="ResultItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Hàng 1: A ⇄ B, khoá, nút -->
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid ColumnSpacing="8" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MaxWidth="360" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" MaxWidth="360" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FileAText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Button x:Name="SwapButton" Grid.Column="1" Click="SwapButton_Click" Padding="6,2" ToolTipService.ToolTip="Đổi chỗ A và B" AutomationProperties.Name="Đổi chỗ A và B">
                    <FontIcon Glyph="&#xE8AB;" FontSize="14" />
                </Button>
                <TextBlock x:Name="FileBText" Grid.Column="2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Border Grid.Column="3" Width="1" Margin="4,2" Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                <TextBlock x:Name="KeyText" Grid.Column="4" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                <Button x:Name="OptionsButton" Click="OptionsButton_Click" AutomationProperties.Name="Tuỳ chọn so sánh" ToolTipService.ToolTip="Đổi file B, cột khoá, cách so, cột bỏ qua">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE713;" FontSize="14" /><TextBlock Text="Tuỳ chọn..." /></StackPanel>
                </Button>
                <Button x:Name="ExportButton" Click="ExportButton_Click" AutomationProperties.Name="Xuất Excel" ToolTipService.ToolTip="Xuất các dòng đang hiện ra Excel (.xlsx): sheet Kết quả tô màu + sheet Tóm tắt">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xEDE1;" FontSize="14" /><TextBlock Text="Xuất Excel" /></StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Hàng 2: 4 ô số = bộ lọc trạng thái (bấm để hiện / ẩn) -->
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="TileSame" Grid.Column="0" Tag="Same" Click="Tile_Click" Style="{StaticResource TileStyle}" AutomationProperties.Name="Giống">
                <StackPanel><TextBlock x:Name="SameCount" Style="{StaticResource TileNumber}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Text="Giống" Style="{StaticResource TileLabel}" /></StackPanel>
            </Button>
            <Button x:Name="TileModified" Grid.Column="1" Tag="Modified" Click="Tile_Click" Style="{StaticResource TileStyle}" AutomationProperties.Name="Sửa">
                <StackPanel><TextBlock x:Name="ModifiedCount" Style="{StaticResource TileNumber}" Foreground="{ThemeResource SystemFillColorCautionBrush}" /><TextBlock x:Name="ModifiedLabel" Text="Sửa" Style="{StaticResource TileLabel}" /></StackPanel>
            </Button>
            <Button x:Name="TileOnlyB" Grid.Column="2" Tag="OnlyB" Click="Tile_Click" Style="{StaticResource TileStyle}" AutomationProperties.Name="Chỉ có ở B">
                <StackPanel><TextBlock x:Name="OnlyBCount" Style="{StaticResource TileNumber}" Foreground="{ThemeResource SystemFillColorSuccessBrush}" /><TextBlock Text="Chỉ có ở B (thêm)" Style="{StaticResource TileLabel}" /></StackPanel>
            </Button>
            <Button x:Name="TileOnlyA" Grid.Column="3" Tag="OnlyA" Click="Tile_Click" Style="{StaticResource TileStyle}" AutomationProperties.Name="Chỉ có ở A">
                <StackPanel><TextBlock x:Name="OnlyACount" Style="{StaticResource TileNumber}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" /><TextBlock Text="Chỉ có ở A (bớt)" Style="{StaticResource TileLabel}" /></StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" PlaceholderText="Tìm khoá, tên cột hoặc giá trị... (Ctrl+F)" TextChanged="SearchBox_TextChanged" AutomationProperties.Name="Tìm trong kết quả" />
            <TextBlock x:Name="ShownText" Grid.Column="1" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <!-- Bảng kết quả: mỗi ô khác 1 dòng; bản ghi thêm / bớt / giống 1 dòng "(cả bản ghi)" -->
        <Border Grid.Row="3" CornerRadius="6" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Padding="12,8" ColumnSpacing="12" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="KeyHeader" FontWeight="SemiBold" Text="Khoá" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="Cột" />
                    <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="File A" />
                    <TextBlock Grid.Column="3" FontWeight="SemiBold" Text="File B" />
                    <TextBlock Grid.Column="4" FontWeight="SemiBold" Text="Trạng thái" />
                </Grid>
                <ListView x:Name="ResultList" Grid.Row="1" SelectionMode="Single" IsDoubleTapEnabled="True" DoubleTapped="ResultList_DoubleTapped"
                          PreviewKeyDown="ResultList_PreviewKeyDown" ItemContainerStyle="{StaticResource ResultItemStyle}" AutomationProperties.Name="Kết quả so sánh">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="views:CompareRow">
                            <Grid Padding="12,0" ColumnSpacing="12" MinHeight="32" BorderThickness="{x:Bind TopLine}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Key}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{x:Bind ColumnName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{x:Bind ColumnBrush}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind ValueA}" Foreground="{x:Bind BrushA}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="3" Text="{x:Bind ValueB}" Foreground="{x:Bind BrushB}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Border Grid.Column="4" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="10" Padding="8,1" Background="{x:Bind PillBackground}">
                                    <TextBlock Text="{x:Bind StatusLabel}" FontSize="12" Foreground="{x:Bind PillForeground}" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="EmptyText" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ProgressRing x:Name="BusyRing" Grid.Row="1" IsActive="False" Width="40" Height="40" />
            </Grid>
        </Border>

        <TextBlock x:Name="FooterText" Grid.Row="4" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
    </Grid>
</Window>

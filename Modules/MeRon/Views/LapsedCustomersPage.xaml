<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MeRon.Views.LapsedCustomersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MeRon.ViewModels"
    xmlns:local="using:MeRon.Views"
    NavigationCacheMode="Enabled">

    <Grid Padding="24,12,24,0" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Khách lâu không đặt" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <Border Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,4,0,0" CornerRadius="14" Padding="12,3,12,4"
                    Background="#26E8590C">
                <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                           TextWrapping="Wrap" AutomationProperties.AutomationId="LapsedSummary" />
            </Border>
            <TextBox x:Name="SearchBox" Grid.Column="2" Width="280" Style="{StaticResource DefaultTextBoxStyle}"
                     PlaceholderText="Tìm theo tên hoặc số điện thoại" AutomationProperties.Name="Tìm khách"
                     Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <!-- Bộ lọc: số ngày không đặt, số đơn tối thiểu, sắp xếp -->
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Không đặt từ" VerticalAlignment="Center" FontSize="14" />
            <NumberBox Grid.Column="1" Value="{x:Bind ViewModel.MinDays, Mode=TwoWay}" Minimum="1" Width="80" SpinButtonPlacementMode="Hidden"
                       AutomationProperties.Name="Số ngày không đặt" />
            <TextBlock Grid.Column="2" Text="ngày" VerticalAlignment="Center" FontSize="14" />
            <DropDownButton Grid.Column="3" AutomationProperties.Name="Chọn nhanh số ngày" ToolTipService.ToolTip="Chọn nhanh số ngày">
                <FontIcon Glyph="&#xE823;" FontSize="14" />
                <DropDownButton.Flyout>
                    <MenuFlyout x:Name="DaysMenu" Placement="BottomEdgeAlignedLeft" />
                </DropDownButton.Flyout>
            </DropDownButton>
            <TextBlock Grid.Column="4" Text="Đã đặt ít nhất" VerticalAlignment="Center" FontSize="14" Margin="16,0,0,0" />
            <NumberBox Grid.Column="5" Value="{x:Bind ViewModel.MinOrders, Mode=TwoWay}" Minimum="1" Width="70" SpinButtonPlacementMode="Hidden"
                       AutomationProperties.Name="Số đơn tối thiểu" />
            <TextBlock Grid.Column="6" Text="đơn" VerticalAlignment="Center" FontSize="14" />
            <DropDownButton Grid.Column="7" x:Name="SortButton" AutomationProperties.Name="Sắp xếp" Margin="16,0,0,0">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE8CB;" FontSize="14" />
                    <TextBlock x:Name="SortText" Text="Sắp xếp" FontSize="14" />
                </StackPanel>
                <DropDownButton.Flyout>
                    <MenuFlyout x:Name="SortMenu" Placement="BottomEdgeAlignedLeft" />
                </DropDownButton.Flyout>
            </DropDownButton>
        </Grid>

        <InfoBar Grid.Row="2" Severity="Error" IsClosable="False" Message="{x:Bind ViewModel.Error, Mode=OneWay}"
                 IsOpen="{x:Bind local:Ui.HasText(ViewModel.Error), Mode=OneWay}" />
        <InfoBar Grid.Row="2" Severity="Success" IsClosable="True" Message="{x:Bind ViewModel.Message, Mode=OneWay}"
                 IsOpen="{x:Bind local:Ui.HasText(ViewModel.Message), Mode=OneWay}" AutomationProperties.AutomationId="LapsedMessage" />

        <TextBlock Grid.Row="3" Opacity="0.75" TextWrapping="Wrap"
                   Text="Khách đã đặt đủ số đơn mà đơn gần nhất (theo ngày giao, không tính đơn Huỷ) đã quá số ngày trên. Thói quen = trung bình bao nhiêu ngày đặt 1 lần (cần từ 3 lần đặt); nghỉ gấp 2 lần thói quen trở lên thì có nhãn cam - nên hỏi thăm trước." />

        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
            <ItemsRepeater x:Name="RowsRepeater" ItemsSource="{x:Bind ViewModel.Rows}" Margin="0,0,12,24" MaxWidth="980" HorizontalAlignment="Left">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="8" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:LapsedRow">
                        <!-- Thẻ khách: ô số ngày không đặt (cam khi nghỉ quá thói quen), ô tròn chữ cái đầu, thông tin, nút -->
                        <Border Padding="14,12" CornerRadius="10" BorderThickness="1"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                AutomationProperties.Name="{x:Bind AccessibleName}">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="64" CornerRadius="10" Padding="0,8" VerticalAlignment="Center" Background="{x:Bind local:Ui.LapsedBackground(IsOverHabit)}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{x:Bind DaysText}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"
                                                   Foreground="{x:Bind local:Ui.LapsedForeground(IsOverHabit)}" />
                                        <TextBlock Text="ngày" FontSize="12" HorizontalAlignment="Center" Foreground="{x:Bind local:Ui.LapsedForeground(IsOverHabit)}" />
                                    </StackPanel>
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Border Width="26" Height="26" CornerRadius="13" Background="{x:Bind local:Ui.AvatarBrush(Name)}" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind local:Ui.Initial(Name)}" Foreground="White" FontWeight="SemiBold" FontSize="12"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="{x:Bind Name}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <Border Padding="8,1" CornerRadius="10" VerticalAlignment="Center"
                                                Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                                Visibility="{x:Bind local:Ui.VisibleIf(IsOverHabit)}">
                                            <TextBlock Text="{x:Bind OverHabitText}" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind Contact}" Opacity="0.75" Visibility="{x:Bind local:Ui.VisibleIf(HasContact)}" />
                                    <TextBlock>
                                        <Run Text="{x:Bind LastDayText}" /><Run Text="  ·  " /><Run Text="{x:Bind OrdersText}" FontWeight="SemiBold" />
                                    </TextBlock>
                                    <TextBlock Text="{x:Bind HabitText}" Opacity="0.75" />
                                    <TextBlock Text="{x:Bind ProductsText}" Opacity="0.75" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Button Tag="{x:Bind}" Click="Detail_Click" AutomationProperties.Name="Xem đơn" ToolTipService.ToolTip="Xem các đơn của khách">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <SymbolIcon Symbol="View" />
                                            <TextBlock Text="Xem đơn" />
                                        </StackPanel>
                                    </Button>
                                    <Button Tag="{x:Bind}" Click="Reorder_Click" AutomationProperties.Name="Đặt lại"
                                            ToolTipService.ToolTip="Đơn mới giống đơn gần nhất, giao hôm nay, giá hiện tại">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <SymbolIcon Symbol="RepeatAll" />
                                            <TextBlock Text="Đặt lại" />
                                        </StackPanel>
                                    </Button>
                                    <Button Tag="{x:Bind}" Click="CopyMessage_Click" AutomationProperties.Name="Chép tin nhắn"
                                            ToolTipService.ToolTip="Chép tin nhắn hỏi thăm để dán vào Zalo">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <SymbolIcon Symbol="Message" />
                                            <TextBlock Text="Tin nhắn" />
                                        </StackPanel>
                                    </Button>
                                    <Button Tag="{x:Bind}" Click="CopyPhone_Click" AutomationProperties.Name="Chép số điện thoại"
                                            ToolTipService.ToolTip="Chép số điện thoại" Visibility="{x:Bind local:Ui.VisibleIf(HasPhone)}">
                                        <SymbolIcon Symbol="Phone" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
    </Grid>
</Page>

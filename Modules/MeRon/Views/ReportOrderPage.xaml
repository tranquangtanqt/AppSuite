<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MeRon.Views.ReportOrderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MeRon.ViewModels"
    xmlns:local="using:MeRon.Views">

    <Grid Padding="24,12,24,0" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Thống kê theo đơn hàng" Style="{StaticResource SubtitleTextBlockStyle}" />

        <SelectorBar x:Name="StatusBar" Grid.Row="1" SelectionChanged="StatusBar_SelectionChanged" AutomationProperties.Name="Trạng thái">
            <SelectorBarItem Text="Tất cả" Tag="0" />
            <SelectorBarItem Text="Đã lên đơn" Tag="1" />
            <SelectorBarItem Text="Đã thanh toán" Tag="2" />
            <SelectorBarItem Text="Huỷ" Tag="3" />
        </SelectorBar>

        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="320" MinWidth="160" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox x:Name="CustomerBox" PlaceholderText="Lọc theo khách (tên / SĐT)" QueryIcon="Find" AutomationProperties.Name="Lọc theo khách hàng" />
            <Button Grid.Column="1" Click="ClearCustomer_Click" AutomationProperties.Name="Bỏ lọc khách" ToolTipService.ToolTip="Bỏ lọc khách"
                    Visibility="{x:Bind local:Ui.VisibleIf(ViewModel.HasCustomer), Mode=OneWay}">
                <SymbolIcon Symbol="Clear" />
            </Button>
            <local:DateRangeBar x:Name="RangeBar" Grid.Column="2" Filter="{x:Bind ViewModel.Range}" />
        </Grid>

        <InfoBar Grid.Row="3" Severity="Error" IsClosable="False" Message="{x:Bind ViewModel.Error, Mode=OneWay}"
                 IsOpen="{x:Bind local:Ui.HasText(ViewModel.Error), Mode=OneWay}" />

        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="18" Padding="0,0,12,24" MaxWidth="900" HorizontalAlignment="Left">
                <TextBlock Text="Không có đơn nào khớp bộ lọc." Opacity="0.7" Visibility="{x:Bind local:Ui.VisibleIfNot(ViewModel.HasData), Mode=OneWay}" />

                <!-- Tổng cộng -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Tổng cộng theo đơn hàng (không tính đơn Huỷ)" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Padding="16,10" CornerRadius="8" MinWidth="200" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Tổng số đơn" Opacity="0.75" />
                                <TextBlock Text="{x:Bind ViewModel.OrderCount, Mode=OneWay}" FontSize="24" FontWeight="SemiBold" AutomationProperties.AutomationId="ReportOrderCount" />
                            </StackPanel>
                        </Border>
                        <Border Padding="16,10" CornerRadius="8" MinWidth="240" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Tổng thành tiền" Opacity="0.75" />
                                <TextBlock Text="{x:Bind ViewModel.Amount, Mode=OneWay}" FontSize="24" FontWeight="SemiBold"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" AutomationProperties.AutomationId="ReportAmount" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <ItemsControl x:Name="TilesList" ItemsSource="{x:Bind ViewModel.StatusTiles}" IsTabStop="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="10" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:StatusTile">
                                <Border Padding="14,8" CornerRadius="8" MinWidth="180" Background="{x:Bind local:Ui.StatusBackground(Status)}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                        AutomationProperties.Name="{x:Bind Label}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind Label}" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind Count}" />
                                        <TextBlock Text="{x:Bind Amount}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Theo món -->
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <TextBlock Text="Tổng cộng theo món" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind ViewModel.TotalQuantity, Mode=OneWay}" Opacity="0.75" AutomationProperties.AutomationId="ReportTotalQuantity" />
                    </StackPanel>
                    <local:ReportTable Lines="{x:Bind ViewModel.Products}" QuantityHeader="Số lượng" />
                </StackPanel>

                <!-- Theo khách -->
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="Chi tiết đơn hàng (theo khách - bấm để xem đơn)" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <DropDownButton AutomationProperties.Name="Sắp xếp khách">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8CB;" FontSize="14" />
                                <TextBlock x:Name="SortText" />
                            </StackPanel>
                            <DropDownButton.Flyout>
                                <MenuFlyout x:Name="SortMenu" Placement="BottomEdgeAlignedLeft" />
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </StackPanel>
                    <ItemsControl x:Name="RowsList" ItemsSource="{x:Bind ViewModel.CustomerRows}" IsTabStop="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CustomerReportRow">
                                <Button Click="Customer_Click" Tag="{x:Bind}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                        Margin="0,0,0,4" Padding="12,8" AutomationProperties.Name="{x:Bind AccessibleName}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind RankText}" Opacity="0.6" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind Orders}" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="3" Text="{x:Bind Amount}" HorizontalAlignment="Right" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <FontIcon Grid.Column="4" Glyph="&#xE76C;" FontSize="12" Opacity="0.6" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

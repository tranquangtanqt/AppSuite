<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ModuleF.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ModuleF"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:models="using:ModuleF.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Module F - CSV/TSV Editor">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Padding="12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="0,0,0,16">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button x:Name="OpenButton" Click="OpenButton_Click" ToolTipService.ToolTip="Mở file CSV/TSV">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8E5;" FontSize="14" /><TextBlock Text="Open" /></StackPanel>
                </Button>
                <Button x:Name="SaveButton" Click="SaveButton_Click" IsEnabled="{x:Bind ViewModel.IsDirty, Mode=OneWay}" ToolTipService.ToolTip="Lưu">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE74E;" FontSize="14" /><TextBlock Text="Save" /></StackPanel>
                </Button>
                <Button x:Name="SaveAsButton" Click="SaveAsButton_Click" ToolTipService.ToolTip="Lưu thành file khác">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE792;" FontSize="14" /><TextBlock Text="Save As" /></StackPanel>
                </Button>

                <Border Width="1" Margin="4,2" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                <Button Command="{x:Bind ViewModel.UndoCommand}" ToolTipService.ToolTip="{x:Bind ViewModel.UndoDescription, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE7A7;" FontSize="14" /><TextBlock Text="Undo" /></StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.RedoCommand}" ToolTipService.ToolTip="{x:Bind ViewModel.RedoDescription, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE7A6;" FontSize="14" /><TextBlock Text="Redo" /></StackPanel>
                </Button>

                <Border Width="1" Margin="4,2" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                <Button Click="AddRowButton_Click" ToolTipService.ToolTip="Thêm dòng">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE710;" FontSize="14" /><TextBlock Text="Add Row" /></StackPanel>
                </Button>
                <Button Click="DeleteRowButton_Click" ToolTipService.ToolTip="Xóa dòng đang chọn">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE738;" FontSize="14" /><TextBlock Text="Delete Row" /></StackPanel>
                </Button>
                <Button Click="AddColumnButton_Click" ToolTipService.ToolTip="Thêm cột">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE711;" FontSize="14" /><TextBlock Text="Add Column" /></StackPanel>
                </Button>
                <Button Click="DeleteColumnButton_Click" ToolTipService.ToolTip="Xóa cột đang chọn">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE738;" FontSize="14" /><TextBlock Text="Delete Column" /></StackPanel>
                </Button>
                <Button Click="RenameColumnButton_Click" ToolTipService.ToolTip="Đổi tên cột đang chọn">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE70F;" FontSize="14" /><TextBlock Text="Rename Column" /></StackPanel>
                </Button>

                <Border Width="1" Margin="4,2" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                <Button Click="FindButton_Click" ToolTipService.ToolTip="Tìm kiếm">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE721;" FontSize="14" /><TextBlock Text="Find" /></StackPanel>
                </Button>
                <Button Click="ReplaceButton_Click" ToolTipService.ToolTip="Tìm và thay thế">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8AC;" FontSize="14" /><TextBlock Text="Replace" /></StackPanel>
                </Button>
                <Button Click="FilterButton_Click" ToolTipService.ToolTip="Lọc dữ liệu">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE71C;" FontSize="14" /><TextBlock Text="Filter" /></StackPanel>
                </Button>
                <Button Click="SortButton_Click" ToolTipService.ToolTip="Sắp xếp">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8CB;" FontSize="14" /><TextBlock Text="Sort" /></StackPanel>
                </Button>
                <Button Click="StatisticsButton_Click" ToolTipService.ToolTip="Thống kê">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE9D9;" FontSize="14" /><TextBlock Text="Statistics" /></StackPanel>
                </Button>
            </StackPanel>
        </ScrollViewer>

        <!-- Validation issues -->
        <Expander Grid.Row="1" Header="{x:Bind IssuesHeader, Mode=OneWay}" IsExpanded="False"
                  Visibility="{x:Bind HasIssuesVisibility, Mode=OneWay}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <ListView x:Name="IssuesListView" ItemsSource="{x:Bind ViewModel.Issues}" MaxHeight="160" DoubleTapped="IssuesListView_DoubleTapped">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:ValidationIssue">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7BA;" FontSize="12" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                            <TextBlock Text="{x:Bind Message}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Expander>

        <!-- Data grid -->
        <controls:DataGrid
            x:Name="Grid"
            Grid.Row="2"
            ItemsSource="{x:Bind ViewModel.ViewRows, Mode=OneWay}"
            AutoGenerateColumns="False"
            HeadersVisibility="All"
            SelectionMode="Extended"
            RowHeaderWidth="48"
            CanUserReorderColumns="False"
            CanUserSortColumns="False"
            LoadingRow="Grid_LoadingRow"
            CellEditEnding="Grid_CellEditEnding">
            <controls:DataGrid.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="Copy" Click="CopyMenuItem_Click" />
                    <MenuFlyoutItem Text="Paste" Click="PasteMenuItem_Click" />
                    <MenuFlyoutItem Text="Delete" Click="DeleteRowsMenuItem_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Insert Row" Click="InsertRowMenuItem_Click" />
                    <MenuFlyoutItem Text="Duplicate Row" Click="DuplicateRowMenuItem_Click" />
                </MenuFlyout>
            </controls:DataGrid.ContextFlyout>
        </controls:DataGrid>

        <!-- Status bar -->
        <Grid Grid.Row="3" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16">
                <TextBlock Text="{x:Bind ViewModel.FileName, Mode=OneWay}" />
                <TextBlock Text="{x:Bind ViewModel.EncodingLabel, Mode=OneWay}" Opacity="0.8"
                           IsTapEnabled="True" Tapped="EncodingLabel_Tapped" ToolTipService.ToolTip="Bấm để đổi encoding/delimiter" />
                <TextBlock Text="{x:Bind ViewModel.DelimiterLabel, Mode=OneWay}" Opacity="0.8"
                           IsTapEnabled="True" Tapped="EncodingLabel_Tapped" ToolTipService.ToolTip="Bấm để đổi encoding/delimiter" />
                <TextBlock Opacity="0.8"><Run Text="Dòng:" /><Run Text="{x:Bind ViewModel.RowCount, Mode=OneWay}" /></TextBlock>
                <TextBlock Opacity="0.8"><Run Text="Cột:" /><Run Text="{x:Bind ViewModel.ColumnCount, Mode=OneWay}" /></TextBlock>
                <TextBlock Text="{x:Bind SaveStateText, Mode=OneWay}" Opacity="0.8" />
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Opacity="0.6" />
            </StackPanel>

            <ProgressBar Grid.Column="1" Width="140" VerticalAlignment="Center"
                         Visibility="{x:Bind IsBusyVisibility, Mode=OneWay}"
                         Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}" Maximum="100" />

            <Button Grid.Column="2" Content="Hủy" Click="CancelButton_Click" Visibility="{x:Bind IsBusyVisibility, Mode=OneWay}" />
        </Grid>
    </Grid>
</Window>

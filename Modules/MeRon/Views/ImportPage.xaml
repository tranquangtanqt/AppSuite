<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MeRon.Views.ImportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MeRon.ViewModels"
    xmlns:local="using:MeRon.Views">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24,12,24,24" Spacing="14" MaxWidth="1000" HorizontalAlignment="Left">
            <TextBlock Text="Nhập dữ liệu từ backup của điện thoại" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock TextWrapping="Wrap" Opacity="0.8"
                       Text="Chọn thư mục 1 lần backup (vd 20261011_231039, chứa các file orders_….tsv, users_….tsv…) hoặc thư mục cha chứa nhiều lần backup - khi đó tự lấy bản mới nhất. Nhập sẽ THAY TOÀN BỘ dữ liệu trên máy này." />

            <!-- 1. Chọn thư mục -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{x:Bind ViewModel.FolderPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Thư mục backup"
                         AutomationProperties.Name="Thư mục backup" AutomationProperties.AutomationId="FolderBox" KeyDown="Folder_KeyDown" />
                <Button Grid.Column="1" Content="Chọn thư mục..." Click="Pick_Click" IsEnabled="{x:Bind local:Ui.Not(ViewModel.IsBusy), Mode=OneWay}" />
                <Button Grid.Column="2" Content="Kiểm tra lại" Command="{x:Bind ViewModel.CheckCommand}"
                        ToolTipService.ToolTip="Đọc lại thư mục (vd vừa chép thêm bản backup mới vào thư mục cha)" />
            </Grid>

            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind local:Ui.VisibleIf(ViewModel.IsBusy), Mode=OneWay}" />
            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                       AutomationProperties.AutomationId="ImportStatus" />

            <!-- 2. Xem trước -->
            <StackPanel Spacing="8" Visibility="{x:Bind local:Ui.VisibleIf(ViewModel.HasPlan), Mode=OneWay}">
                <TextBlock Text="{x:Bind ViewModel.BackupTitle, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                <Grid Padding="12,6" ColumnSpacing="12" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Bảng" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="File" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="Sẽ nhập" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="3" Text="Đang có" FontWeight="SemiBold" HorizontalAlignment="Right" />
                </Grid>
                <ItemsControl ItemsSource="{x:Bind ViewModel.Tables}" AutomationProperties.Name="Xem trước các bảng">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ImportTableRow">
                            <Grid Padding="12,4" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Title}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind FileName}" Opacity="0.75" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{x:Bind FileRows}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="3" Text="{x:Bind CurrentRows}" HorizontalAlignment="Right" Opacity="0.75" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <InfoBar Severity="Error" IsClosable="False" Title="Lỗi - chưa nhập được" IsOpen="{x:Bind ViewModel.HasErrors, Mode=OneWay}">
                    <InfoBar.Content>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Errors}" Margin="0,0,0,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{x:Bind}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </InfoBar.Content>
                </InfoBar>
                <InfoBar Severity="Warning" IsClosable="False" Title="Lưu ý (vẫn nhập được)" IsOpen="{x:Bind ViewModel.HasWarnings, Mode=OneWay}">
                    <InfoBar.Content>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Warnings}" Margin="0,0,0,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{x:Bind}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </InfoBar.Content>
                </InfoBar>

                <Button Style="{StaticResource AccentButtonStyle}" Click="Import_Click" IsEnabled="{x:Bind ViewModel.ImportEnabled, Mode=OneWay}"
                        AutomationProperties.Name="Nhập (thay toàn bộ)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <SymbolIcon Symbol="Download" />
                        <TextBlock Text="Nhập (thay toàn bộ)" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- 3. Thông tin -->
            <StackPanel Spacing="4" Margin="0,12,0,0" Opacity="0.75">
                <TextBlock Text="{x:Bind ViewModel.LastImport, Mode=OneWay}" TextWrapping="Wrap" />
                <TextBlock TextWrapping="Wrap" IsTextSelectionEnabled="True">
                    <Run Text="Database: " /><Run Text="{x:Bind ViewModel.DatabasePath}" />
                </TextBlock>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>

<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MainLauncher.Controls.DashboardHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shared="using:SharedUI.Controls"
    mc:Ignorable="d">

    <!--
        Hero header, same structure and same assets as WinUI Gallery's HomePageHeader
        (Controls/HomePage/HomePageHeader.xaml): a hero image faded out via OpacityMaskView +
        a Rectangle mask, title/subtitle over it, and a row of quick-link tiles below in a
        HorizontalScrollContainer. OpacityMaskView/HorizontalScrollContainer/Tile all come from
        SharedUI; GalleryHeaderImage.png and the HomeHeaderTiles/*.png icons were copied from the
        WinUI Gallery sample referenced for this project.
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <LinearGradientBrush x:Key="HeaderBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Offset="0.0" Color="#CED8E4" />
                        <GradientStop Offset="1.0" Color="#D5DBE3" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="HeaderForegroundBrush" Color="Black" />
                    <x:Double x:Key="HeaderImageOpacity">0.9</x:Double>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#020B20" />
                    <SolidColorBrush x:Key="HeaderForegroundBrush" Color="White" />
                    <x:Double x:Key="HeaderImageOpacity">0.8</x:Double>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="Black" />
                    <SolidColorBrush x:Key="HeaderForegroundBrush" Color="White" />
                    <x:Double x:Key="HeaderImageOpacity">0.8</x:Double>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <LinearGradientBrush x:Key="HeaderFadeMaskBrush" StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Offset="0" Color="#FFFFFFFF" />
                <GradientStop Offset="0.75" Color="#FFFFFFFF" />
                <GradientStop Offset="0.85" Color="#00FFFFFF" />
                <GradientStop Offset="1" Color="#00FFFFFF" />
            </LinearGradientBrush>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <shared:OpacityMaskView Grid.RowSpan="3" Height="260" VerticalAlignment="Top">
            <shared:OpacityMaskView.OpacityMask>
                <Rectangle Fill="{ThemeResource HeaderFadeMaskBrush}" />
            </shared:OpacityMaskView.OpacityMask>
            <Grid Background="{ThemeResource HeaderBackgroundBrush}">
                <Image
                    Opacity="{ThemeResource HeaderImageOpacity}"
                    Source="/Assets/GalleryHeaderImage.png"
                    Stretch="UniformToFill" />
            </Grid>
        </shared:OpacityMaskView>

        <StackPanel Margin="36,32,0,0" VerticalAlignment="Top">
            <TextBlock
                Foreground="{ThemeResource HeaderForegroundBrush}"
                FontSize="16"
                Text="{x:Bind Subtitle, Mode=OneWay}" />
            <TextBlock
                Foreground="{ThemeResource HeaderForegroundBrush}"
                Style="{StaticResource TitleLargeTextBlockStyle}"
                Text="AppSuite" />
        </StackPanel>

        <shared:HorizontalScrollContainer Grid.Row="2" Margin="0,32,0,12">
            <shared:HorizontalScrollContainer.Source>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <shared:Tile
                        Title="WinUI 3 Documentation"
                        Description="Kien truc, control va huong dan thiet ke WinUI 3."
                        Link="https://learn.microsoft.com/windows/apps/winui/winui3/">
                        <shared:Tile.Source>
                            <Image Source="/Assets/HomeHeaderTiles/Header-WinUI.png" />
                        </shared:Tile.Source>
                    </shared:Tile>
                    <shared:Tile
                        Title="Windows App SDK"
                        Description="Tai lieu Windows App SDK - runtime ma AppSuite su dung."
                        Link="https://learn.microsoft.com/windows/apps/windows-app-sdk/">
                        <shared:Tile.Source>
                            <Image Source="/Assets/HomeHeaderTiles/Header-WindowsDesign.png" />
                        </shared:Tile.Source>
                    </shared:Tile>
                    <shared:Tile
                        Title="WinUI Gallery (tham khao)"
                        Description="Du an mau ma cac control trong SharedUI duoc chuyen the tu do."
                        Link="https://github.com/microsoft/WinUI-Gallery">
                        <shared:Tile.Source>
                            <Viewbox Height="18">
                                <PathIcon Data="{StaticResource GitHubIconPath}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            </Viewbox>
                        </shared:Tile.Source>
                    </shared:Tile>
                    <shared:Tile
                        Title="Community Toolkit"
                        Description="Tap hop helper, control va app service tai su dung cho WinUI."
                        Link="https://github.com/CommunityToolkit/Windows">
                        <shared:Tile.Source>
                            <Image Source="/Assets/HomeHeaderTiles/Header-Toolkit.png" />
                        </shared:Tile.Source>
                    </shared:Tile>
                </StackPanel>
            </shared:HorizontalScrollContainer.Source>
        </shared:HorizontalScrollContainer>
    </Grid>
</UserControl>

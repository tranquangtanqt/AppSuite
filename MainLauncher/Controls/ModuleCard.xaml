<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MainLauncher.Controls.ModuleCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8"
        Padding="16"
        Width="260"
        Margin="0,0,12,12">
        <Grid>
            <StackPanel Spacing="8">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="40" Height="40"
                        CornerRadius="8"
                        Background="{x:Bind Module.Name, Mode=OneWay, Converter={StaticResource ModuleNameToAccentBrushConverter}}">
                        <FontIcon FontSize="18" Foreground="White" Glyph="&#xE8A5;" />
                    </Border>
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Text="{x:Bind Module.Name, Mode=OneWay}"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        TextTrimming="CharacterEllipsis" />
                </Grid>

                <TextBlock Text="{x:Bind Module.Description, Mode=OneWay}" TextWrapping="Wrap" Opacity="0.7" FontSize="12" />

                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Ellipse
                        Width="10" Height="10"
                        Fill="{x:Bind Module.Status, Mode=OneWay, Converter={StaticResource ModuleStatusToBrushConverter}}"
                        VerticalAlignment="Center" />
                    <TextBlock Text="{x:Bind Module.Status, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock
                        Text="{x:Bind Module.ProcessId, Mode=OneWay}"
                        Opacity="0.6" FontSize="12" VerticalAlignment="Center"
                        Visibility="{x:Bind Module.CanStop, Mode=OneWay}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Start" Command="{x:Bind Module.StartCommand, Mode=OneWay}" IsEnabled="{x:Bind Module.CanStart, Mode=OneWay}" />
                    <Button Content="Stop" Command="{x:Bind Module.StopCommand, Mode=OneWay}" IsEnabled="{x:Bind Module.CanStop, Mode=OneWay}" />
                    <Button Content="Restart" Command="{x:Bind Module.RestartCommand, Mode=OneWay}" IsEnabled="{x:Bind Module.CanStop, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>

            <!--  Status badge, echoing the small colored corner dot on WinUI Gallery's home cards  -->
            <Ellipse
                Width="10" Height="10"
                Margin="0,-2,-2,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Fill="{x:Bind Module.Status, Mode=OneWay, Converter={StaticResource ModuleStatusToBrushConverter}}" />
        </Grid>
    </Border>
</UserControl>

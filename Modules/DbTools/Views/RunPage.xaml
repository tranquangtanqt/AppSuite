<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DbTools.Views.RunPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:DbTools.Views"
    xmlns:vm="using:DbTools.ViewModels"
    xmlns:models="using:DbTools.Models"
    NavigationCacheMode="Required">

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
    <!-- Cao tối thiểu ~560 DIP: vừa cửa sổ 600 DIP (màn hình 150%) mà không phải cuộn mới thấy trạng thái / nhật ký. -->
    <Grid x:Name="Root" Padding="24,12" RowSpacing="8" Background="Transparent" AllowDrop="True"
          DragOver="Root_DragOver" Drop="Root_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" MinHeight="120" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" MinHeight="80" />
        </Grid.RowDefinitions>

        <TextBlock Text="Chạy thư mục SQL" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,48,0"
                   ToolTipService.ToolTip="Chạy mọi file .sql trong thư mục lên PostgreSQL theo thứ tự đúng, trong 1 transaction: lỗi ở đâu là huỷ (rollback) hết." />

        <!-- Thư mục -->
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FolderBox" Header="Thư mục script" Text="{x:Bind ViewModel.Folder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="D:\Projects\...\postgresql_sqlfile" KeyDown="FolderBox_KeyDown" />
            <Button Grid.Column="1" VerticalAlignment="Bottom" Content="Chọn..." Command="{x:Bind ViewModel.BrowseFolderCommand}" />
            <CheckBox Grid.Column="2" VerticalAlignment="Bottom" Content="Gồm thư mục con" IsChecked="{x:Bind ViewModel.IncludeSubfolders, Mode=TwoWay}" />
            <Button x:Name="LoadButton" Grid.Column="3" VerticalAlignment="Bottom" Content="Đọc thư mục" Command="{x:Bind ViewModel.LoadFolderCommand}" />
        </Grid>

        <!-- Kết nối -->
        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="420" />
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="ProfileBox" Header="Chạy lên database" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.Profiles}"
                      SelectedItem="{x:Bind ViewModel.SelectedProfile, Mode=TwoWay}" PlaceholderText="(chưa có kết nối)"
                      IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind ViewModel.ProfileInfo, Mode=OneWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="models:ConnectionProfile">
                        <TextBlock Text="{x:Bind PickerText, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <!-- Schema: để trống = mặc định (search_path của server / user, thường là public). Nhớ theo hồ sơ kết nối. -->
            <Grid Grid.Column="1" ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
            <ComboBox x:Name="SchemaBox" Header="Schema" IsEditable="True" HorizontalAlignment="Stretch"
                      ItemsSource="{x:Bind ViewModel.Schemas}" Text="{x:Bind ViewModel.SchemaInput, Mode=TwoWay}"
                      PlaceholderText="(mặc định: public)" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                      DropDownOpened="SchemaBox_DropDownOpened" TextSubmitted="SchemaBox_TextSubmitted" LostFocus="SchemaBox_LostFocus"
                      AutomationProperties.AutomationId="SchemaBox"
                      ToolTipService.ToolTip="Schema chạy script: tên không ghi schema trong file sẽ tạo / tìm ở schema này (SET search_path). Để trống = mặc định của server / user (thường là public). Tên có ghi schema trong file vẫn theo file." />
                <Button Grid.Column="1" VerticalAlignment="Bottom" Content="✕" Width="32" Padding="0" Click="ClearSchema_Click"
                        IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" AutomationProperties.Name="Bỏ schema"
                        ToolTipService.ToolTip="Bỏ schema - về mặc định (search_path của server / user, thường là public)" />
            </Grid>
            <CheckBox Grid.Column="2" VerticalAlignment="Bottom" Content="Tìm cả trong public" IsChecked="{x:Bind ViewModel.IncludePublic, Mode=TwoWay}"
                      IsEnabled="{x:Bind ViewModel.HasSchema, Mode=OneWay}"
                      ToolTipService.ToolTip="search_path = schema đã chọn, public: script dùng được bảng / hàm nền nằm ở public. Đối tượng mới vẫn tạo ở schema đã chọn." />
            <Button Grid.Column="3" VerticalAlignment="Bottom" HorizontalAlignment="Left" Content="Quản lý kết nối..." Click="ManageConnections_Click" />
        </Grid>

        <!-- Thanh công cụ danh sách -->
        <Grid Grid.Row="3" ColumnSpacing="6" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{x:Bind ViewModel.OrderNote, Mode=OneWay}" Opacity="0.7" FontSize="12" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <Button Content="▲" Width="40" Command="{x:Bind ViewModel.MoveUpCommand}" AutomationProperties.Name="Lên"
                        ToolTipService.ToolTip="Đưa file đang chọn lên trên (Alt+↑). Có thể kéo dòng để đổi chỗ." />
                <Button Content="▼" Width="40" Command="{x:Bind ViewModel.MoveDownCommand}" AutomationProperties.Name="Xuống"
                        ToolTipService.ToolTip="Đưa file đang chọn xuống dưới (Alt+↓). Có thể kéo dòng để đổi chỗ." />
                <Button Content="Bỏ khỏi danh sách" Command="{x:Bind ViewModel.RemoveCommand}"
                        ToolTipService.ToolTip="Không chạy file này. Đọc lại thư mục vẫn bỏ qua tới khi Sắp lại tự động." />
                <Button Content="Mở file" Command="{x:Bind ViewModel.OpenFileCommand}" ToolTipService.ToolTip="Mở file đang chọn bằng ứng dụng mặc định" />
                <Button Content="Chuyển UTF-8" Command="{x:Bind ViewModel.ConvertUtf8Command}" AutomationProperties.AutomationId="ConvertUtf8"
                        ToolTipService.ToolTip="Tạo bản UTF-8 của các file Shift-JIS (lưu thư mục tạm / thư mục dump, hoặc ghi đè file gốc) để mở / chạy bằng psql, DBeaver. DbTools tự chạy file Shift-JIS được, không cần bước này." />
                <Button Content="Sắp lại tự động" Command="{x:Bind ViewModel.AutoSortCommand}"
                        ToolTipService.ToolTip="Bỏ thứ tự chỉnh tay và các file đã bỏ, đọc lại thư mục rồi tự sắp" />
            </StackPanel>
        </Grid>

        <!-- Danh sách file theo thứ tự chạy -->
        <Border Grid.Row="4" BorderThickness="1" CornerRadius="4" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Padding="12,6" ColumnSpacing="10" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="180" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="#" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="1" Text="File (thứ tự chạy)" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="Loại" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="3" Text="Cảnh báo" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="4" Text="Kết quả" FontWeight="SemiBold" />
                </Grid>
                <ListView x:Name="FileList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Files}" SelectedItem="{x:Bind ViewModel.SelectedFile, Mode=TwoWay}"
                          CanDragItems="True" CanReorderItems="True" AllowDrop="True" PreviewKeyDown="FileList_PreviewKeyDown"
                          AutomationProperties.AutomationId="FileList" AutomationProperties.Name="Danh sách file">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="MinHeight" Value="32" />
                            <Setter Property="Padding" Value="12,0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:FileRow">
                            <Grid ColumnSpacing="10" ToolTipService.ToolTip="{x:Bind FullPath}" AutomationProperties.Name="{x:Bind RelativePath}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="180" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Number, Mode=OneWay}" HorizontalAlignment="Right" Opacity="0.6" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{x:Bind RelativePath, Mode=OneWay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Kind, Mode=OneWay}" TextTrimming="CharacterEllipsis" Opacity="0.85" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{x:Bind Danger, Mode=OneWay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           Foreground="{ThemeResource SystemFillColorCautionBrush}" FontWeight="SemiBold" />
                                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                            ToolTipService.ToolTip="{x:Bind Detail, Mode=OneWay}">
                                    <FontIcon Glyph="{x:Bind StatusGlyph, Mode=OneWay}" FontSize="14" Foreground="{x:Bind views:Ui.StatusBrush(Status), Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel Grid.Row="1" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24" IsHitTestVisible="False"
                            Opacity="0.6" Visibility="{x:Bind views:Ui.VisibleIf(ViewModel.IsEmpty), Mode=OneWay}">
                    <FontIcon Glyph="&#xE8B7;" FontSize="28" />
                    <TextBlock Text="Kéo-thả thư mục chứa file .sql vào đây" HorizontalAlignment="Center" FontWeight="SemiBold" />
                    <TextBlock Text="hoặc chọn Thư mục script ở trên rồi bấm Đọc thư mục" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Chi tiết file đang chọn -->
        <Border Grid.Row="5" Padding="12,6" CornerRadius="4" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <ScrollViewer MaxHeight="64" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="DetailText" Text="{x:Bind ViewModel.SelectedDetail, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                           FontSize="12" AutomationProperties.AutomationId="DetailText" />
            </ScrollViewer>
        </Border>

        <!-- Tuỳ chọn + nút chạy -->
        <Grid Grid.Row="6" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <CheckBox x:Name="DropFirstBox" MinHeight="28" Content="Xoá đối tượng cũ rồi tạo lại" IsChecked="{x:Bind ViewModel.DropFirst, Mode=TwoWay}"
                          IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                          ToolTipService.ToolTip="Trước khi chạy: DROP ... IF EXISTS các đối tượng mà thư mục tạo ra (thứ tự ngược, không CASCADE), trong cùng transaction. DROP TABLE xoá luôn dữ liệu." />
                <CheckBox x:Name="BackupFirstBox" MinHeight="28" Content="Sao lưu trước khi chạy" IsChecked="{x:Bind ViewModel.BackupBeforeRun, Mode=TwoWay}"
                          IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" AutomationProperties.AutomationId="BackupFirstBox"
                          ToolTipService.ToolTip="{x:Bind ViewModel.BackupTip}" />
            </StackPanel>
            <Button Grid.Column="1" VerticalAlignment="Center" Content="Xem script xoá" Command="{x:Bind ViewModel.SaveDropScriptCommand}"
                    ToolTipService.ToolTip="Ghi script xoá ngược ra file .sql tạm và mở ra xem" />
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="Kiểm tra" Command="{x:Bind ViewModel.CheckCommand}"
                        ToolTipService.ToolTip="Đối chiếu với DB (chỉ đọc): đối tượng đã có, file xoá / sửa dữ liệu, lệnh không chạy được" />
                <Button Content="Chạy thử" Command="{x:Bind ViewModel.DryRunCommand}"
                        ToolTipService.ToolTip="Chạy hết rồi ROLLBACK - biết script chạy được mà DB không đổi" />
                <Button Content="Chạy" MinWidth="96" Style="{StaticResource CompactAccentButtonStyle}" Command="{x:Bind ViewModel.RunCommand}"
                        ToolTipService.ToolTip="Hỏi lại rồi chạy trong 1 transaction; lỗi là rollback hết" />
                <Button Content="Huỷ" Command="{x:Bind ViewModel.CancelCommand}" />
            </StackPanel>
        </Grid>

        <!-- Tiến độ -->
        <Grid Grid.Row="7" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <ProgressBar Maximum="100" Value="{x:Bind ViewModel.Progress, Mode=OneWay}" />
                <TextBlock x:Name="StatusLine" Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="StatusText" />
            </StackPanel>
            <HyperlinkButton Grid.Column="1" VerticalAlignment="Bottom" Content="Copy nhật ký" Padding="4,0" Command="{x:Bind ViewModel.CopyLogCommand}" />
            <HyperlinkButton Grid.Column="2" VerticalAlignment="Bottom" Content="Thư mục log" Padding="4,0" Command="{x:Bind ViewModel.OpenLogFolderCommand}" />
        </Grid>

        <!-- Nhật ký -->
        <TextBox x:Name="LogBox" Grid.Row="8" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"
                 Text="{x:Bind ViewModel.LogOutput, Mode=OneWay}" ScrollViewer.VerticalScrollBarVisibility="Auto"
                 AutomationProperties.AutomationId="LogBox" AutomationProperties.Name="Nhật ký" TextChanged="LogBox_TextChanged" />
    </Grid>
    </ScrollViewer>
</Page>

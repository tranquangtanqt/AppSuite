<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MainLauncher.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:MainLauncher.Controls"
    xmlns:vm="using:MainLauncher.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <controls:DashboardHeader Grid.Row="0" Subtitle="{x:Bind ViewModel.HeaderSubtitle, Mode=OneWay}" />

            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="16" Margin="36,12,36,0">
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="20" Width="180">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Total Modules" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                        <TextBlock Text="{x:Bind ViewModel.TotalModules, Mode=OneWay}" Style="{StaticResource TitleLargeTextBlockStyle}" />
                    </StackPanel>
                </Border>
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="20" Width="180">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Running" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                        <TextBlock
                            Text="{x:Bind ViewModel.RunningModules, Mode=OneWay}"
                            Style="{StaticResource TitleLargeTextBlockStyle}"
                            Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                    </StackPanel>
                </Border>
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="20" Width="180">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Stopped" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                        <TextBlock
                            Text="{x:Bind ViewModel.StoppedModules, Mode=OneWay}"
                            Style="{StaticResource TitleLargeTextBlockStyle}"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                    </StackPanel>
                </Border>
                <Button
                    Content="Refresh"
                    Command="{x:Bind ViewModel.RefreshStatusCommand}"
                    VerticalAlignment="Bottom" />
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="36,24,36,36" Spacing="12">
                <TextBlock
                    Text="Modules"
                    FontSize="16"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    AutomationProperties.HeadingLevel="Level2" />
                <GridView
                    ItemsSource="{x:Bind ViewModel.Modules}"
                    SelectionMode="None"
                    IsItemClickEnabled="False">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ModuleViewModel">
                            <controls:ModuleCard Module="{x:Bind}" />
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>

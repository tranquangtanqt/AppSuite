<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MeRon.Views.DebtsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MeRon.ViewModels"
    xmlns:local="using:MeRon.Views"
    NavigationCacheMode="Enabled"
    SizeChanged="DebtsPage_SizeChanged">

    <Grid Padding="24,12,24,0" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="3*" MinWidth="170" />
                <ColumnDefinition Width="2*" MinWidth="140" MaxWidth="280" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Công nợ" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <Border Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,4,0,0" CornerRadius="14" Padding="12,3,12,4"
                    Background="{StaticResource OrangeSoftBrush}">
                <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                           TextWrapping="Wrap" AutomationProperties.AutomationId="DebtSummary" />
            </Border>
            <TextBox x:Name="SearchBox" Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource DefaultTextBoxStyle}"
                     PlaceholderText="Tìm theo tên hoặc số điện thoại" AutomationProperties.Name="Tìm khách"
                     Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <!-- Không hiện: chữ trên nút trong thẻ khách bind theo Visibility của phần tử này (DebtsPage_SizeChanged). -->
        <Border x:Name="DetailLabelSwitch" Width="0" Height="0" />
        <Border x:Name="PayLabelSwitch" Width="0" Height="0" />

        <!-- Bộ lọc: tính cả đơn giao sau hôm nay, sắp xếp, mốc tuổi nợ -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="16">
            <CheckBox x:Name="IncludeFutureBox" Content="Tính cả đơn giao sau hôm nay (đặt trước)"
                      IsChecked="{x:Bind ViewModel.IncludeFuture, Mode=TwoWay}" AutomationProperties.Name="Tính cả đơn giao sau hôm nay" />
            <DropDownButton x:Name="SortButton" AutomationProperties.Name="Sắp xếp">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE8CB;" FontSize="{StaticResource FontSizeBody}" />
                    <TextBlock x:Name="SortText" Text="Sắp xếp" FontSize="{StaticResource FontSizeBody}" />
                </StackPanel>
                <DropDownButton.Flyout>
                    <MenuFlyout x:Name="SortMenu" Placement="BottomEdgeAlignedLeft" />
                </DropDownButton.Flyout>
            </DropDownButton>
            <!-- Mốc tuổi nợ: Enter / rời ô thì áp dụng; nhớ trong settings.json -->
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="Mốc ngày" VerticalAlignment="Center" />
                <TextBox x:Name="MarksBox" Width="120" Text="{x:Bind ViewModel.MarksText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="7, 30" AutomationProperties.Name="Mốc tuổi nợ" KeyDown="MarksBox_KeyDown" LostFocus="MarksBox_LostFocus"
                         ToolTipService.ToolTip="Các mốc số ngày cách nhau bằng dấu phẩy (tối đa 5), vd 7, 30 → nhóm 0–7, 8–30, trên 30 ngày. Enter để áp dụng" />
                <Button Content="Mặc định" Click="MarksDefault_Click" AutomationProperties.Name="Mốc tuổi nợ mặc định"
                        ToolTipService.ToolTip="Về mốc 7, 30" />
                <TextBlock Text="{x:Bind ViewModel.MarksError, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" VerticalAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="260" Visibility="{x:Bind local:Ui.VisibleIfText(ViewModel.MarksError), Mode=OneWay}"
                           AutomationProperties.AutomationId="MarksError" />
            </StackPanel>
        </StackPanel>

        <!-- Công nợ theo tuổi nợ (2026-11-13): mỗi đơn vào 1 nhóm theo số ngày từ ngày giao; bấm ô = lọc khách có nợ trong nhóm -->
        <ItemsRepeater Grid.Row="2" ItemsSource="{x:Bind ViewModel.Tiles}" AutomationProperties.Name="Công nợ theo tuổi nợ"
                       Visibility="{x:Bind local:Ui.VisibleIf(ViewModel.HasTiles), Mode=OneWay}">
            <ItemsRepeater.Layout>
                <UniformGridLayout MinItemWidth="150" MinColumnSpacing="8" MinRowSpacing="8" ItemsStretch="Fill" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="vm:AgingTile">
                    <Button Tag="{x:Bind}" Click="Tile_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,8"
                            CornerRadius="10" BorderThickness="{x:Bind local:DebtsPage.TileThickness(IsSelected)}"
                            BorderBrush="{x:Bind local:DebtsPage.TileBorder(IsSelected)}" Background="{x:Bind local:DebtsPage.TileBackground(IsOldest)}"
                            AutomationProperties.Name="{x:Bind AccessibleName}"
                            ToolTipService.ToolTip="Bấm để chỉ xem khách có nợ trong nhóm này (bấm lại để bỏ lọc)">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Bind Label}" Opacity="0.8" Foreground="{x:Bind local:DebtsPage.TileForeground(IsOldest)}" />
                            <TextBlock Text="{x:Bind AmountText}" FontSize="{StaticResource FontSizeEmphasis}" FontWeight="SemiBold"
                                       Foreground="{x:Bind local:DebtsPage.TileForeground(IsOldest)}" />
                            <TextBlock Text="{x:Bind CountText}" FontSize="{StaticResource FontSizeCaption}" Opacity="0.75"
                                       Foreground="{x:Bind local:DebtsPage.TileForeground(IsOldest)}" />
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>

        <InfoBar Grid.Row="3" Severity="Error" IsClosable="False" Message="{x:Bind ViewModel.Error, Mode=OneWay}"
                 IsOpen="{x:Bind local:Ui.HasText(ViewModel.Error), Mode=OneWay}" />
        <InfoBar Grid.Row="3" Severity="Success" IsClosable="True" Message="{x:Bind ViewModel.Message, Mode=OneWay}"
                 IsOpen="{x:Bind local:Ui.HasText(ViewModel.Message), Mode=OneWay}" AutomationProperties.AutomationId="DebtMessage" />

        <TextBlock Grid.Row="4" Opacity="0.75" TextWrapping="Wrap" Text="{x:Bind ViewModel.Note, Mode=OneWay}" />

        <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,24" MaxWidth="980" HorizontalAlignment="Left">
                <TextBlock Text="Không có đơn nào chưa thanh toán 🎉" Opacity="0.75" Margin="0,24,0,0"
                           Visibility="{x:Bind local:Ui.VisibleIfNot(ViewModel.HasData), Mode=OneWay}" />
                <ItemsRepeater x:Name="RowsRepeater" ItemsSource="{x:Bind ViewModel.Rows}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="8" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:DebtRow">
                            <!-- Thẻ khách: ô số ngày đơn cũ nhất (cam khi quá mốc tuổi nợ lớn nhất), thông tin, tổng nợ, nút -->
                            <Border Padding="14,12" CornerRadius="10" BorderThickness="1"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    AutomationProperties.Name="{x:Bind AccessibleName}">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="64" CornerRadius="10" Padding="0,8" VerticalAlignment="Center" Background="{x:Bind local:Ui.LapsedBackground(IsOverdue)}"
                                            ToolTipService.ToolTip="Đơn cũ nhất chưa thanh toán đã giao bao nhiêu ngày">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="{x:Bind DaysText}" FontSize="{StaticResource FontSizeNumber}" FontWeight="SemiBold" HorizontalAlignment="Center"
                                                       Foreground="{x:Bind local:Ui.LapsedForeground(IsOverdue)}" />
                                            <TextBlock Text="ngày" FontSize="{StaticResource FontSizeCaption}" HorizontalAlignment="Center" Foreground="{x:Bind local:Ui.LapsedForeground(IsOverdue)}" />
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                        <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Border Width="26" Height="26" CornerRadius="13" Background="{x:Bind local:Ui.AvatarBrush(Name)}" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind local:Ui.Initial(Name)}" Foreground="White" FontWeight="SemiBold" FontSize="{StaticResource FontSizeCaption}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontSize="{StaticResource FontSizeEmphasis}" FontWeight="SemiBold" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name}" />
                                        </Grid>
                                        <TextBlock Text="{x:Bind Contact}" Opacity="0.75" TextTrimming="CharacterEllipsis" Visibility="{x:Bind local:Ui.VisibleIf(HasContact)}" />
                                        <TextBlock Text="{x:Bind OrdersText}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind OrdersText}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{x:Bind AmountText}" FontSize="{StaticResource FontSizeNumber}" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Button Tag="{x:Bind}" Click="Detail_Click" AutomationProperties.Name="Chi tiết"
                                                IsEnabled="{x:Bind HasCustomer}"
                                                ToolTipService.ToolTip="Các đơn đang nợ của khách - ở đó Chụp ảnh để gửi Zalo, Thanh toán toàn bộ, sửa từng đơn">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <SymbolIcon Symbol="View" />
                                                <TextBlock Text="Chi tiết" Visibility="{Binding Visibility, ElementName=DetailLabelSwitch}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Tag="{x:Bind}" Click="PayAll_Click" AutomationProperties.Name="Thanh toán hết"
                                                ToolTipService.ToolTip="Chuyển mọi đơn đang nợ của khách sang Đã thanh toán (có hỏi lại)">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE8C7;" FontSize="{StaticResource FontSizeEmphasis}" />
                                                <TextBlock Text="Thanh toán hết" Visibility="{Binding Visibility, ElementName=PayLabelSwitch}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Tag="{x:Bind}" Click="CopyMessage_Click" AutomationProperties.Name="Chép tin nhắn nhắc nợ"
                                                IsEnabled="{x:Bind HasCustomer}" ToolTipService.ToolTip="Chép tin nhắn nhắc thanh toán để dán vào Zalo (gửi kèm ảnh)">
                                            <SymbolIcon Symbol="Message" />
                                        </Button>
                                        <Button Tag="{x:Bind}" Click="CopyPhone_Click" AutomationProperties.Name="Chép số điện thoại"
                                                ToolTipService.ToolTip="Chép số điện thoại" Visibility="{x:Bind local:Ui.VisibleIf(HasPhone)}">
                                            <SymbolIcon Symbol="Phone" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

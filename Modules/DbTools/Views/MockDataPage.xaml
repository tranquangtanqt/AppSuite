<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DbTools.Views.MockDataPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:DbTools.Views"
    xmlns:vm="using:DbTools.ViewModels"
    xmlns:models="using:DbTools.Models"
    NavigationCacheMode="Required">

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
    <Grid x:Name="Root" Padding="24,12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" MinHeight="150" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" MinHeight="110" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="2" Margin="0,0,48,0">
            <TextBlock Text="Sinh dữ liệu mẫu" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock Opacity="0.7" TextWrapping="Wrap"
                       Text="Từ vài dòng mẫu (bảng trong DB hoặc file CSV) sinh thêm nhiều dòng giả ra file CSV / INSERT. Không ghi gì vào DB." />
        </StackPanel>

        <!-- Nguồn mẫu -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="16">
            <RadioButton GroupName="MockSource" Content="Bảng trong DB" IsChecked="{x:Bind ViewModel.FromDb, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                         AutomationProperties.AutomationId="FromDbRadio" />
            <RadioButton GroupName="MockSource" Content="File CSV mẫu" IsChecked="{x:Bind ViewModel.FromCsv, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                         AutomationProperties.AutomationId="FromCsvRadio" />
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid ColumnSpacing="8" Visibility="{x:Bind views:Ui.VisibleIf(ViewModel.FromDb), Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="320" />
                    <ColumnDefinition Width="*" MaxWidth="200" />
                    <ColumnDefinition Width="*" MaxWidth="300" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox Header="Server (hồ sơ kết nối)" HorizontalAlignment="Stretch" views:ProfilePicker.Selected="{x:Bind ViewModel.Profile, Mode=TwoWay}" PlaceholderText="(chưa có kết nối)" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:ConnectionProfile">
                            <TextBlock Text="{x:Bind PickerText, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox x:Name="DbBox" Grid.Column="1" Header="Database" IsEditable="True" HorizontalAlignment="Stretch"
                          ItemsSource="{x:Bind ViewModel.Databases}" Text="{x:Bind ViewModel.Database, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                          DropDownOpened="DbBox_DropDownOpened" Loaded="EditableBox_Loaded" AutomationProperties.AutomationId="MockDbBox" />
                <ComboBox x:Name="TableBox" Grid.Column="2" Header="Bảng (schema.bảng)" IsEditable="True" HorizontalAlignment="Stretch"
                          ItemsSource="{x:Bind ViewModel.TableNames}" Text="{x:Bind ViewModel.Table, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                          DropDownOpened="TableBox_DropDownOpened" Loaded="EditableBox_Loaded" PlaceholderText="vd public.app_order"
                          AutomationProperties.AutomationId="MockTableBox" />
                <NumberBox Grid.Column="3" Header="Số dòng mẫu" Minimum="1" Maximum="1000" Width="110" SpinButtonPlacementMode="Hidden"
                           Value="{x:Bind ViewModel.SampleRows, Mode=TwoWay}" ToolTipService.ToolTip="Đọc bao nhiêu dòng đầu của bảng làm mẫu (1 - 1000)" />
                <Button Grid.Column="4" VerticalAlignment="Bottom" Content="Đọc mẫu" Command="{x:Bind ViewModel.LoadSampleCommand}"
                        AutomationProperties.AutomationId="LoadSampleButton" />
            </Grid>
            <Grid ColumnSpacing="8" Visibility="{x:Bind views:Ui.VisibleIf(ViewModel.FromCsv), Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Header="File CSV mẫu (dòng đầu là tên cột; UTF-8 / Shift-JIS, dấu phẩy hoặc tab)" Text="{x:Bind ViewModel.CsvPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" AutomationProperties.AutomationId="CsvPathBox" />
                <Button Grid.Column="1" VerticalAlignment="Bottom" Content="Chọn..." Command="{x:Bind ViewModel.BrowseCsvCommand}" />
                <TextBox Grid.Column="2" Header="Tên bảng cho INSERT" Text="{x:Bind ViewModel.CsvTable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="trống = tên file" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" AutomationProperties.AutomationId="CsvTableBox" />
                <Button Grid.Column="3" VerticalAlignment="Bottom" Content="Đọc mẫu" Command="{x:Bind ViewModel.LoadSampleCommand}" />
            </Grid>
        </Grid>

        <TextBlock Grid.Row="3" Text="{x:Bind ViewModel.SourceInfo, Mode=OneWay}" Opacity="0.8" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                   AutomationProperties.AutomationId="SourceInfo" />

        <!-- Cách sinh từng cột -->
        <Border Grid.Row="4" BorderThickness="1" CornerRadius="4" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Padding="12,6" ColumnSpacing="8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="210" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Cột" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="Kiểu" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="Khoá / ràng buộc" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="3" Text="Mẫu" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="4" Text="Cách sinh" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="5" Text="Tham số" FontWeight="SemiBold" />
                </Grid>
                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Columns}" SelectionMode="None" AutomationProperties.AutomationId="MockColumnList"
                          AutomationProperties.Name="Cách sinh từng cột">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="12,2" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:MockColumnRow">
                            <Grid ColumnSpacing="8" AutomationProperties.Name="{x:Bind Name}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="210" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind Name}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind TypeText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontFamily="Consolas" FontSize="12"
                                           ToolTipService.ToolTip="{x:Bind TypeText}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind KeyText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="12" Opacity="0.85"
                                           ToolTipService.ToolTip="{x:Bind KeyText}" />
                                <TextBlock Grid.Column="3" Text="{x:Bind SampleText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="12" Opacity="0.85"
                                           ToolTipService.ToolTip="{x:Bind SampleText}" />
                                <ComboBox Grid.Column="4" HorizontalAlignment="Stretch" ItemsSource="{x:Bind vm:MockColumnRow.RuleLabels}"
                                          SelectedIndex="{x:Bind RuleIndex, Mode=TwoWay}" AutomationProperties.Name="Cách sinh" />
                                <TextBox Grid.Column="5" Text="{x:Bind Param, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{x:Bind ParamEnabled, Mode=OneWay}"
                                         PlaceholderText="{x:Bind ParamHint, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind ParamHint, Mode=OneWay}" FontFamily="Consolas" FontSize="12"
                                         AutomationProperties.Name="Tham số" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock Grid.Row="1" Text="Chưa có mẫu - chọn nguồn rồi bấm Đọc mẫu." Opacity="0.6" HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsHitTestVisible="False" Visibility="{x:Bind views:Ui.HiddenIf(ViewModel.HasColumns), Mode=OneWay}" />
            </Grid>
        </Border>

        <!-- Đầu ra -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="12">
            <NumberBox Header="Số dòng sinh ra" Minimum="1" Maximum="1000000" Width="140" SpinButtonPlacementMode="Compact" SmallChange="100"
                       Value="{x:Bind ViewModel.Rows, Mode=TwoWay}" AutomationProperties.AutomationId="MockRowsBox"
                       ToolTipService.ToolTip="1 - 1.000.000 dòng; nhớ cho lần sau" />
            <CheckBox VerticalAlignment="Bottom" Content="CSV" IsChecked="{x:Bind ViewModel.OutCsv, Mode=TwoWay}" MinWidth="70" AutomationProperties.AutomationId="OutCsvBox" />
            <CheckBox VerticalAlignment="Bottom" Content="SQL INSERT" IsChecked="{x:Bind ViewModel.OutSql, Mode=TwoWay}" AutomationProperties.AutomationId="OutSqlBox"
                      ToolTipService.ToolTip="File .sql: INSERT nhiều dòng / câu (500 dòng), không BEGIN / COMMIT - chạy được bằng trang Chạy thư mục SQL hoặc psql" />
            <ComboBox Header="Encoding CSV" SelectedIndex="{x:Bind ViewModel.EncodingIndex, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.OutCsv, Mode=OneWay}"
                      AutomationProperties.AutomationId="EncodingBox">
                <ComboBoxItem Content="UTF-8 có BOM (Excel)" />
                <ComboBoxItem Content="UTF-8" />
                <ComboBoxItem Content="Shift-JIS" />
            </ComboBox>
            <CheckBox VerticalAlignment="Bottom" Content="Dòng tiêu đề" IsChecked="{x:Bind ViewModel.Header, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.OutCsv, Mode=OneWay}" />
            <ComboBox Header="NULL trong CSV" SelectedIndex="{x:Bind ViewModel.NullIndex, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.OutCsv, Mode=OneWay}">
                <ComboBoxItem Content="ô trống" />
                <ComboBoxItem Content="chữ NULL" />
            </ComboBox>
        </StackPanel>

        <Grid Grid.Row="6" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Header="Thư mục lưu" Text="{x:Bind ViewModel.OutputFolder, Mode=TwoWay}" AutomationProperties.AutomationId="MockFolderBox" />
            <Button Grid.Column="1" VerticalAlignment="Bottom" Content="Chọn..." Command="{x:Bind ViewModel.BrowseOutputCommand}" />
            <Button Grid.Column="2" VerticalAlignment="Bottom" Content="Mở" Command="{x:Bind ViewModel.OpenOutputCommand}" />
            <Button Grid.Column="3" VerticalAlignment="Bottom" Content="Xem trước" Command="{x:Bind ViewModel.PreviewCommand}" AutomationProperties.AutomationId="PreviewButton"
                    ToolTipService.ToolTip="20 dòng đầu - đúng 20 dòng đầu của file khi Sinh file" />
            <Button Grid.Column="4" VerticalAlignment="Bottom" Content="Sinh file" MinWidth="96" Style="{StaticResource CompactAccentButtonStyle}"
                    Command="{x:Bind ViewModel.GenerateCommand}" AutomationProperties.AutomationId="GenerateButton" />
        </Grid>

        <StackPanel Grid.Row="7" Orientation="Horizontal" Spacing="8">
            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="18" Height="18" />
            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap" VerticalAlignment="Center" IsTextSelectionEnabled="True"
                       AutomationProperties.AutomationId="StatusText" />
        </StackPanel>

        <TextBox Grid.Row="8" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                 Text="{x:Bind ViewModel.PreviewText, Mode=OneWay}" PlaceholderText="Xem trước (CSV)" AutomationProperties.AutomationId="PreviewBox" />
    </Grid>
    </ScrollViewer>
</Page>

<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MeRon.Views.DateBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel>
        <!-- Tiêu đề như Header của các ô khác (cỡ 14, cách ô 8). -->
        <TextBlock x:Name="HeaderText" FontSize="14" Margin="0,0,0,8" Visibility="Collapsed" />
        <Grid>
            <!-- Style mặc định (cỡ 14) như các ô số / ô gợi ý; chừa chỗ bên phải cho nút lịch. -->
            <TextBox x:Name="Input" Style="{StaticResource DefaultTextBoxStyle}" Padding="10,5,36,6"
                     PreviewKeyDown="Input_KeyDown" LostFocus="Input_LostFocus" />
            <Button x:Name="CalendarButton" HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="0,1,1,1" Padding="9,0"
                    Background="Transparent" BorderThickness="0" IsTabStop="False" AutomationProperties.Name="Mở lịch">
                <FontIcon Glyph="&#xE787;" FontSize="14" />
                <Button.Flyout>
                    <Flyout x:Name="CalendarFlyout" Placement="BottomEdgeAlignedLeft" Opening="CalendarFlyout_Opening">
                        <StackPanel Spacing="8">
                            <!-- Lịch tiếng Việt: tên tháng, thứ (T2…CN), tuần bắt đầu thứ Hai. -->
                            <CalendarView x:Name="Calendar" Language="vi-VN" FirstDayOfWeek="Monday" SelectionMode="Single" DayOfWeekFormat="{}{dayofweek.abbreviated}"
                                          SelectedDatesChanged="Calendar_SelectedDatesChanged" AutomationProperties.Name="Lịch" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="TodayButton" HorizontalAlignment="Stretch" Click="Today_Click" AutomationProperties.Name="Hôm nay">
                                    <TextBlock x:Name="TodayText" />
                                </Button>
                                <Button x:Name="ClearButton" Grid.Column="1" HorizontalAlignment="Stretch" Click="Clear_Click"
                                        Content="Xoá ngày" AutomationProperties.Name="Xoá ngày" />
                            </Grid>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </Grid>
    </StackPanel>
</UserControl>

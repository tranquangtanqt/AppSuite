<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DbTools.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:DbTools.Views"
    xmlns:vm="using:DbTools.ViewModels">

    <Grid Padding="24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="2" Margin="0,0,48,0">
            <TextBlock Text="Lịch sử chạy" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock Opacity="0.7" TextWrapping="Wrap"
                       Text="Mọi lần Chạy / Chạy thử / Dump / Restore / Copy DB: lúc nào, database nào, thư mục / file nào (bản svn / git), kết quả. Mới nhất ở trên." />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <Button Content="Mở log" Style="{StaticResource CompactAccentButtonStyle}" Command="{x:Bind ViewModel.OpenLogCommand}" />
                <Button Content="Mở thư mục" Command="{x:Bind ViewModel.OpenFolderCommand}"
                        ToolTipService.ToolTip="Thư mục script của lần chạy; với Dump / Restore: file dump" />
                <Button Content="Mở bản sao lưu" Command="{x:Bind ViewModel.OpenBackupCommand}"
                        ToolTipService.ToolTip="Thư mục Sao lưu trước khi chạy của lần chạy đó" />
                <Button Content="Làm mới" Command="{x:Bind ViewModel.RefreshCommand}" />
                <Button Content="Xoá lịch sử" Command="{x:Bind ViewModel.ClearCommand}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" BorderThickness="1" CornerRadius="4" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Padding="12,6" ColumnSpacing="10" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="Lúc" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="Kiểu" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="3" Text="Database" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="4" Text="Thư mục · bản" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="5" Text="Kết quả" FontWeight="SemiBold" />
                </Grid>
                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Rows}" SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}"
                          DoubleTapped="List_DoubleTapped" AutomationProperties.AutomationId="HistoryList" AutomationProperties.Name="Lịch sử chạy">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="12,0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:HistoryRow">
                            <Grid ColumnSpacing="10" Padding="0,6" AutomationProperties.Name="{x:Bind Time}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="{x:Bind views:Ui.ResultGlyph(Success)}" FontSize="14" Foreground="{x:Bind views:Ui.ResultBrush(Success)}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Time}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Mode}" TextWrapping="Wrap" />
                                <TextBlock Grid.Column="3" Text="{x:Bind Target}" TextWrapping="Wrap" />
                                <StackPanel Grid.Column="4" ToolTipService.ToolTip="{x:Bind Folder}">
                                    <TextBlock Text="{x:Bind FolderName}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Revision}" Opacity="0.7" FontSize="12" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="5" Text="{x:Bind Result}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis"
                                           ToolTipService.ToolTip="{x:Bind Result}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock Grid.Row="1" Text="Chưa có lần chạy nào." Opacity="0.6" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{x:Bind views:Ui.VisibleIf(ViewModel.IsEmpty), Mode=OneWay}" />
            </Grid>
        </Border>
    </Grid>
</Page>

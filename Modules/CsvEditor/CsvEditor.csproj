<Project Sdk="Microsoft.NET.Sdk">
  <!--
    CsvEditor is a fully standalone WinUI 3 app: it opens, builds and runs on its own (right-click
    CsvEditor.csproj > Set as Startup Project, or `dotnet run` from this folder). It only references
    Common for the shared IModuleInfo-style contracts/logging - never MainLauncher.
  -->

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="CommunityToolkit.WinUI.UI.Controls.DataGrid" />
    <!-- DataGrid 7.1.2 kéo metapackage Microsoft.WindowsAppSDK >= 1.0.0 (nguyên khối, cũ): ghim (1.1.5, Directory.Packages.props) + ExcludeAssets=all
         để không chép lẫn DLL WinUI cũ; WinUI 2.2.1 từ Modules/Directory.Build.props cung cấp runtime. -->
    <PackageReference Include="Microsoft.WindowsAppSDK" ExcludeAssets="all" />
    <PackageReference Include="System.Text.Encoding.CodePages" />
    <!-- Xuất .xlsx (Services/XlsxExporter). -->
    <PackageReference Include="DocumentFormat.OpenXml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Common\Common.csproj" />
    <ProjectReference Include="..\..\SharedUI\SharedUI.csproj" />
  </ItemGroup>
</Project>

<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="ScreenCapture.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ScreenCapture">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Compact sizing (Button/TextBox/ComboBox/TextBlock/...) applied suite-wide -->
                <ResourceDictionary Source="ms-appx:///SharedUI/Themes/CompactStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Màu chủ đạo cam (cùng màu Launcher, Number Stamp) thay màu nhấn Windows: nút, tab, công cụ đang chọn. -->
            <Color x:Key="SystemAccentColor">#D86445</Color>
            <Color x:Key="SystemAccentColorLight1">#E27A5E</Color>
            <Color x:Key="SystemAccentColorLight2">#EB9279</Color>
            <Color x:Key="SystemAccentColorLight3">#F3B09C</Color>
            <Color x:Key="SystemAccentColorDark1">#C4502F</Color>
            <Color x:Key="SystemAccentColorDark2">#A83F22</Color>
            <Color x:Key="SystemAccentColorDark3">#86301A</Color>

            <!-- Nền quanh ảnh trong Editor: xám trung tính cố định (Mica ăn màu hình nền desktop nên ảnh trắng khó thấy mép). -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="CanvasAreaBackgroundBrush" Color="#E3E3E3" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="CanvasAreaBackgroundBrush" Color="#1C1C1C" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="CanvasAreaBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>

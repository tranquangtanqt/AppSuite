<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MainLauncher.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:MainLauncher.Controls"
    xmlns:vm="using:MainLauncher.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <controls:DashboardHeader Grid.Row="0" Subtitle="{x:Bind ViewModel.HeaderSubtitle, Mode=OneWay}" />

            <!-- 3 thẻ chia đều bề ngang, mỗi thẻ tối đa 200 (rộng cố định 180 thì cửa sổ hẹp bị cắt mất nút Làm mới) -->
            <Grid Grid.Row="1" ColumnSpacing="12" Margin="36,0,36,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="200" />
                    <ColumnDefinition Width="*" MaxWidth="200" />
                    <ColumnDefinition Width="*" MaxWidth="200" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16,10" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Grid.Column="0">
                    <StackPanel Spacing="0">
                        <TextBlock Text="Tổng số module" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                        <TextBlock Text="{x:Bind ViewModel.TotalModules, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />
                    </StackPanel>
                </Border>
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16,10" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Grid.Column="1">
                    <StackPanel Spacing="0">
                        <TextBlock Text="Đang chạy" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                        <TextBlock
                            Text="{x:Bind ViewModel.RunningModules, Mode=OneWay}"
                            Style="{StaticResource TitleTextBlockStyle}"
                            Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                    </StackPanel>
                </Border>
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16,10" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Grid.Column="2">
                    <StackPanel Spacing="0">
                        <TextBlock Text="Đã dừng" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                        <TextBlock
                            Text="{x:Bind ViewModel.StoppedModules, Mode=OneWay}"
                            Style="{StaticResource TitleTextBlockStyle}"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                    </StackPanel>
                </Border>
                <Button
                    Grid.Column="3"
                    Content="Làm mới"
                    Command="{x:Bind ViewModel.RefreshStatusCommand}"
                    VerticalAlignment="Center" />
            </Grid>

            <StackPanel Grid.Row="2" Margin="36,20,36,24" Spacing="10">
                <!-- Tiêu đề + Ẩn / hiện từng module (dùng chung với Module List / Settings, lưu Config\launcher-settings.json) -->
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock
                        Text="Module"
                        FontSize="16"
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        AutomationProperties.HeadingLevel="Level2" />
                    <controls:ModuleVisibilityButton VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="Đã ẩn hết module - bấm &quot;Ẩn / hiện&quot; để chọn lại (hoặc trang Cài đặt)."
                           Visibility="{x:Bind ViewModel.IsAllHidden, Mode=OneWay}" Opacity="0.7" />
                <GridView
                    ItemsSource="{x:Bind ViewModel.VisibleModules}"
                    SelectionMode="None"
                    IsItemClickEnabled="False">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ModuleViewModel">
                            <controls:ModuleCard Module="{x:Bind}" />
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>

<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FileTools.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:FileTools.Views"
    xmlns:core="using:FileTools.Core"
    NavigationCacheMode="Required">

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
    <Grid x:Name="Root" Padding="24,16" RowSpacing="12" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" MinHeight="200" />
            <RowDefinition Height="*" MinHeight="120" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="2">
            <TextBlock Text="Tìm trong file" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock Opacity="0.7" TextWrapping="Wrap"
                       Text="Tìm chữ / regex trong file lớn. Hiện tối đa N dòng khớp (vẫn đếm hết), có thể xuất mọi dòng khớp ra file tạm để mở xem." />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="4">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Header="File nguồn" Text="{x:Bind ViewModel.SourcePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="1" VerticalAlignment="Bottom" Content="Chọn..." Command="{x:Bind ViewModel.BrowseSourceCommand}" />
            </Grid>
            <TextBlock Text="{x:Bind ViewModel.SourceInfo, Mode=OneWay}" Opacity="0.7" />
        </StackPanel>

        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="QueryBox" Header="Tìm" PlaceholderText="chữ cần tìm, hoặc regex"
                     Text="{x:Bind ViewModel.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" KeyDown="QueryBox_KeyDown" />
            <NumberBox Grid.Column="1" Header="Hiện tối đa (dòng)" Width="150" Minimum="1" SpinButtonPlacementMode="Compact"
                       Value="{x:Bind ViewModel.MaxResults, Mode=TwoWay}" />
            <Button Grid.Column="2" VerticalAlignment="Bottom" Content="Tìm" MinWidth="100" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.SearchCommand}" />
        </Grid>

        <StackPanel Grid.Row="3" Spacing="0">
            <StackPanel Orientation="Horizontal" Spacing="20">
                <CheckBox Content="Không phân biệt dấu (tiếng Việt)" IsChecked="{x:Bind ViewModel.IgnoreDiacritics, Mode=TwoWay}" />
                <CheckBox Content="Phân biệt hoa / thường" IsChecked="{x:Bind ViewModel.MatchCase, Mode=TwoWay}" />
                <CheckBox Content="Regex" IsChecked="{x:Bind ViewModel.IsRegex, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="20">
                <CheckBox Content="Xuất dòng khớp ra file tạm" IsChecked="{x:Bind ViewModel.ExportMatches, Mode=TwoWay}" />
                <CheckBox Content="Kèm số dòng khi xuất" IsChecked="{x:Bind ViewModel.ExportLineNumbers, Mode=TwoWay}" />
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="4" BorderThickness="1" CornerRadius="4" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Padding="12,6" ColumnSpacing="12" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Dòng" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Summary, Mode=OneWay}" FontWeight="SemiBold" />
                </Grid>
                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Hits}" SelectionMode="Single">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="MinHeight" Value="22" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="core:SearchHit">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind LineNumber}" HorizontalAlignment="Right" Opacity="0.7" FontFamily="Consolas" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Text}" FontFamily="Consolas" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <views:JobPanel Grid.Row="5" Job="{x:Bind ViewModel}" />
    </Grid>
    </ScrollViewer>
</Page>

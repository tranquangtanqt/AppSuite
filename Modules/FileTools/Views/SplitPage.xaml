<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FileTools.Views.SplitPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:FileTools.Views"
    NavigationCacheMode="Required">

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
    <Grid x:Name="Root" Padding="24,16" RowSpacing="12" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="140" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="2">
            <TextBlock Text="Tách file" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock Opacity="0.7" TextWrapping="Wrap"
                       Text="Tách 1 file lớn thành nhiều phần, không bao giờ cắt ngang 1 dòng (hay 1 ô CSV nhiều dòng). Kéo-thả file vào đây." />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="4">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Header="File nguồn" Text="{x:Bind ViewModel.SourcePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="1" VerticalAlignment="Bottom" Content="Chọn..." Command="{x:Bind ViewModel.BrowseSourceCommand}" />
            </Grid>
            <TextBlock Text="{x:Bind ViewModel.SourceInfo, Mode=OneWay}" Opacity="0.7" />
        </StackPanel>

        <!-- Mỗi lựa chọn cùng hàng với ô số của nó; chỉ ô của lựa chọn đang chọn sửa được. -->
        <StackPanel Grid.Row="2" Spacing="8">
            <TextBlock Text="Tách theo" />
            <Grid ColumnSpacing="12" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="200" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <RadioButton GroupName="SplitMode" Tag="0" Content="Dung lượng mỗi phần" Checked="Mode_Checked"
                             IsChecked="{x:Bind views:ModeChoice.Is(ViewModel.ModeIndex, 0), Mode=OneWay}" />
                <NumberBox Grid.Column="1" Width="180" VerticalAlignment="Center" Minimum="0.01" SmallChange="10" SpinButtonPlacementMode="Compact"
                           AutomationProperties.Name="Dung lượng (MB)" Value="{x:Bind ViewModel.SizeMb, Mode=TwoWay}"
                           IsEnabled="{x:Bind views:ModeChoice.Is(ViewModel.ModeIndex, 0), Mode=OneWay}" />
                <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="MB" />

                <RadioButton Grid.Row="1" GroupName="SplitMode" Tag="1" Content="Số dòng mỗi phần" Checked="Mode_Checked"
                             IsChecked="{x:Bind views:ModeChoice.Is(ViewModel.ModeIndex, 1), Mode=OneWay}" />
                <NumberBox Grid.Row="1" Grid.Column="1" Width="180" VerticalAlignment="Center" Minimum="1" SmallChange="100000" SpinButtonPlacementMode="Compact"
                           AutomationProperties.Name="Số dòng" Value="{x:Bind ViewModel.LinesPerPart, Mode=TwoWay}"
                           IsEnabled="{x:Bind views:ModeChoice.Is(ViewModel.ModeIndex, 1), Mode=OneWay}" />
                <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Text="dòng" />

                <RadioButton Grid.Row="2" GroupName="SplitMode" Tag="2" Content="Số phần (chia đều)" Checked="Mode_Checked"
                             IsChecked="{x:Bind views:ModeChoice.Is(ViewModel.ModeIndex, 2), Mode=OneWay}" />
                <NumberBox Grid.Row="2" Grid.Column="1" Width="180" VerticalAlignment="Center" Minimum="1" Maximum="10000" SpinButtonPlacementMode="Compact"
                           AutomationProperties.Name="Số phần" Value="{x:Bind ViewModel.Parts, Mode=TwoWay}"
                           IsEnabled="{x:Bind views:ModeChoice.Is(ViewModel.ModeIndex, 2), Mode=OneWay}" />
                <TextBlock Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" Text="phần" />
            </Grid>
            <CheckBox Content="Lặp dòng tiêu đề (CSV) ở mọi phần" IsChecked="{x:Bind ViewModel.RepeatHeader, Mode=TwoWay}" />
        </StackPanel>

        <Grid Grid.Row="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Header="Thư mục chứa các phần" Text="{x:Bind ViewModel.OutputFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="1" VerticalAlignment="Bottom" Content="Chọn..." Command="{x:Bind ViewModel.BrowseOutputCommand}" />
            <views:OutputPanel Grid.Column="2" Settings="{x:Bind ViewModel.Output}" />
            <Button Grid.Column="3" VerticalAlignment="Bottom" Content="Tách file" MinWidth="110" Style="{StaticResource CompactAccentButtonStyle}" Command="{x:Bind ViewModel.SplitCommand}" />
        </Grid>

        <views:JobPanel Grid.Row="4" Job="{x:Bind ViewModel}" />
    </Grid>
    </ScrollViewer>
</Page>

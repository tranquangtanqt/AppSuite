<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FileTools.Views.DelimiterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:FileTools.Views"
    xmlns:vm="using:FileTools.ViewModels"
    NavigationCacheMode="Required">

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
    <Grid x:Name="Root" Padding="24,16" RowSpacing="12" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="140" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="2">
            <TextBlock Text="Đổi dấu phân cách" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock Opacity="0.7" TextWrapping="Wrap"
                       Text="Đổi , ↔ Tab ↔ ; ↔ | cho cả file, giữ nguyên mọi cột. Ô có chứa dấu phân cách mới / ngoặc kép / xuống dòng được tự bọc trong ngoặc kép." />
        </StackPanel>

        <views:CsvSourcePanel Grid.Row="1" Source="{x:Bind ViewModel}" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="24">
            <ComboBox Header="Đổi thành" MinWidth="200" ItemsSource="{x:Bind vm:DelimiterViewModel.TargetNames}"
                      SelectedIndex="{x:Bind ViewModel.TargetIndex, Mode=TwoWay}" />
            <CheckBox VerticalAlignment="Bottom" Content="Bọc mọi ô trong &quot;&quot;" IsChecked="{x:Bind ViewModel.QuoteAll, Mode=TwoWay}" />
        </StackPanel>

        <Grid Grid.Row="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Header="File kết quả" Text="{x:Bind ViewModel.OutputPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="1" VerticalAlignment="Bottom" Content="Chọn..." Command="{x:Bind ViewModel.BrowseOutputCommand}" />
            <views:OutputPanel Grid.Column="2" Settings="{x:Bind ViewModel.Output}" />
        </Grid>

        <Button Grid.Row="4" Content="Đổi dấu phân cách" MinWidth="120" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.RunCommand}" />

        <views:JobPanel Grid.Row="5" Job="{x:Bind ViewModel}" />
    </Grid>
    </ScrollViewer>
</Page>

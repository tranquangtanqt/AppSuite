<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CsvEditor.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CsvEditor"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:primitives="using:CommunityToolkit.WinUI.UI.Controls.Primitives"
    xmlns:models="using:CsvEditor.Models"
    xmlns:vm="using:CsvEditor.ViewModels"
    xmlns:views="using:CsvEditor.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="CsvEditor">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!-- Kéo-thả file CSV/TSV vào bất kỳ chỗ nào trong cửa sổ để mở (Background Transparent để cả vùng trống nhận thả). -->
    <Grid x:Name="RootGrid" Padding="12" RowSpacing="8" Background="Transparent" AllowDrop="True" DragOver="Root_DragOver" Drop="Root_Drop"
          KeyboardAcceleratorPlacementMode="Hidden">
        <!-- Phím tắt của mục nằm trong menu thả xuống (Cột ▾ → Đi tới cột) phải gắn ở ngoài menu mới chạy khi menu đóng.
             KeyboardAcceleratorPlacementMode=Hidden: không thì rê chuột ở đâu trong cửa sổ cũng nổi tooltip "Ctrl+Shift+G". -->
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="G" Modifiers="Control,Shift" Invoked="GoToColumnAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.Resources>
            <!-- Thẻ "đang lọc / đang sắp xếp": bấm phần chữ = mở lại hộp thoại, bấm ✕ = bỏ. -->
            <Style x:Key="ChipBorderStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="ChipBodyButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="14,0,0,14" />
                <Setter Property="Padding" Value="10,4,4,4" />
            </Style>
            <Style x:Key="ChipCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="0,14,14,0" />
                <Setter Property="Padding" Value="6,4,10,4" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
            </Style>
            <!-- Nút dạng chữ ở thanh trạng thái: chỉ rõ là nút khi rê chuột / Tab tới. -->
            <Style x:Key="StatusButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="6,2" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- Menu chuột phải trên ô (Grid_ContextRequested chọn menu theo chỗ bấm: ô hay tiêu đề cột). -->
            <MenuFlyout x:Key="CellMenu">
                <MenuFlyoutItem Text="Sao chép" Click="CopyMenuItem_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                <MenuFlyoutItem Text="Dán" Click="PasteMenuItem_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE77F;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Tag="FilterByValue" Text="Lọc theo giá trị này" Click="FilterByValueItem_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE71C;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                <MenuFlyoutItem Tag="ExcludeValue" Text="Lọc bỏ giá trị này" Click="ExcludeValueItem_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE711;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Xem dọc dòng này" Click="RecordViewMenuItem_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A0;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                <MenuFlyoutItem Text="Chèn dòng bên dưới" Click="InsertRowMenuItem_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE710;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                <MenuFlyoutItem Text="Nhân bản dòng" Click="DuplicateRowMenuItem_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                <MenuFlyoutItem Text="Xoá dòng đang chọn" Click="DeleteRowsMenuItem_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
            </MenuFlyout>

            <!-- Menu chuột phải trên tiêu đề cột. -->
            <MenuFlyout x:Key="HeaderMenu">
                <MenuFlyoutItem Text="Sắp xếp tăng dần (A → Z, 1 → 9)" Click="SortAscendingItem_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74A;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                <MenuFlyoutItem Text="Sắp xếp giảm dần (Z → A, 9 → 1)" Click="SortDescendingItem_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74B;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                <MenuFlyoutItem Tag="ClearColumnFilter" Text="Bỏ ô lọc của cột này" Click="ClearColumnFilterItem_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE711;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Ẩn cột này" Click="HideColumnItem_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xED1A;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                <MenuFlyoutItem Tag="FreezeTo" Text="Cố định đến cột này" Click="FreezeToColumnItem_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE718;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                <MenuFlyoutItem Tag="Unfreeze" Text="Bỏ cố định cột" Click="UnfreezeColumns_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE77A;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Đổi tên cột..." Click="HeaderRenameItem_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8AC;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                <MenuFlyoutItem Text="Chèn cột bên phải..." Click="InsertColumnRightItem_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE710;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                <MenuFlyoutItem Text="Xoá cột" Click="HeaderDeleteItem_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
            </MenuFlyout>
        </Grid.Resources>

        <!-- Thanh công cụ: thao tác hay dùng để ngoài, việc ít dùng gom vào Dòng ▾ / Cột ▾ / Xuất ▾. Nút có phím tắt phải
             nằm ngoài menu thả xuống (phím tắt của mục trong menu chỉ chạy khi menu đang mở). -->
        <Grid Grid.Row="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="0,0,0,16">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button x:Name="OpenButton" Click="OpenButton_Click" ToolTipService.ToolTip="Mở file CSV / TSV (Ctrl+O) - hoặc kéo-thả file vào cửa sổ">
                        <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8E5;" FontSize="14" /><TextBlock Text="Mở" /></StackPanel>
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="O" Modifiers="Control" />
                        </Button.KeyboardAccelerators>
                    </Button>
                    <!-- Menu dựng lại mỗi lần mở (RecentMenu_Opening) từ Data\Config\recent-files.json. -->
                    <DropDownButton x:Name="RecentButton" ToolTipService.ToolTip="File gần đây" AutomationProperties.Name="File gần đây">
                        <FontIcon Glyph="&#xE81C;" FontSize="14" />
                        <DropDownButton.Flyout>
                            <MenuFlyout x:Name="RecentMenu" Placement="BottomEdgeAlignedLeft" Opening="RecentMenu_Opening" />
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <Button x:Name="SaveButton" Click="SaveButton_Click" IsEnabled="{x:Bind ViewModel.IsDirty, Mode=OneWay}" ToolTipService.ToolTip="Lưu (Ctrl+S)">
                        <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE74E;" FontSize="14" /><TextBlock Text="Lưu" /></StackPanel>
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="S" Modifiers="Control" />
                        </Button.KeyboardAccelerators>
                    </Button>
                    <DropDownButton x:Name="ExportButton" IsEnabled="{x:Bind HasColumns(ViewModel.ColumnCount), Mode=OneWay}" ToolTipService.ToolTip="Lưu thành file khác / xuất Excel">
                        <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xEDE1;" FontSize="14" /><TextBlock Text="Xuất" /></StackPanel>
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                <MenuFlyoutItem x:Name="SaveAsButton" Text="Lưu thành file khác..." Click="SaveAsButton_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE792;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="ExportXlsxButton" Text="Xuất Excel (.xlsx)..." Click="ExportXlsxButton_Click"
                                                ToolTipService.ToolTip="Xuất các dòng đang hiện (theo lọc / sắp xếp) ra file Excel .xlsx - file CSV đang mở không đổi"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xEDE1;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>

                    <Border Width="1" Margin="4,2" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                    <Button Command="{x:Bind ViewModel.UndoCommand}" ToolTipService.ToolTip="{x:Bind UndoToolTip(ViewModel.UndoDescription), Mode=OneWay}" AutomationProperties.Name="Hoàn tác">
                        <FontIcon Glyph="&#xE7A7;" FontSize="14" />
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Z" Modifiers="Control" />
                        </Button.KeyboardAccelerators>
                    </Button>
                    <Button Command="{x:Bind ViewModel.RedoCommand}" ToolTipService.ToolTip="{x:Bind RedoToolTip(ViewModel.RedoDescription), Mode=OneWay}" AutomationProperties.Name="Làm lại">
                        <FontIcon Glyph="&#xE7A6;" FontSize="14" />
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Y" Modifiers="Control" />
                            <KeyboardAccelerator Key="Z" Modifiers="Control,Shift" />
                        </Button.KeyboardAccelerators>
                    </Button>

                    <Border Width="1" Margin="4,2" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                    <DropDownButton x:Name="RowMenuButton" IsEnabled="{x:Bind HasColumns(ViewModel.ColumnCount), Mode=OneWay}" ToolTipService.ToolTip="Thêm / nhân bản / xoá dòng">
                        <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8FD;" FontSize="14" /><TextBlock Text="Dòng" /></StackPanel>
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                <MenuFlyoutItem Text="Thêm dòng" Click="AddRowButton_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE710;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                                <MenuFlyoutItem Text="Nhân bản dòng đang chọn" Click="DuplicateRowButton_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                                <MenuFlyoutItem Text="Xoá dòng đang chọn" Click="DeleteRowButton_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <DropDownButton x:Name="ColumnMenuButton" IsEnabled="{x:Bind HasColumns(ViewModel.ColumnCount), Mode=OneWay}" ToolTipService.ToolTip="Đi tới cột theo tên (Ctrl+Shift+G); thêm / đổi tên / xoá cột (cột của ô đang chọn) - chuột phải tiêu đề cột cũng có">
                        <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8A9;" FontSize="14" /><TextBlock Text="Cột" /></StackPanel>
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                <MenuFlyoutItem x:Name="GoToColumnMenuItem" Text="Đi tới cột..." Click="GoToColumn_Click" KeyboardAcceleratorTextOverride="Ctrl+Shift+G"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE721;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="ShowHideColumnsMenuItem" Text="Ẩn / hiện cột..." Click="ShowHideColumns_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7B3;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                                <MenuFlyoutItem Text="Cố định đến cột đang chọn" Click="FreezeToCurrentColumn_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE718;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                                <MenuFlyoutItem Text="Bỏ cố định cột" Click="UnfreezeColumns_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE77A;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Thêm cột..." Click="AddColumnButton_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE710;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                                <MenuFlyoutItem Text="Đổi tên cột đang chọn..." Click="RenameColumnButton_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8AC;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                                <MenuFlyoutItem Text="Xoá cột đang chọn" Click="DeleteColumnButton_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>

                    <Border Width="1" Margin="4,2" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                    <Button Click="FindButton_Click" IsEnabled="{x:Bind HasColumns(ViewModel.ColumnCount), Mode=OneWay}" ToolTipService.ToolTip="Tìm (Ctrl+F) / thay thế (Ctrl+H)">
                        <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE721;" FontSize="14" /><TextBlock Text="Tìm" /></StackPanel>
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="F" Modifiers="Control" />
                            <KeyboardAccelerator Key="H" Modifiers="Control" />
                        </Button.KeyboardAccelerators>
                    </Button>
                    <Button x:Name="GoToButton" Click="GoToButton_Click" IsEnabled="{x:Bind HasColumns(ViewModel.ColumnCount), Mode=OneWay}" ToolTipService.ToolTip="Đi tới dòng (Ctrl+G)" AutomationProperties.Name="Đi tới dòng">
                        <FontIcon Glyph="&#xE72A;" FontSize="14" />
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="G" Modifiers="Control" />
                        </Button.KeyboardAccelerators>
                    </Button>
                    <Button Click="FilterButton_Click" IsEnabled="{x:Bind HasColumns(ViewModel.ColumnCount), Mode=OneWay}" ToolTipService.ToolTip="Lọc nâng cao (nhiều điều kiện, và / hoặc)">
                        <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE71C;" FontSize="14" /><TextBlock Text="Lọc" /></StackPanel>
                    </Button>
                    <Button Click="SortButton_Click" IsEnabled="{x:Bind HasColumns(ViewModel.ColumnCount), Mode=OneWay}" ToolTipService.ToolTip="Sắp xếp theo nhiều cột">
                        <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8CB;" FontSize="14" /><TextBlock Text="Sắp xếp" /></StackPanel>
                    </Button>
                    <Button Click="StatisticsButton_Click" IsEnabled="{x:Bind HasColumns(ViewModel.ColumnCount), Mode=OneWay}" ToolTipService.ToolTip="Thống kê từng cột (đếm, trống, tổng, nhỏ nhất / lớn nhất...)" AutomationProperties.Name="Thống kê">
                        <FontIcon Glyph="&#xE9D9;" FontSize="14" />
                    </Button>
                    <ToggleButton x:Name="RecordViewToggle" Click="RecordViewToggle_Click" IsEnabled="{x:Bind HasColumns(ViewModel.ColumnCount), Mode=OneWay}"
                                  ToolTipService.ToolTip="Xem dọc dòng đang chọn: tên cột - giá trị, sửa được, tìm cột (Ctrl+R)" AutomationProperties.Name="Xem dọc">
                        <FontIcon Glyph="&#xE8A0;" FontSize="14" />
                        <ToggleButton.KeyboardAccelerators>
                            <KeyboardAccelerator Key="R" Modifiers="Control" />
                        </ToggleButton.KeyboardAccelerators>
                    </ToggleButton>
                </StackPanel>
            </ScrollViewer>

            <Button x:Name="HelpButton" Grid.Column="1" VerticalAlignment="Top" Click="HelpButton_Click" ToolTipService.ToolTip="Hướng dẫn sử dụng (F1)" AutomationProperties.Name="Hướng dẫn">
                <FontIcon Glyph="&#xE897;" FontSize="14" />
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="F1" />
                </Button.KeyboardAccelerators>
            </Button>
        </Grid>

        <!-- Thẻ lọc / sắp xếp đang áp dụng (RefreshChips) - thay cho nút Clear Filter / Clear Sort và nút ✕ ở góc bảng.
             Tự xuống hàng: 5 thẻ cùng lúc ở cửa sổ hẹp không bị cắt mất. -->
        <views:WrapPanel x:Name="ChipsBar" Grid.Row="1" Spacing="8" Visibility="Collapsed">
            <TextBlock x:Name="ShownRowsText" VerticalAlignment="Center" Opacity="0.8" />
            <Border x:Name="FilterChip" Style="{StaticResource ChipBorderStyle}">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource ChipBodyButtonStyle}" Click="FilterButton_Click" ToolTipService.ToolTip="Sửa điều kiện lọc">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE71C;" FontSize="12" />
                            <TextBlock x:Name="FilterChipText" MaxWidth="420" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ChipCloseButtonStyle}" Click="ClearActiveFilterButton_Click"
                            ToolTipService.ToolTip="Bỏ lọc" AutomationProperties.Name="Bỏ lọc">
                        <FontIcon Glyph="&#xE10A;" FontSize="10" />
                    </Button>
                </StackPanel>
            </Border>
            <Border x:Name="QuickFilterChip" Style="{StaticResource ChipBorderStyle}">
                <StackPanel Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal" Spacing="6" Padding="10,4,4,4">
                        <FontIcon Glyph="&#xE71C;" FontSize="12" />
                        <TextBlock x:Name="QuickFilterChipText" MaxWidth="420" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Style="{StaticResource ChipCloseButtonStyle}" Click="ClearAllFiltersButton_Click"
                            ToolTipService.ToolTip="Xoá mọi ô lọc ở tiêu đề cột" AutomationProperties.Name="Xoá ô lọc">
                        <FontIcon Glyph="&#xE10A;" FontSize="10" />
                    </Button>
                </StackPanel>
            </Border>
            <Border x:Name="SortChip" Style="{StaticResource ChipBorderStyle}">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource ChipBodyButtonStyle}" Click="SortButton_Click" ToolTipService.ToolTip="Sửa cách sắp xếp">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8CB;" FontSize="12" />
                            <TextBlock x:Name="SortChipText" MaxWidth="420" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ChipCloseButtonStyle}" Click="ClearActiveSortButton_Click"
                            ToolTipService.ToolTip="Bỏ sắp xếp (về thứ tự trong file)" AutomationProperties.Name="Bỏ sắp xếp">
                        <FontIcon Glyph="&#xE10A;" FontSize="10" />
                    </Button>
                </StackPanel>
            </Border>
            <Border x:Name="HiddenColumnsChip" Style="{StaticResource ChipBorderStyle}">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource ChipBodyButtonStyle}" Click="ShowHideColumns_Click" ToolTipService.ToolTip="Chọn cột ẩn / hiện">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xED1A;" FontSize="12" />
                            <TextBlock x:Name="HiddenColumnsChipText" MaxWidth="420" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ChipCloseButtonStyle}" Click="ShowAllColumns_Click"
                            ToolTipService.ToolTip="Hiện tất cả cột" AutomationProperties.Name="Hiện tất cả cột">
                        <FontIcon Glyph="&#xE10A;" FontSize="10" />
                    </Button>
                </StackPanel>
            </Border>
            <Border x:Name="FrozenColumnsChip" Style="{StaticResource ChipBorderStyle}">
                <StackPanel Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal" Spacing="6" Padding="10,4,4,4">
                        <FontIcon Glyph="&#xE718;" FontSize="12" />
                        <TextBlock x:Name="FrozenColumnsChipText" MaxWidth="420" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Style="{StaticResource ChipCloseButtonStyle}" Click="UnfreezeColumns_Click"
                            ToolTipService.ToolTip="Bỏ cố định cột" AutomationProperties.Name="Bỏ cố định cột">
                        <FontIcon Glyph="&#xE10A;" FontSize="10" />
                    </Button>
                </StackPanel>
            </Border>
        </views:WrapPanel>

        <!-- Validation issues -->
        <Expander Grid.Row="2" Header="{x:Bind IssuesHeaderText(ViewModel.Issues.Count), Mode=OneWay}" IsExpanded="False"
                  Visibility="{x:Bind VisibleIfAny(ViewModel.Issues.Count), Mode=OneWay}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <ListView x:Name="IssuesListView" ItemsSource="{x:Bind ViewModel.Issues}" MaxHeight="160" DoubleTapped="IssuesListView_DoubleTapped">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:ValidationIssue">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7BA;" FontSize="12" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                            <TextBlock Text="{x:Bind Message}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Expander>

        <!-- Data grid. The filter box lives inside each column's own header (HeaderStyle below) rather
             than as a synced external row or a real DataGridRow (both tried and reverted) - only the
             native header is both pinned during vertical scroll and directly typable with no
             double-click/F2 gesture, for free, since it's a plain TextBox rather than a DataGrid cell.
             DataGridColumn has no HeaderTemplate shortcut, so the template is applied per column via
             HeaderStyle's ContentTemplate setter instead (DataGridColumn.Header itself rejects a raw
             UIElement - "Content does not support UIElement; use ContentTemplate instead"). Declared
             here (compile-time XAML) because DataTemplate has no public code-only constructor. -->
        <controls:DataGrid
            x:Name="Grid"
            Grid.Row="3"
            ItemsSource="{x:Bind ViewModel.ViewRows, Mode=OneWay}"
            AutoGenerateColumns="False"
            HeadersVisibility="All"
            SelectionMode="Extended"
            RowHeaderWidth="48"
            CanUserReorderColumns="False"
            CanUserSortColumns="False"
            LoadingRow="Grid_LoadingRow"
            CellEditEnding="Grid_CellEditEnding"
            Loaded="Grid_Loaded"
            CurrentCellChanged="Grid_CurrentCellChanged"
            SelectionChanged="Grid_SelectionChanged"
            ContextRequested="Grid_ContextRequested">
            <controls:DataGrid.Resources>
                <local:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibilityConverter" />
                <DataTemplate x:Key="FilterHeaderTemplate">
                    <StackPanel Spacing="4" Padding="0,2,0,4" HorizontalAlignment="Stretch">
                        <TextBlock Text="{Binding ColumnName}" />
                        <!-- Lấp đầy phần nội dung của tiêu đề; phần này chỉ rộng hết cột sau khi FilterTextBox_Loaded bỏ
                             chỗ chừa cho mũi tên sắp xếp. (Cách cũ đặt Width theo độ rộng tiêu đề: vẫn bị cắt theo phần
                             nội dung hẹp, mất luôn nút ✕.) Nút ✕ đè lên mép phải của ô. -->
                        <Grid HorizontalAlignment="Stretch">
                            <TextBox Text="{Binding FilterText, Mode=TwoWay}" PlaceholderText="Lọc..."
                                     HorizontalAlignment="Stretch" Loaded="FilterTextBox_Loaded" />
                            <Button Padding="4" Margin="0,0,4,0" Background="Transparent" BorderThickness="0"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Click="ClearFilterButton_Click" ToolTipService.ToolTip="Xoá ô lọc"
                                    Visibility="{Binding FilterText, Converter={StaticResource EmptyStringToVisibilityConverter}}">
                                <FontIcon Glyph="&#xE10A;" FontSize="10" />
                            </Button>
                        </Grid>
                    </StackPanel>
                </DataTemplate>
                <Style x:Key="FilterHeaderStyle" TargetType="primitives:DataGridColumnHeader">
                    <Setter Property="ContentTemplate" Value="{StaticResource FilterHeaderTemplate}" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="8,8" />
                </Style>
            </controls:DataGrid.Resources>
        </controls:DataGrid>

        <!-- Lọc ra 0 dòng (RefreshChips): bảng không có dòng nào thì báo rõ và cho bỏ lọc ngay. -->
        <StackPanel x:Name="NoRowsPanel" Grid.Row="3" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
            <FontIcon Glyph="&#xE71C;" FontSize="28" Opacity="0.7" />
            <TextBlock Text="Không có dòng nào khớp bộ lọc" Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center" />
            <Button Content="Bỏ lọc" Click="ClearEveryFilterButton_Click" HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Excel-like "fill handle": a small square glued to the bottom-right corner of the current
             cell (see UpdateFillHandlePosition) - dragging it down copies the cell's value into the
             rows below, or (holding Ctrl) auto-increments a numeric value by 1 per row instead of
             copying it verbatim. A transparent Canvas overlaid on the DataGrid: it has no Background
             of its own, so pointer hit-testing falls through to the grid everywhere except the
             handle/preview, which do have one. -->
        <Canvas x:Name="FillHandleLayer" Grid.Row="3">
            <Border x:Name="FillPreviewBorder"
                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="1.5"
                    Background="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.15"
                    Visibility="Collapsed" IsHitTestVisible="False" />
            <!-- The clickable hit area (16x16, Background=Transparent so it still participates in hit
                 testing) is deliberately bigger than the 8x8 dot drawn inside it - an 8px target is
                 hard to land a mouse on precisely, and both are centered on the same point so this
                 doesn't change where the handle visually sits. -->
            <Border x:Name="FillHandle" Width="16" Height="16" Background="Transparent"
                    Visibility="Collapsed"
                    PointerPressed="FillHandle_PointerPressed"
                    PointerMoved="FillHandle_PointerMoved"
                    PointerReleased="FillHandle_PointerReleased"
                    PointerCaptureLost="FillHandle_PointerCaptureLost"
                    ToolTipService.ToolTip="Kéo để điền giá trị xuống các dòng dưới (giữ Ctrl để tự tăng số)">
                <Border Width="8" Height="8" Background="{ThemeResource AccentFillColorDefaultBrush}"
                        BorderBrush="White" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                        IsHitTestVisible="False" />
            </Border>
        </Canvas>

        <!-- Khung Xem dọc (SetRecordPaneOpen / UpdateRecordPane): dòng đang chọn thành danh sách "số. tên cột | giá trị" -
             đọc 1 bản ghi nhiều cột không phải cuộn ngang. Nằm đè bên phải hàng của bảng; mở khung thì bảng chừa lề phải. -->
        <Border x:Name="RecordPane" Grid.Row="3" Width="400" HorizontalAlignment="Right" Visibility="Collapsed"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8" Padding="12,10">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="RecordTitle" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="1" Click="RecordPrevButton_Click" ToolTipService.ToolTip="Dòng trên" AutomationProperties.Name="Dòng trên">
                        <FontIcon Glyph="&#xE70E;" FontSize="12" />
                    </Button>
                    <Button Grid.Column="2" Click="RecordNextButton_Click" ToolTipService.ToolTip="Dòng dưới" AutomationProperties.Name="Dòng dưới">
                        <FontIcon Glyph="&#xE70D;" FontSize="12" />
                    </Button>
                    <Button Grid.Column="3" Click="RecordCloseButton_Click" ToolTipService.ToolTip="Đóng khung Xem dọc (Ctrl+R)" AutomationProperties.Name="Đóng xem dọc">
                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                    </Button>
                </Grid>
                <TextBox x:Name="RecordSearchBox" Grid.Row="1" PlaceholderText="Tìm cột hoặc giá trị..." TextChanged="RecordSearchBox_TextChanged" />
                <TextBlock x:Name="RecordEmptyText" Grid.Row="2" Text="Chọn 1 dòng trong bảng để xem dọc." Opacity="0.7" TextWrapping="Wrap" />
                <ScrollViewer Grid.Row="2" Padding="0,0,12,0">
                    <ItemsControl x:Name="RecordFieldList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RecordField">
                                <Grid ColumnSpacing="8" Padding="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Label}" Opacity="0.75" TextWrapping="Wrap" VerticalAlignment="Center"
                                               ToolTipService.ToolTip="{x:Bind Label}" />
                                    <!-- Enter = ghi + sang ô dưới, Shift+Enter = xuống dòng trong ô, Esc = trả lại giá trị cũ;
                                         rời ô cũng ghi (RecordValue_LostFocus) - 1 bước Hoàn tác như sửa trên bảng. -->
                                    <TextBox Grid.Column="1" Text="{x:Bind EditText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="{x:Bind ColumnName}"
                                             TextWrapping="Wrap" AcceptsReturn="True" MinWidth="0"
                                             LostFocus="RecordValue_LostFocus" PreviewKeyDown="RecordValue_PreviewKeyDown" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Màn hình bắt đầu (chưa mở file nào - UpdateStartScreen): vùng kéo-thả, nút Mở file, file gần đây, bảng trống. -->
        <ScrollViewer x:Name="StartScreen" Grid.Row="1" Grid.RowSpan="3" Visibility="Collapsed">
            <Grid MaxWidth="600" Margin="0,24" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <Rectangle RadiusX="12" RadiusY="12" StrokeThickness="1.5" StrokeDashArray="5,3"
                           Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                           Fill="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <StackPanel Padding="32,28" Spacing="12">
                    <FontIcon Glyph="&#xE8E5;" FontSize="36" HorizontalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Text="Kéo-thả file CSV / TSV / TXT vào đây" Style="{StaticResource SubtitleTextBlockStyle}"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <Button x:Name="StartOpenButton" Style="{StaticResource AccentButtonStyle}" Click="OpenButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8E5;" FontSize="14" /><TextBlock Text="Mở file...  (Ctrl+O)" /></StackPanel>
                        </Button>
                        <Button x:Name="NewTableButton" Click="NewTableButton_Click" ToolTipService.ToolTip="Bắt đầu bảng trống: đặt tên cột đầu tiên rồi nhập dữ liệu, Lưu để chọn chỗ lưu">
                            <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE710;" FontSize="14" /><TextBlock Text="Bảng trống" /></StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="Tự nhận dấu phân cách (phẩy, chấm phẩy, Tab, |) và bảng mã (UTF-8, UTF-16, Shift-JIS). Nhận sai thì bấm nút bảng mã ở thanh dưới cùng để chọn lại."
                               Opacity="0.7" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />

                    <StackPanel x:Name="StartRecentPanel" Spacing="2" Margin="0,8,0,0">
                        <TextBlock Text="File gần đây" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,4" />
                        <StackPanel x:Name="StartRecentList" Spacing="2" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Status bar -->
        <!-- MinHeight bằng nút Huỷ: nút hiện ra lúc đang chạy không làm bảng nhảy. Tên file và thông báo tự rút gọn có "...",
             cột * cho thông báo lấy phần còn lại nên tên file dài không đẩy gì ra ngoài cửa sổ. -->
        <Grid Grid.Row="4" ColumnSpacing="16" MinHeight="32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="{x:Bind ViewModel.FileName, Mode=OneWay}" MaxWidth="280" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                       ToolTipService.ToolTip="{x:Bind ViewModel.FileName, Mode=OneWay}" />
            <Button x:Name="EncodingButton" Grid.Column="1" Style="{StaticResource StatusButtonStyle}" Click="EncodingButton_Click"
                    IsEnabled="{x:Bind HasFile(ViewModel.FileName), Mode=OneWay}"
                    ToolTipService.ToolTip="Đổi bảng mã / dấu phân cách rồi mở lại file" AutomationProperties.Name="Đổi bảng mã / dấu phân cách">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock><Run Text="{x:Bind ViewModel.EncodingLabel, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{x:Bind ViewModel.DelimiterLabel, Mode=OneWay}" /></TextBlock>
                    <FontIcon Glyph="&#xE70D;" FontSize="10" />
                </StackPanel>
            </Button>
            <!-- Cùng nhóm với bảng mã / dấu phân cách: cách đọc file. Người dùng tự chọn (không tự đoán); đổi khi đang mở
                 file → mở lại file đó. -->
            <CheckBox x:Name="HasHeaderBox" Grid.Column="2" Content="Dòng đầu là tiêu đề" IsChecked="True" MinWidth="0" MinHeight="0" Padding="6,0,0,0"
                      VerticalAlignment="Center" Click="HasHeaderBox_Click"
                      ToolTipService.ToolTip="Bỏ tick nếu file không có dòng tên cột: mọi dòng là dữ liệu, cột tự đặt tên Cột 1, Cột 2… (chỉ để hiển thị, lưu file không ghi dòng tên cột)" />
            <TextBlock Grid.Column="3" Opacity="0.8" VerticalAlignment="Center"><Run Text="Dòng: " /><Run Text="{x:Bind ViewModel.RowCount, Mode=OneWay}" /></TextBlock>
            <TextBlock Grid.Column="4" Opacity="0.8" VerticalAlignment="Center"><Run Text="Cột: " /><Run Text="{x:Bind ViewModel.ColumnCount, Mode=OneWay}" /></TextBlock>
            <TextBlock Grid.Column="5" Text="{x:Bind SaveStateText(ViewModel.IsDirty), Mode=OneWay}" Opacity="0.8" VerticalAlignment="Center" />
            <TextBlock Grid.Column="6" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Opacity="0.8" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                       ToolTipService.ToolTip="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />

            <ProgressBar Grid.Column="7" Width="140" VerticalAlignment="Center"
                         Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                         Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}" Maximum="100" />

            <Button Grid.Column="8" Content="Huỷ" Click="CancelButton_Click" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
        </Grid>
    </Grid>
</Window>

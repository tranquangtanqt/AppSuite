<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FileTools.Views.ComparePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:FileTools.Views"
    xmlns:vm="using:FileTools.ViewModels"
    NavigationCacheMode="Required">

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
    <Grid x:Name="Root" Padding="24,16" RowSpacing="12" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" MinHeight="240" />
            <RowDefinition Height="*" MinHeight="120" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="2">
            <TextBlock Text="So sánh 2 file" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock Opacity="0.7" TextWrapping="Wrap"
                       Text="Dòng thêm / bớt / sửa giữa 2 file text (kể cả khác encoding), kèm vài dòng giống xung quanh. Kết quả đầy đủ xuất ra báo cáo HTML (nút Mở kết quả). Kéo-thả 2 file vào đây." />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="8" RowSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBox Header="File A (cũ)" Text="{x:Bind ViewModel.PathA, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="1" VerticalAlignment="Bottom" Content="Chọn..." Command="{x:Bind ViewModel.BrowseACommand}" />
            <Button Grid.Column="2" Grid.RowSpan="2" VerticalAlignment="Center" Content="⇅ Đổi chỗ" Command="{x:Bind ViewModel.SwapCommand}" />
            <TextBox Grid.Row="1" Header="File B (mới)" Text="{x:Bind ViewModel.PathB, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Row="1" Grid.Column="1" VerticalAlignment="Bottom" Content="Chọn..." Command="{x:Bind ViewModel.BrowseBCommand}" />
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="20">
            <CheckBox VerticalAlignment="Bottom" Content="Không phân biệt hoa / thường" IsChecked="{x:Bind ViewModel.IgnoreCase, Mode=TwoWay}" />
            <CheckBox VerticalAlignment="Bottom" Content="Bỏ qua khác biệt khoảng trắng" IsChecked="{x:Bind ViewModel.IgnoreWhitespace, Mode=TwoWay}" />
            <NumberBox Header="Dòng ngữ cảnh" Width="140" Minimum="0" Maximum="50" SpinButtonPlacementMode="Compact" Value="{x:Bind ViewModel.ContextLines, Mode=TwoWay}" />
            <Button VerticalAlignment="Bottom" Content="So sánh" MinWidth="110" Style="{StaticResource CompactAccentButtonStyle}" Command="{x:Bind ViewModel.CompareCommand}" />
        </StackPanel>

        <Border Grid.Row="3" BorderThickness="1" CornerRadius="4" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                    <TextBlock Padding="12,6,12,0" Text="{x:Bind ViewModel.Summary, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <Grid Padding="12,4,12,6" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Dòng A" Opacity="0.7" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="1" Text="Dòng B" Opacity="0.7" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="Nội dung (đỏ = chỉ có ở A, xanh = chỉ có ở B)" Opacity="0.7" />
                    </Grid>
                </StackPanel>
                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Rows}" SelectionMode="None" Padding="0">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="MinHeight" Value="20" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:DiffRow">
                            <Grid Padding="12,1" ColumnSpacing="8" Background="{x:Bind views:Ui.DiffBackground(Kind, IsHeader)}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind NumberA}" HorizontalAlignment="Right" Opacity="0.6" FontFamily="Consolas" />
                                <TextBlock Grid.Column="1" Text="{x:Bind NumberB}" HorizontalAlignment="Right" Opacity="0.6" FontFamily="Consolas" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Mark}" FontFamily="Consolas" FontWeight="Bold" />
                                <TextBlock Grid.Column="3" Text="{x:Bind Text}" FontFamily="Consolas" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <views:JobPanel Grid.Row="4" Job="{x:Bind ViewModel}" />
    </Grid>
    </ScrollViewer>
</Page>

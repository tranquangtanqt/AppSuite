<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MeRon.Views.ReportOrderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MeRon.ViewModels"
    xmlns:local="using:MeRon.Views">

    <Grid Padding="24,12,24,0" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Thống kê theo đơn hàng" Style="{StaticResource TitleTextBlockStyle}" />

        <SelectorBar x:Name="StatusBar" Grid.Row="1" SelectionChanged="StatusBar_SelectionChanged" AutomationProperties.Name="Trạng thái">
            <SelectorBarItem Text="Tất cả" Tag="0" />
            <SelectorBarItem Text="Đã lên đơn" Tag="1" />
            <SelectorBarItem Text="Đã thanh toán" Tag="2" />
            <SelectorBarItem Text="Huỷ" Tag="3" />
        </SelectorBar>

        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="320" MinWidth="160" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox x:Name="CustomerBox" PlaceholderText="Lọc theo khách (tên / SĐT)" QueryIcon="Find" AutomationProperties.Name="Lọc theo khách hàng" />
            <Button Grid.Column="1" Click="ClearCustomer_Click" AutomationProperties.Name="Bỏ lọc khách" ToolTipService.ToolTip="Bỏ lọc khách"
                    Visibility="{x:Bind local:Ui.VisibleIf(ViewModel.HasCustomer), Mode=OneWay}">
                <SymbolIcon Symbol="Clear" />
            </Button>
            <local:DateRangeBar x:Name="RangeBar" Grid.Column="2" Filter="{x:Bind ViewModel.Range}" />
        </Grid>

        <InfoBar Grid.Row="3" Severity="Error" IsClosable="False" Message="{x:Bind ViewModel.Error, Mode=OneWay}"
                 IsOpen="{x:Bind local:Ui.HasText(ViewModel.Error), Mode=OneWay}" />

        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="18" Padding="0,0,12,24" MaxWidth="1100" HorizontalAlignment="Stretch">
                <TextBlock Text="Không có đơn nào khớp bộ lọc." Opacity="0.7" Visibility="{x:Bind local:Ui.VisibleIfNot(ViewModel.HasData), Mode=OneWay}" />

                <!-- Tổng cộng -->
                <StackPanel Spacing="8">
                    <!-- Giao diện 2026-10-15: 4 ô KPI có icon tròn màu, số to; ô trạng thái nền trắng + chấm màu + thanh tỷ lệ. -->
                    <TextBlock Text="Tổng cộng theo đơn hàng (không tính đơn Huỷ)" FontWeight="SemiBold" Opacity="0.8" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1.3*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Padding="16,14" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Width="32" Height="32" CornerRadius="16" Background="#26E8590C">
                                        <FontIcon Glyph="&#xE7BF;" FontSize="15" Foreground="#E8590C" />
                                    </Border>
                                    <TextBlock Text="Tổng số đơn" Opacity="0.75" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.OrderCount, Mode=OneWay}" FontSize="30" FontWeight="Bold" AutomationProperties.AutomationId="ReportOrderCount" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Padding="16,14" CornerRadius="10" Background="{ThemeResource AccentFillColorDefaultBrush}">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Width="32" Height="32" CornerRadius="16" Background="#33FFFFFF">
                                        <FontIcon Glyph="&#xE8C7;" FontSize="15" Foreground="White" />
                                    </Border>
                                    <TextBlock Text="Tổng thành tiền" Foreground="White" Opacity="0.9" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.Amount, Mode=OneWay}" FontSize="30" FontWeight="Bold" Foreground="White"
                                           AutomationProperties.AutomationId="ReportAmount" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Padding="16,14" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Width="32" Height="32" CornerRadius="16" Background="#262F9E44">
                                        <FontIcon Glyph="&#xE9D2;" FontSize="15" Foreground="#2F9E44" />
                                    </Border>
                                    <TextBlock Text="TB mỗi đơn" Opacity="0.75" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.AverageAmount, Mode=OneWay}" FontSize="30" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Padding="16,14" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Width="32" Height="32" CornerRadius="16" Background="#261C7ED6">
                                        <FontIcon Glyph="&#xED56;" FontSize="15" Foreground="#1C7ED6" />
                                    </Border>
                                    <TextBlock Text="Tổng số món" Opacity="0.75" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.QuantityValue, Mode=OneWay}" FontSize="30" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <ItemsControl x:Name="TilesList" ItemsSource="{x:Bind ViewModel.StatusTiles}" IsTabStop="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="12" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:StatusTile">
                                <Border Padding="16,12" CornerRadius="10" Width="226" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                        AutomationProperties.Name="{x:Bind Label}">
                                    <StackPanel Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Ellipse Width="10" Height="10" Fill="{x:Bind local:Ui.StatusSolid(Status)}" VerticalAlignment="Center" />
                                            <TextBlock Text="{x:Bind Label}" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <TextBlock>
                                            <Run Text="{x:Bind CountValue}" FontSize="22" FontWeight="Bold" /><Run Text=" đơn" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </TextBlock>
                                        <TextBlock Text="{x:Bind AmountValue}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <Grid Height="6" CornerRadius="3" Background="{ThemeResource ControlStrongFillColorDisabledBrush}">
                                            <ProgressBar Value="{x:Bind Share}" Maximum="100" MinHeight="6" CornerRadius="3" Background="Transparent"
                                                         Foreground="{x:Bind local:Ui.StatusSolid(Status)}" IsTabStop="False" />
                                        </Grid>
                                        <TextBlock Text="{x:Bind ShareText}" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Theo món -->
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <TextBlock Text="Tổng cộng theo món" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind ViewModel.TotalQuantity, Mode=OneWay}" Opacity="0.75" AutomationProperties.AutomationId="ReportTotalQuantity" />
                    </StackPanel>
                    <local:ReportTable Lines="{x:Bind ViewModel.Products}" QuantityHeader="Số lượng" />
                </StackPanel>

                <!-- Theo khách -->
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="Chi tiết đơn hàng (theo khách - bấm để xem đơn)" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <DropDownButton AutomationProperties.Name="Sắp xếp khách">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8CB;" FontSize="14" />
                                <TextBlock x:Name="SortText" />
                            </StackPanel>
                            <DropDownButton.Flyout>
                                <MenuFlyout x:Name="SortMenu" Placement="BottomEdgeAlignedLeft" />
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </StackPanel>
                    <ItemsControl x:Name="RowsList" ItemsSource="{x:Bind ViewModel.CustomerRows}" IsTabStop="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CustomerReportRow">
                                <Button Click="Customer_Click" Tag="{x:Bind}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                        Margin="0,0,0,4" Padding="12,8" AutomationProperties.Name="{x:Bind AccessibleName}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind RankText}" Opacity="0.6" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind Orders}" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="3" Text="{x:Bind Amount}" HorizontalAlignment="Right" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <FontIcon Grid.Column="4" Glyph="&#xE76C;" FontSize="12" Opacity="0.6" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MeRon.Views.ReportProductPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MeRon.ViewModels"
    xmlns:local="using:MeRon.Views"
    NavigationCacheMode="Enabled">

    <Grid Padding="24,12,24,0" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Thống kê theo món ăn" Style="{StaticResource TitleTextBlockStyle}" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <ComboBox ItemsSource="{x:Bind ViewModel.ProductOptions, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.Product, Mode=TwoWay}"
                      DisplayMemberPath="Name" MinWidth="240" AutomationProperties.Name="Món ăn" PlaceholderText="(Tất cả món)" />
            <local:DateRangeBar x:Name="RangeBar" Filter="{x:Bind ViewModel.Range}" />
        </StackPanel>

        <InfoBar Grid.Row="2" Severity="Error" IsClosable="False" Message="{x:Bind ViewModel.Error, Mode=OneWay}"
                 IsOpen="{x:Bind local:Ui.HasText(ViewModel.Error), Mode=OneWay}" />

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="18" Padding="0,0,12,24" MaxWidth="1100" HorizontalAlignment="Stretch">
                <TextBlock Text="Không có món nào được bán trong khoảng ngày này (không tính đơn Huỷ)." Opacity="0.7"
                           Visibility="{x:Bind local:Ui.VisibleIfNot(ViewModel.HasData), Mode=OneWay}" />

                <!-- 3 ô số liệu cùng kiểu trang Theo đơn hàng -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1.3*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Padding="16,14" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource OrangeSoftBrush}">
                                    <FontIcon Glyph="&#xED56;" FontSize="{StaticResource FontSizeEmphasis}" Foreground="{StaticResource OrangeBrush}" />
                                </Border>
                                <TextBlock Text="Tổng số món" Opacity="0.75" VerticalAlignment="Center" />
                            </StackPanel>
                            <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left"><TextBlock Text="{x:Bind ViewModel.TotalQuantity, Mode=OneWay}" FontSize="{StaticResource FontSizeDisplay}" FontWeight="SemiBold"
                                       AutomationProperties.AutomationId="ProductTotalQuantity" /></Viewbox>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Padding="16,14" CornerRadius="10" Background="{ThemeResource AccentFillColorDefaultBrush}">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource OnColorOverlayBrush}">
                                    <FontIcon Glyph="&#xE8C7;" FontSize="{StaticResource FontSizeEmphasis}" Foreground="White" />
                                </Border>
                                <TextBlock Text="Tổng trước giảm giá" Foreground="White" Opacity="0.9" VerticalAlignment="Center" />
                            </StackPanel>
                            <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left"><TextBlock Text="{x:Bind ViewModel.TotalAmount, Mode=OneWay}" FontSize="{StaticResource FontSizeDisplay}" FontWeight="SemiBold" Foreground="White" /></Viewbox>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Padding="16,14" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource BlueSoftBrush}">
                                    <FontIcon Glyph="&#xE8FD;" FontSize="{StaticResource FontSizeEmphasis}" Foreground="{StaticResource BlueBrush}" />
                                </Border>
                                <TextBlock Text="Số món khác nhau" Opacity="0.75" VerticalAlignment="Center" />
                            </StackPanel>
                            <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left"><TextBlock Text="{x:Bind ViewModel.ProductCount, Mode=OneWay}" FontSize="{StaticResource FontSizeDisplay}" FontWeight="SemiBold" /></Viewbox>
                        </StackPanel>
                    </Border>
                </Grid>

                <StackPanel Spacing="6">
                    <TextBlock Text="Theo từng món (số lượng giảm dần; món tự do gộp theo tên)" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Bind ViewModel.PreviousText, Mode=OneWay}" Opacity="0.7" TextWrapping="Wrap"
                               FontSize="{StaticResource FontSizeCaption}" Visibility="{x:Bind local:Ui.VisibleIf(ViewModel.HasPrevious), Mode=OneWay}" />
                    <local:ReportTable Lines="{x:Bind ViewModel.Products}" ShowTrend="{x:Bind ViewModel.HasPrevious, Mode=OneWay}"
                                       TrendHeaderTip="{x:Bind ViewModel.PreviousText, Mode=OneWay}" />
                </StackPanel>

                <!-- Món × thứ trong tuần (2026-11-13): trung bình mỗi ngày, nền cam đậm dần theo thứ bán nhiều nhất của từng món -->
                <StackPanel Spacing="6" Visibility="{x:Bind local:Ui.VisibleIf(ViewModel.HasData), Mode=OneWay}">
                    <TextBlock Text="Theo thứ trong tuần" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Bind ViewModel.WeekdayNote, Mode=OneWay}" Opacity="0.7" TextWrapping="Wrap" FontSize="{StaticResource FontSizeCaption}"
                               AutomationProperties.AutomationId="WeekdayNote" />
                    <Border CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel>
                            <Grid Padding="12,6" ColumnSpacing="4" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="120" />
                                    <ColumnDefinition Width="62" />
                                    <ColumnDefinition Width="62" />
                                    <ColumnDefinition Width="62" />
                                    <ColumnDefinition Width="62" />
                                    <ColumnDefinition Width="62" />
                                    <ColumnDefinition Width="62" />
                                    <ColumnDefinition Width="62" />
                                    <ColumnDefinition Width="70" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Món" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="T2" FontWeight="SemiBold" HorizontalAlignment="Center"
                                           ToolTipService.ToolTip="{x:Bind ViewModel.WeekdayTips[0], Mode=OneWay}" />
                                <TextBlock Grid.Column="2" Text="T3" FontWeight="SemiBold" HorizontalAlignment="Center"
                                           ToolTipService.ToolTip="{x:Bind ViewModel.WeekdayTips[1], Mode=OneWay}" />
                                <TextBlock Grid.Column="3" Text="T4" FontWeight="SemiBold" HorizontalAlignment="Center"
                                           ToolTipService.ToolTip="{x:Bind ViewModel.WeekdayTips[2], Mode=OneWay}" />
                                <TextBlock Grid.Column="4" Text="T5" FontWeight="SemiBold" HorizontalAlignment="Center"
                                           ToolTipService.ToolTip="{x:Bind ViewModel.WeekdayTips[3], Mode=OneWay}" />
                                <TextBlock Grid.Column="5" Text="T6" FontWeight="SemiBold" HorizontalAlignment="Center"
                                           ToolTipService.ToolTip="{x:Bind ViewModel.WeekdayTips[4], Mode=OneWay}" />
                                <TextBlock Grid.Column="6" Text="T7" FontWeight="SemiBold" HorizontalAlignment="Center"
                                           ToolTipService.ToolTip="{x:Bind ViewModel.WeekdayTips[5], Mode=OneWay}" />
                                <TextBlock Grid.Column="7" Text="CN" FontWeight="SemiBold" HorizontalAlignment="Center"
                                           ToolTipService.ToolTip="{x:Bind ViewModel.WeekdayTips[6], Mode=OneWay}" />
                                <TextBlock Grid.Column="8" Text="Tổng" FontWeight="SemiBold" HorizontalAlignment="Right" />
                            </Grid>
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Weekdays}" IsTabStop="False" AutomationProperties.Name="Món theo thứ trong tuần">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:WeekdayRowView">
                                        <Grid Padding="12,3" ColumnSpacing="4" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" MinWidth="120" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="70" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <ItemsControl Grid.Column="1" ItemsSource="{x:Bind Cells}" IsTabStop="False">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" Spacing="4" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:WeekdayCellView">
                                                        <Grid Width="62" Height="28" ToolTipService.ToolTip="{x:Bind Tip}" AutomationProperties.Name="{x:Bind Tip}">
                                                            <Border CornerRadius="4" Background="{StaticResource OrangeBrush}" Opacity="{x:Bind local:ReportProductPage.HeatOpacity(Heat)}" />
                                                            <TextBlock Text="{x:Bind Text}" FontWeight="{x:Bind Weight}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Grid.Column="2" Text="{x:Bind Total}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="{x:Bind ViewModel.OrdersTitle, Mode=OneWay}" FontWeight="SemiBold" AutomationProperties.AutomationId="ProductOrdersTitle" />
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Orders}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="6" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:OrderCardViewModel">
                                <Button Click="Order_Click" Tag="{x:Bind}" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                        Background="Transparent" BorderThickness="0" AutomationProperties.Name="{x:Bind AccessibleName}">
                                    <local:OrderCard Card="{x:Bind}" />
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MeRon.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="MeRon - quản lý bán hàng">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!-- Mỗi mục 1 trang; Tag = tên class trang trong MeRon.Views. -->
    <NavigationView x:Name="Nav" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" PaneDisplayMode="Left"
                    OpenPaneLength="220" SelectionChanged="Nav_SelectionChanged" ItemInvoked="Nav_ItemInvoked"
                    KeyboardAcceleratorPlacementMode="Hidden">
        <NavigationView.MenuItems>
            <NavigationViewItemHeader Content="Bán hàng" />
            <NavigationViewItem Content="Đặt hàng" Tag="OrdersPage">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE7BF;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Mua hàng" Tag="PurchasesPage">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE719;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItemHeader Content="Thống kê" />
            <NavigationViewItem Content="Theo đơn hàng" Tag="ReportOrderPage">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE9D2;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Theo món ăn" Tag="ReportProductPage">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE9F9;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Tổng hợp" Tag="ReportSummaryPage">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE8EF;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Khách hàng tiềm năng" Tag="ReportCustomerPage">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE734;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItemHeader Content="Danh mục" />
            <NavigationViewItem Content="Khách hàng" Tag="CustomersPage" Icon="People" />
            <NavigationViewItem Content="Món ăn" Tag="ProductsPage">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xED56;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Danh mục món ăn" Tag="CategoriesPage" Icon="List" />
            <NavigationViewItem Content="Địa chỉ" Tag="AddressesPage" Icon="Map" />
            <NavigationViewItemHeader Content="Dữ liệu" />
            <NavigationViewItem Content="Nhập dữ liệu" Tag="ImportPage" Icon="Download" />
            <NavigationViewItem Content="Xuất / Xoá dữ liệu" Tag="ExportPage" Icon="Upload" />
        </NavigationView.MenuItems>
        <NavigationView.FooterMenuItems>
            <!-- Mở cửa sổ Hướng dẫn, không chuyển trang (SelectsOnInvoked=False → xử lý ở ItemInvoked). -->
            <NavigationViewItem Content="Hướng dẫn (F1)" Tag="Help" Icon="Help" SelectsOnInvoked="False" />
        </NavigationView.FooterMenuItems>
        <!-- F1 cho cả cửa sổ. NavigationView ở trên đặt KeyboardAcceleratorPlacementMode="Hidden": không thì WinUI tự hiện
             tooltip "F1" khi rê chuột vào bất kỳ chỗ nào không có tooltip riêng. -->
        <NavigationView.KeyboardAccelerators>
            <KeyboardAccelerator Key="F1" Invoked="F1_Invoked" />
        </NavigationView.KeyboardAccelerators>

        <!-- 10 trang được cache (giữ bộ lọc, và 1 trang duy nhất cho ViewModel dùng chung cả phiên) - CacheSize mặc định 10 vừa khít, để dư. -->
        <Frame x:Name="ContentFrame" CacheSize="20" />
    </NavigationView>
</Window>

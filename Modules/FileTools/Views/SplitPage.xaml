<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FileTools.Views.SplitPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:FileTools.Views"
    NavigationCacheMode="Required">

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
    <Grid x:Name="Root" Padding="24,16" RowSpacing="12" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="140" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="2">
            <TextBlock Text="Tách file" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock Opacity="0.7" TextWrapping="Wrap"
                       Text="Tách 1 file lớn thành nhiều phần, không bao giờ cắt ngang 1 dòng (hay 1 ô CSV nhiều dòng). Kéo-thả file vào đây." />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="4">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Header="File nguồn" Text="{x:Bind ViewModel.SourcePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="1" VerticalAlignment="Bottom" Content="Chọn..." Command="{x:Bind ViewModel.BrowseSourceCommand}" />
            </Grid>
            <TextBlock Text="{x:Bind ViewModel.SourceInfo, Mode=OneWay}" Opacity="0.7" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="32">
            <RadioButtons Header="Tách theo" SelectedIndex="{x:Bind ViewModel.ModeIndex, Mode=TwoWay}">
                <x:String>Dung lượng mỗi phần</x:String>
                <x:String>Số dòng mỗi phần</x:String>
                <x:String>Số phần (chia đều)</x:String>
            </RadioButtons>
            <StackPanel Spacing="8">
                <NumberBox Header="Dung lượng (MB)" Width="200" Minimum="0.01" SmallChange="10" SpinButtonPlacementMode="Compact"
                           Value="{x:Bind ViewModel.SizeMb, Mode=TwoWay}" />
                <NumberBox Header="Số dòng" Width="200" Minimum="1" SmallChange="100000" SpinButtonPlacementMode="Compact"
                           Value="{x:Bind ViewModel.LinesPerPart, Mode=TwoWay}" />
                <NumberBox Header="Số phần" Width="200" Minimum="1" Maximum="10000" SpinButtonPlacementMode="Compact"
                           Value="{x:Bind ViewModel.Parts, Mode=TwoWay}" />
            </StackPanel>
            <CheckBox VerticalAlignment="Top" Margin="0,24,0,0" Content="Lặp dòng tiêu đề (CSV) ở mọi phần" IsChecked="{x:Bind ViewModel.RepeatHeader, Mode=TwoWay}" />
        </StackPanel>

        <Grid Grid.Row="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Header="Thư mục chứa các phần" Text="{x:Bind ViewModel.OutputFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="1" VerticalAlignment="Bottom" Content="Chọn..." Command="{x:Bind ViewModel.BrowseOutputCommand}" />
            <views:OutputPanel Grid.Column="2" Settings="{x:Bind ViewModel.Output}" />
        </Grid>

        <Button Grid.Row="4" Content="Tách file" MinWidth="110" Style="{StaticResource CompactAccentButtonStyle}" Command="{x:Bind ViewModel.SplitCommand}" />

        <views:JobPanel Grid.Row="5" Job="{x:Bind ViewModel}" />
    </Grid>
    </ScrollViewer>
</Page>

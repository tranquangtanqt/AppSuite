<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FileTools.Views.InfoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:FileTools.Views"
    xmlns:vm="using:FileTools.ViewModels"
    NavigationCacheMode="Required">

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
    <Grid x:Name="Root" Padding="24,16" RowSpacing="12" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" MinHeight="200" />
            <RowDefinition Height="*" MinHeight="120" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="2">
            <TextBlock Text="Thông tin file" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock Opacity="0.7" TextWrapping="Wrap"
                       Text="Số dòng, encoding, kiểu xuống dòng, dòng dài nhất; file dạng bảng thêm dấu phân cách, số cột và các bản ghi lệch số cột. Chọn hoặc kéo-thả file là tự phân tích." />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="4">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Header="File" Text="{x:Bind ViewModel.SourcePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="1" VerticalAlignment="Bottom" Content="Chọn..." Command="{x:Bind ViewModel.BrowseSourceCommand}" />
                <Button Grid.Column="2" VerticalAlignment="Bottom" Content="Phân tích lại" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.InspectCommand}" />
            </Grid>
        </StackPanel>

        <Border Grid.Row="2" BorderThickness="1" CornerRadius="4" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <ListView ItemsSource="{x:Bind ViewModel.Rows}" SelectionMode="None" Padding="0,4">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:InfoRow">
                        <Grid ColumnSpacing="16" Padding="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Label}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Value}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <views:JobPanel Grid.Row="3" Job="{x:Bind ViewModel}" />
    </Grid>
    </ScrollViewer>
</Page>

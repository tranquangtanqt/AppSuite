<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MeRon.Views.OrderFormPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MeRon.ViewModels"
    xmlns:local="using:MeRon.Views">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="24,12,24,16" Spacing="12" MaxWidth="980" HorizontalAlignment="Left">
                <!-- Tiêu đề -->
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Click="Back_Click" AutomationProperties.Name="Quay lại" ToolTipService.ToolTip="Quay lại (không lưu)">
                        <SymbolIcon Symbol="Back" />
                    </Button>
                    <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                    <Border Padding="8,2" CornerRadius="4" VerticalAlignment="Center"
                            Background="{x:Bind local:Ui.StatusBackground(ViewModel.OriginalStatus), Mode=OneWay}"
                            Visibility="{x:Bind local:Ui.VisibleIf(ViewModel.IsEdit), Mode=OneWay}">
                        <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" FontSize="12" />
                    </Border>
                </StackPanel>

                <InfoBar Severity="Informational" IsClosable="False" IsOpen="{x:Bind ViewModel.IsCancelled, Mode=OneWay}"
                         Message="Đơn đã huỷ: sửa và Lưu vẫn giữ trạng thái Huỷ (không tính vào báo cáo)." />
                <InfoBar Severity="Warning" IsClosable="False" IsOpen="{x:Bind ViewModel.HasCopyNotice, Mode=OneWay}"
                         Message="{x:Bind ViewModel.CopyNotice, Mode=OneWay}" AutomationProperties.AutomationId="CopyNotice" />

                <!-- Khách hàng -->
                <AutoSuggestBox x:Name="CustomerBox" Header="Khách hàng" PlaceholderText="Gõ tên hoặc số điện thoại rồi chọn" QueryIcon="Find"
                                MaxWidth="460" HorizontalAlignment="Left" Width="460" AutomationProperties.Name="Khách hàng"
                                AutomationProperties.AutomationId="FormCustomerBox" />

                <!-- Các dòng món -->
                <StackPanel Spacing="4">
                    <Grid Padding="0,0,0,2" ColumnSpacing="8" Opacity="0.75">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="220" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Món" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="Đơn giá" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="2" Text="Số lượng" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="Thành tiền" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    </Grid>
                    <ItemsControl x:Name="LinesList" ItemsSource="{x:Bind ViewModel.Lines}" IsTabStop="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:OrderLineViewModel">
                                <Grid ColumnSpacing="8" Margin="0,0,0,6" Opacity="{x:Bind RowOpacity}" ToolTipService.ToolTip="{x:Bind LockTip}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="220" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Món trong danh mục -->
                                    <Grid Visibility="{x:Bind local:Ui.VisibleIf(IsProduct)}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Khoảng cách nằm ở Margin của biểu tượng (không dùng ColumnSpacing): dòng không khoá thì ô món thẳng hàng với ô món tự do. -->
                                        <FontIcon Glyph="&#xE72E;" FontSize="14" Margin="0,0,6,0" Visibility="{x:Bind local:Ui.VisibleIf(IsLocked)}"
                                                  AutomationProperties.Name="Dòng bị khoá" />
                                        <!-- Gõ lọc rồi chọn (ProductSuggest) - bắt buộc là 1 món trong danh sách. -->
                                        <AutoSuggestBox x:Name="ProductBox" Grid.Column="1" PlaceholderText="Gõ tên món rồi chọn" QueryIcon="Find"
                                                        IsEnabled="{x:Bind IsEditable}"
                                                        Loaded="ProductBox_Loaded" AutomationProperties.Name="Món ăn" />
                                    </Grid>
                                    <!-- Lỗi ô món ở hàng riêng: không kéo cao các ô Số lượng / Đơn giá của dòng. -->
                                    <TextBlock Grid.Row="1" Grid.ColumnSpan="4" Text="{x:Bind ProductError, Mode=OneWay}" TextWrapping="Wrap" FontSize="12"
                                               Margin="0,2,0,0" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                               Visibility="{x:Bind local:Ui.VisibleIf(HasProductError), Mode=OneWay}"
                                               AutomationProperties.AutomationId="ProductError" />
                                    <!-- Món tự do -->
                                    <!-- Style mặc định (cỡ chữ 14) như ô món / ô số bên cạnh; style gọn chung (SharedUI) chỉ áp lên TextBox nên chữ nhỏ hơn. -->
                                    <TextBox x:Name="FreeNameBox" Style="{StaticResource DefaultTextBoxStyle}" Text="{x:Bind FreeName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="Tên món tự do" Visibility="{x:Bind local:Ui.VisibleIf(IsFree)}"
                                             AutomationProperties.Name="Tên món tự do" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind UnitPriceText, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Visibility="{x:Bind local:Ui.VisibleIf(IsProduct)}" />
                                    <NumberBox x:Name="FreePriceBox" Grid.Column="1" Value="{x:Bind FreePrice, Mode=TwoWay}" Minimum="0" PlaceholderText="Đơn giá"
                                               Visibility="{x:Bind local:Ui.VisibleIf(IsFree)}" Loaded="FreePriceBox_Loaded" AutomationProperties.Name="Đơn giá món tự do" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                        <Button Command="{x:Bind DecreaseCommand}" IsEnabled="{x:Bind IsEditable}" Padding="8,4" AutomationProperties.Name="Bớt 1">
                                            <FontIcon Glyph="&#xE738;" FontSize="12" />
                                        </Button>
                                        <NumberBox Value="{x:Bind Quantity, Mode=TwoWay}" Minimum="1" Width="64" IsEnabled="{x:Bind IsEditable}" Loaded="QuantityBox_Loaded"
                                                   AutomationProperties.Name="Số lượng" />
                                        <Button Command="{x:Bind IncreaseCommand}" IsEnabled="{x:Bind IsEditable}" Padding="8,4" AutomationProperties.Name="Thêm 1">
                                            <FontIcon Glyph="&#xE710;" FontSize="12" />
                                        </Button>
                                    </StackPanel>
                                    <TextBlock Grid.Column="3" Text="{x:Bind LineTotalText, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <Button Grid.Column="4" Command="{x:Bind RemoveCommand}" IsEnabled="{x:Bind IsEditable}" Padding="6"
                                            Background="Transparent" BorderThickness="0" AutomationProperties.Name="Xoá dòng" ToolTipService.ToolTip="Xoá dòng">
                                        <SymbolIcon Symbol="Cancel" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Command="{x:Bind ViewModel.AddLineCommand}" Click="AddLine_Click" AutomationProperties.Name="Thêm món">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <SymbolIcon Symbol="Add" />
                                <TextBlock Text="Thêm món" />
                            </StackPanel>
                        </Button>
                        <Button Command="{x:Bind ViewModel.AddFreeLineCommand}" AutomationProperties.Name="Thêm món tự do"
                                ToolTipService.ToolTip="Món không có trong danh sách Món ăn: tự nhập tên + đơn giá">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE710;" FontSize="14" />
                                <TextBlock Text="Thêm món tự do" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- Tiền -->
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <NumberBox x:Name="DiscountBox" Header="Giảm giá" Value="{x:Bind ViewModel.Discount, Mode=TwoWay}" Minimum="0" Width="200" Loaded="DiscountBox_Loaded"
                               AutomationProperties.Name="Giảm giá" AutomationProperties.AutomationId="DiscountBox" />
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Spacing="2">
                        <TextBlock Text="{x:Bind ViewModel.QuantityText, Mode=OneWay}" HorizontalAlignment="Right" Opacity="0.75"
                                   AutomationProperties.AutomationId="QuantityText" />
                        <TextBlock Text="{x:Bind ViewModel.SubTotalText, Mode=OneWay}" HorizontalAlignment="Right" Opacity="0.75" />
                        <Border Padding="12,6" CornerRadius="8" Background="{ThemeResource AccentFillColorDefaultBrush}">
                            <TextBlock Text="{x:Bind ViewModel.TotalText, Mode=OneWay}" FontWeight="SemiBold" FontSize="16"
                                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" AutomationProperties.AutomationId="TotalText" />
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Ngày + thanh toán -->
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <CalendarDatePicker Header="Ngày giao hàng" Date="{x:Bind ViewModel.DeliveryDate, Mode=TwoWay}" Width="170"
                                        DateFormat="{}{day.integer(2)}/{month.integer(2)}/{year.full}" AutomationProperties.Name="Ngày giao hàng" />
                    <ToggleSwitch Header="Đã thanh toán trước" IsOn="{x:Bind ViewModel.IsPrepaid, Mode=TwoWay}" OnContent="Có" OffContent="Không"
                                  AutomationProperties.Name="Đã thanh toán trước" />
                    <CalendarDatePicker Header="Ngày thanh toán" Date="{x:Bind ViewModel.PaymentDate, Mode=TwoWay}" Width="170"
                                        DateFormat="{}{day.integer(2)}/{month.integer(2)}/{year.full}" AutomationProperties.Name="Ngày thanh toán"
                                        Visibility="{x:Bind local:Ui.VisibleIf(ViewModel.PaymentVisible), Mode=OneWay}" />
                </StackPanel>

                <TextBox Header="Ghi chú" Style="{StaticResource DefaultTextBoxStyle}" Text="{x:Bind ViewModel.Note, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64"
                         AutomationProperties.Name="Ghi chú" />
            </StackPanel>
        </ScrollViewer>

        <!-- Nút cố định cuối trang -->
        <Border Grid.Row="1" Padding="24,10" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Style="{StaticResource AccentButtonStyle}" Click="Save_Click" AutomationProperties.Name="Lưu đơn" ToolTipService.ToolTip="Lưu (Ctrl+S)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <SymbolIcon Symbol="Save" />
                        <TextBlock Text="Lưu" />
                    </StackPanel>
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="S" />
                    </Button.KeyboardAccelerators>
                </Button>
                <Button Content="Quay lại" Click="Back_Click" />
                <Button Click="CopyOrder_Click" Visibility="{x:Bind local:Ui.VisibleIf(ViewModel.IsEdit), Mode=OneWay}" Margin="24,0,0,0"
                        AutomationProperties.Name="Sao chép đơn" ToolTipService.ToolTip="Tạo đơn mới giống đơn này (cùng ngày giao, giá hiện tại) - không lưu đơn đang sửa">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <SymbolIcon Symbol="Copy" />
                        <TextBlock Text="Sao chép đơn" />
                    </StackPanel>
                </Button>
                <Button Click="CancelOrder_Click" Visibility="{x:Bind local:Ui.VisibleIf(ViewModel.CanCancel), Mode=OneWay}"
                        AutomationProperties.Name="Huỷ đơn">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <SymbolIcon Symbol="Cancel" />
                        <TextBlock Text="Huỷ đơn" />
                    </StackPanel>
                </Button>
                <Button Click="Delete_Click" Visibility="{x:Bind local:Ui.VisibleIf(ViewModel.IsEdit), Mode=OneWay}" AutomationProperties.Name="Xoá đơn">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <SymbolIcon Symbol="Delete" />
                        <TextBlock Text="Xoá đơn" />
                    </StackPanel>
                </Button>
                <!-- Lỗi cạnh nút Lưu: luôn thấy dù form đang cuộn tới đâu. -->
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="16,0,0,0" VerticalAlignment="Center"
                            Visibility="{x:Bind local:Ui.VisibleIfText(ViewModel.Error), Mode=OneWay}">
                    <FontIcon Glyph="&#xEA39;" FontSize="16" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.Error, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               TextWrapping="Wrap" MaxWidth="520" VerticalAlignment="Center" AutomationProperties.AutomationId="FormError" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>

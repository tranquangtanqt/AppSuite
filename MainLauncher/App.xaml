<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="MainLauncher.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MainLauncher"
    xmlns:converters="using:MainLauncher.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Default styles for SharedUI's custom controls (CopyButton, OpacityMaskView) -->
                <ResourceDictionary Source="ms-appx:///SharedUI/Themes/Generic.xaml" />
                <!-- Compact sizing (Button/TextBox/ComboBox/TextBlock/...) applied suite-wide -->
                <ResourceDictionary Source="ms-appx:///SharedUI/Themes/CompactStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:ModuleStatusToBrushConverter x:Key="ModuleStatusToBrushConverter" />
            <converters:ModuleNameToAccentBrushConverter x:Key="ModuleNameToAccentBrushConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>

<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FileTools.Views.FilterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:FileTools.Views"
    NavigationCacheMode="Required">

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
    <Grid x:Name="Root" Padding="24,16" RowSpacing="12" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="2">
            <TextBlock Text="Lọc dòng" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock Opacity="0.7" TextWrapping="Wrap"
                       Text="Giữ hoặc bỏ các dòng chứa từ khoá (mỗi dòng 1 từ khoá) hoặc khớp regex, ghi ra file mới. File CSV lọc theo bản ghi (ô nhiều dòng không bị tách)." />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="4">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Header="File nguồn" Text="{x:Bind ViewModel.SourcePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="1" VerticalAlignment="Bottom" Content="Chọn..." Command="{x:Bind ViewModel.BrowseSourceCommand}" />
            </Grid>
            <TextBlock Text="{x:Bind ViewModel.SourceInfo, Mode=OneWay}" Opacity="0.7" />
        </StackPanel>

        <Grid Grid.Row="2" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox VerticalAlignment="Top" Header="Từ khoá (mỗi dòng 1 từ; regex: chỉ dùng dòng đầu)" AcceptsReturn="True" TextWrapping="Wrap" Height="120"
                     Text="{x:Bind ViewModel.Terms, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <StackPanel Grid.Column="1" Spacing="8">
                <RadioButtons Header="Dòng khớp khi" SelectedIndex="{x:Bind ViewModel.MatchAllIndex, Mode=TwoWay}">
                    <x:String>Chứa 1 trong các từ</x:String>
                    <x:String>Chứa tất cả các từ</x:String>
                </RadioButtons>
                <RadioButtons Header="Dòng khớp thì" SelectedIndex="{x:Bind ViewModel.ActionIndex, Mode=TwoWay}">
                    <x:String>Giữ lại</x:String>
                    <x:String>Bỏ đi</x:String>
                </RadioButtons>
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="4" Margin="0,24,0,0">
                <CheckBox Content="Không phân biệt dấu (tiếng Việt)" IsChecked="{x:Bind ViewModel.IgnoreDiacritics, Mode=TwoWay}" />
                <CheckBox Content="Phân biệt hoa / thường" IsChecked="{x:Bind ViewModel.MatchCase, Mode=TwoWay}" />
                <CheckBox Content="Regex" IsChecked="{x:Bind ViewModel.IsRegex, Mode=TwoWay}" />
                <CheckBox Content="Luôn giữ dòng tiêu đề (dòng 1)" IsChecked="{x:Bind ViewModel.KeepHeader, Mode=TwoWay}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Header="File kết quả" Text="{x:Bind ViewModel.OutputPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="1" VerticalAlignment="Bottom" Content="Chọn..." Command="{x:Bind ViewModel.BrowseOutputCommand}" />
            <views:OutputPanel Grid.Column="2" Settings="{x:Bind ViewModel.Output}" />
        </Grid>

        <Button Grid.Row="4" Content="Lọc dòng" MinWidth="110" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.FilterCommand}" />

        <views:JobPanel Grid.Row="5" Job="{x:Bind ViewModel}" />
    </Grid>
    </ScrollViewer>
</Page>

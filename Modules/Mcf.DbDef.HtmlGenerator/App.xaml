<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Mcf.DbDef.HtmlGenerator.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Mcf.DbDef.HtmlGenerator">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Compact sizing (Button/TextBox/ComboBox/TextBlock/...) applied suite-wide -->
                <ResourceDictionary Source="ms-appx:///SharedUI/Themes/CompactStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>

<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DbTools.Views.DbInfoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:DbTools.Views"
    xmlns:vm="using:DbTools.ViewModels"
    xmlns:models="using:DbTools.Models"
    NavigationCacheMode="Required">

    <Page.Resources>
        <Style x:Key="HeaderRow" TargetType="Grid">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="ColumnSpacing" Value="10" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="HeaderText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="ListBorder" TargetType="Border">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        </Style>
        <Style x:Key="RowItem" TargetType="ListViewItem">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="Code" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        </Style>
    </Page.Resources>

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
    <Grid x:Name="Root" Padding="24,12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="240" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="2" Margin="0,0,48,0">
            <TextBlock Text="Thông tin DB" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock Opacity="0.7" TextWrapping="Wrap"
                       Text="Tra cứu cấu trúc database: tổng quan, bảng (cột, index, ràng buộc, trigger, DDL), view / hàm / trigger / sequence. Chỉ đọc, không thay đổi gì." />
        </StackPanel>

        <!-- Server + database -->
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="420" />
                <ColumnDefinition Width="*" MaxWidth="260" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ComboBox Header="Server (hồ sơ kết nối)" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.Profiles}"
                      SelectedItem="{x:Bind ViewModel.Profile, Mode=TwoWay}" PlaceholderText="(chưa có kết nối)"
                      IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="models:ConnectionProfile">
                        <TextBlock Text="{x:Bind Display, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <ComboBox x:Name="DbBox" Grid.Column="1" Header="Database" IsEditable="True" HorizontalAlignment="Stretch"
                      ItemsSource="{x:Bind ViewModel.Databases}" Text="{x:Bind ViewModel.Database, Mode=TwoWay}"
                      IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" DropDownOpened="DbBox_DropDownOpened" Loaded="DbBox_Loaded"
                      AutomationProperties.AutomationId="InfoDbBox" />
            <Button Grid.Column="2" VerticalAlignment="Bottom" Content="Đọc" MinWidth="80" Style="{StaticResource CompactAccentButtonStyle}"
                    Command="{x:Bind ViewModel.LoadCommand}" AutomationProperties.AutomationId="InfoLoadButton"
                    ToolTipService.ToolTip="Đọc lại thông tin từ catalog của database (chỉ đọc)" />
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="18" Height="18" />
            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.AutomationId="StatusText" />
        </StackPanel>

        <SelectorBar Grid.Row="3" SelectionChanged="Tabs_SelectionChanged" AutomationProperties.AutomationId="InfoTabs">
            <SelectorBarItem Text="Tổng quan" IsSelected="True" />
            <SelectorBarItem Text="Bảng" />
            <SelectorBarItem Text="Đối tượng khác" />
        </SelectorBar>

        <!-- Lọc chung cho Bảng / Đối tượng khác -->
        <Grid Grid.Row="4" ColumnSpacing="8" Visibility="{x:Bind views:Ui.VisibleIf(ViewModel.ShowFilter), Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" MaxWidth="320" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ComboBox Header="Schema" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.SchemaOptions}"
                      SelectedItem="{x:Bind ViewModel.SelectedSchema, Mode=TwoWay}" AutomationProperties.AutomationId="SchemaFilter" />
            <TextBox Grid.Column="1" Header="Tìm theo tên" Text="{x:Bind ViewModel.NameFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="một phần tên, vd: order" AutomationProperties.AutomationId="NameFilter" />
            <ComboBox Grid.Column="2" Header="Sắp theo" SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}"
                      Visibility="{x:Bind views:Ui.TabVisible(ViewModel.Tab, 1), Mode=OneWay}" AutomationProperties.AutomationId="SortBox">
                <ComboBoxItem Content="Tên" />
                <ComboBoxItem Content="Dung lượng (lớn trước)" />
                <ComboBoxItem Content="Số dòng (nhiều trước)" />
            </ComboBox>
        </Grid>

        <Grid Grid.Row="5">
            <!-- ===== Tổng quan ===== -->
            <Grid RowSpacing="10" Visibility="{x:Bind views:Ui.TabVisible(ViewModel.Tab, 0), Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <ItemsControl ItemsSource="{x:Bind ViewModel.Overview}" AutomationProperties.AutomationId="OverviewList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:InfoLine">
                            <Grid ColumnSpacing="12" Padding="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Label}" Opacity="0.7" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Value}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Grid.Row="1" Style="{StaticResource ListBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Style="{StaticResource HeaderRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Schema" Style="{StaticResource HeaderText}" />
                            <TextBlock Grid.Column="1" Text="Owner" Style="{StaticResource HeaderText}" />
                            <TextBlock Grid.Column="2" Text="Bảng" Style="{StaticResource HeaderText}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="3" Text="View" Style="{StaticResource HeaderText}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="4" Text="Hàm" Style="{StaticResource HeaderText}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="5" Text="Trigger" Style="{StaticResource HeaderText}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="6" Text="Sequence" Style="{StaticResource HeaderText}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="7" Text="Dung lượng" Style="{StaticResource HeaderText}" HorizontalAlignment="Right" />
                        </Grid>
                        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Schemas}" SelectionMode="None" ItemContainerStyle="{StaticResource RowItem}"
                                  AutomationProperties.AutomationId="SchemaList">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:SchemaRow">
                                    <Grid ColumnSpacing="10" AutomationProperties.Name="{x:Bind Schema}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="90" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Schema}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Owner}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Opacity="0.8" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind Tables}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{x:Bind Views}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4" Text="{x:Bind Functions}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="5" Text="{x:Bind Triggers}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="6" Text="{x:Bind Sequences}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="7" Text="{x:Bind Size}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===== Bảng: danh sách ===== -->
            <Grid RowSpacing="6" Visibility="{x:Bind views:Ui.VisibleIf(ViewModel.ShowTableList), Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind ViewModel.TablesSummary, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center"
                               AutomationProperties.AutomationId="TablesSummary" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                        <Button Content="Đếm chính xác" Command="{x:Bind ViewModel.CountAllCommand}"
                                ToolTipService.ToolTip="SELECT count(*) từng bảng đang hiện trong danh sách (bảng lớn có thể lâu). Mặc định là số ước lượng (≈) theo thống kê của server." />
                        <Button Content="Xem chi tiết" Style="{StaticResource CompactAccentButtonStyle}" Command="{x:Bind ViewModel.OpenDetailCommand}"
                                AutomationProperties.AutomationId="OpenDetailButton" ToolTipService.ToolTip="Cột, index, ràng buộc, trigger, DDL của bảng đang chọn (bấm đúp / Enter cũng được)" />
                    </StackPanel>
                </Grid>
                <Border Grid.Row="1" Style="{StaticResource ListBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Style="{StaticResource HeaderRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Bảng" Style="{StaticResource HeaderText}" />
                            <TextBlock Grid.Column="1" Text="Số dòng" Style="{StaticResource HeaderText}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="2" Text="Dung lượng" Style="{StaticResource HeaderText}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="3" Text="Cột" Style="{StaticResource HeaderText}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="4" Text="PK" Style="{StaticResource HeaderText}" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="5" Text="Ghi chú" Style="{StaticResource HeaderText}" />
                        </Grid>
                        <ListView x:Name="TableList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Tables}" SelectedItem="{x:Bind ViewModel.SelectedTable, Mode=TwoWay}"
                                  ItemContainerStyle="{StaticResource RowItem}" DoubleTapped="TableList_DoubleTapped" KeyDown="TableList_KeyDown"
                                  AutomationProperties.AutomationId="TableList" AutomationProperties.Name="Danh sách bảng">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:TableRow">
                                    <Grid ColumnSpacing="10" ToolTipService.ToolTip="{x:Bind Tip}" AutomationProperties.Name="{x:Bind FullName}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind FullName}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind KindText}" Opacity="0.6" FontSize="12" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{x:Bind Rows, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind Size}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{x:Bind Columns}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4" Text="{x:Bind PrimaryKey}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="5" Text="{x:Bind Comment}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Opacity="0.8" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===== Bảng: chi tiết ===== -->
            <Grid RowSpacing="6" Visibility="{x:Bind views:Ui.VisibleIf(ViewModel.ShowTableDetail), Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Content="← Danh sách bảng" Command="{x:Bind ViewModel.CloseDetailCommand}" AutomationProperties.AutomationId="CloseDetailButton" />
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.DetailTitle, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="16"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" AutomationProperties.AutomationId="DetailTitle" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                        <Button Content="Đếm dòng chính xác" Command="{x:Bind ViewModel.CountRowsCommand}" ToolTipService.ToolTip="SELECT count(*) (bảng lớn có thể lâu)" />
                        <Button Content="Copy DDL" Command="{x:Bind ViewModel.CopyDdlCommand}" AutomationProperties.AutomationId="CopyDdlButton" />
                        <Button Content="Sinh dữ liệu mẫu" Click="MockData_Click" AutomationProperties.AutomationId="MockDataButton"
                                ToolTipService.ToolTip="Mở trang Sinh dữ liệu mẫu với bảng này (lấy vài dòng đầu làm mẫu)" />
                    </StackPanel>
                </Grid>
                <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.DetailInfo, Mode=OneWay}" Opacity="0.8" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                           AutomationProperties.AutomationId="DetailInfo" />
                <SelectorBar Grid.Row="2" SelectionChanged="DetailTabs_SelectionChanged" AutomationProperties.AutomationId="DetailTabs">
                    <SelectorBarItem Text="{x:Bind ViewModel.ColumnsTab, Mode=OneWay}" IsSelected="True" />
                    <SelectorBarItem Text="{x:Bind ViewModel.IndexesTab, Mode=OneWay}" />
                    <SelectorBarItem Text="{x:Bind ViewModel.ConstraintsTab, Mode=OneWay}" />
                    <SelectorBarItem Text="{x:Bind ViewModel.TriggersTab, Mode=OneWay}" />
                    <SelectorBarItem Text="DDL" />
                </SelectorBar>
                <Grid Grid.Row="3">
                    <!-- Cột -->
                    <Border Style="{StaticResource ListBorder}" Visibility="{x:Bind views:Ui.TabVisible(ViewModel.DetailTab, 0), Mode=OneWay}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Style="{StaticResource HeaderRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="#" Style="{StaticResource HeaderText}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="1" Text="Cột" Style="{StaticResource HeaderText}" />
                                <TextBlock Grid.Column="2" Text="Kiểu" Style="{StaticResource HeaderText}" />
                                <TextBlock Grid.Column="3" Text="Null" Style="{StaticResource HeaderText}" />
                                <TextBlock Grid.Column="4" Text="Mặc định" Style="{StaticResource HeaderText}" />
                                <TextBlock Grid.Column="5" Text="Khoá" Style="{StaticResource HeaderText}" />
                                <TextBlock Grid.Column="6" Text="Ghi chú" Style="{StaticResource HeaderText}" />
                            </Grid>
                            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.DetailColumns}" ItemContainerStyle="{StaticResource RowItem}"
                                      AutomationProperties.AutomationId="ColumnList" AutomationProperties.Name="Cột">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ColumnRow">
                                        <Grid ColumnSpacing="10" AutomationProperties.Name="{x:Bind Name}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="72" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Number}" Opacity="0.6" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                       IsTextSelectionEnabled="True" ToolTipService.ToolTip="{x:Bind Name}" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind Type}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontFamily="Consolas"
                                                       ToolTipService.ToolTip="{x:Bind Type}" />
                                            <TextBlock Grid.Column="3" Text="{x:Bind Null}" FontSize="12" VerticalAlignment="Center" Opacity="0.8" />
                                            <TextBlock Grid.Column="4" Text="{x:Bind Default}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontFamily="Consolas" FontSize="12"
                                                       ToolTipService.ToolTip="{x:Bind Default}" />
                                            <TextBlock Grid.Column="5" Text="{x:Bind Key}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" ToolTipService.ToolTip="{x:Bind Key}" />
                                            <TextBlock Grid.Column="6" Text="{x:Bind Comment}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                       ToolTipService.ToolTip="{x:Bind Comment}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                    <!-- Index -->
                    <Border Style="{StaticResource ListBorder}" Visibility="{x:Bind views:Ui.TabVisible(ViewModel.DetailTab, 1), Mode=OneWay}">
                        <ListView ItemsSource="{x:Bind ViewModel.DetailIndexes}" ItemContainerStyle="{StaticResource RowItem}" AutomationProperties.AutomationId="IndexList">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:IndexRow">
                                    <StackPanel Padding="0,6" Spacing="2" AutomationProperties.Name="{x:Bind Name}">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" IsTextSelectionEnabled="True" />
                                            <TextBlock Text="{x:Bind Kind}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            <TextBlock Text="{x:Bind Size}" Opacity="0.6" />
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Definition}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" Opacity="0.85" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                    <!-- Ràng buộc -->
                    <Border Style="{StaticResource ListBorder}" Visibility="{x:Bind views:Ui.TabVisible(ViewModel.DetailTab, 2), Mode=OneWay}">
                        <ListView ItemsSource="{x:Bind ViewModel.DetailConstraints}" ItemContainerStyle="{StaticResource RowItem}" AutomationProperties.AutomationId="ConstraintList">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:ConstraintRow">
                                    <StackPanel Padding="0,6" Spacing="2" AutomationProperties.Name="{x:Bind Name}">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" IsTextSelectionEnabled="True" />
                                            <TextBlock Text="{x:Bind Kind}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Definition}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" Opacity="0.85" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                    <!-- Trigger -->
                    <Border Style="{StaticResource ListBorder}" Visibility="{x:Bind views:Ui.TabVisible(ViewModel.DetailTab, 3), Mode=OneWay}">
                        <ListView ItemsSource="{x:Bind ViewModel.DetailTriggers}" ItemContainerStyle="{StaticResource RowItem}" AutomationProperties.AutomationId="TriggerList">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:TriggerRow">
                                    <StackPanel Padding="0,6" Spacing="2" AutomationProperties.Name="{x:Bind Name}">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" IsTextSelectionEnabled="True" />
                                            <TextBlock Text="{x:Bind State}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            <TextBlock Text="{x:Bind Function}" Opacity="0.7" />
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Definition}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" Opacity="0.85" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                    <!-- DDL -->
                    <TextBox Style="{StaticResource Code}" Text="{x:Bind ViewModel.Ddl, Mode=OneWay}" AutomationProperties.AutomationId="DdlBox"
                             AutomationProperties.Name="DDL" Visibility="{x:Bind views:Ui.TabVisible(ViewModel.DetailTab, 4), Mode=OneWay}" />
                </Grid>
            </Grid>

            <!-- ===== Đối tượng khác ===== -->
            <Grid RowSpacing="6" Visibility="{x:Bind views:Ui.TabVisible(ViewModel.Tab, 2), Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="100" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="100" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <SelectorBar SelectionChanged="ObjectKinds_SelectionChanged" AutomationProperties.AutomationId="ObjectKinds">
                        <SelectorBarItem Text="View" IsSelected="True" />
                        <SelectorBarItem Text="Hàm / procedure" />
                        <SelectorBarItem Text="Trigger" />
                        <SelectorBarItem Text="Sequence" />
                        <SelectorBarItem Text="Extension" />
                    </SelectorBar>
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ObjectsSummary, Mode=OneWay}" Opacity="0.7" VerticalAlignment="Center" HorizontalAlignment="Right"
                               AutomationProperties.AutomationId="ObjectsSummary" />
                </Grid>
                <Border Grid.Row="1" Style="{StaticResource ListBorder}">
                    <ListView ItemsSource="{x:Bind ViewModel.Objects}" SelectedItem="{x:Bind ViewModel.SelectedObject, Mode=TwoWay}"
                              ItemContainerStyle="{StaticResource RowItem}" AutomationProperties.AutomationId="ObjectList" AutomationProperties.Name="Đối tượng">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ObjectRow">
                                <Grid ColumnSpacing="10" AutomationProperties.Name="{x:Bind FullName}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind FullName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind FullName}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Info}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Opacity="0.8"
                                               FontFamily="Consolas" FontSize="12" ToolTipService.ToolTip="{x:Bind Info}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Comment}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Opacity="0.8"
                                               ToolTipService.ToolTip="{x:Bind Comment}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
                <Grid Grid.Row="2">
                    <TextBlock Text="Định nghĩa" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button HorizontalAlignment="Right" Content="Copy" Command="{x:Bind ViewModel.CopyDefinitionCommand}" AutomationProperties.AutomationId="CopyDefinitionButton" />
                </Grid>
                <TextBox Grid.Row="3" Style="{StaticResource Code}" Text="{x:Bind ViewModel.ObjectDefinition, Mode=OneWay}"
                         AutomationProperties.AutomationId="DefinitionBox" AutomationProperties.Name="Định nghĩa" />
            </Grid>
        </Grid>
    </Grid>
    </ScrollViewer>
</Page>

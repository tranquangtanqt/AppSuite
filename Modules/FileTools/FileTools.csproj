<Project Sdk="Microsoft.NET.Sdk">
  <!--
    FileTools is a fully standalone WinUI 3 app: it opens, builds and runs on its own (right-click
    FileTools.csproj > Set as Startup Project, or `dotnet run` from this folder). It only references
    Common for the shared IModuleInfo-style contracts/logging - never MainLauncher.
  -->

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="System.Text.Encoding.CodePages" />
    <PackageReference Include="System.IO.Hashing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Common\Common.csproj" />
    <ProjectReference Include="..\..\SharedUI\SharedUI.csproj" />
  </ItemGroup>
</Project>

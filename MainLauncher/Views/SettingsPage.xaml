<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MainLauncher.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:MainLauncher.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Padding="24" Spacing="16" MaxWidth="700" HorizontalAlignment="Left">
        <TextBlock Text="Cài đặt" Style="{StaticResource TitleLargeTextBlockStyle}" />

        <StackPanel Spacing="4">
            <TextBlock Text="Thư mục cài đặt" FontWeight="SemiBold" />
            <TextBlock Text="{x:Bind ViewModel.BaseDirectory}" TextWrapping="Wrap" Opacity="0.8" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="File cấu hình module" FontWeight="SemiBold" />
            <TextBlock Text="{x:Bind ViewModel.ModulesConfigPath}" TextWrapping="Wrap" Opacity="0.8" />
        </StackPanel>

        <Button Content="Tải lại modules.json" Command="{x:Bind ViewModel.ReloadModulesCommand}" />

        <!-- Đóng MainLauncher mà còn module đang chạy (thứ tự mục = enum CloseModulesOnExit) -->
        <RadioButtons x:Name="CloseModulesOnExitRadio" Header="Khi đóng MainLauncher mà còn module đang chạy" Margin="0,8,0,0"
                      SelectedIndex="{x:Bind ViewModel.CloseModulesOnExitIndex, Mode=TwoWay}">
            <x:String>Hỏi mỗi lần (Đóng hết / Để chạy tiếp)</x:String>
            <x:String>Luôn đóng hết các module</x:String>
            <x:String>Luôn để các module chạy tiếp</x:String>
        </RadioButtons>

        <!-- Ẩn / hiện module ở Dashboard và Module List (cùng lựa chọn với nút "Ẩn / hiện" ở 2 trang đó) -->
        <StackPanel Spacing="6" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="Module hiện trên màn hình" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text="{x:Bind ViewModel.Dashboard.VisibleSummary, Mode=OneWay}" Opacity="0.6" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="Bỏ tích để ẩn module khỏi trang Tổng quan và Danh sách module (danh sách này luôn đủ để bật lại). Lưu ngay vào Config\launcher-settings.json; module đang ẩn mà đang chạy vẫn hiện tạm để bấm Dừng được."
                       TextWrapping="Wrap" Opacity="0.7" FontSize="12" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.Dashboard.VisibilityItems}" Margin="0,4,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ModuleVisibilityItem">
                        <CheckBox IsChecked="{x:Bind IsVisible, Mode=TwoWay}" AutomationProperties.Name="{x:Bind Name}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{x:Bind Name}" />
                                <TextBlock Text="{x:Bind Description}" Opacity="0.6" TextTrimming="CharacterEllipsis" MaxWidth="360" />
                            </StackPanel>
                        </CheckBox>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="Hiện tất cả" Command="{x:Bind ViewModel.Dashboard.ShowAllModulesCommand}" />
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</Page>

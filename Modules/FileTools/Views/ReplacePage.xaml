<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FileTools.Views.ReplacePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:FileTools.Views"
    NavigationCacheMode="Required">

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
    <Grid x:Name="Root" Padding="24,16" RowSpacing="12" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" MinHeight="440" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="140" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="2">
            <TextBlock Text="Thay thế hàng loạt" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock Opacity="0.7" TextWrapping="Wrap"
                       Text="Tìm và thay chữ / regex trên nhiều file. Bấm Xem trước để đếm số chỗ thay từng file (chưa ghi gì), rồi mới Thay thế. Giữ nguyên encoding và kiểu xuống dòng của từng file; thay theo từng dòng." />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox Header="Tìm" Text="{x:Bind ViewModel.Find, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBox Grid.Column="1" Header="Thay bằng (regex: dùng được $1, $2...)" Text="{x:Bind ViewModel.Replacement, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="20">
            <CheckBox Content="Phân biệt hoa / thường" IsChecked="{x:Bind ViewModel.MatchCase, Mode=TwoWay}" />
            <CheckBox Content="Chỉ nguyên từ" IsChecked="{x:Bind ViewModel.WholeWord, Mode=TwoWay}" />
            <CheckBox Content="Regex" IsChecked="{x:Bind ViewModel.IsRegex, Mode=TwoWay}" />
        </StackPanel>

        <views:BatchFilesPanel Grid.Row="3" Batch="{x:Bind ViewModel}" DetailHeader="Số chỗ sẽ thay" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8">
            <Button Content="Xem trước" MinWidth="110" Command="{x:Bind ViewModel.PreviewCommand}" />
            <Button Content="Thay thế" MinWidth="110" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.ConvertCommand}" />
        </StackPanel>

        <views:JobPanel Grid.Row="5" Job="{x:Bind ViewModel}" />
    </Grid>
    </ScrollViewer>
</Page>

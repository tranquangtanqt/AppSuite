<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MeRon.Views.ProductsPage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MeRon.ViewModels"
    xmlns:local="using:MeRon.Views">

    <Grid Padding="24,12,24,16" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="8">
            <!-- Ô tìm co lại khi cửa sổ hẹp (tối đa 320), không che tên trang / số mục. -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" MaxWidth="320" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Món ăn" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <Border Grid.Column="1" VerticalAlignment="Center" Margin="16,4,0,0" CornerRadius="14" Padding="12,3,12,4" Background="#26E8590C"><TextBlock Text="{x:Bind ViewModel.CountText, Mode=OneWay}" AutomationProperties.AutomationId="CountText" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" /></Border>
            <TextBox x:Name="SearchBox" Grid.Column="3" PlaceholderText="Tìm theo tên món" AutomationProperties.Name="Tìm món ăn"
                     Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="4" Style="{StaticResource AccentButtonStyle}" Click="Add_Click" AutomationProperties.Name="Thêm món ăn">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <SymbolIcon Symbol="Add" />
                    <TextBlock Text="Thêm" />
                </StackPanel>
            </Button>
        </Grid>

        <InfoBar Grid.Row="1" Severity="Error" IsClosable="False" Message="{x:Bind ViewModel.LoadError, Mode=OneWay}"
                 IsOpen="{x:Bind local:Ui.HasText(ViewModel.LoadError), Mode=OneWay}" />

        <Border Grid.Row="2" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
        <Grid RowSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Padding="16,10" ColumnSpacing="12" Background="{ThemeResource LayerFillColorAltBrush}" CornerRadius="10,10,0,0" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="STT" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="Tên" FontWeight="SemiBold" />
                <TextBlock Grid.Column="2" Text="Giá" FontWeight="SemiBold" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="3" Text="Danh mục" FontWeight="SemiBold" />
                <TextBlock Grid.Column="4" Text="Mô tả" FontWeight="SemiBold" />
            </Grid>
            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Items}" SelectionMode="Single"
                      IsItemClickEnabled="True" ItemClick="List_ItemClick" AutomationProperties.Name="Danh sách món ăn">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="Padding" Value="16,0" />
                        <Setter Property="MinHeight" Value="42" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProductRow">
                        <Grid ColumnSpacing="12" AutomationProperties.Name="{x:Bind Item.Name}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Index}" Opacity="0.6" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Item.Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{x:Bind local:Format.Money(Item.Price)}" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            <Border Grid.Column="3" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="11" Padding="10,2,10,3" Background="#261C7ED6" Visibility="{x:Bind local:Ui.VisibleIfText(CategoryName)}"><TextBlock Text="{x:Bind CategoryName}" FontSize="13" Foreground="#1C7ED6" TextTrimming="CharacterEllipsis" /></Border>
                            <TextBlock Grid.Column="4" Text="{x:Bind Item.Description}" TextTrimming="CharacterEllipsis" Opacity="0.8" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
        </Border>
    </Grid>
</Page>

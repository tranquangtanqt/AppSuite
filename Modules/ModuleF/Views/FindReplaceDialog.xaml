<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="ModuleF.Views.FindReplaceDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Tìm kiếm / Thay thế"
    PrimaryButtonText="Đóng"
    DefaultButton="Primary">

    <StackPanel Spacing="10" MinWidth="360">
        <TextBox x:Name="FindTextBox" Header="Tìm" TextChanged="FindTextBox_TextChanged" />

        <ComboBox x:Name="ModeComboBox" Header="Kiểu tìm" HorizontalAlignment="Stretch"
                  SelectionChanged="ModeComboBox_SelectionChanged">
            <ComboBoxItem Content="Chứa (Contains)" />
            <ComboBoxItem Content="Khớp toàn bộ (Equals)" />
            <ComboBoxItem Content="Bắt đầu bằng (StartsWith)" />
            <ComboBoxItem Content="Kết thúc bằng (EndsWith)" />
            <ComboBoxItem Content="Regex" />
        </ComboBox>

        <CheckBox x:Name="CaseSensitiveCheckBox" Content="Phân biệt hoa/thường" Checked="CaseSensitiveCheckBox_Changed" Unchecked="CaseSensitiveCheckBox_Changed" />

        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="PreviousButton" Content="◀ Trước" Click="PreviousButton_Click" />
            <Button x:Name="NextButton" Content="Sau ▶" Click="NextButton_Click" />
            <TextBlock x:Name="MatchStatusText" VerticalAlignment="Center" Opacity="0.8" />
        </StackPanel>

        <TextBox x:Name="ReplaceTextBox" Header="Thay bằng" />
        <Button x:Name="ReplaceAllButton" Content="Thay thế tất cả kết quả" Click="ReplaceAllButton_Click" HorizontalAlignment="Left" />
        <TextBlock x:Name="ReplaceStatusText" Opacity="0.8" />
    </StackPanel>
</ContentDialog>

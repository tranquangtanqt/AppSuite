<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DbTools.Views.ServerLogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:DbTools.Views"
    xmlns:vm="using:DbTools.ViewModels"
    xmlns:core="using:DbTools.Core"
    xmlns:models="using:DbTools.Models"
    xmlns:shared="using:SharedUI.Controls"
    NavigationCacheMode="Required">

    <Grid Padding="24,12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Tiêu đề + nút Cấu hình log (bấm mở chi tiết bằng lời). Cửa sổ ~600 px cao: dồn gọn để danh sách đủ chỗ. -->
        <Grid Margin="0,0,48,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Nhật ký server" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center"
                       ToolTipService.ToolTip="Đọc file log của server PostgreSQL qua SQL (chỉ đọc): ai chạy câu gì, lúc nào, từ máy nào, lỗi gì. Cần superuser (hoặc pg_monitor + pg_read_server_files)." />
            <Button Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="10,4"
                    Visibility="{x:Bind views:Ui.VisibleIfText(ViewModel.ConfigSummary), Mode=OneWay}"
                    AutomationProperties.AutomationId="LogConfig" ToolTipService.ToolTip="Server ghi những gì, giữ bao lâu, đủ quyền đọc không">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="{x:Bind views:Ui.WarnBrush(ViewModel.ConfigWarning), Mode=OneWay}"
                              Visibility="{x:Bind views:Ui.VisibleIf(ViewModel.ConfigWarning), Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.ConfigSummary, Mode=OneWay}" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="LogConfigSummary" />
                </StackPanel>
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedLeft">
                        <!-- Khung flyout mặc định rộng tối đa ~456: nới ra để câu giải thích không bị cắt -->
                        <Flyout.FlyoutPresenterStyle>
                            <Style TargetType="FlyoutPresenter">
                                <Setter Property="MaxWidth" Value="680" />
                            </Style>
                        </Flyout.FlyoutPresenterStyle>
                        <ScrollViewer MaxWidth="640" MaxHeight="420">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.ConfigLines}" AutomationProperties.AutomationId="LogConfigLines">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="core:LogConfigLine">
                                        <Grid ColumnSpacing="6" Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind views:Ui.ConfigBullet(Warning)}" Foreground="{x:Bind views:Ui.WarnBrush(Warning)}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Text}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <!-- Server · file log · đọc bao nhiêu · nút -->
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="320" />
                <ColumnDefinition Width="*" MaxWidth="380" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox HorizontalAlignment="Stretch" views:ProfilePicker.Selected="{x:Bind ViewModel.Profile, Mode=TwoWay}"
                      PlaceholderText="(chưa có kết nối)" AutomationProperties.Name="Server" AutomationProperties.AutomationId="LogProfileBox"
                      ToolTipService.ToolTip="Server (hồ sơ kết nối) - đọc qua database bảo trì postgres">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="models:ConnectionProfile">
                        <TextBlock Text="{x:Bind PickerText, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.Files}" SelectedItem="{x:Bind ViewModel.File, Mode=TwoWay}"
                      PlaceholderText="(bấm Làm mới để lấy danh sách file)" AutomationProperties.Name="File log" AutomationProperties.AutomationId="LogFileBox"
                      ToolTipService.ToolTip="File trong thư mục log của server, mới sửa nhất ở trên; 'đang ghi' = file server đang ghi">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:LogFileItem">
                        <TextBlock Text="{x:Bind Display}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <ComboBox x:Name="SizeBox" Grid.Column="2" SelectedIndex="{x:Bind ViewModel.ReadSizeIndex, Mode=TwoWay}" MinWidth="120"
                      AutomationProperties.Name="Đọc bao nhiêu" ToolTipService.ToolTip="File lớn: chỉ đọc phần cuối (mới nhất)" />
            <Button Grid.Column="3" Content="Làm mới" Command="{x:Bind ViewModel.RefreshCommand}" AutomationProperties.AutomationId="LogRefresh"
                    ToolTipService.ToolTip="Đọc lại cấu hình log + danh sách file, rồi đọc file server đang ghi" />
            <Button Grid.Column="4" Content="Đọc file" Style="{StaticResource CompactAccentButtonStyle}" Command="{x:Bind ViewModel.ReadCommand}"
                    AutomationProperties.AutomationId="LogRead" ToolTipService.ToolTip="Đọc file đang chọn (đọc lại để thấy dòng mới)" />
            <Button Grid.Column="5" Content="{x:Bind ViewModel.FollowText, Mode=OneWay}" Command="{x:Bind ViewModel.FollowCommand}" MinWidth="96"
                    AutomationProperties.AutomationId="LogFollow"
                    ToolTipService.ToolTip="Mỗi 2 giây đọc phần mới của file server đang ghi, dòng mới hiện cuối bảng (tự cuộn nếu đang ở cuối); server sang file mới thì tự đọc sang. Bấm lại để dừng." />
        </Grid>

        <!-- Lọc: chữ trong SQL / thông báo, user, database, máy / ứng dụng; nút Loại (ô tích từng loại + ẩn câu của DbTools) -->
        <shared:WrapPanel Grid.Row="2" Spacing="8">
            <TextBox Width="200" PlaceholderText="Tìm trong câu SQL / thông báo" Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Tìm trong SQL" />
            <TextBox Width="100" PlaceholderText="User" Text="{x:Bind ViewModel.UserText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Lọc user" />
            <TextBox Width="110" PlaceholderText="Database" Text="{x:Bind ViewModel.DatabaseText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Lọc database" />
            <TextBox Width="150" PlaceholderText="Máy / IP / ứng dụng" Text="{x:Bind ViewModel.ClientText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Lọc máy" />
            <DropDownButton Content="{x:Bind ViewModel.KindsSummary, Mode=OneWay}" AutomationProperties.AutomationId="LogKinds"
                            ToolTipService.ToolTip="Chọn loại dòng hiện (kèm số dòng mỗi loại); ẩn / hiện câu của chính DbTools">
                <DropDownButton.Flyout>
                    <Flyout Placement="BottomEdgeAlignedLeft">
                        <StackPanel Spacing="2">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Kinds}" AutomationProperties.Name="Loại dòng">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LogKindOption">
                                        <CheckBox Content="{x:Bind Text, Mode=OneWay}" IsChecked="{x:Bind IsChecked, Mode=TwoWay}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <MenuFlyoutSeparator />
                            <CheckBox Content="Ẩn câu của DbTools" IsChecked="{x:Bind ViewModel.HideOwn, Mode=TwoWay}" AutomationProperties.AutomationId="LogHideOwn"
                                      ToolTipService.ToolTip="Ẩn các câu DbTools chạy để đọc log (application_name = AppSuite DbTools)" />
                        </StackPanel>
                    </Flyout>
                </DropDownButton.Flyout>
            </DropDownButton>
        </shared:WrapPanel>

        <Border Grid.Row="3" BorderThickness="1" CornerRadius="4" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Padding="12,6" ColumnSpacing="10" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="104" />
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- Bấm tiêu đề Giờ: đổi cũ trước ↔ mới trước (nhớ cho lần sau) -->
                    <Button Content="{x:Bind ViewModel.TimeHeader, Mode=OneWay}" Command="{x:Bind ViewModel.ToggleSortCommand}" FontWeight="SemiBold"
                            Padding="0" Margin="0,-2" MinHeight="0" Background="Transparent" BorderThickness="0"
                            AutomationProperties.AutomationId="LogSortTime" ToolTipService.ToolTip="{x:Bind ViewModel.TimeHeaderTip, Mode=OneWay}" />
                    <TextBlock Grid.Column="1" Text="Loại" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="User · DB" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="3" Text="Máy · ứng dụng" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="4" Text="ms" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="5" Text="Câu SQL / thông báo" FontWeight="SemiBold" />
                </Grid>
                <ListView x:Name="LogList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Rows}" SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}"
                          AutomationProperties.AutomationId="LogList" AutomationProperties.Name="Nhật ký server">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="MinHeight" Value="30" />
                            <Setter Property="Padding" Value="12,0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:LogRow">
                            <Grid ColumnSpacing="10" AutomationProperties.Name="{x:Bind Text}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="104" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Time}" VerticalAlignment="Center" Opacity="0.85" />
                                <TextBlock Grid.Column="1" Text="{x:Bind KindText}" VerticalAlignment="Center" FontWeight="SemiBold"
                                           Foreground="{x:Bind views:Ui.LogKindBrush(Kind)}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Who}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="3" Text="{x:Bind Where}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Opacity="0.85" />
                                <TextBlock Grid.Column="4" Text="{x:Bind Ms}" VerticalAlignment="Center" HorizontalAlignment="Right" Opacity="0.85" />
                                <TextBlock Grid.Column="5" Text="{x:Bind Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           FontFamily="Consolas" FontSize="12" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock Grid.Row="1" Text="Chưa có dòng nào - bấm Làm mới (hoặc nới bộ lọc)." Opacity="0.6" HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsHitTestVisible="False" Visibility="{x:Bind views:Ui.VisibleIf(ViewModel.IsEmpty), Mode=OneWay}" />
            </Grid>
        </Border>

        <!-- Chi tiết dòng đang chọn: đủ câu SQL, tham số, chi tiết lỗi (chọn / chép được) -->
        <TextBox Grid.Row="4" Text="{x:Bind ViewModel.Detail, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                 FontFamily="Consolas" FontSize="12" Height="120" ScrollViewer.VerticalScrollBarVisibility="Auto"
                 Visibility="{x:Bind views:Ui.VisibleIfText(ViewModel.Detail), Mode=OneWay}"
                 AutomationProperties.Name="Chi tiết dòng log" AutomationProperties.AutomationId="LogDetail" />

        <Grid Grid.Row="5" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind ViewModel.CountText, Mode=OneWay}" VerticalAlignment="Center" FontWeight="SemiBold" AutomationProperties.AutomationId="LogCount" />
            <!-- Trạng thái đọc / xuất: 1 dòng, rê chuột xem đủ -->
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Status, Mode=OneWay}" VerticalAlignment="Center" Opacity="0.8" TextTrimming="CharacterEllipsis"
                       ToolTipService.ToolTip="{x:Bind ViewModel.Status, Mode=OneWay}" AutomationProperties.AutomationId="LogStatus" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                <Button Content="Xuất CSV" Command="{x:Bind ViewModel.ExportCsvCommand}" AutomationProperties.AutomationId="LogExportCsv"
                        ToolTipService.ToolTip="Các dòng đang hiện → file CSV (mở bằng CsvEditor / Excel) trong &lt;thư mục dump&gt;\NhatKyServer" />
                <Button Content="Xuất TXT" Command="{x:Bind ViewModel.ExportTextCommand}" AutomationProperties.AutomationId="LogExportTxt"
                        ToolTipService.ToolTip="Các dòng đang hiện, đúng nguyên văn log (mật khẩu đã che)" />
                <Button Content="Mở thư mục" Command="{x:Bind ViewModel.OpenExportFolderCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>

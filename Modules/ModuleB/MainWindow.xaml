<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ModuleB.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ModuleB"
    xmlns:models="using:ModuleB.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Module B">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Padding="12">
        <Grid.Resources>
            <Style x:Key="PlusMinusTreeViewItemStyle" TargetType="TreeViewItem">
                <Setter Property="CollapsedGlyph" Value="&#xE710;" />
                <Setter Property="ExpandedGlyph" Value="&#xE738;" />
            </Style>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left: folder explorer -->
        <Grid Grid.Column="0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Padding="8" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Explorer" VerticalAlignment="Center" FontWeight="SemiBold" />
                <ProgressRing Grid.Column="1" IsActive="{x:Bind ViewModel.IsIndexing, Mode=OneWay}"
                              ToolTipService.ToolTip="Dang lap chi muc file Excel..." Width="16" Height="16" />
            </Grid>

            <TreeView x:Name="FolderTreeView" Grid.Row="1" Padding="4" SelectionMode="Single"
                      Expanding="FolderTreeView_Expanding" SelectionChanged="FolderTreeView_SelectionChanged"
                      ItemContainerStyle="{StaticResource PlusMinusTreeViewItemStyle}">
                <TreeView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8B7;" FontSize="16" />
                            <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <Button Grid.Row="2" Margin="8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="SettingsButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE713;" FontSize="16" />
                    <TextBlock Text="Cai dat thu muc" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Right: search + results -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Margin="0,0,0,8" TextWrapping="Wrap" Opacity="0.8"
                       Text="Hay nhap noi dung can tim kiem. Ban co the ket hop voi toan tu AND hoac OR de ho tro cho viec tim kiem tot hon." />

            <Grid Grid.Row="1" Margin="0,0,0,8" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="GroupFilterBox" Grid.Column="0" PlaceholderText="Loc theo GROUP / thu muc (vd: 10.PD AND ban hang)"
                         Text="{x:Bind ViewModel.GroupFilter, Mode=TwoWay}">
                    <TextBox.Header>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE71C;" FontSize="14" />
                            <TextBlock Text="Nhom / thu muc" />
                        </StackPanel>
                    </TextBox.Header>
                </TextBox>
                <Button Grid.Column="1" Content="Xóa" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.ClearCommand}" />
            </Grid>

            <Grid Grid.Row="2" Margin="0,0,0,8" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="KeywordQueryBox" Grid.Column="0" PlaceholderText="Tu khoa noi dung file (vd: GetBunData)"
                         Text="{x:Bind ViewModel.KeywordQuery, Mode=TwoWay}">
                    <TextBox.Header>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE721;" FontSize="14" />
                            <TextBlock Text="Nội dung tìm kiếm" />
                        </StackPanel>
                    </TextBox.Header>
                </TextBox>
                <Button Grid.Column="1" Content="Tìm kiếm" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Bottom"
                        Command="{x:Bind ViewModel.SearchCommand}" />
            </Grid>

            <Border Grid.Row="3" Margin="0,0,0,0" Padding="12,6" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="DANH SACH FILE" FontWeight="SemiBold" />
                    <ProgressRing IsActive="{x:Bind ViewModel.IsSearching, Mode=OneWay}" Width="16" Height="16" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Padding="12,8" ColumnSpacing="12" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Thư mục" FontWeight="SemiBold" Opacity="0.8" />
                    <TextBlock Grid.Column="1" Text="Tên file" FontWeight="SemiBold" Opacity="0.8" />
                </Grid>

                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Results}" SelectionMode="Single"
                          IsItemClickEnabled="True" ItemClick="ResultsListView_ItemClick">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:SearchResultItem">
                            <Grid Padding="12,8" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Open File" Tag="{x:Bind FullPath}" Click="OpenFileMenuItem_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE8E5;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Grid.ContextFlyout>
                                <TextBlock Grid.Column="0" Text="{x:Bind GroupName}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="{x:Bind IconGlyph}" Foreground="{x:Bind IconBrush}" FontSize="16" />
                                    <TextBlock Text="{x:Bind FileName}" VerticalAlignment="Center" TextWrapping="NoWrap" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
    </Grid>
</Window>

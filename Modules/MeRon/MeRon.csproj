<Project Sdk="Microsoft.NET.Sdk">
  <!--
    MeRon is a fully standalone WinUI 3 app: it opens, builds and runs on its own (right-click
    MeRon.csproj > Set as Startup Project, or `dotnet run` from this folder). It only references
    Common for the shared IModuleInfo-style contracts/logging - never MainLauncher.

    Core\ không phụ thuộc WinUI (database, import TSV, nghiệp vụ) - Tests\MeRon.Tests biên dịch kèm trực tiếp.
  -->

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

  <ItemGroup>
    <!-- OAuth client Google (Desktop app) cho Đăng nhập + tải backup lên Drive: chỉ có trên máy đã đặt file, không commit
         (.gitignore client_secret*.json); không có file thì nút Đăng nhập báo "chưa cấu hình". -->
    <Content Include="Assets\client_secret*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Common\Common.csproj" />
    <ProjectReference Include="..\..\SharedUI\SharedUI.csproj" />
  </ItemGroup>
</Project>

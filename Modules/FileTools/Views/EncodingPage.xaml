<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FileTools.Views.EncodingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:FileTools.Views"
    xmlns:vm="using:FileTools.ViewModels"
    NavigationCacheMode="Required">

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
    <Grid x:Name="Root" Padding="24,16" RowSpacing="12" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" MinHeight="440" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="2">
            <TextBlock Text="Đổi encoding (hàng loạt)" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock Opacity="0.7" TextWrapping="Wrap"
                       Text="Chuyển nhiều file sang 1 encoding (vd Shift-JIS → UTF-8). Cột bên phải là encoding tự nhận của từng file. Ký tự không có trong encoding đích sẽ được báo trong nhật ký. Kéo-thả file / thư mục vào danh sách." />
        </StackPanel>

        <views:BatchFilesPanel Grid.Row="1" Batch="{x:Bind ViewModel}" DetailHeader="Encoding hiện tại" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="16">
            <ComboBox Header="Đọc file nguồn theo" MinWidth="190" ItemsSource="{x:Bind vm:EncodingViewModel.SourceEncodingNames}"
                      SelectedIndex="{x:Bind ViewModel.SourceEncodingIndex, Mode=TwoWay}" />
            <views:OutputPanel Settings="{x:Bind ViewModel.Output}" />
            <Button VerticalAlignment="Bottom" Content="Đổi encoding" MinWidth="120" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.ConvertCommand}" />
        </StackPanel>

        <views:JobPanel Grid.Row="3" Job="{x:Bind ViewModel}" />
    </Grid>
    </ScrollViewer>
</Page>

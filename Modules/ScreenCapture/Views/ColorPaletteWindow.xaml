<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ScreenCapture.Views.ColorPaletteWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Bảng màu - ScreenCapture">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!-- Bảng màu kiểu PicPick (2026-11-09): trái = màu có sẵn + màu tự chọn; phải = chọn màu (H / S / L, R / G / B, #);
         dưới = Hút màu, (mở từ Editor) Dùng làm Màu nét / Màu nền, định dạng + mã + Copy. -->
    <Grid Padding="16,12,16,16" RowSpacing="14" ColumnSpacing="24">
        <Grid.Resources>
            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,6,0,2" />
            </Style>
            <Style x:Key="ChannelLabelStyle" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Right" />
            </Style>
            <Style x:Key="ChannelBoxStyle" TargetType="NumberBox">
                <Setter Property="Width" Value="92" />
                <Setter Property="SpinButtonPlacementMode" Value="Compact" />
            </Style>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Trái: các ô màu dựng trong code (BuildSwatches). -->
        <StackPanel Spacing="4">
            <TextBlock Text="Màu chủ đề" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,2" />
            <StackPanel x:Name="ThemePanel" Spacing="6" />
            <TextBlock Text="Màu chuẩn" Style="{StaticResource SectionTitleStyle}" />
            <StackPanel x:Name="StandardPanel" Orientation="Horizontal" Spacing="4" />
            <TextBlock Text="Màu tự chọn" Style="{StaticResource SectionTitleStyle}" />
            <StackPanel x:Name="CustomPanel" Spacing="4" />
        </StackPanel>

        <!-- Phải: vùng Độ bão hoà × Độ sáng + thanh sắc màu + các ô số. -->
        <Grid Grid.Column="1" ColumnSpacing="10" RowSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Vùng màu luôn vuông: SpectrumHost_SizeChanged đặt cạnh = min(rộng, cao) của ô và cho thanh sắc màu cao bằng, cùng căn trên. -->
            <Border x:Name="SpectrumHost" SizeChanged="SpectrumHost_SizeChanged">
                <primitives:ColorSpectrum x:Name="Spectrum" Components="SaturationValue" Shape="Box" HorizontalAlignment="Left" VerticalAlignment="Top"
                                          ColorChanged="Spectrum_ColorChanged" AutomationProperties.Name="Vùng chọn màu" />
            </Border>

            <!-- Thanh sắc màu (Hue): bấm / kéo để đổi, tam giác bên trái chỉ sắc màu đang chọn. -->
            <Grid x:Name="HueColumn" Grid.Column="1" Width="30" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Canvas x:Name="HueMarkerCanvas">
                    <Polygon x:Name="HueMarker" Points="0,0 8,5 0,10" Fill="{ThemeResource TextFillColorPrimaryBrush}" />
                </Canvas>
                <Rectangle x:Name="HueBar" Grid.Column="1" Stroke="{ThemeResource CardStrokeColorDefaultBrush}" StrokeThickness="1"
                           PointerPressed="HueBar_PointerPressed" PointerMoved="HueBar_PointerMoved" PointerReleased="HueBar_PointerReleased"
                           SizeChanged="HueBar_SizeChanged" AutomationProperties.Name="Thanh sắc màu">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FF0000" Offset="0" />
                            <GradientStop Color="#FFFF00" Offset="0.1667" />
                            <GradientStop Color="#00FF00" Offset="0.3333" />
                            <GradientStop Color="#00FFFF" Offset="0.5" />
                            <GradientStop Color="#0000FF" Offset="0.6667" />
                            <GradientStop Color="#FF00FF" Offset="0.8333" />
                            <GradientStop Color="#FF0000" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
            </Grid>

            <StackPanel Grid.Column="2" Spacing="5">
                <Border Width="64" Height="48" HorizontalAlignment="Right" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Rectangle x:Name="PreviewSwatch" />
                </Border>
                <Grid ColumnSpacing="6" RowSpacing="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="H:" Style="{StaticResource ChannelLabelStyle}" ToolTipService.ToolTip="Sắc màu (0–255)" />
                    <NumberBox x:Name="HueBox" Grid.Column="1" Style="{StaticResource ChannelBoxStyle}" ValueChanged="HslBox_ValueChanged" AutomationProperties.Name="H" />
                    <TextBlock Grid.Row="1" Text="S:" Style="{StaticResource ChannelLabelStyle}" ToolTipService.ToolTip="Độ bão hoà (0–255)" />
                    <NumberBox x:Name="SatBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource ChannelBoxStyle}" ValueChanged="HslBox_ValueChanged" AutomationProperties.Name="S" />
                    <TextBlock Grid.Row="2" Text="L:" Style="{StaticResource ChannelLabelStyle}" ToolTipService.ToolTip="Độ sáng (0–255)" />
                    <NumberBox x:Name="LumBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource ChannelBoxStyle}" ValueChanged="HslBox_ValueChanged" AutomationProperties.Name="L" />
                    <TextBlock Grid.Row="3" Text="R:" Style="{StaticResource ChannelLabelStyle}" Margin="0,6,0,0" />
                    <NumberBox x:Name="RedBox" Grid.Row="3" Grid.Column="1" Style="{StaticResource ChannelBoxStyle}" Margin="0,6,0,0" ValueChanged="RgbBox_ValueChanged" AutomationProperties.Name="R" />
                    <TextBlock Grid.Row="4" Text="G:" Style="{StaticResource ChannelLabelStyle}" />
                    <NumberBox x:Name="GreenBox" Grid.Row="4" Grid.Column="1" Style="{StaticResource ChannelBoxStyle}" ValueChanged="RgbBox_ValueChanged" AutomationProperties.Name="G" />
                    <TextBlock Grid.Row="5" Text="B:" Style="{StaticResource ChannelLabelStyle}" />
                    <NumberBox x:Name="BlueBox" Grid.Row="5" Grid.Column="1" Style="{StaticResource ChannelBoxStyle}" ValueChanged="RgbBox_ValueChanged" AutomationProperties.Name="B" />
                    <TextBlock Grid.Row="6" Text="#" Style="{StaticResource ChannelLabelStyle}" Margin="0,6,0,0" />
                    <TextBox x:Name="HexBox" Grid.Row="6" Grid.Column="1" Width="92" Margin="0,6,0,0" MaxLength="7"
                             KeyDown="HexBox_KeyDown" LostFocus="HexBox_LostFocus" AutomationProperties.Name="Mã màu HTML"
                             ToolTipService.ToolTip="Gõ mã màu (vd 757369) rồi Enter" />
                </Grid>
            </StackPanel>

            <Button x:Name="AddCustomButton" Grid.Row="1" Grid.ColumnSpan="3" HorizontalAlignment="Stretch" Click="AddCustomButton_Click"
                    ToolTipService.ToolTip="Thêm màu đang chọn vào đầu Màu tự chọn (tối đa 20 màu, đầy thì bỏ màu cũ nhất)">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock Text="Thêm vào màu tự chọn" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Dưới: Hút màu | Dùng làm Màu nét / Màu nền (chỉ khi mở từ Editor) | định dạng + mã + Copy. -->
        <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="PickButton" Click="PickButton_Click" Style="{StaticResource CompactAccentButtonStyle}"
                    ToolTipService.ToolTip="Hút màu trên màn hình: bấm vào điểm cần lấy màu (Esc: huỷ). Mã màu tự copy.">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <!-- Ống hút màu -->
                    <Viewbox Width="16" Height="16">
                        <PathIcon Data="M13.6,0.6 C14.4,-0.2 15.8,-0.2 16.6,0.6 L17.4,1.4 C18.2,2.2 18.2,3.6 17.4,4.4 L14.9,6.9 L16,8 L14.6,9.4 L8.6,3.4 L10,2 L11.1,3.1 Z M7.9,4.8 L13.2,10.1 L5.3,18 L2.6,18.4 L1.7,19.3 L0.7,18.3 L1.6,17.4 L2,14.7 Z" />
                    </Viewbox>
                    <TextBlock Text="Hút màu" />
                </StackPanel>
            </Button>
            <StackPanel x:Name="EditorTargetPanel" Grid.Column="1" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                <Button x:Name="UseAsStrokeButton" Content="Dùng làm Màu nét" Click="UseAsStrokeButton_Click"
                        ToolTipService.ToolTip="Đặt màu đang chọn làm Màu nét của Editor (áp cả cho hình đang chọn)" />
                <Button x:Name="UseAsFillButton" Content="Dùng làm Màu nền" Click="UseAsFillButton_Click"
                        ToolTipService.ToolTip="Đặt màu đang chọn làm Màu nền của Editor (áp cả cho hình đang chọn)" />
            </StackPanel>
            <ComboBox x:Name="FormatBox" Grid.Column="3" Width="96" SelectionChanged="FormatBox_SelectionChanged"
                      AutomationProperties.Name="Định dạng mã màu" ToolTipService.ToolTip="Định dạng mã màu khi copy">
                <ComboBoxItem Content="HTML" />
                <ComboBoxItem Content="RGB" />
            </ComboBox>
            <TextBox x:Name="CodeBox" Grid.Column="4" Width="170" IsReadOnly="True" AutomationProperties.Name="Mã màu" />
            <Button x:Name="CopyButton" Grid.Column="5" Click="CopyButton_Click" MinWidth="96" ToolTipService.ToolTip="Copy mã màu">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                    <TextBlock x:Name="CopyButtonText" Text="Copy" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>

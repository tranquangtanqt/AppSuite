<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ScreenCapture.Views.EditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ScreenCapture.Views"
    xmlns:skia="using:SkiaSharp.Views.Windows"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="ScreenCapture - Editor">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!-- Kéo-thả file ảnh vào bất kỳ đâu trong Editor → mở thành tab mới. -->
    <Grid Padding="8" RowSpacing="0" Background="Transparent" AllowDrop="True" DragOver="Root_DragOver" Drop="Root_Drop">
        <Grid.Resources>
            <!-- Icon-on-top + small label toolbar button, dùng chung cho mọi nút trong toolbar
                 (ButtonBase để áp được cho cả Button lẫn ToggleButton). -->
            <Style x:Key="ToolButtonStyle" TargetType="ButtonBase">
                <Setter Property="Padding" Value="6,4" />
                <Setter Property="MinWidth" Value="46" />
            </Style>
            <!-- Nút nhỏ 1 hàng (icon + chữ), xếp 3 nút chồng nhau trong 1 cột như ribbon Office/PicPick - cho
                 các lệnh phụ (Xoá / Lên trên / Xuống dưới, Undo / Redo / Dán) để ribbon vừa màn hình ~1280px. -->
            <Style x:Key="SmallToolButtonStyle" TargetType="Button">
                <Setter Property="Padding" Value="6,0" />
                <Setter Property="Height" Value="21" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
            </Style>
            <Style x:Key="SmallToolButtonContentStyle" TargetType="StackPanel">
                <Setter Property="Orientation" Value="Horizontal" />
                <Setter Property="Spacing" Value="6" />
            </Style>
            <!-- Nút -/+ nhỏ hai bên ô số (Stamp Format), cao bằng NumberBox. -->
            <Style x:Key="StepperButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="26" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="ToolButtonContentStyle" TargetType="StackPanel">
                <Setter Property="Spacing" Value="2" />
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>
            <!-- Tab header ribbon (Trang chủ/Tệp) - ToggleButton phẳng, chỉ đổi nền lúc Checked
                 (theme resource mặc định), không cần ControlTemplate riêng. -->
            <Style x:Key="RibbonTabHeaderStyle" TargetType="ToggleButton">
                <Setter Property="Padding" Value="16,6" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="4,4,0,0" />
            </Style>
            <!-- Khung 1 nhóm nút trong ribbon content, có nhãn nhóm phía dưới giống PicPick. -->
            <Style x:Key="RibbonGroupStyle" TargetType="Border">
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="6,4" />
                <Setter Property="Margin" Value="0,0,4,0" />
            </Style>
            <Style x:Key="RibbonGroupLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10" />
                <Setter Property="Opacity" Value="0.65" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,2,0,0" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: tab header -->
        <StackPanel Orientation="Horizontal" Spacing="2" Grid.Row="0">
            <ToggleButton x:Name="HomeTabHeader" Content="Trang chủ" Style="{StaticResource RibbonTabHeaderStyle}"
                          IsChecked="True" Click="RibbonTabHeader_Click" />
            <ToggleButton x:Name="FileTabHeader" Content="Tệp" Style="{StaticResource RibbonTabHeaderStyle}"
                          Click="RibbonTabHeader_Click" />
            <ToggleButton x:Name="NumberStampTabHeader" Content="Number Stamp" Style="{StaticResource RibbonTabHeaderStyle}"
                          Click="RibbonTabHeader_Click" Visibility="Collapsed" />
            <ToggleButton x:Name="RegionTabHeader" Content="Vùng chọn" Style="{StaticResource RibbonTabHeaderStyle}"
                          Click="RibbonTabHeader_Click" Visibility="Collapsed" />
            <ToggleButton x:Name="FormatTabHeader" Content="Định dạng" Style="{StaticResource RibbonTabHeaderStyle}"
                          Click="RibbonTabHeader_Click" Visibility="Collapsed" />
        </StackPanel>
        <!-- Nút "?" góc phải hàng tab (giống nút Help của Office/PicPick). -->
        <Button x:Name="HelpHeaderButton" Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Center"
                Style="{StaticResource SmallToolButtonStyle}" Click="HelpButton_Click"
                ToolTipService.ToolTip="Hướng dẫn: tất cả tính năng và phím tắt (F1)">
            <FontIcon Glyph="&#xE897;" FontSize="16" />
        </Button>

        <!-- Row 1: ribbon content, đổi theo tab đang chọn -->
        <Border Grid.Row="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,6">
            <!-- Cửa sổ hẹp hơn ribbon (màn hình nhỏ / DPI cao) → cuộn ngang được thay vì mất hẳn các nhóm bên phải. -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled"
                          VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled">
            <Grid>
                <StackPanel x:Name="HomeRibbonPanel" Orientation="Horizontal">

                    <Border Style="{StaticResource RibbonGroupStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <ToggleButton x:Name="MoveToolButton" Style="{StaticResource ToolButtonStyle}" Click="MoveToolButton_Click">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <!-- Icon con trỏ chuột (như PicPick) - Segoe Fluent Icons không có glyph
                                             mũi tên con trỏ phù hợp nên vẽ bằng PathIcon. -->
                                        <Viewbox Width="16" Height="16" HorizontalAlignment="Center">
                                            <PathIcon Data="M0,0 L0,17 L4.2,13 L7.2,20 L10,18.8 L7,12 L12.5,12 Z" />
                                        </Viewbox>
                                        <TextBlock Text="Move" FontSize="10" />
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton x:Name="SelectToolButton" Style="{StaticResource ToolButtonStyle}" Click="SelectToolButton_Click"
                                              ToolTipService.ToolTip="Kéo chọn 1 vùng để Cắt ảnh / Copy / Cut / Xoá">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE8B3;" />
                                        <TextBlock Text="Select" FontSize="10" />
                                    </StackPanel>
                                </ToggleButton>
                                <StackPanel Spacing="1" VerticalAlignment="Center">
                                    <Button x:Name="DeleteButton" Style="{StaticResource SmallToolButtonStyle}" Click="DeleteButton_Click" IsEnabled="False"
                                            ToolTipService.ToolTip="Xoá hình đang chọn (Delete)">
                                        <StackPanel Style="{StaticResource SmallToolButtonContentStyle}">
                                            <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                            <TextBlock Text="Xoá" FontSize="11" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="BringToFrontButton" Style="{StaticResource SmallToolButtonStyle}" Click="BringToFrontButton_Click" IsEnabled="False">
                                        <StackPanel Style="{StaticResource SmallToolButtonContentStyle}">
                                            <FontIcon Glyph="&#xE8A7;" FontSize="12" />
                                            <TextBlock Text="Lên trên" FontSize="11" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="SendToBackButton" Style="{StaticResource SmallToolButtonStyle}" Click="SendToBackButton_Click" IsEnabled="False">
                                        <StackPanel Style="{StaticResource SmallToolButtonContentStyle}">
                                            <FontIcon Glyph="&#xE8A8;" FontSize="12" />
                                            <TextBlock Text="Xuống dưới" FontSize="11" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="Chọn" Style="{StaticResource RibbonGroupLabelStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource RibbonGroupStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <ToggleButton x:Name="RectangleToolButton" Style="{StaticResource ToolButtonStyle}" Click="RectangleToolButton_Click">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE739;" />
                                        <TextBlock Text="Chữ nhật" FontSize="10" />
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton x:Name="EllipseToolButton" Style="{StaticResource ToolButtonStyle}" Click="EllipseToolButton_Click">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xEA3B;" />
                                        <TextBlock Text="Elip" FontSize="10" />
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton x:Name="LineToolButton" Style="{StaticResource ToolButtonStyle}" Click="LineToolButton_Click"
                                              ToolTipService.ToolTip="Đường thẳng (giữ Shift: khoá góc 45°)">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <TextBlock Text="&#x2571;" FontSize="16" HorizontalAlignment="Center" />
                                        <TextBlock Text="Đường" FontSize="10" />
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton x:Name="ArrowToolButton" Style="{StaticResource ToolButtonStyle}" Click="ArrowToolButton_Click">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE72A;" />
                                        <TextBlock Text="Mũi tên" FontSize="10" />
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton x:Name="PenToolButton" Style="{StaticResource ToolButtonStyle}" Click="PenToolButton_Click"
                                              ToolTipService.ToolTip="Bút vẽ tự do - màu Color1, cỡ nét theo Size. Sửa nét đã vẽ bằng công cụ Move.">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xEE56;" />
                                        <TextBlock Text="Bút" FontSize="10" />
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton x:Name="HighlightToolButton" Style="{StaticResource ToolButtonStyle}" Click="HighlightToolButton_Click">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE7E6;" />
                                        <TextBlock Text="Highlight" FontSize="10" />
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton x:Name="TextToolButton" Style="{StaticResource ToolButtonStyle}" Click="TextToolButton_Click"
                                              ToolTipService.ToolTip="Bấm lên ảnh rồi gõ chữ ngay tại chỗ (Enter = xuống dòng, Esc / bấm ra ngoài = xong). Nhấp đúp chữ đã có để sửa. Phông, cỡ, đậm / nghiêng, nền, viền chữ ở tab Định dạng.">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE8D2;" />
                                        <TextBlock Text="Text" FontSize="10" />
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton x:Name="CalloutToolButton" Style="{StaticResource ToolButtonStyle}" Click="CalloutToolButton_Click"
                                              ToolTipService.ToolTip="Khung chú thích (bong bóng lời nói): kéo khung (hoặc bấm 1 cái) rồi gõ chữ; kéo chấm tròn ở đầu đuôi để chỉ vào chỗ cần chú thích. Viền + chữ màu Color1, nền Color2.">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE90A;" />
                                        <TextBlock Text="Chú thích" FontSize="10" />
                                    </StackPanel>
                                </ToggleButton>
                            </StackPanel>
                            <TextBlock Text="Vẽ hình" Style="{StaticResource RibbonGroupLabelStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource RibbonGroupStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <ToggleButton x:Name="FillToolButton" Style="{StaticResource ToolButtonStyle}" Click="FillToolButton_Click">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE8D3;" />
                                        <TextBlock Text="Tô màu" FontSize="10" />
                                    </StackPanel>
                                </ToggleButton>
                                <Button x:Name="StampsToolButton" Style="{StaticResource ToolButtonStyle}">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE73E;" />
                                        <TextBlock Text="Stamps" FontSize="10" />
                                    </StackPanel>
                                    <Button.Flyout>
                                        <Flyout x:Name="StampsFlyout" Placement="Bottom">
                                            <ScrollViewer MaxHeight="360" MaxWidth="340">
                                                <StackPanel Spacing="8">
                                                    <TextBlock Text="Number Stamps" FontWeight="SemiBold" />
                                                    <ItemsControl x:Name="NumberStampsList" ItemsSource="{x:Bind NumberStamps}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" Spacing="6" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="local:StampPickerItem">
                                                                <Button Padding="0" CornerRadius="16" Click="NumberStampItem_Click" Tag="{x:Bind Brush}">
                                                                    <Grid>
                                                                        <Ellipse Width="32" Height="32" Fill="{x:Bind Brush}" Stroke="White" StrokeThickness="2" />
                                                                        <TextBlock Text="1" Foreground="White" FontWeight="Bold"
                                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Grid>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <TextBlock Text="General Stamps" FontWeight="SemiBold" />
                                                    <ItemsControl x:Name="GeneralStampsList" ItemsSource="{x:Bind GeneralStamps}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="44" ItemHeight="44" MaximumRowsOrColumns="6" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="local:StampPickerItem">
                                                                <Button Width="40" Height="40" Padding="0" Click="StampItem_Click" Tag="{x:Bind Kind}">
                                                                    <FontIcon Glyph="{x:Bind Glyph}" Foreground="{x:Bind Brush}" RenderTransformOrigin="0.5,0.5">
                                                                        <FontIcon.RenderTransform>
                                                                            <RotateTransform Angle="{x:Bind Rotation}" />
                                                                        </FontIcon.RenderTransform>
                                                                    </FontIcon>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="Tô &amp; Dấu" Style="{StaticResource RibbonGroupLabelStyle}" />
                        </StackPanel>
                    </Border>

                    <!-- Che thông tin nhạy cảm (RedactAnnotation): kéo khung lên vùng cần che; Size = mức độ che. -->
                    <Border Style="{StaticResource RibbonGroupStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <ToggleButton x:Name="MosaicToolButton" Style="{StaticResource ToolButtonStyle}" Click="MosaicToolButton_Click"
                                              ToolTipService.ToolTip="Che bằng ô vuông pixel - kéo khung lên vùng cần che (mật khẩu, email...). Size = cỡ ô.">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE80A;" />
                                        <TextBlock Text="Mosaic" FontSize="10" />
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton x:Name="BlurToolButton" Style="{StaticResource ToolButtonStyle}" Click="BlurToolButton_Click"
                                              ToolTipService.ToolTip="Che bằng cách làm mờ - kéo khung lên vùng cần che. Size = độ mờ (chữ nhỏ nên để Size cao hoặc dùng Mosaic).">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xED1A;" />
                                        <TextBlock Text="Làm mờ" FontSize="10" />
                                    </StackPanel>
                                </ToggleButton>
                            </StackPanel>
                            <TextBlock Text="Che" Style="{StaticResource RibbonGroupLabelStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource RibbonGroupStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <ToggleButton x:Name="CropToolButton" Style="{StaticResource ToolButtonStyle}" Click="CropToolButton_Click">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE7A8;" />
                                        <TextBlock Text="Cắt" FontSize="10" />
                                    </StackPanel>
                                </ToggleButton>
                                <!-- Xoay / lật / co giãn cả ảnh (cùng các shape) - khác kéo khung ảnh (chỉ nới / cắt khung). -->
                                <Button x:Name="TransformButton" Style="{StaticResource ToolButtonStyle}"
                                        ToolTipService.ToolTip="Xoay, lật, đổi cỡ ảnh">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE7AD;" />
                                        <TextBlock Text="Xoay" FontSize="10" />
                                    </StackPanel>
                                    <Button.Flyout>
                                        <MenuFlyout Placement="Bottom">
                                            <MenuFlyoutItem x:Name="RotateRightItem" Text="Xoay phải 90°" Tag="RotateRight"
                                                            KeyboardAcceleratorTextOverride="Ctrl+R" Click="TransformItem_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE7AD;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem x:Name="RotateLeftItem" Text="Xoay trái 90°" Tag="RotateLeft"
                                                            KeyboardAcceleratorTextOverride="Ctrl+Shift+R" Click="TransformItem_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE7AD;" RenderTransformOrigin="0.5,0.5">
                                                        <FontIcon.RenderTransform>
                                                            <ScaleTransform ScaleX="-1" />
                                                        </FontIcon.RenderTransform>
                                                    </FontIcon>
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem x:Name="Rotate180Item" Text="Xoay 180°" Tag="Rotate180" Click="TransformItem_Click" />
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem x:Name="FlipHorizontalItem" Text="Lật ngang" Tag="FlipHorizontal" Click="TransformItem_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE8AB;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem x:Name="FlipVerticalItem" Text="Lật dọc" Tag="FlipVertical" Click="TransformItem_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE8AB;" RenderTransformOrigin="0.5,0.5">
                                                        <FontIcon.RenderTransform>
                                                            <RotateTransform Angle="90" />
                                                        </FontIcon.RenderTransform>
                                                    </FontIcon>
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem x:Name="ResizeImageItem" Text="Đổi cỡ ảnh…"
                                                            KeyboardAcceleratorTextOverride="Ctrl+E" Click="ResizeImageItem_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE740;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                                <StackPanel Spacing="1" VerticalAlignment="Center">
                                    <Button x:Name="UndoButton" Style="{StaticResource SmallToolButtonStyle}" Click="UndoButton_Click" ToolTipService.ToolTip="Undo (Ctrl+Z)">
                                        <StackPanel Style="{StaticResource SmallToolButtonContentStyle}">
                                            <FontIcon Glyph="&#xE7A7;" FontSize="12" />
                                            <TextBlock Text="Undo" FontSize="11" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="RedoButton" Style="{StaticResource SmallToolButtonStyle}" Click="RedoButton_Click" ToolTipService.ToolTip="Redo (Ctrl+Y / Ctrl+Shift+Z)">
                                        <StackPanel Style="{StaticResource SmallToolButtonContentStyle}">
                                            <FontIcon Glyph="&#xE7A6;" FontSize="12" />
                                            <TextBlock Text="Redo" FontSize="11" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="PasteButton" Style="{StaticResource SmallToolButtonStyle}" Click="PasteButton_Click" ToolTipService.ToolTip="Dán ảnh từ clipboard (Ctrl+V)">
                                        <StackPanel Style="{StaticResource SmallToolButtonContentStyle}">
                                            <FontIcon Glyph="&#xE77F;" FontSize="12" />
                                            <TextBlock Text="Dán" FontSize="11" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="Cắt &amp; Sửa" Style="{StaticResource RibbonGroupLabelStyle}" />
                        </StackPanel>
                    </Border>

                    <!-- Dùng chung cho tab Trang chủ và Định dạng: code chuyển nhóm này sang tab đang mở (SelectRibbonTab). -->
                    <Border x:Name="ColorSizeGroup" Style="{StaticResource RibbonGroupStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Color1" FontSize="10" HorizontalAlignment="Center" />
                                    <Button x:Name="Color1Button" Width="32" Height="32" Padding="0">
                                        <Rectangle x:Name="Color1Swatch" Width="22" Height="22" Fill="#E74C3C" Stroke="Gray" StrokeThickness="1" />
                                        <Button.Flyout>
                                            <Flyout>
                                                <ColorPicker x:Name="Color1ColorPicker" ColorChanged="Color1ColorPicker_ColorChanged"
                                                             IsMoreButtonVisible="False" IsAlphaEnabled="False" />
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Color2" FontSize="10" HorizontalAlignment="Center" />
                                    <Button x:Name="Color2Button" Width="32" Height="32" Padding="0">
                                        <Rectangle x:Name="Color2Swatch" Width="22" Height="22" Fill="White" Stroke="Gray" StrokeThickness="1" />
                                        <Button.Flyout>
                                            <Flyout>
                                                <ColorPicker x:Name="Color2ColorPicker" ColorChanged="Color2ColorPicker_ColorChanged"
                                                             IsMoreButtonVisible="False" IsAlphaEnabled="False" />
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center" Width="100">
                                    <TextBlock Text="Size" FontSize="10" />
                                    <Slider x:Name="SizeSlider" ValueChanged="SizeSlider_ValueChanged" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="Màu &amp; Cỡ nét" Style="{StaticResource RibbonGroupLabelStyle}" />
                        </StackPanel>
                    </Border>

                </StackPanel>

                <StackPanel x:Name="FileRibbonPanel" Orientation="Horizontal" Visibility="Collapsed">

                    <Border Style="{StaticResource RibbonGroupStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <Button x:Name="OpenImageButton" Style="{StaticResource ToolButtonStyle}" Click="OpenImageButton_Click"
                                        ToolTipService.ToolTip="Mở ảnh có sẵn (PNG, JPG, BMP, GIF, WEBP) thành tab mới để ghi chú - chọn được nhiều file, hoặc kéo-thả file vào Editor (Ctrl+O)">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE8E5;" />
                                        <TextBlock Text="Mở" FontSize="10" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="NewImageButton" Style="{StaticResource ToolButtonStyle}" Click="NewImageButton_Click"
                                        ToolTipService.ToolTip="Tạo ảnh trống thành tab mới - chọn cỡ (ảnh trong clipboard, ảnh đang mở, màn hình…) và màu nền (Ctrl+N)">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE8A5;" />
                                        <TextBlock Text="Ảnh mới" FontSize="10" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="Mở &amp; Tạo" Style="{StaticResource RibbonGroupLabelStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource RibbonGroupStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <Button x:Name="SaveButton" Style="{StaticResource ToolButtonStyle}" Click="SaveButton_Click"
                                        ToolTipService.ToolTip="Lưu (Ctrl+S): ảnh đã gắn với 1 file (đã lưu trước đó, hoặc mở từ PNG / JPG / BMP) thì ghi đè file đó, chưa có thì hỏi nơi lưu như Lưu thành">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE74E;" />
                                        <TextBlock Text="Lưu" FontSize="10" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="SaveAsButton" Style="{StaticResource ToolButtonStyle}" Click="SaveAsButton_Click"
                                        ToolTipService.ToolTip="Lưu thành file mới: chọn nơi lưu và định dạng PNG / JPG / BMP (Ctrl+Shift+S). Chất lượng JPG chỉnh trong Cài đặt">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE792;" />
                                        <TextBlock Text="Lưu thành…" FontSize="10" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ToolButtonStyle}" Click="CopyButton_Click" ToolTipService.ToolTip="Copy ảnh (Ctrl+C)">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE8C8;" />
                                        <TextBlock Text="Copy" FontSize="10" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="Lưu" Style="{StaticResource RibbonGroupLabelStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource RibbonGroupStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <Button Style="{StaticResource ToolButtonStyle}" Click="SettingsButton_Click" ToolTipService.ToolTip="Phím tắt, hẹn giờ, tự động lưu, phiên làm việc...">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE713;" />
                                        <TextBlock Text="Cài đặt" FontSize="10" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ToolButtonStyle}" Click="HelpButton_Click" ToolTipService.ToolTip="Tất cả tính năng và phím tắt (F1)">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE897;" />
                                        <TextBlock Text="Hướng dẫn" FontSize="10" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ToolButtonStyle}" Click="CloseButton_Click">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE711;" />
                                        <TextBlock Text="Đóng" FontSize="10" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="Cửa sổ" Style="{StaticResource RibbonGroupLabelStyle}" />
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- Tab contextual "Định dạng": hiện khi đang chọn / đang vẽ chữ, khung chú thích, hình, đường, bút. Đổi gì
                     cũng áp cho shape đang chọn (nếu có) và cho các shape vẽ tiếp bằng công cụ đang dùng. Mỗi nhóm chỉ hiện
                     khi hợp với loại shape (UpdateFormatTab). Nhóm Màu & Cỡ nét được chuyển sang đầu tab này khi mở. -->
                <StackPanel x:Name="FormatRibbonPanel" Orientation="Horizontal" Visibility="Collapsed">

                    <Border x:Name="FontGroup" Style="{StaticResource RibbonGroupStyle}">
                        <StackPanel>
                            <StackPanel Spacing="4">
                                <ComboBox x:Name="FontFamilyBox" Width="176" Height="30" SelectionChanged="FontFamilyBox_SelectionChanged"
                                          ToolTipService.ToolTip="Phông chữ (gõ vài chữ đầu để nhảy tới phông)" />
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <NumberBox x:Name="FontSizeBox" Width="92" SpinButtonPlacementMode="Compact"
                                               ValueChanged="FontSizeBox_ValueChanged" ToolTipService.ToolTip="Cỡ chữ (px)" />
                                    <ToggleButton x:Name="BoldButton" Width="36" Height="32" Padding="0" Click="BoldButton_Click"
                                                  ToolTipService.ToolTip="Chữ đậm">
                                        <TextBlock Text="B" FontWeight="Bold" />
                                    </ToggleButton>
                                    <ToggleButton x:Name="ItalicButton" Width="36" Height="32" Padding="0" Click="ItalicButton_Click"
                                                  ToolTipService.ToolTip="Chữ nghiêng">
                                        <TextBlock Text="I" FontStyle="Italic" FontFamily="Times New Roman" FontSize="16" />
                                    </ToggleButton>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="Phông chữ" Style="{StaticResource RibbonGroupLabelStyle}" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="TextDecorGroup" Style="{StaticResource RibbonGroupStyle}">
                        <StackPanel>
                            <StackPanel Spacing="2">
                                <CheckBox x:Name="TextBackgroundCheck" Content="Nền ô chữ (Color2)" MinWidth="0"
                                          Click="TextBackgroundCheck_Click" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <CheckBox x:Name="TextOutlineCheck" Content="Viền chữ" MinWidth="0" Click="TextOutlineCheck_Click"
                                              ToolTipService.ToolTip="Viền quanh từng nét chữ - chữ dễ đọc trên ảnh nhiều màu" />
                                    <Button x:Name="TextOutlineColorButton" Width="28" Height="28" Padding="0" VerticalAlignment="Center"
                                            ToolTipService.ToolTip="Màu viền chữ">
                                        <Rectangle x:Name="TextOutlineSwatch" Width="18" Height="18" Fill="White" Stroke="Gray" StrokeThickness="1" />
                                        <Button.Flyout>
                                            <Flyout>
                                                <ColorPicker x:Name="TextOutlineColorPicker" ColorChanged="TextOutlineColorPicker_ColorChanged"
                                                             IsMoreButtonVisible="False" IsAlphaEnabled="False" />
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="Nền &amp; viền chữ" Style="{StaticResource RibbonGroupLabelStyle}" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="ShapeFillGroup" Style="{StaticResource RibbonGroupStyle}">
                        <StackPanel>
                            <StackPanel Spacing="2">
                                <CheckBox x:Name="ShapeFillCheck" Content="Tô nền (Color2)" MinWidth="0" Click="ShapeFillCheck_Click" />
                                <StackPanel x:Name="CornerRadiusRow" Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="Bo góc" FontSize="12" VerticalAlignment="Center" />
                                    <Slider x:Name="CornerRadiusSlider" Width="96" ValueChanged="CornerRadiusSlider_ValueChanged" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="Hình" Style="{StaticResource RibbonGroupLabelStyle}" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="StrokeStyleGroup" Style="{StaticResource RibbonGroupStyle}">
                        <StackPanel>
                            <StackPanel Spacing="2">
                                <ComboBox x:Name="DashBox" Width="172" Height="30" SelectionChanged="DashBox_SelectionChanged"
                                          ToolTipService.ToolTip="Kiểu nét">
                                    <ComboBoxItem Content="━━━  Nét liền" />
                                    <ComboBoxItem Content="╍╍╍  Nét đứt" />
                                    <ComboBoxItem Content="┅┅┅  Nét chấm" />
                                </ComboBox>
                                <StackPanel Orientation="Horizontal" Spacing="6" ToolTipService.ToolTip="Độ đục: 100% = không trong suốt">
                                    <TextBlock Text="Độ đục" FontSize="12" VerticalAlignment="Center" />
                                    <Slider x:Name="OpacitySlider" Width="116" ValueChanged="OpacitySlider_ValueChanged" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="Nét &amp; độ trong suốt" Style="{StaticResource RibbonGroupLabelStyle}" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="ArrowHeadGroup" Style="{StaticResource RibbonGroupStyle}">
                        <StackPanel>
                            <Grid RowSpacing="4" ColumnSpacing="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Đầu" FontSize="12" VerticalAlignment="Center" />
                                <ComboBox x:Name="StartHeadBox" Grid.Column="1" Width="164" Height="30" SelectionChanged="ArrowHeadBox_SelectionChanged">
                                    <ComboBoxItem Content="Không" />
                                    <ComboBoxItem Content="◀  Tam giác" />
                                    <ComboBoxItem Content="&lt;  Chữ V" />
                                    <ComboBoxItem Content="●  Chấm tròn" />
                                </ComboBox>
                                <TextBlock Grid.Row="1" Text="Cuối" FontSize="12" VerticalAlignment="Center" />
                                <ComboBox x:Name="EndHeadBox" Grid.Row="1" Grid.Column="1" Width="164" Height="30" SelectionChanged="ArrowHeadBox_SelectionChanged">
                                    <ComboBoxItem Content="Không" />
                                    <ComboBoxItem Content="▶  Tam giác" />
                                    <ComboBoxItem Content="&gt;  Chữ V" />
                                    <ComboBoxItem Content="●  Chấm tròn" />
                                </ComboBox>
                            </Grid>
                            <TextBlock Text="Đầu mũi tên" Style="{StaticResource RibbonGroupLabelStyle}" />
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- Tab contextual "Vùng chọn": hiện khi tool Select đã kéo chọn 1 vùng. -->
                <StackPanel x:Name="RegionRibbonPanel" Orientation="Horizontal" Visibility="Collapsed">
                    <Border Style="{StaticResource RibbonGroupStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <Button Style="{StaticResource ToolButtonStyle}" Click="RegionCropButton_Click"
                                        ToolTipService.ToolTip="Cắt ảnh theo vùng chọn (Enter)">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE7A8;" />
                                        <TextBlock Text="Cắt ảnh" FontSize="10" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ToolButtonStyle}" Click="RegionCopyButton_Click"
                                        ToolTipService.ToolTip="Copy vùng chọn (Ctrl+C)">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE8C8;" />
                                        <TextBlock Text="Copy" FontSize="10" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ToolButtonStyle}" Click="RegionCutButton_Click"
                                        ToolTipService.ToolTip="Copy rồi xoá trắng vùng chọn (Ctrl+X)">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE8C6;" />
                                        <TextBlock Text="Cut" FontSize="10" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ToolButtonStyle}" Click="RegionEraseButton_Click"
                                        ToolTipService.ToolTip="Xoá trắng vùng chọn (Delete)">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE75C;" />
                                        <TextBlock Text="Xoá vùng" FontSize="10" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="Vùng chọn" Style="{StaticResource RibbonGroupLabelStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource RibbonGroupStyle}">
                        <StackPanel>
                            <Button Style="{StaticResource ToolButtonStyle}" Click="RegionClearButton_Click"
                                    ToolTipService.ToolTip="Bỏ chọn vùng (Esc)">
                                <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                    <FontIcon Glyph="&#xE711;" />
                                    <TextBlock Text="Bỏ chọn" FontSize="10" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="Đóng" Style="{StaticResource RibbonGroupLabelStyle}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="NumberStampRibbonPanel" Orientation="Horizontal" Visibility="Collapsed">

                    <Border Style="{StaticResource RibbonGroupStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <Button x:Name="FlattenButton" Style="{StaticResource ToolButtonStyle}" Click="FlattenButton_Click">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE73D;" />
                                        <TextBlock Text="Flatten" FontSize="10" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ToolButtonStyle}" Click="DeleteButton_Click">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE74D;" />
                                        <TextBlock Text="Xoá" FontSize="10" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="Edit" Style="{StaticResource RibbonGroupLabelStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource RibbonGroupStyle}">
                        <StackPanel>
                            <ItemsControl ItemsSource="{x:Bind NumberStamps}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:StampPickerItem">
                                        <Button Padding="0" Width="26" Height="26" CornerRadius="13"
                                                Click="StampStyleSwatch_Click" Tag="{x:Bind Brush}">
                                            <Ellipse Width="20" Height="20" Fill="{x:Bind Brush}" Stroke="White" StrokeThickness="1.5" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Shape Styles" Style="{StaticResource RibbonGroupLabelStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource RibbonGroupStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Current" FontSize="10" HorizontalAlignment="Center" />
                                    <!-- Nút +/- tự dựng thay cho spin button Inline của NumberBox: bản gốc xếp
                                         Up trước Down (ngược thói quen trái=giảm, phải=tăng) và chèn lên chữ số khi
                                         box hẹp. -->
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <Button Style="{StaticResource StepperButtonStyle}" Click="CurrentDecrement_Click">
                                            <FontIcon Glyph="&#xE738;" FontSize="10" />
                                        </Button>
                                        <NumberBox x:Name="CurrentNumberBox" Width="48" SpinButtonPlacementMode="Hidden"
                                                   ValueChanged="CurrentNumberBox_ValueChanged">
                                            <NumberBox.Resources>
                                                <x:Double x:Key="TextControlThemeMinWidth">0</x:Double>
                                            </NumberBox.Resources>
                                        </NumberBox>
                                        <Button Style="{StaticResource StepperButtonStyle}" Click="CurrentIncrement_Click">
                                            <FontIcon Glyph="&#xE710;" FontSize="10" />
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Next" FontSize="10" HorizontalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <Button Style="{StaticResource StepperButtonStyle}" Click="NextDecrement_Click">
                                            <FontIcon Glyph="&#xE738;" FontSize="10" />
                                        </Button>
                                        <NumberBox x:Name="NextNumberBox" Width="48" SpinButtonPlacementMode="Hidden"
                                                   ValueChanged="NextNumberBox_ValueChanged">
                                            <NumberBox.Resources>
                                                <x:Double x:Key="TextControlThemeMinWidth">0</x:Double>
                                            </NumberBox.Resources>
                                        </NumberBox>
                                        <Button Style="{StaticResource StepperButtonStyle}" Click="NextIncrement_Click">
                                            <FontIcon Glyph="&#xE710;" FontSize="10" />
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="Stamp Format" Style="{StaticResource RibbonGroupLabelStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource RibbonGroupStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Outline" FontSize="10" HorizontalAlignment="Center" />
                                    <Button x:Name="StampOutlineButton" Width="32" Height="32" Padding="0">
                                        <Rectangle x:Name="StampOutlineSwatch" Width="22" Height="22" Fill="White" Stroke="Gray" StrokeThickness="1" />
                                        <Button.Flyout>
                                            <Flyout>
                                                <ColorPicker x:Name="StampOutlineColorPicker" ColorChanged="StampOutlineColorPicker_ColorChanged"
                                                             IsMoreButtonVisible="False" IsAlphaEnabled="False" />
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Fill" FontSize="10" HorizontalAlignment="Center" />
                                    <Button x:Name="StampFillButton" Width="32" Height="32" Padding="0">
                                        <Rectangle x:Name="StampFillSwatch" Width="22" Height="22" Fill="#D86445" Stroke="Gray" StrokeThickness="1" />
                                        <Button.Flyout>
                                            <Flyout>
                                                <ColorPicker x:Name="StampFillColorPicker" ColorChanged="StampFillColorPicker_ColorChanged"
                                                             IsMoreButtonVisible="False" IsAlphaEnabled="False" />
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="Shape Colors" Style="{StaticResource RibbonGroupLabelStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource RibbonGroupStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <Button Style="{StaticResource ToolButtonStyle}" Click="BringToFrontButton_Click">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE8A7;" />
                                        <TextBlock Text="Lên trên" FontSize="10" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ToolButtonStyle}" Click="SendToBackButton_Click">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE8A8;" />
                                        <TextBlock Text="Xuống dưới" FontSize="10" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="Arrange" Style="{StaticResource RibbonGroupLabelStyle}" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>
            </ScrollViewer>
        </Border>

        <!-- Row 2: mỗi lần chụp là 1 tab (giống PicPick) - tab chỉ dùng làm thanh chuyển ảnh, nội dung
             luôn vẽ trên cùng 1 Canvas bên dưới (đổi EditorViewModel khi đổi tab). -->
        <TabView x:Name="DocumentTabs" Grid.Row="2" Margin="0,6,0,0"
                 IsAddTabButtonVisible="False" TabWidthMode="SizeToContent" CanReorderTabs="False" CanDragTabs="False"
                 SelectionChanged="DocumentTabs_SelectionChanged" TabCloseRequested="DocumentTabs_TabCloseRequested">
            <TabView.TabStripFooter>
                <Button x:Name="CloseAllTabsButton" Click="CloseAllTabsButton_Click" Margin="8,0,0,0" Padding="10,4"
                        VerticalAlignment="Center" Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="Đóng tất cả ảnh (hỏi lưu tất cả vào 1 thư mục nếu còn ảnh chưa lưu)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8BB;" FontSize="12" />
                        <TextBlock Text="Đóng tất cả" FontSize="12" />
                    </StackPanel>
                </Button>
            </TabView.TabStripFooter>
        </TabView>

        <!-- IsTabStop: nhận lại focus khi đóng ô gõ chữ trên ảnh, để phím tắt của Editor vẫn chạy. -->
        <ScrollViewer x:Name="CanvasScroller" Grid.Row="3" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      IsTabStop="True" UseSystemFocusVisuals="False"
                      HorizontalContentAlignment="Left" VerticalContentAlignment="Top" Margin="0,0,0,8">
            <!-- Viền ảnh + 8 handle khung ảnh vẽ trong Skia (có lề CanvasPad), không dùng viền Border. -->
            <Grid HorizontalAlignment="Left" VerticalAlignment="Top">
                <skia:SKXamlCanvas x:Name="Canvas"
                                    PaintSurface="Canvas_PaintSurface"
                                    PointerPressed="Canvas_PointerPressed"
                                    PointerMoved="Canvas_PointerMoved"
                                    PointerReleased="Canvas_PointerReleased"
                                    DoubleTapped="Canvas_DoubleTapped" />
                <!-- Ô gõ chữ ngay trên ảnh (Text / Khung chú thích) được thêm vào đây khi đang gõ. Không có Background nên
                     phần trống không chặn chuột của Canvas. -->
                <Grid x:Name="InlineEditorHost" />
            </Grid>
        </ScrollViewer>

        <!-- Row 4: thanh trạng thái - trái: thông báo; phải: zoom của ảnh đang mở (kiểu PicPick).
             Ctrl + lăn chuột trên ảnh, Ctrl + '+' / '-' / '0' cũng zoom. -->
        <Grid Grid.Row="4" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Opacity="0.7" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <!-- Thứ tự tab ảnh đang mở / tổng số tab (UpdateTabPosition). -->
                <TextBlock x:Name="TabPositionText" VerticalAlignment="Center" Margin="0,0,14,0" Opacity="0.8"
                           ToolTipService.ToolTip="Ảnh đang mở / tổng số ảnh (tab) trong Editor" />
                <Button x:Name="ZoomFitButton" Style="{StaticResource SmallToolButtonStyle}" Click="ZoomFitButton_Click"
                        ToolTipService.ToolTip="Vừa cửa sổ">
                    <FontIcon Glyph="&#xE9A6;" FontSize="14" />
                </Button>
                <Button x:Name="ZoomOutButton" Style="{StaticResource SmallToolButtonStyle}" Click="ZoomOutButton_Click"
                        ToolTipService.ToolTip="Thu nhỏ (Ctrl + -)">
                    <FontIcon Glyph="&#xE71F;" FontSize="14" />
                </Button>
                <DropDownButton x:Name="ZoomLevelButton" Content="100%" MinWidth="72" Padding="8,2"
                                ToolTipService.ToolTip="Mức zoom (Ctrl + 0 = 100%)">
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="ZoomLevelFlyout" Placement="Top" />
                    </DropDownButton.Flyout>
                </DropDownButton>
                <Button x:Name="ZoomInButton" Style="{StaticResource SmallToolButtonStyle}" Click="ZoomInButton_Click"
                        ToolTipService.ToolTip="Phóng to (Ctrl + +)">
                    <FontIcon Glyph="&#xE8A3;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

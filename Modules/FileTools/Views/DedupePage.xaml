<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FileTools.Views.DedupePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:FileTools.Views"
    xmlns:vm="using:FileTools.ViewModels"
    NavigationCacheMode="Required">

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
    <Grid x:Name="Root" Padding="24,16" RowSpacing="12" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="200" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="140" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="2">
            <TextBlock Text="Bỏ dòng trùng" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock Opacity="0.7" TextWrapping="Wrap"
                       Text="Giữ lần xuất hiện đầu tiên, giữ nguyên thứ tự. So cả dòng, hoặc chỉ theo các cột được tích (vd trùng mã khách hàng). Dùng được cho cả file text / log thường (so cả dòng)." />
        </StackPanel>

        <views:CsvSourcePanel Grid.Row="1" Source="{x:Bind ViewModel}" />

        <Grid Grid.Row="2" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="8">
                <RadioButtons Header="So sánh" SelectedIndex="{x:Bind ViewModel.ModeIndex, Mode=TwoWay}">
                    <x:String>So cả dòng</x:String>
                    <x:String>Chỉ theo các cột đã tích</x:String>
                </RadioButtons>
                <CheckBox Content="Không phân biệt hoa / thường" IsChecked="{x:Bind ViewModel.IgnoreCase, Mode=TwoWay}" />
                <CheckBox Content="Bỏ khoảng trắng đầu / cuối khi so" IsChecked="{x:Bind ViewModel.Trim, Mode=TwoWay}" />
            </StackPanel>
            <Border Grid.Column="1" BorderThickness="1" CornerRadius="4" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Opacity="{x:Bind views:Ui.OpacityIf(ViewModel.ByColumns), Mode=OneWay}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Padding="12,6" Text="Cột dùng để so" FontWeight="SemiBold" />
                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Columns}" SelectionMode="None" IsEnabled="{x:Bind ViewModel.ByColumns, Mode=OneWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:CsvColumnItem">
                                <CheckBox Content="{x:Bind Label}" IsChecked="{x:Bind IsChecked, Mode=TwoWay}" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Header="File kết quả" Text="{x:Bind ViewModel.OutputPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="1" VerticalAlignment="Bottom" Content="Chọn..." Command="{x:Bind ViewModel.BrowseOutputCommand}" />
            <views:OutputPanel Grid.Column="2" Settings="{x:Bind ViewModel.Output}" />
        </Grid>

        <Button Grid.Row="4" Content="Bỏ dòng trùng" MinWidth="120" Style="{StaticResource CompactAccentButtonStyle}" Command="{x:Bind ViewModel.RunCommand}" />

        <views:JobPanel Grid.Row="5" Job="{x:Bind ViewModel}" />
    </Grid>
    </ScrollViewer>
</Page>

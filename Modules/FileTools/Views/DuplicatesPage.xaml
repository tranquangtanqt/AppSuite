<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FileTools.Views.DuplicatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:FileTools.Views"
    xmlns:vm="using:FileTools.ViewModels"
    NavigationCacheMode="Required">

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
    <Grid x:Name="Root" Padding="24,16" RowSpacing="12" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" MinHeight="260" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="2">
            <TextBlock Text="Tìm file trùng" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock Opacity="0.7" TextWrapping="Wrap"
                       Text="Tìm các file có nội dung giống hệt nhau (không cần cùng tên) trong 1 hoặc nhiều thư mục. Tích các bản thừa rồi chuyển vào Thùng rác - luôn giữ lại ít nhất 1 bản mỗi nhóm." />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Header="Thư mục (nhiều thư mục: cách nhau bằng ;)" Text="{x:Bind ViewModel.Folders, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="1" VerticalAlignment="Bottom" Content="Thêm thư mục..." Command="{x:Bind ViewModel.BrowseFolderCommand}" />
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="16">
            <TextBox Header="Mẫu lọc" Width="200" Text="{x:Bind ViewModel.Patterns, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <NumberBox Header="Bỏ qua file nhỏ hơn (KB)" Width="190" Minimum="0" SpinButtonPlacementMode="Compact" Value="{x:Bind ViewModel.MinSizeKb, Mode=TwoWay}" />
            <CheckBox VerticalAlignment="Bottom" Content="Gồm thư mục con" IsChecked="{x:Bind ViewModel.Recursive, Mode=TwoWay}" />
            <Button VerticalAlignment="Bottom" Content="Tìm file trùng" MinWidth="120" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.FindCommand}" />
        </StackPanel>

        <Border Grid.Row="3" BorderThickness="1" CornerRadius="4" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Padding="12,6" Text="{x:Bind ViewModel.Summary, Mode=OneWay}" FontWeight="SemiBold" />
                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Groups}" SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:DuplicateGroupItem">
                            <StackPanel Padding="0,6" Spacing="2">
                                <TextBlock Text="{x:Bind Header}" FontWeight="SemiBold" Opacity="0.85" />
                                <ItemsControl ItemsSource="{x:Bind Files}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DuplicateFileItem">
                                            <CheckBox IsChecked="{x:Bind IsChecked, Mode=TwoWay}" ToolTipService.ToolTip="{x:Bind Path}">
                                                <TextBlock TextTrimming="CharacterEllipsis">
                                                    <Run Text="{x:Bind Name}" FontWeight="SemiBold" />
                                                    <Run Text="  " />
                                                    <Run Text="{x:Bind Folder}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </TextBlock>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8">
            <Button Content="Tích các bản thừa (giữ bản đầu mỗi nhóm)" Command="{x:Bind ViewModel.CheckAllButFirstCommand}" />
            <Button Content="Bỏ tích tất cả" Command="{x:Bind ViewModel.UncheckAllCommand}" />
            <Button Content="Chuyển file đã tích vào Thùng rác..." Command="{x:Bind ViewModel.RecycleCheckedCommand}" />
        </StackPanel>

        <views:JobPanel Grid.Row="5" Job="{x:Bind ViewModel}" />
    </Grid>
    </ScrollViewer>
</Page>

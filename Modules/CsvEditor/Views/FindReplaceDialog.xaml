<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="CsvEditor.Views.FindReplaceDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Tìm kiếm / Thay thế"
    PrimaryButtonText="Đóng"
    DefaultButton="Primary">

    <!-- ContentDialog tắt cuộn dọc của chính nó: nội dung dài hơn cửa sổ bị cắt mất phần dưới → tự cuộn khi cần -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="10" MinWidth="360">
        <TextBox x:Name="FindTextBox" Header="Tìm" TextChanged="FindTextBox_TextChanged" />

        <ComboBox x:Name="ModeComboBox" Header="Kiểu tìm" HorizontalAlignment="Stretch"
                  SelectionChanged="ModeComboBox_SelectionChanged">
            <ComboBoxItem Content="Chứa" />
            <ComboBoxItem Content="Khớp toàn bộ ô" />
            <ComboBoxItem Content="Bắt đầu bằng" />
            <ComboBoxItem Content="Kết thúc bằng" />
            <ComboBoxItem Content="Regex" />
        </ComboBox>

        <CheckBox x:Name="CaseSensitiveCheckBox" Content="Phân biệt hoa/thường" Checked="CaseSensitiveCheckBox_Changed" Unchecked="CaseSensitiveCheckBox_Changed" />

        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="PreviousButton" Click="PreviousButton_Click" AutomationProperties.Name="Trước">
                <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE76B;" FontSize="12" /><TextBlock Text="Trước" /></StackPanel>
            </Button>
            <Button x:Name="NextButton" Click="NextButton_Click" AutomationProperties.Name="Sau">
                <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="Sau" /><FontIcon Glyph="&#xE76C;" FontSize="12" /></StackPanel>
            </Button>
            <TextBlock x:Name="MatchStatusText" VerticalAlignment="Center" Opacity="0.8" />
        </StackPanel>

        <TextBox x:Name="ReplaceTextBox" Header="Thay bằng" />
        <Button x:Name="ReplaceAllButton" Content="Thay thế tất cả kết quả" Click="ReplaceAllButton_Click" HorizontalAlignment="Left" />
        <TextBlock x:Name="ReplaceStatusText" Opacity="0.8" />
    </StackPanel>
    </ScrollViewer>
</ContentDialog>

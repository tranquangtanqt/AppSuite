<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="ModuleB.FileMatchesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ModuleB"
    xmlns:models="using:ModuleB.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="{x:Bind FileName}"
    CloseButtonText="Dong"
    DefaultButton="Close">

    <ContentDialog.Resources>
        <!-- ContentDialog clips its content to these theme resources (default ~548x756) before the
             inner Grid's own Width/MaxHeight ever apply - override them here to fit the wider table. -->
        <x:Double x:Key="ContentDialogMaxWidth">960</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">800</x:Double>
    </ContentDialog.Resources>

    <Grid Width="900" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Opacity="0.8"
                    Text="Cac o co chua tu khoa tim kiem. Bam &quot;Mo tai day&quot; de mo file trong Excel va nhay den dung sheet/o." />

        <ListView Grid.Row="1" ItemsSource="{x:Bind Matches}" MaxHeight="640" SelectionMode="None"
                  ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:CellMatchItem">
                    <Grid ColumnSpacing="12" Padding="8,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{x:Bind SheetName}" VerticalAlignment="Top" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{x:Bind CellReference}" VerticalAlignment="Top" />
                        <TextBlock Grid.Column="2" Text="{x:Bind Text}" VerticalAlignment="Top" TextWrapping="Wrap" />
                        <Button Grid.Column="3" Content="Mo tai day" VerticalAlignment="Top" Tag="{x:Bind}" Click="OpenCellButton_Click" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</ContentDialog>

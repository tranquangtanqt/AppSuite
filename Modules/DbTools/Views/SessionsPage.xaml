<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DbTools.Views.SessionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:DbTools.Views"
    xmlns:vm="using:DbTools.ViewModels"
    xmlns:models="using:DbTools.Models"
    NavigationCacheMode="Required">

    <Grid Padding="24,12" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="2" Margin="0,0,48,0">
            <TextBlock Text="Phiên kết nối" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock Opacity="0.7" TextWrapping="Wrap"
                       Text="Ai đang kết nối vào database nào. Ngắt phiên trước khi copy DB / restore, hoặc gỡ phiên treo đang giữ khoá." />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="420" />
                <ColumnDefinition Width="*" MaxWidth="240" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox Header="Server (hồ sơ kết nối)" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.Profiles}"
                      SelectedItem="{x:Bind ViewModel.Profile, Mode=TwoWay}" PlaceholderText="(chưa có kết nối)" AutomationProperties.AutomationId="SessionProfileBox">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="models:ConnectionProfile">
                        <TextBlock Text="{x:Bind Display, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <ComboBox x:Name="DbBox" Grid.Column="1" Header="Database (trống = mọi DB)" IsEditable="True" HorizontalAlignment="Stretch"
                      ItemsSource="{x:Bind ViewModel.Databases}" Text="{x:Bind ViewModel.Database, Mode=TwoWay}"
                      DropDownOpened="DbBox_DropDownOpened" Loaded="DbBox_Loaded" TextSubmitted="DbBox_TextSubmitted" LostFocus="DbBox_LostFocus"
                      AutomationProperties.AutomationId="SessionDbBox" />
            <Button Grid.Column="2" VerticalAlignment="Bottom" Content="✕" Width="32" Padding="0" Click="ClearDb_Click"
                    AutomationProperties.Name="Mọi database" ToolTipService.ToolTip="Bỏ lọc - xem phiên của mọi database" />
            <Button Grid.Column="3" VerticalAlignment="Bottom" Content="Làm mới" Style="{StaticResource CompactAccentButtonStyle}"
                    Command="{x:Bind ViewModel.RefreshCommand}" AutomationProperties.AutomationId="RefreshButton" />
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.AutomationId="StatusText" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <Button Content="Ngắt phiên đã chọn" Command="{x:Bind ViewModel.TerminateSelectedCommand}" AutomationProperties.AutomationId="TerminateSelected"
                        ToolTipService.ToolTip="pg_terminate_backend các phiên đang chọn (Ctrl / Shift + bấm để chọn nhiều)" />
                <Button Content="Ngắt hết" Command="{x:Bind ViewModel.TerminateAllCommand}" AutomationProperties.AutomationId="TerminateAll"
                        ToolTipService.ToolTip="Ngắt mọi phiên trong danh sách (theo ô Database), trừ phiên của DbTools" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="3" BorderThickness="1" CornerRadius="4" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Padding="12,6" ColumnSpacing="10" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="PID" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="Database" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="User · ứng dụng" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="3" Text="Máy" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="4" Text="Trạng thái" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="5" Text="Kết nối lúc" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="6" Text="Câu gần nhất" FontWeight="SemiBold" />
                </Grid>
                <ListView x:Name="SessionList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Rows}" SelectionMode="Extended"
                          SelectionChanged="SessionList_SelectionChanged" AutomationProperties.AutomationId="SessionList" AutomationProperties.Name="Phiên kết nối">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="MinHeight" Value="32" />
                            <Setter Property="Padding" Value="12,0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:SessionRow">
                            <Grid ColumnSpacing="10" AutomationProperties.Name="{x:Bind PidText}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind PidText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Database}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Who}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Who}" />
                                <TextBlock Grid.Column="3" Text="{x:Bind Client}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="4" Text="{x:Bind State}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="5" Text="{x:Bind Since}" VerticalAlignment="Center" Opacity="0.8" />
                                <TextBlock Grid.Column="6" Text="{x:Bind Query}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontFamily="Consolas" FontSize="12"
                                           ToolTipService.ToolTip="{x:Bind QueryTip}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock Grid.Row="1" Text="Chưa có danh sách - bấm Làm mới." Opacity="0.6" HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsHitTestVisible="False" Visibility="{x:Bind views:Ui.VisibleIf(ViewModel.IsEmpty), Mode=OneWay}" />
            </Grid>
        </Border>
    </Grid>
</Page>

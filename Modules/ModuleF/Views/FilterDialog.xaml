<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="ModuleF.Views.FilterDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:ModuleF.ViewModels"
    mc:Ignorable="d"
    x:Name="Root"
    Title="Lọc dữ liệu"
    PrimaryButtonText="Áp dụng"
    SecondaryButtonText="Bỏ lọc"
    CloseButtonText="Hủy"
    DefaultButton="Primary">

    <StackPanel Spacing="10" MinWidth="520" MaxHeight="480">
        <ComboBox x:Name="JoinComboBox" Header="Kết hợp các điều kiện" SelectedIndex="0" HorizontalAlignment="Left">
            <ComboBoxItem Content="AND (thỏa mãn tất cả)" />
            <ComboBoxItem Content="OR (thỏa mãn 1 trong các điều kiện)" />
        </ComboBox>

        <Button Content="+ Thêm điều kiện" Click="AddConditionButton_Click" HorizontalAlignment="Left" />

        <ListView x:Name="ConditionsListView" ItemsSource="{x:Bind Conditions}" MaxHeight="320" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:FilterConditionRow">
                    <Grid ColumnSpacing="6" Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Column="0" ItemsSource="{Binding ColumnNames, ElementName=Root}"
                                  SelectedIndex="{x:Bind ColumnIndex, Mode=TwoWay}" />

                        <ComboBox Grid.Column="1" SelectedIndex="{x:Bind OperatorIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="=" />
                            <ComboBoxItem Content="!=" />
                            <ComboBoxItem Content="&gt;" />
                            <ComboBoxItem Content="&lt;" />
                            <ComboBoxItem Content="&gt;=" />
                            <ComboBoxItem Content="&lt;=" />
                            <ComboBoxItem Content="Chứa" />
                            <ComboBoxItem Content="Regex" />
                        </ComboBox>

                        <TextBox Grid.Column="2" Text="{x:Bind Value, Mode=TwoWay}" PlaceholderText="Giá trị" />

                        <CheckBox Grid.Column="3" Content="NOT" IsChecked="{x:Bind Negate, Mode=TwoWay}" />

                        <Button Grid.Column="4" Content="✕" Click="RemoveConditionButton_Click" Tag="{x:Bind}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </StackPanel>
</ContentDialog>

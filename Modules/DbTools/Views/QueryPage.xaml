<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DbTools.Views.QueryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:DbTools.Views"
    xmlns:vm="using:DbTools.ViewModels"
    xmlns:models="using:DbTools.Models"
    NavigationCacheMode="Required">

    <Grid Padding="24,12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="90" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" MinHeight="120" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="2" Margin="0,0,48,0">
            <TextBlock Text="Chạy SQL" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock Opacity="0.7" TextWrapping="Wrap"
                       Text="Chạy nhanh vài câu SQL, xem kết quả dạng bảng. Mặc định chỉ đọc (giao dịch READ ONLY, luôn rollback): câu ghi dữ liệu sẽ bị PostgreSQL từ chối." />
        </StackPanel>

        <!-- Server · giới hạn dòng · cho phép ghi · Chạy / Huỷ · Lịch sử -->
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="420" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox Header="Server (hồ sơ kết nối)" HorizontalAlignment="Stretch" views:ProfilePicker.Selected="{x:Bind ViewModel.Profile, Mode=TwoWay}"
                      PlaceholderText="(chưa có kết nối)" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" AutomationProperties.AutomationId="QueryProfileBox">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="models:ConnectionProfile">
                        <TextBlock Text="{x:Bind PickerText, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <ComboBox Grid.Column="1" Header="Đọc tối đa" Width="120" SelectedIndex="{x:Bind ViewModel.LimitIndex, Mode=TwoWay}"
                      AutomationProperties.AutomationId="QueryLimitBox"
                      ToolTipService.ToolTip="Số dòng đọc về bảng kết quả. Tất cả: bảng lớn sẽ chậm và tốn bộ nhớ - muốn lấy đủ thì dùng Xuất CSV.">
                <x:String>100 dòng</x:String>
                <x:String>1.000 dòng</x:String>
                <x:String>10.000 dòng</x:String>
                <x:String>Tất cả</x:String>
            </ComboBox>
            <ToggleSwitch Grid.Column="2" Header="Cho phép ghi" OffContent="Chỉ đọc" OnContent="Ghi" MinWidth="0" Width="110"
                          IsOn="{x:Bind ViewModel.AllowWrite, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                          AutomationProperties.AutomationId="AllowWriteSwitch"
                          ToolTipService.ToolTip="Tắt (mặc định): BEGIN READ ONLY ... ROLLBACK. Bật: BEGIN ... COMMIT, hỏi lại trước khi chạy. Đổi server là tự tắt." />
            <Button x:Name="RunButton" Grid.Column="3" VerticalAlignment="Bottom" Style="{StaticResource CompactAccentButtonStyle}" Click="Run_Click"
                    IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" AutomationProperties.AutomationId="QueryRunButton"
                    ToolTipService.ToolTip="Chạy đoạn đang chọn (không chọn thì cả ô) - Ctrl+Enter hoặc F5">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE768;" FontSize="14" />
                    <TextBlock Text="Chạy" />
                </StackPanel>
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="F5" />
                </Button.KeyboardAccelerators>
            </Button>
            <Button Grid.Column="4" VerticalAlignment="Bottom" Content="Huỷ" Command="{x:Bind ViewModel.CancelCommand}"
                    AutomationProperties.AutomationId="QueryCancelButton" ToolTipService.ToolTip="Dừng câu đang chạy (rollback)" />
            <Button Grid.Column="5" VerticalAlignment="Bottom" AutomationProperties.AutomationId="QueryHistoryButton" AutomationProperties.Name="Lịch sử câu"
                    ToolTipService.ToolTip="200 câu chạy gần nhất - bấm 1 câu để nạp lại vào ô soạn">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE81C;" FontSize="14" />
                    <TextBlock Text="Lịch sử" />
                </StackPanel>
                <Button.Flyout>
                    <Flyout x:Name="HistoryFlyout" Placement="BottomEdgeAlignedRight">
                        <!-- FlyoutPresenter mặc định rộng tối đa 456: nới ra, không thì nút Xoá lịch sử bị cắt. -->
                        <Flyout.FlyoutPresenterStyle>
                            <Style TargetType="FlyoutPresenter">
                                <Setter Property="MaxWidth" Value="640" />
                            </Style>
                        </Flyout.FlyoutPresenterStyle>
                        <Grid Width="560" RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox PlaceholderText="Tìm trong câu / hồ sơ / server" Text="{x:Bind ViewModel.HistoryFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.AutomationId="QueryHistoryFilter" />
                                <Button Grid.Column="1" Content="Xoá lịch sử" Command="{x:Bind ViewModel.ClearHistoryCommand}" AutomationProperties.AutomationId="QueryHistoryClear" />
                            </Grid>
                            <ListView Grid.Row="1" MaxHeight="420" ItemsSource="{x:Bind ViewModel.History}" IsItemClickEnabled="True" SelectionMode="None"
                                      ItemClick="History_ItemClick" AutomationProperties.AutomationId="QueryHistoryList">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:QueryHistoryRow">
                                        <StackPanel Padding="0,6" Spacing="2" AutomationProperties.Name="{x:Bind Sql}">
                                            <TextBlock Text="{x:Bind Sql}" FontFamily="Consolas" FontSize="12" MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Info}" FontSize="12" Opacity="0.7"
                                                       Foreground="{x:Bind views:Ui.ResultBrush(Success)}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <TextBlock Grid.Row="2" Text="{x:Bind ViewModel.WriteWarning, Mode=OneWay}" Foreground="#DC2626" FontWeight="SemiBold" TextWrapping="Wrap"
                   Visibility="{x:Bind views:Ui.VisibleIf(ViewModel.AllowWrite), Mode=OneWay}" AutomationProperties.AutomationId="WriteWarning" />

        <TextBox x:Name="Editor" Grid.Row="3" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="13" IsSpellCheckEnabled="False"
                 Text="{x:Bind ViewModel.SqlText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="Editor_PreviewKeyDown"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                 PlaceholderText="SELECT * FROM ...;   (nhiều câu cách nhau bằng ;  -  Ctrl+Enter / F5 để chạy)"
                 AutomationProperties.AutomationId="QueryEditor" AutomationProperties.Name="Câu SQL" />

        <TextBlock Grid.Row="4" Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                   Foreground="{x:Bind StatusBrush(ViewModel.StatusIsError), Mode=OneWay}" AutomationProperties.AutomationId="QueryStatus" />

        <Grid Grid.Row="5" ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <SelectorBar x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged" AutomationProperties.AutomationId="QueryTabs">
                <SelectorBarItem Text="Kết quả" IsSelected="True" />
                <SelectorBarItem Text="Thông báo" />
            </SelectorBar>
            <Button Grid.Column="1" VerticalAlignment="Center" Content="Chép dòng đã chọn" Click="CopySelected_Click" IsEnabled="{x:Bind ViewModel.HasTable, Mode=OneWay}"
                    AutomationProperties.AutomationId="CopySelectedButton" ToolTipService.ToolTip="Dòng đang chọn trong bảng (Ctrl / Shift + bấm để chọn nhiều) kèm tiêu đề - dán vào Excel được. Ctrl+C trong bảng cũng được." />
            <Button Grid.Column="2" VerticalAlignment="Center" Content="Chép cả bảng" Click="CopyAll_Click" IsEnabled="{x:Bind ViewModel.HasTable, Mode=OneWay}"
                    AutomationProperties.AutomationId="CopyAllButton" ToolTipService.ToolTip="Mọi dòng đang có trong bảng (theo giới hạn) kèm tiêu đề" />
            <Button Grid.Column="3" VerticalAlignment="Center" Content="Xuất CSV" Command="{x:Bind ViewModel.ExportCsvCommand}"
                    AutomationProperties.AutomationId="ExportCsvButton"
                    ToolTipService.ToolTip="Đủ mọi dòng (không theo giới hạn) → &lt;thư mục dump&gt;\ChaySql, mở bằng CsvEditor. Còn dòng chưa đọc thì chạy lại câu đó trong giao dịch chỉ đọc." />
        </Grid>

        <Border Grid.Row="6" BorderThickness="1" CornerRadius="4" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid>
                <!-- Kết quả: cuộn ngang cả tiêu đề + bảng; bảng tự cuộn dọc (chỉ dựng các dòng đang hiện). -->
                <ScrollViewer x:Name="ResultScroll" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled"
                              Visibility="{x:Bind views:Ui.TabVisible(ViewModel.Tab, 0), Mode=OneWay}">
                    <Grid x:Name="ResultGrid" HorizontalAlignment="Left">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel x:Name="HeaderPanel" Orientation="Horizontal" Padding="12,4" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    AutomationProperties.AutomationId="ResultHeader" />
                        <ListView x:Name="ResultList" Grid.Row="1" SelectionMode="Extended" ContainerContentChanging="ResultList_ContainerContentChanging"
                                  AutomationProperties.AutomationId="ResultList" AutomationProperties.Name="Kết quả">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="MinHeight" Value="28" />
                                    <Setter Property="Padding" Value="12,0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Background="Transparent" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                            <ListView.KeyboardAccelerators>
                                <KeyboardAccelerator Key="C" Modifiers="Control" Invoked="CopyAccelerator_Invoked" />
                            </ListView.KeyboardAccelerators>
                            <ListView.ContextFlyout>
                                <MenuFlyout x:Name="RowMenu" Opening="RowMenu_Opening">
                                    <MenuFlyoutItem x:Name="CopyCellItem" Text="Chép ô này" Click="CopyCell_Click" />
                                    <MenuFlyoutItem Text="Chép dòng đã chọn (kèm tiêu đề)" Click="CopySelected_Click" />
                                    <MenuFlyoutItem Text="Chép dòng đã chọn (không tiêu đề)" Click="CopySelectedNoHeader_Click" />
                                    <MenuFlyoutItem Text="Chép cả bảng" Click="CopyAll_Click" />
                                </MenuFlyout>
                            </ListView.ContextFlyout>
                        </ListView>
                    </Grid>
                </ScrollViewer>
                <TextBlock Text="Chưa có bảng kết quả." Opacity="0.6" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                           Visibility="{x:Bind EmptyVisible(ViewModel.HasTable, ViewModel.Tab), Mode=OneWay}" />

                <TextBox Text="{x:Bind ViewModel.Messages, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0"
                         FontFamily="Consolas" FontSize="12" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         Visibility="{x:Bind views:Ui.TabVisible(ViewModel.Tab, 1), Mode=OneWay}"
                         AutomationProperties.AutomationId="QueryMessages" AutomationProperties.Name="Thông báo" />
            </Grid>
        </Border>
    </Grid>
</Page>

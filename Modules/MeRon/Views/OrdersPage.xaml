<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MeRon.Views.OrdersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MeRon.ViewModels"
    xmlns:local="using:MeRon.Views"
    NavigationCacheMode="Enabled">

    <Grid Padding="24,12,24,16" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Tiêu đề + Chi tiết / Thêm -->
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Đặt hàng" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Summary, Mode=OneWay}" AutomationProperties.AutomationId="OrdersSummary"
                       Opacity="0.75" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="2" Click="Detail_Click" AutomationProperties.Name="Chi tiết"
                    ToolTipService.ToolTip="Toàn bộ đơn khớp bộ lọc, gộp theo khách - có Thanh toán toàn bộ, Chụp ảnh">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <SymbolIcon Symbol="View" />
                    <TextBlock Text="Chi tiết" />
                </StackPanel>
            </Button>
            <Button Grid.Column="3" Style="{StaticResource AccentButtonStyle}" Click="Add_Click" AutomationProperties.Name="Thêm đơn">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <SymbolIcon Symbol="Add" />
                    <TextBlock Text="Thêm" />
                </StackPanel>
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Control" Key="N" />
                </Button.KeyboardAccelerators>
            </Button>
        </Grid>

        <!-- Trạng thái + sắp xếp -->
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <SelectorBar x:Name="StatusBar" SelectionChanged="StatusBar_SelectionChanged" AutomationProperties.Name="Trạng thái">
                <SelectorBarItem Text="Tất cả" Tag="0" />
                <SelectorBarItem Text="Đã lên đơn" Tag="1" />
                <SelectorBarItem Text="Đã thanh toán" Tag="2" />
                <SelectorBarItem Text="Huỷ" Tag="3" />
            </SelectorBar>
            <DropDownButton x:Name="SortButton" Grid.Column="1" AutomationProperties.Name="Sắp xếp" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE8CB;" FontSize="14" />
                    <TextBlock x:Name="SortText" Text="Sắp xếp" />
                </StackPanel>
                <DropDownButton.Flyout>
                    <MenuFlyout x:Name="SortMenu" Placement="BottomEdgeAlignedRight" />
                </DropDownButton.Flyout>
            </DropDownButton>
            <Button Grid.Column="2" Click="Refresh_Click" AutomationProperties.Name="Làm mới" ToolTipService.ToolTip="Tải lại (F5)" VerticalAlignment="Center">
                <SymbolIcon Symbol="Refresh" />
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="F5" />
                </Button.KeyboardAccelerators>
            </Button>
        </Grid>

        <!-- Khách + khoảng ngày giao -->
        <!-- Ô khách co lại (tối đa 320) khi cửa sổ hẹp để ô ngày + Khoảng ngày luôn thấy đủ. -->
        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="320" MinWidth="160" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox x:Name="CustomerBox" PlaceholderText="Lọc theo khách (tên / SĐT)" QueryIcon="Find"
                            AutomationProperties.Name="Lọc theo khách hàng" />
            <Button Grid.Column="1" Click="ClearCustomer_Click" AutomationProperties.Name="Bỏ lọc khách" ToolTipService.ToolTip="Bỏ lọc khách"
                    Visibility="{x:Bind local:Ui.VisibleIf(ViewModel.HasCustomer), Mode=OneWay}">
                <SymbolIcon Symbol="Clear" />
            </Button>
            <CalendarDatePicker Grid.Column="2" Date="{x:Bind ViewModel.FromDate, Mode=TwoWay}" PlaceholderText="Từ ngày"
                                DateFormat="{}{day.integer(2)}/{month.integer(2)}/{year.full}" AutomationProperties.Name="Từ ngày" Width="136" />
            <TextBlock Grid.Column="3" Text="–" VerticalAlignment="Center" />
            <CalendarDatePicker Grid.Column="4" Date="{x:Bind ViewModel.ToDate, Mode=TwoWay}" PlaceholderText="Đến ngày"
                                DateFormat="{}{day.integer(2)}/{month.integer(2)}/{year.full}" AutomationProperties.Name="Đến ngày" Width="136" />
            <DropDownButton Grid.Column="5" AutomationProperties.Name="Khoảng ngày nhanh" ToolTipService.ToolTip="Chọn nhanh khoảng ngày">
                <FontIcon Glyph="&#xE787;" FontSize="16" />
                <DropDownButton.Flyout>
                    <MenuFlyout x:Name="RangeMenu" Placement="BottomEdgeAlignedRight" />
                </DropDownButton.Flyout>
            </DropDownButton>
        </Grid>

        <InfoBar Grid.Row="3" Severity="Error" IsClosable="False" Message="{x:Bind ViewModel.Error, Mode=OneWay}"
                 IsOpen="{x:Bind local:Ui.HasText(ViewModel.Error), Mode=OneWay}" />

        <Grid Grid.Row="4">
            <!-- Mỗi thẻ là 1 nút: bấm chuột, Tab + Enter, trình đọc màn hình đều mở được đơn. ItemsRepeater vẫn ảo hoá
                 (vài nghìn đơn không tạo hết thẻ). -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Cards}" AutomationProperties.Name="Danh sách đơn hàng">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="6" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:OrderCardViewModel">
                            <Button Click="Card_Click" Tag="{x:Bind}" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                    Background="Transparent" BorderThickness="0" AutomationProperties.Name="{x:Bind AccessibleName}">
                                <local:OrderCard Card="{x:Bind}" />
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10"
                        Visibility="{x:Bind local:Ui.VisibleIf(ViewModel.IsEmpty), Mode=OneWay}">
                <TextBlock Text="Không có đơn nào khớp bộ lọc." HorizontalAlignment="Center" Opacity="0.7" />
                <Button Content="Thêm đơn" HorizontalAlignment="Center" Click="Add_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>

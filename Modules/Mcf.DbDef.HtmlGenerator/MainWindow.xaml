<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Mcf.DbDef.HtmlGenerator.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Mcf.DbDef.HtmlGenerator"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Module D">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Text="Module D - Tu dien du lieu (DB Definition)" Style="{StaticResource TitleLargeTextBlockStyle}" />
            <TextBlock Text="Doc Data\Excel\*.xlsm -> luu Data\Database\Mcf.DbDef.HtmlGenerator.db -> xuat Data\Database\Mcf.DbDef.HtmlGenerator.html" Opacity="0.7" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button Content="1. Doc Excel -> SQLite" Command="{x:Bind ViewModel.ImportExcelCommand}" Style="{StaticResource AccentButtonStyle}" />
            <Button Content="2. Xuat HTML" Command="{x:Bind ViewModel.ExportHtmlCommand}" />
            <Button Content="Mo file HTML" Command="{x:Bind ViewModel.OpenHtmlCommand}" />
        </StackPanel>

        <ProgressBar Grid.Row="2" IsIndeterminate="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />

        <TextBlock Grid.Row="3" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" TextWrapping="Wrap" />

        <Border Grid.Row="4" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
            <ListView ItemsSource="{x:Bind ViewModel.LogLines}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{x:Bind}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</Window>

<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Unit test cho Engine của ImageCompare: so sánh pixel, tự căn (dịch chuyển / theo dòng), SSIM, tìm ảnh con,
    tìm chữ trong kết quả OCR, OCR tiếng Việt, báo cáo HTML.

    Giống CsvEditor.Tests: ImageCompare là app WinUI nên không ProjectReference được; Engine\ không phụ thuộc
    WinUI (chỉ SkiaSharp) → biên dịch kèm trực tiếp. Phần OCR (Tesseract + tessdata) nằm ở thư viện Common.Ocr →
    ProjectReference (TFM windows vì Common.Ocr có Windows OCR). Chỉ x64: OCR cần native tesseract50.dll.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <RootNamespace>ImageCompare.Tests</RootNamespace>
    <!-- xUnit1051: test engine ngắn (< 1 s), không cần truyền TestContext.Current.CancellationToken vào mọi lời gọi. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\Modules\ImageCompare\Engine\**\*.cs" Link="ImageCompare\Engine\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="TestData\*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Common.Ocr\Common.Ocr.csproj" />
  </ItemGroup>
  <!-- Native Tesseract x64 + tessdata + VC++ runtime cạnh exe test (PlatformTarget x64 ở trên). -->
  <Import Project="..\..\Common.Ocr\Common.Ocr.targets" />

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>

<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MeRon.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24,12,24,24" Spacing="14" MaxWidth="1000" HorizontalAlignment="Left">
            <TextBlock Text="Cài đặt" Style="{StaticResource TitleTextBlockStyle}" />

            <!-- Giao diện: áp dụng khi app khởi động (xem App.xaml.cs) nên đổi xong cần mở lại -->
            <Border Padding="18,16" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource OrangeSoftBrush}">
                            <FontIcon Glyph="&#xE790;" FontSize="{StaticResource FontSizeEmphasis}" Foreground="{StaticResource OrangeBrush}" />
                        </Border>
                        <TextBlock Text="Giao diện" Style="{StaticResource GroupTitleTextBlockStyle}" VerticalAlignment="Center" />
                    </StackPanel>
                    <RadioButtons x:Name="ThemeChoice" MaxColumns="3" AutomationProperties.Name="Giao diện" SelectionChanged="Theme_SelectionChanged">
                        <x:String>Theo Windows</x:String>
                        <x:String>Sáng</x:String>
                        <x:String>Tối</x:String>
                    </RadioButtons>
                    <StackPanel x:Name="RestartPanel" Orientation="Horizontal" Spacing="12" Visibility="Collapsed">
                        <TextBlock Text="Mở lại app để áp dụng." VerticalAlignment="Center" />
                        <Button Content="Mở lại ngay" Click="Restart_Click" AutomationProperties.Name="Mở lại ngay"
                                ToolTipService.ToolTip="Đóng rồi mở lại MeRon. Đơn đang nhập dở chưa Lưu sẽ mất." />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Menu bên trái: bỏ tích = ẩn mục khỏi menu (lưu ngay, MenuSettings) -->
            <Border Padding="18,16" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource OrangeSoftBrush}">
                            <FontIcon Glyph="&#xE700;" FontSize="{StaticResource FontSizeEmphasis}" Foreground="{StaticResource OrangeBrush}" />
                        </Border>
                        <TextBlock Text="Menu bên trái" Style="{StaticResource GroupTitleTextBlockStyle}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" Opacity="0.8"
                               Text="Bỏ tích các mục ít dùng để ẩn khỏi menu - áp dụng ngay, tắt app mở lại vẫn giữ. Nhóm ẩn hết mục thì tiêu đề nhóm cũng ẩn. Đặt hàng luôn hiện; Cài đặt và Hướng dẫn ở cuối menu cũng luôn hiện." />
                    <!-- Các nhóm + ô tích dựng trong code theo đúng menu của MainWindow -->
                    <StackPanel x:Name="MenuGroups" Spacing="12" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="Hiện tất cả" Click="ShowAll_Click" AutomationProperties.Name="Hiện tất cả" />
                        <TextBlock x:Name="MenuStatus" VerticalAlignment="Center" Opacity="0.8" AutomationProperties.AutomationId="MenuStatus" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Nhập đơn hàng loạt: sửa tay dòng đã ghim thì hỏi hay tự bỏ ghim (MenuSettings.AskBeforeUnpin) -->
            <Border Padding="18,16" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource OrangeSoftBrush}">
                            <FontIcon Glyph="&#xE718;" FontSize="{StaticResource FontSizeEmphasis}" Foreground="{StaticResource OrangeBrush}" />
                        </Border>
                        <TextBlock Text="Nhập đơn hàng loạt" Style="{StaticResource GroupTitleTextBlockStyle}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" Opacity="0.8"
                               Text="Dòng đã sửa trong popup Sửa đơn hoặc đã chọn khách / món trên thẻ được ghim: đọc lại vẫn đúng khách, món đã chọn. Khi bạn sửa tay chữ của dòng đó trong ô chữ, mặc định ghim tự bỏ và dòng đọc theo chữ mới." />
                    <CheckBox x:Name="AskUnpinBox" Content="Hỏi trước khi bỏ ghim (giữ ghim thì chữ dòng trả về như cũ)"
                              AutomationProperties.Name="Hỏi trước khi bỏ ghim" Checked="AskUnpin_Changed" Unchecked="AskUnpin_Changed" />
                </StackPanel>
            </Border>

            <!-- Ảnh "Chụp ảnh" (Pictures\MeRon): tự đưa ảnh cũ vào Thùng rác khi mở app (Core\CaptureFiles) -->
            <Border Padding="18,16" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource OrangeSoftBrush}">
                            <FontIcon Glyph="&#xE722;" FontSize="{StaticResource FontSizeEmphasis}" Foreground="{StaticResource OrangeBrush}" />
                        </Border>
                        <TextBlock Text="Ảnh chụp" Style="{StaticResource GroupTitleTextBlockStyle}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" Opacity="0.8"
                               Text="Mỗi lần bấm Chụp ảnh (màn Chi tiết), ảnh được chép vào clipboard và lưu thêm 1 file PNG vào Pictures\MeRon. Ảnh cũ hơn số ngày dưới đây tự đưa vào Thùng rác mỗi lần mở app (lấy lại được từ Thùng rác). Chỉ xoá ảnh do MeRon tự đặt tên (chi_tiet_don_hang_…, hoa_don_cong_no_…), file khác trong thư mục giữ nguyên." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Tự xoá ảnh cũ hơn" VerticalAlignment="Center" />
                        <NumberBox x:Name="KeepDaysBox" Minimum="0" Maximum="3650" Width="90" SpinButtonPlacementMode="Hidden"
                                   AutomationProperties.Name="Số ngày giữ ảnh chụp" ValueChanged="KeepDays_ValueChanged" />
                        <TextBlock Text="ngày  (0 = giữ hết)" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="Dọn ngay" Click="CleanNow_Click" AutomationProperties.Name="Dọn ảnh cũ ngay" />
                        <Button Content="Mở thư mục ảnh" Click="OpenFolder_Click" AutomationProperties.Name="Mở thư mục ảnh" />
                        <TextBlock x:Name="CaptureStatus" VerticalAlignment="Center" Opacity="0.8" TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="CaptureStatus" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

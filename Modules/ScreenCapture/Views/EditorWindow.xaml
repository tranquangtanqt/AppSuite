<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ScreenCapture.Views.EditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ScreenCapture.Views"
    xmlns:skia="using:SkiaSharp.Views.Windows"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="ScreenCapture - Editor">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Padding="8" RowSpacing="0">
        <Grid.Resources>
            <!-- Icon-on-top + small label toolbar button, dùng chung cho mọi nút trong toolbar
                 (ButtonBase để áp được cho cả Button lẫn ToggleButton). -->
            <Style x:Key="ToolButtonStyle" TargetType="ButtonBase">
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="MinWidth" Value="52" />
            </Style>
            <!-- Nút -/+ nhỏ hai bên ô số (Stamp Format), cao bằng NumberBox. -->
            <Style x:Key="StepperButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="26" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="ToolButtonContentStyle" TargetType="StackPanel">
                <Setter Property="Spacing" Value="2" />
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>
            <!-- Tab header ribbon (Trang chủ/Tệp) - ToggleButton phẳng, chỉ đổi nền lúc Checked
                 (theme resource mặc định), không cần ControlTemplate riêng. -->
            <Style x:Key="RibbonTabHeaderStyle" TargetType="ToggleButton">
                <Setter Property="Padding" Value="16,6" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="4,4,0,0" />
            </Style>
            <!-- Khung 1 nhóm nút trong ribbon content, có nhãn nhóm phía dưới giống PicPick. -->
            <Style x:Key="RibbonGroupStyle" TargetType="Border">
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="6,4" />
                <Setter Property="Margin" Value="0,0,4,0" />
            </Style>
            <Style x:Key="RibbonGroupLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10" />
                <Setter Property="Opacity" Value="0.65" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,2,0,0" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: tab header -->
        <StackPanel Orientation="Horizontal" Spacing="2" Grid.Row="0">
            <ToggleButton x:Name="HomeTabHeader" Content="Trang chủ" Style="{StaticResource RibbonTabHeaderStyle}"
                          IsChecked="True" Click="RibbonTabHeader_Click" />
            <ToggleButton x:Name="FileTabHeader" Content="Tệp" Style="{StaticResource RibbonTabHeaderStyle}"
                          Click="RibbonTabHeader_Click" />
            <ToggleButton x:Name="NumberStampTabHeader" Content="Number Stamp" Style="{StaticResource RibbonTabHeaderStyle}"
                          Click="RibbonTabHeader_Click" Visibility="Collapsed" />
            <ToggleButton x:Name="RegionTabHeader" Content="Vùng chọn" Style="{StaticResource RibbonTabHeaderStyle}"
                          Click="RibbonTabHeader_Click" Visibility="Collapsed" />
        </StackPanel>

        <!-- Row 1: ribbon content, đổi theo tab đang chọn -->
        <Border Grid.Row="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,6">
            <Grid>
                <StackPanel x:Name="HomeRibbonPanel" Orientation="Horizontal">

                    <Border Style="{StaticResource RibbonGroupStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <ToggleButton x:Name="MoveToolButton" Style="{StaticResource ToolButtonStyle}" Click="MoveToolButton_Click">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <!-- Icon con trỏ chuột (như PicPick) - Segoe Fluent Icons không có glyph
                                             mũi tên con trỏ phù hợp nên vẽ bằng PathIcon. -->
                                        <Viewbox Width="16" Height="16" HorizontalAlignment="Center">
                                            <PathIcon Data="M0,0 L0,17 L4.2,13 L7.2,20 L10,18.8 L7,12 L12.5,12 Z" />
                                        </Viewbox>
                                        <TextBlock Text="Move" FontSize="10" />
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton x:Name="SelectToolButton" Style="{StaticResource ToolButtonStyle}" Click="SelectToolButton_Click"
                                              ToolTipService.ToolTip="Kéo chọn 1 vùng để Cắt ảnh / Copy / Cut / Xoá">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE8B3;" />
                                        <TextBlock Text="Select" FontSize="10" />
                                    </StackPanel>
                                </ToggleButton>
                                <Button x:Name="DeleteButton" Style="{StaticResource ToolButtonStyle}" Click="DeleteButton_Click" IsEnabled="False">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE74D;" />
                                        <TextBlock Text="Xoá" FontSize="10" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BringToFrontButton" Style="{StaticResource ToolButtonStyle}" Click="BringToFrontButton_Click" IsEnabled="False">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE8A7;" />
                                        <TextBlock Text="Lên trên" FontSize="10" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="SendToBackButton" Style="{StaticResource ToolButtonStyle}" Click="SendToBackButton_Click" IsEnabled="False">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE8A8;" />
                                        <TextBlock Text="Xuống dưới" FontSize="10" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="Chọn" Style="{StaticResource RibbonGroupLabelStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource RibbonGroupStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <ToggleButton x:Name="RectangleToolButton" Style="{StaticResource ToolButtonStyle}" Click="RectangleToolButton_Click">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE739;" />
                                        <TextBlock Text="Chữ nhật" FontSize="10" />
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton x:Name="EllipseToolButton" Style="{StaticResource ToolButtonStyle}" Click="EllipseToolButton_Click">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xEA3B;" />
                                        <TextBlock Text="Elip" FontSize="10" />
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton x:Name="LineToolButton" Style="{StaticResource ToolButtonStyle}" Click="LineToolButton_Click">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <TextBlock Text="&#x2571;" FontSize="16" HorizontalAlignment="Center" />
                                        <TextBlock Text="Đường thẳng" FontSize="10" />
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton x:Name="ArrowToolButton" Style="{StaticResource ToolButtonStyle}" Click="ArrowToolButton_Click">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE72A;" />
                                        <TextBlock Text="Mũi tên" FontSize="10" />
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton x:Name="HighlightToolButton" Style="{StaticResource ToolButtonStyle}" Click="HighlightToolButton_Click">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE7E6;" />
                                        <TextBlock Text="Highlight" FontSize="10" />
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton x:Name="TextToolButton" Style="{StaticResource ToolButtonStyle}" Click="TextToolButton_Click">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE8D2;" />
                                        <TextBlock Text="Text" FontSize="10" />
                                    </StackPanel>
                                </ToggleButton>
                            </StackPanel>
                            <TextBlock Text="Vẽ hình" Style="{StaticResource RibbonGroupLabelStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource RibbonGroupStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <ToggleButton x:Name="FillToolButton" Style="{StaticResource ToolButtonStyle}" Click="FillToolButton_Click">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE8D3;" />
                                        <TextBlock Text="Tô màu" FontSize="10" />
                                    </StackPanel>
                                </ToggleButton>
                                <Button x:Name="StampsToolButton" Style="{StaticResource ToolButtonStyle}">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE73E;" />
                                        <TextBlock Text="Stamps" FontSize="10" />
                                    </StackPanel>
                                    <Button.Flyout>
                                        <Flyout x:Name="StampsFlyout" Placement="Bottom">
                                            <ScrollViewer MaxHeight="360" MaxWidth="340">
                                                <StackPanel Spacing="8">
                                                    <TextBlock Text="Number Stamps" FontWeight="SemiBold" />
                                                    <ItemsControl x:Name="NumberStampsList" ItemsSource="{x:Bind NumberStamps}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" Spacing="6" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="local:StampPickerItem">
                                                                <Button Padding="0" CornerRadius="16" Click="NumberStampItem_Click" Tag="{x:Bind Brush}">
                                                                    <Grid>
                                                                        <Ellipse Width="32" Height="32" Fill="{x:Bind Brush}" Stroke="White" StrokeThickness="2" />
                                                                        <TextBlock Text="1" Foreground="White" FontWeight="Bold"
                                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Grid>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <TextBlock Text="General Stamps" FontWeight="SemiBold" />
                                                    <ItemsControl x:Name="GeneralStampsList" ItemsSource="{x:Bind GeneralStamps}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="44" ItemHeight="44" MaximumRowsOrColumns="6" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="local:StampPickerItem">
                                                                <Button Width="40" Height="40" Padding="0" Click="StampItem_Click" Tag="{x:Bind Kind}">
                                                                    <FontIcon Glyph="{x:Bind Glyph}" Foreground="{x:Bind Brush}" />
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="Tô &amp; Dấu" Style="{StaticResource RibbonGroupLabelStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource RibbonGroupStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <ToggleButton x:Name="CropToolButton" Style="{StaticResource ToolButtonStyle}" Click="CropToolButton_Click">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE7A8;" />
                                        <TextBlock Text="Cắt" FontSize="10" />
                                    </StackPanel>
                                </ToggleButton>
                                <Button x:Name="UndoButton" Style="{StaticResource ToolButtonStyle}" Click="UndoButton_Click" ToolTipService.ToolTip="Undo (Ctrl+Z)">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE7A7;" />
                                        <TextBlock Text="Undo" FontSize="10" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="RedoButton" Style="{StaticResource ToolButtonStyle}" Click="RedoButton_Click" ToolTipService.ToolTip="Redo (Ctrl+Y / Ctrl+Shift+Z)">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE7A6;" />
                                        <TextBlock Text="Redo" FontSize="10" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="PasteButton" Style="{StaticResource ToolButtonStyle}" Click="PasteButton_Click" ToolTipService.ToolTip="Dán ảnh từ clipboard (Ctrl+V)">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE77F;" />
                                        <TextBlock Text="Dán" FontSize="10" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="Cắt &amp; Sửa" Style="{StaticResource RibbonGroupLabelStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource RibbonGroupStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Color1" FontSize="10" HorizontalAlignment="Center" />
                                    <Button x:Name="Color1Button" Width="32" Height="32" Padding="0">
                                        <Rectangle x:Name="Color1Swatch" Width="22" Height="22" Fill="#E74C3C" Stroke="Gray" StrokeThickness="1" />
                                        <Button.Flyout>
                                            <Flyout>
                                                <ColorPicker x:Name="Color1ColorPicker" ColorChanged="Color1ColorPicker_ColorChanged"
                                                             IsMoreButtonVisible="False" IsAlphaEnabled="False" />
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Color2" FontSize="10" HorizontalAlignment="Center" />
                                    <Button x:Name="Color2Button" Width="32" Height="32" Padding="0">
                                        <Rectangle x:Name="Color2Swatch" Width="22" Height="22" Fill="White" Stroke="Gray" StrokeThickness="1" />
                                        <Button.Flyout>
                                            <Flyout>
                                                <ColorPicker x:Name="Color2ColorPicker" ColorChanged="Color2ColorPicker_ColorChanged"
                                                             IsMoreButtonVisible="False" IsAlphaEnabled="False" />
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="Màu" Style="{StaticResource RibbonGroupLabelStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource RibbonGroupStyle}">
                        <StackPanel>
                            <StackPanel VerticalAlignment="Center" Width="120">
                                <TextBlock Text="Size" FontSize="10" />
                                <Slider x:Name="SizeSlider" ValueChanged="SizeSlider_ValueChanged" />
                            </StackPanel>
                            <TextBlock Text="Cỡ nét" Style="{StaticResource RibbonGroupLabelStyle}" />
                        </StackPanel>
                    </Border>

                </StackPanel>

                <StackPanel x:Name="FileRibbonPanel" Orientation="Horizontal" Visibility="Collapsed">

                    <Border Style="{StaticResource RibbonGroupStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <Button Style="{StaticResource ToolButtonStyle}" Click="SaveButton_Click" ToolTipService.ToolTip="Lưu PNG (Ctrl+S)">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE792;" />
                                        <TextBlock Text="Lưu PNG" FontSize="10" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ToolButtonStyle}" Click="CopyButton_Click" ToolTipService.ToolTip="Copy ảnh (Ctrl+C)">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE8C8;" />
                                        <TextBlock Text="Copy" FontSize="10" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="Lưu" Style="{StaticResource RibbonGroupLabelStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource RibbonGroupStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <Button Style="{StaticResource ToolButtonStyle}" Click="SettingsButton_Click" ToolTipService.ToolTip="Phím tắt, hẹn giờ, tự động lưu, phiên làm việc...">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE713;" />
                                        <TextBlock Text="Cài đặt" FontSize="10" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ToolButtonStyle}" Click="CloseButton_Click">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE711;" />
                                        <TextBlock Text="Đóng" FontSize="10" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="Cửa sổ" Style="{StaticResource RibbonGroupLabelStyle}" />
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- Tab contextual "Vùng chọn": hiện khi tool Select đã kéo chọn 1 vùng. -->
                <StackPanel x:Name="RegionRibbonPanel" Orientation="Horizontal" Visibility="Collapsed">
                    <Border Style="{StaticResource RibbonGroupStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <Button Style="{StaticResource ToolButtonStyle}" Click="RegionCropButton_Click"
                                        ToolTipService.ToolTip="Cắt ảnh theo vùng chọn (Enter)">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE7A8;" />
                                        <TextBlock Text="Cắt ảnh" FontSize="10" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ToolButtonStyle}" Click="RegionCopyButton_Click"
                                        ToolTipService.ToolTip="Copy vùng chọn (Ctrl+C)">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE8C8;" />
                                        <TextBlock Text="Copy" FontSize="10" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ToolButtonStyle}" Click="RegionCutButton_Click"
                                        ToolTipService.ToolTip="Copy rồi xoá trắng vùng chọn (Ctrl+X)">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE8C6;" />
                                        <TextBlock Text="Cut" FontSize="10" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ToolButtonStyle}" Click="RegionEraseButton_Click"
                                        ToolTipService.ToolTip="Xoá trắng vùng chọn (Delete)">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE75C;" />
                                        <TextBlock Text="Xoá vùng" FontSize="10" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="Vùng chọn" Style="{StaticResource RibbonGroupLabelStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource RibbonGroupStyle}">
                        <StackPanel>
                            <Button Style="{StaticResource ToolButtonStyle}" Click="RegionClearButton_Click"
                                    ToolTipService.ToolTip="Bỏ chọn vùng (Esc)">
                                <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                    <FontIcon Glyph="&#xE711;" />
                                    <TextBlock Text="Bỏ chọn" FontSize="10" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="Đóng" Style="{StaticResource RibbonGroupLabelStyle}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="NumberStampRibbonPanel" Orientation="Horizontal" Visibility="Collapsed">

                    <Border Style="{StaticResource RibbonGroupStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <Button x:Name="FlattenButton" Style="{StaticResource ToolButtonStyle}" Click="FlattenButton_Click">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE73D;" />
                                        <TextBlock Text="Flatten" FontSize="10" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ToolButtonStyle}" Click="DeleteButton_Click">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE74D;" />
                                        <TextBlock Text="Xoá" FontSize="10" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="Edit" Style="{StaticResource RibbonGroupLabelStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource RibbonGroupStyle}">
                        <StackPanel>
                            <ItemsControl ItemsSource="{x:Bind NumberStamps}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:StampPickerItem">
                                        <Button Padding="0" Width="26" Height="26" CornerRadius="13"
                                                Click="StampStyleSwatch_Click" Tag="{x:Bind Brush}">
                                            <Ellipse Width="20" Height="20" Fill="{x:Bind Brush}" Stroke="White" StrokeThickness="1.5" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Shape Styles" Style="{StaticResource RibbonGroupLabelStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource RibbonGroupStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Current" FontSize="10" HorizontalAlignment="Center" />
                                    <!-- Nút +/- tự dựng thay cho spin button Inline của NumberBox: bản gốc xếp
                                         Up trước Down (ngược thói quen trái=giảm, phải=tăng) và chèn lên chữ số khi
                                         box hẹp. -->
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <Button Style="{StaticResource StepperButtonStyle}" Click="CurrentDecrement_Click">
                                            <FontIcon Glyph="&#xE738;" FontSize="10" />
                                        </Button>
                                        <NumberBox x:Name="CurrentNumberBox" Width="48" SpinButtonPlacementMode="Hidden"
                                                   ValueChanged="CurrentNumberBox_ValueChanged">
                                            <NumberBox.Resources>
                                                <x:Double x:Key="TextControlThemeMinWidth">0</x:Double>
                                            </NumberBox.Resources>
                                        </NumberBox>
                                        <Button Style="{StaticResource StepperButtonStyle}" Click="CurrentIncrement_Click">
                                            <FontIcon Glyph="&#xE710;" FontSize="10" />
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Next" FontSize="10" HorizontalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <Button Style="{StaticResource StepperButtonStyle}" Click="NextDecrement_Click">
                                            <FontIcon Glyph="&#xE738;" FontSize="10" />
                                        </Button>
                                        <NumberBox x:Name="NextNumberBox" Width="48" SpinButtonPlacementMode="Hidden"
                                                   ValueChanged="NextNumberBox_ValueChanged">
                                            <NumberBox.Resources>
                                                <x:Double x:Key="TextControlThemeMinWidth">0</x:Double>
                                            </NumberBox.Resources>
                                        </NumberBox>
                                        <Button Style="{StaticResource StepperButtonStyle}" Click="NextIncrement_Click">
                                            <FontIcon Glyph="&#xE710;" FontSize="10" />
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="Stamp Format" Style="{StaticResource RibbonGroupLabelStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource RibbonGroupStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Outline" FontSize="10" HorizontalAlignment="Center" />
                                    <Button x:Name="StampOutlineButton" Width="32" Height="32" Padding="0">
                                        <Rectangle x:Name="StampOutlineSwatch" Width="22" Height="22" Fill="White" Stroke="Gray" StrokeThickness="1" />
                                        <Button.Flyout>
                                            <Flyout>
                                                <ColorPicker x:Name="StampOutlineColorPicker" ColorChanged="StampOutlineColorPicker_ColorChanged"
                                                             IsMoreButtonVisible="False" IsAlphaEnabled="False" />
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Fill" FontSize="10" HorizontalAlignment="Center" />
                                    <Button x:Name="StampFillButton" Width="32" Height="32" Padding="0">
                                        <Rectangle x:Name="StampFillSwatch" Width="22" Height="22" Fill="#D86445" Stroke="Gray" StrokeThickness="1" />
                                        <Button.Flyout>
                                            <Flyout>
                                                <ColorPicker x:Name="StampFillColorPicker" ColorChanged="StampFillColorPicker_ColorChanged"
                                                             IsMoreButtonVisible="False" IsAlphaEnabled="False" />
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="Shape Colors" Style="{StaticResource RibbonGroupLabelStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource RibbonGroupStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <Button Style="{StaticResource ToolButtonStyle}" Click="BringToFrontButton_Click">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE8A7;" />
                                        <TextBlock Text="Lên trên" FontSize="10" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ToolButtonStyle}" Click="SendToBackButton_Click">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE8A8;" />
                                        <TextBlock Text="Xuống dưới" FontSize="10" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="Arrange" Style="{StaticResource RibbonGroupLabelStyle}" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 2: mỗi lần chụp là 1 tab (giống PicPick) - tab chỉ dùng làm thanh chuyển ảnh, nội dung
             luôn vẽ trên cùng 1 Canvas bên dưới (đổi EditorViewModel khi đổi tab). -->
        <TabView x:Name="DocumentTabs" Grid.Row="2" Margin="0,6,0,0"
                 IsAddTabButtonVisible="False" TabWidthMode="SizeToContent" CanReorderTabs="False" CanDragTabs="False"
                 SelectionChanged="DocumentTabs_SelectionChanged" TabCloseRequested="DocumentTabs_TabCloseRequested">
            <TabView.TabStripFooter>
                <Button x:Name="CloseAllTabsButton" Click="CloseAllTabsButton_Click" Margin="8,0,0,0" Padding="10,4"
                        VerticalAlignment="Center" Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="Đóng tất cả ảnh (hỏi lưu tất cả vào 1 thư mục nếu còn ảnh chưa lưu)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8BB;" FontSize="12" />
                        <TextBlock Text="Đóng tất cả" FontSize="12" />
                    </StackPanel>
                </Button>
            </TabView.TabStripFooter>
        </TabView>

        <ScrollViewer x:Name="CanvasScroller" Grid.Row="3" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      HorizontalContentAlignment="Left" VerticalContentAlignment="Top" Margin="0,0,0,8">
            <!-- Viền ảnh + 8 handle khung ảnh vẽ trong Skia (có lề CanvasPad), không dùng viền Border. -->
            <Border HorizontalAlignment="Left" VerticalAlignment="Top">
                <skia:SKXamlCanvas x:Name="Canvas"
                                    PaintSurface="Canvas_PaintSurface"
                                    PointerPressed="Canvas_PointerPressed"
                                    PointerMoved="Canvas_PointerMoved"
                                    PointerReleased="Canvas_PointerReleased" />
            </Border>
        </ScrollViewer>

        <TextBlock x:Name="StatusText" Grid.Row="4" Opacity="0.7" />
    </Grid>
</Window>

<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MeRon.Views.OrderDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MeRon.ViewModels"
    xmlns:local="using:MeRon.Views">

    <Grid Padding="24,12,24,0" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Click="Back_Click" AutomationProperties.Name="Quay lại" ToolTipService.ToolTip="Quay lại danh sách đơn">
                <SymbolIcon Symbol="Back" />
            </Button>
            <TextBlock Grid.Column="1" Text="Chi tiết" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.Summary, Mode=OneWay}" AutomationProperties.AutomationId="DetailSummary"
                       Opacity="0.75" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="3" Click="Capture_Click" AutomationProperties.Name="Chụp ảnh"
                    ToolTipService.ToolTip="Chép ảnh danh sách vào clipboard (dán vào Zalo / Messenger) và lưu file PNG">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <SymbolIcon Symbol="Camera" />
                    <TextBlock Text="Chụp ảnh" />
                </StackPanel>
            </Button>
            <Button Grid.Column="4" Click="OpenPictures_Click" AutomationProperties.Name="Thư mục ảnh"
                    ToolTipService.ToolTip="Mở thư mục ảnh chụp (Pictures\MeRon) - vừa chụp thì chọn sẵn ảnh đó">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <SymbolIcon Symbol="Folder" />
                    <TextBlock Text="Thư mục ảnh" />
                </StackPanel>
            </Button>
            <Button Grid.Column="5" Style="{StaticResource AccentButtonStyle}" Click="PayAll_Click" AutomationProperties.Name="Thanh toán toàn bộ"
                    Visibility="{x:Bind local:Ui.VisibleIf(ViewModel.CanPayAll), Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE8C7;" FontSize="16" />
                    <TextBlock Text="Thanh toán toàn bộ" />
                </StackPanel>
            </Button>
        </Grid>

        <InfoBar Grid.Row="1" Severity="Success" IsClosable="True" Message="{x:Bind ViewModel.Message, Mode=OneWay}"
                 IsOpen="{x:Bind local:Ui.HasText(ViewModel.Message), Mode=OneWay}" AutomationProperties.AutomationId="DetailMessage" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <!-- Phần này được chụp thành ảnh: nền đặc để ảnh không trong suốt. -->
            <StackPanel x:Name="CaptureArea" Spacing="14" Padding="12" MaxWidth="820" HorizontalAlignment="Left"
                        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                        Visibility="{x:Bind local:Ui.VisibleIf(ViewModel.HasGroups), Mode=OneWay}">
                <!-- Tiêu đề ảnh (vd mở từ trang Công nợ: "Đơn chưa thanh toán - tên khách · tính đến ... · Tổng ...") -->
                <TextBlock Text="{x:Bind ViewModel.CaptureTitle, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                           Visibility="{x:Bind local:Ui.VisibleIfText(ViewModel.CaptureTitle), Mode=OneWay}"
                           AutomationProperties.AutomationId="CaptureTitle" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.Groups}" IsTabStop="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CustomerOrderGroup">
                            <Border Padding="14,12" Margin="0,0,0,14" CornerRadius="8" BorderThickness="1"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{x:Bind CustomerName}" FontSize="18" FontWeight="SemiBold" />
                                    <ItemsControl ItemsSource="{x:Bind Orders}" IsTabStop="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:OrderCardViewModel">
                                                <Button Click="Order_Click" Tag="{x:Bind}" Padding="0" Margin="0,0,0,8" HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0"
                                                        AutomationProperties.Name="{x:Bind AccessibleName}">
                                                    <local:OrderCard Card="{x:Bind}" ShowCustomer="False" />
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{x:Bind TotalText}" HorizontalAlignment="Right" FontWeight="SemiBold"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

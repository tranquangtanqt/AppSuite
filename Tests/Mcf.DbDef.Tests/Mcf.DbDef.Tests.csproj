<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Unit test cho Mcf.DbDef.HtmlGenerator: đọc workbook DBDef (*.xlsm, EPPlus) → bảng / cột / khoá ngoại → SQLite →
    báo cáo HTML. File Excel mẫu được dựng ngay trong test bằng EPPlus - không cần tài liệu mcframe thật.

    Giống CsvEditor.Tests: module là app WinUI nên biên dịch kèm trực tiếp Services\ + Models\ (không phụ thuộc WinUI).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>Mcf.DbDef.Tests</RootNamespace>
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\Modules\Mcf.DbDef.HtmlGenerator\Services\**\*.cs" Link="Module\Services\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\Modules\Mcf.DbDef.HtmlGenerator\Models\**\*.cs" Link="Module\Models\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EPPlus" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>

<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MainLauncher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MainLauncher"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="AppSuite - Main Launcher">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <NavigationView
        x:Name="NavView"
        PaneDisplayMode="Left"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        Loaded="NavView_Loaded"
        ItemInvoked="NavView_ItemInvoked"
        SelectionChanged="NavView_SelectionChanged">

        <NavigationView.KeyboardAccelerators>
            <KeyboardAccelerator Key="F1" Invoked="HelpAccelerator_Invoked" />
        </NavigationView.KeyboardAccelerators>

        <NavigationView.MenuItems>
            <NavigationViewItem Content="Tổng quan" Tag="Dashboard">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Home" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Danh sách module" Tag="Modules">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="List" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Nhật ký" Tag="Logs">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Document" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <NavigationView.FooterMenuItems>
            <!-- Mở cửa sổ Hướng dẫn riêng, không chuyển trang (SelectsOnInvoked=False, xử lý ở ItemInvoked) -->
            <NavigationViewItem Content="Hướng dẫn (F1)" Tag="Help" SelectsOnInvoked="False" ToolTipService.ToolTip="Hướng dẫn sử dụng (F1)">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE897;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Cài đặt" Tag="Settings">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Setting" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.FooterMenuItems>

        <Grid>
            <Frame x:Name="ContentFrame" />
            <!-- Mở MainLauncher lần nữa khi đang chạy: đưa cửa sổ này lên + báo nhỏ (tự ẩn); đóng hết module lúc thoát: báo tiến trình.
                 Góc dưới phải, nền đặc + bóng (nền InfoBar trong suốt, đè lên nội dung trang thì chữ chồng nhau). -->
            <Border x:Name="NoticeHost" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,24,24" MaxWidth="420" CornerRadius="6" Translation="0,0,24"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
                <InfoBar x:Name="NoticeBar" IsOpen="False" IsClosable="True" Severity="Informational"
                         Closed="NoticeBar_Closed" AutomationProperties.AutomationId="NoticeBar" />
            </Border>
        </Grid>
    </NavigationView>
</Window>

<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MeRon.Views.ReportCustomerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MeRon.ViewModels"
    xmlns:local="using:MeRon.Views"
    NavigationCacheMode="Enabled">

    <Grid Padding="24,12,24,0" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Khách hàng tiềm năng" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Summary, Mode=OneWay}" Opacity="0.75" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="CustomerReportSummary" />
        </Grid>
        <local:DateRangeBar Grid.Row="1" Filter="{x:Bind ViewModel.Range}" />
        <InfoBar Grid.Row="2" Severity="Error" IsClosable="False" Message="{x:Bind ViewModel.Error, Mode=OneWay}"
                 IsOpen="{x:Bind local:Ui.HasText(ViewModel.Error), Mode=OneWay}" />

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="0,0,12,24" MaxWidth="800" HorizontalAlignment="Left" Spacing="6">
                <TextBlock Text="Xếp theo tổng tiền đã đặt (không tính đơn Huỷ), tối đa 100 khách. Bấm 1 khách để xem các đơn trong khoảng ngày."
                           Opacity="0.75" TextWrapping="Wrap" />
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Rows}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="4" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:CustomerReportRow">
                            <Button Click="Customer_Click" Tag="{x:Bind}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                    Padding="12,8" AutomationProperties.Name="{x:Bind AccessibleName}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind RankText}" FontWeight="SemiBold" Opacity="0.7" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Orders}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind Amount}" HorizontalAlignment="Right" FontWeight="SemiBold"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <FontIcon Grid.Column="4" Glyph="&#xE76C;" FontSize="12" Opacity="0.6" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

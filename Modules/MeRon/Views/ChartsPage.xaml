<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MeRon.Views.ChartsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MeRon.ViewModels"
    xmlns:local="using:MeRon.Views"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <Style x:Key="ChartCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="18,16" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24,12,24,24" Spacing="14" MaxWidth="1100" HorizontalAlignment="Stretch">
            <TextBlock Text="Biểu đồ" Style="{StaticResource TitleTextBlockStyle}" />

            <!-- Bộ lọc: 1 hàng trên các biểu đồ -->
            <StackPanel Orientation="Horizontal" Spacing="12">
                <local:DateRangeBar x:Name="RangeBar" Filter="{x:Bind ViewModel.Range}" />
                <ComboBox x:Name="BucketBox" SelectedIndex="{x:Bind ViewModel.BucketChoice, Mode=TwoWay}" MinWidth="150"
                          AutomationProperties.Name="Gom theo" ToolTipService.ToolTip="Gom cột theo ngày / tuần / tháng (Tự động: theo độ dài khoảng ngày)">
                    <x:String>Theo: tự động</x:String>
                    <x:String>Theo ngày</x:String>
                    <x:String>Theo tuần</x:String>
                    <x:String>Theo tháng</x:String>
                </ComboBox>
                <ToggleSwitch IsOn="{x:Bind ViewModel.ShowTables, Mode=TwoWay}" OnContent="Bảng số liệu" OffContent="Bảng số liệu"
                              AutomationProperties.Name="Bảng số liệu" />
            </StackPanel>
            <TextBlock Text="{x:Bind ViewModel.RangeText, Mode=OneWay}" Opacity="0.7" TextWrapping="Wrap" AutomationProperties.AutomationId="ChartRange" />
            <TextBlock Text="{x:Bind ViewModel.Error, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap"
                       Visibility="{x:Bind local:Ui.VisibleIfText(ViewModel.Error), Mode=OneWay}" />
            <TextBlock Text="Không có đơn hàng nào trong khoảng ngày này." Opacity="0.7"
                       Visibility="{x:Bind local:Ui.VisibleIfNot(ViewModel.HasData), Mode=OneWay}" AutomationProperties.AutomationId="ChartEmpty" />

            <!-- 4 ô số chính -->
            <ItemsRepeater x:Name="KpiList">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="150" MinColumnSpacing="10" MinRowSpacing="10" ItemsStretch="Fill" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:KpiTile">
                        <Border Padding="16,12" CornerRadius="10" BorderThickness="1"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{x:Bind Label}" FontSize="{StaticResource FontSizeCaption}" Opacity="0.75" />
                                <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left"><TextBlock Text="{x:Bind Value}" FontSize="{StaticResource FontSizeNumber}" FontWeight="SemiBold" AutomationProperties.Name="{x:Bind Label}" /></Viewbox>
                                <TextBlock Text="{x:Bind Delta}" FontSize="{StaticResource FontSizeCaption}" Opacity="0.75" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <!-- Doanh thu theo thời gian -->
            <Border Style="{StaticResource ChartCardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="{x:Bind ViewModel.SalesTitle, Mode=OneWay}" Style="{StaticResource GroupTitleTextBlockStyle}" />
                    <local:ColumnChart x:Name="SalesChart" AutomationProperties.Name="Biểu đồ doanh thu" />
                    <local:ChartTable x:Name="SalesTable" Visibility="{x:Bind local:Ui.VisibleIf(ViewModel.ShowTables), Mode=OneWay}" />
                </StackPanel>
            </Border>

            <!-- Thứ trong tuần -->
            <Border Style="{StaticResource ChartCardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Số đơn theo thứ trong tuần" Style="{StaticResource GroupTitleTextBlockStyle}" />
                    <local:ColumnChart x:Name="WeekdayChart" Height="220" AutomationProperties.Name="Biểu đồ số đơn theo thứ" />
                    <local:ChartTable x:Name="WeekdayTable" Visibility="{x:Bind local:Ui.VisibleIf(ViewModel.ShowTables), Mode=OneWay}" />
                </StackPanel>
            </Border>

            <!-- Khách mới / quay lại -->
            <Border Style="{StaticResource ChartCardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="{x:Bind ViewModel.MixTitle, Mode=OneWay}" Style="{StaticResource GroupTitleTextBlockStyle}" />
                    <TextBlock Text="Khách mới = lần đầu tiên đặt (tính trên mọi đơn từ trước tới nay) rơi vào kỳ đó." FontSize="{StaticResource FontSizeCaption}" Opacity="0.7" />
                    <local:ColumnChart x:Name="MixChart" AutomationProperties.Name="Biểu đồ khách mới và khách quay lại" />
                    <local:ChartTable x:Name="MixTable" Visibility="{x:Bind local:Ui.VisibleIf(ViewModel.ShowTables), Mode=OneWay}" />
                </StackPanel>
            </Border>

            <!-- Món bán chạy -->
            <Border Style="{StaticResource ChartCardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="10 món bán chạy (theo doanh thu)" Style="{StaticResource GroupTitleTextBlockStyle}" />
                    <local:BarList x:Name="TopList" AutomationProperties.Name="Món bán chạy" />
                    <local:ChartTable x:Name="TopTable" Visibility="{x:Bind local:Ui.VisibleIf(ViewModel.ShowTables), Mode=OneWay}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>

</Page>

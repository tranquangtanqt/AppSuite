<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    ScreenCapture is a fully standalone WinUI 3 app: it opens, builds and runs on its own (right-click
    ScreenCapture.csproj > Set as Startup Project, or `dotnet run` from this folder). It only references
    Common for the shared IModuleInfo-style contracts/logging - never MainLauncher.
  -->

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.Views.WinUI" />
    <!-- SkiaSharp.Views.WinUI kéo metapackage Microsoft.WindowsAppSDK 1.1.5 (nguyên khối, xung đột với WinUI 2.2.1):
         ghim đúng 1.1.5 + ExcludeAssets=all để bỏ hẳn asset của nó; WinUI 2.2.1 từ Modules/Directory.Build.props cung cấp runtime. -->
    <PackageReference Include="Microsoft.WindowsAppSDK" ExcludeAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Common\Common.csproj" />
    <ProjectReference Include="..\..\SharedUI\SharedUI.csproj" />
  </ItemGroup>
</Project>

<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MeRon.Views.ReportSummaryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MeRon.Views"
    NavigationCacheMode="Enabled">

    <Grid Padding="24,12,24,0" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Thống kê tổng hợp" Style="{StaticResource SubtitleTextBlockStyle}" />
        <local:DateRangeBar Grid.Row="1" Filter="{x:Bind ViewModel.Range}" />
        <InfoBar Grid.Row="2" Severity="Error" IsClosable="False" Message="{x:Bind ViewModel.Error, Mode=OneWay}"
                 IsOpen="{x:Bind local:Ui.HasText(ViewModel.Error), Mode=OneWay}" />

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="20" Padding="0,0,12,24" MaxWidth="900" HorizontalAlignment="Left">
                <TextBlock Text="{x:Bind ViewModel.Difference, Mode=OneWay}" FontWeight="SemiBold" AutomationProperties.AutomationId="SummaryDifference" />

                <!-- Đơn hàng -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Đơn hàng (không tính đơn Huỷ)" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Padding="16,10" CornerRadius="8" MinWidth="180" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Tổng số đơn" Opacity="0.75" />
                                <TextBlock Text="{x:Bind ViewModel.OrderCount, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" AutomationProperties.AutomationId="SummaryOrderCount" />
                            </StackPanel>
                        </Border>
                        <Border Padding="16,10" CornerRadius="8" MinWidth="220" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Tổng thành tiền" Opacity="0.75" />
                                <TextBlock Text="{x:Bind ViewModel.OrderAmount, Mode=OneWay}" FontSize="22" FontWeight="SemiBold"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" AutomationProperties.AutomationId="SummaryOrderAmount" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <local:ReportTable Lines="{x:Bind ViewModel.Products}" />
                </StackPanel>

                <!-- Mua hàng -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Mua hàng" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Padding="16,10" CornerRadius="8" MinWidth="180" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Tổng số phiếu nhập" Opacity="0.75" />
                                <TextBlock Text="{x:Bind ViewModel.PurchaseCount, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" AutomationProperties.AutomationId="SummaryPurchaseCount" />
                            </StackPanel>
                        </Border>
                        <Border Padding="16,10" CornerRadius="8" MinWidth="220" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Tổng thành tiền" Opacity="0.75" />
                                <TextBlock Text="{x:Bind ViewModel.PurchaseAmount, Mode=OneWay}" FontSize="22" FontWeight="SemiBold"
                                           AutomationProperties.AutomationId="SummaryPurchaseAmount" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <local:ReportTable Lines="{x:Bind ViewModel.PurchaseItems}" NameHeader="Khoản hàng" QuantityHeader="Số lần" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

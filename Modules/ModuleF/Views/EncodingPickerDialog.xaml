<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="ModuleF.Views.EncodingPickerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Chọn Encoding / Delimiter"
    PrimaryButtonText="Mở lại"
    CloseButtonText="Hủy"
    DefaultButton="Primary">

    <StackPanel Spacing="12" MinWidth="320">
        <TextBlock TextWrapping="Wrap" Opacity="0.8"
                   Text="Dùng khi nhận diện tự động sai (văn bản hiển thị lỗi hoặc bảng bị lệch cột)." />

        <ComboBox x:Name="EncodingComboBox" Header="Encoding" HorizontalAlignment="Stretch" SelectedIndex="0">
            <ComboBoxItem Content="UTF-8" Tag="utf8" />
            <ComboBoxItem Content="UTF-8 BOM" Tag="utf8bom" />
            <ComboBoxItem Content="UTF-16 LE" Tag="utf16le" />
            <ComboBoxItem Content="UTF-16 BE" Tag="utf16be" />
            <ComboBoxItem Content="Shift-JIS" Tag="shiftjis" />
        </ComboBox>

        <ComboBox x:Name="DelimiterComboBox" Header="Delimiter" HorizontalAlignment="Stretch" SelectedIndex="0">
            <ComboBoxItem Content="Dấu phẩy (,)" Tag="," />
            <ComboBoxItem Content="Tab" Tag="&#9;" />
            <ComboBoxItem Content="Dấu chấm phẩy (;)" Tag=";" />
            <ComboBoxItem Content="Dấu gạch đứng (|)" Tag="|" />
        </ComboBox>
    </StackPanel>
</ContentDialog>

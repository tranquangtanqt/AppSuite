<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Rdbms.HtmlGenerator.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Rdbms.HtmlGenerator"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Rdbms.HtmlGenerator - Từ điển dữ liệu database">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Padding="24,16,24,20" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Tiêu đề gọn + nút phụ dồn phải cùng hàng -->
        <Grid Grid.Row="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Spacing="0">
                <TextBlock Text="Từ điển dữ liệu database" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Text="Đọc cấu trúc bảng / cột từ database rồi xuất trang HTML để tra cứu" Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1" VerticalAlignment="Center" Click="OpenCompareDialog_Click" IsEnabled="{x:Bind local:MainWindow.Not(ViewModel.IsBusy), Mode=OneWay}"
                    ToolTipService.ToolTip="So sánh 2 lần đọc (vd dev với prod, hoặc bản cũ với bản mới): bảng / cột / kiểu / khoá / index thêm, bớt, đổi">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE8AB;" FontSize="14" />
                    <TextBlock Text="So sánh schema" />
                </StackPanel>
            </Button>
            <Button Grid.Column="2" VerticalAlignment="Center" Click="OpenOptionsDialog_Click" IsEnabled="{x:Bind local:MainWindow.Not(ViewModel.IsBusy), Mode=OneWay}" ToolTipService.ToolTip="Cài đặt: giới hạn thời gian kết nối / truy vấn, tự mở HTML">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE713;" FontSize="14" />
                    <TextBlock Text="Cài đặt" />
                </StackPanel>
            </Button>
            <Button Grid.Column="3" VerticalAlignment="Center" Click="HelpButton_Click" ToolTipService.ToolTip="Hướng dẫn sử dụng (F1)">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE897;" FontSize="14" />
                    <TextBlock Text="Hướng dẫn (F1)" />
                </StackPanel>
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="F1" />
                </Button.KeyboardAccelerators>
            </Button>
        </Grid>

        <!-- Thẻ Kết nối: nhãn cùng cột, 2 combobox cùng rộng, dòng cuối = đang trỏ tới đâu + đọc lúc nào -->
        <Border Grid.Row="1" Padding="16,12" CornerRadius="8" BorderThickness="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid ColumnSpacing="10" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Hồ sơ" VerticalAlignment="Center" Opacity="0.7" />
                <ComboBox x:Name="ProfileComboBox" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                          ItemsSource="{x:Bind ViewModel.ProfileNames}" AutomationProperties.Name="Hồ sơ kết nối"
                          SelectionChanged="ProfileComboBox_SelectionChanged" IsEnabled="{x:Bind local:MainWindow.Not(ViewModel.IsBusy), Mode=OneWay}"
                          ToolTipService.ToolTip="Hồ sơ kết nối (vd dev / test / prod): nguồn, thông tin kết nối và file .db / .html riêng" />
                <DropDownButton Grid.Row="0" Grid.Column="2" AutomationProperties.Name="Quản lý hồ sơ" ToolTipService.ToolTip="Thêm / đổi tên / xoá hồ sơ"
                                IsEnabled="{x:Bind local:MainWindow.Not(ViewModel.IsBusy), Mode=OneWay}">
                    <FontIcon Glyph="&#xE712;" FontSize="14" />
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuFlyoutItem Text="Thêm hồ sơ (sao chép hồ sơ đang chọn)..." Click="AddProfile_Click">
                                <MenuFlyoutItem.Icon>
                                    <SymbolIcon Symbol="Add" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Đổi tên hồ sơ..." Click="RenameProfile_Click">
                                <MenuFlyoutItem.Icon>
                                    <SymbolIcon Symbol="Rename" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="DeleteProfileItem" Text="Xoá hồ sơ..." Click="DeleteProfile_Click">
                                <MenuFlyoutItem.Icon>
                                    <SymbolIcon Symbol="Delete" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>

                <TextBlock Grid.Row="1" Text="Nguồn" VerticalAlignment="Center" Opacity="0.7" />
                <!-- Thứ tự mục = thứ tự enum DatabaseSourceType (SelectedIndex <-> enum) -->
                <ComboBox x:Name="SourceComboBox" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                          SelectionChanged="SourceComboBox_SelectionChanged" IsEnabled="{x:Bind local:MainWindow.Not(ViewModel.IsBusy), Mode=OneWay}">
                    <x:String>PostgreSQL</x:String>
                    <x:String>Oracle</x:String>
                    <x:String>MySQL</x:String>
                    <x:String>SQL Server</x:String>
                </ComboBox>
                <Button Grid.Row="1" Grid.Column="2" Click="OpenSettingsDialog_Click" IsEnabled="{x:Bind local:MainWindow.Not(ViewModel.IsBusy), Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE70F;" FontSize="14" />
                        <TextBlock Text="Thiết lập kết nối" />
                    </StackPanel>
                </Button>

                <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="6" Opacity="0.75">
                    <FontIcon Glyph="&#xE968;" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Text="{x:Bind ViewModel.ConnectionSummary, Mode=OneWay}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Thẻ 3 bước: nút cùng cỡ có biểu tượng, nút nên bấm tiếp màu nhấn; tiến trình + trạng thái ở trong thẻ -->
        <Border Grid.Row="2" Padding="16,12" CornerRadius="8" BorderThickness="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <StackPanel Spacing="10">
                <!-- 3 nút chia đều bề ngang (cửa sổ hẹp không bị cắt), mũi tên ở giữa -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.ImportDatabaseCommand}" Style="{x:Bind local:MainWindow.StepButtonStyle(ViewModel.NextStep, 1), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE896;" FontSize="14" />
                            <TextBlock Text="1. Đọc database" />
                        </StackPanel>
                    </Button>
                    <!-- Chỉ hiện khi đang đọc database -->
                    <Button x:Name="CancelImportButton" Grid.Column="1" Command="{x:Bind ViewModel.ImportDatabaseCancelCommand}"
                            Visibility="{x:Bind ViewModel.IsImporting, Mode=OneWay}"
                            ToolTipService.ToolTip="Dừng đọc database - dữ liệu đọc lần trước (nếu có) giữ nguyên">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                            <TextBlock Text="Huỷ" />
                        </StackPanel>
                    </Button>
                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="10" Opacity="0.5" VerticalAlignment="Center" />
                    <Button Grid.Column="3" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.ExportHtmlCommand}" Style="{x:Bind local:MainWindow.StepButtonStyle(ViewModel.NextStep, 2), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xEDE1;" FontSize="14" />
                            <TextBlock Text="2. Xuất HTML" />
                        </StackPanel>
                    </Button>
                    <FontIcon Grid.Column="4" Glyph="&#xE76C;" FontSize="10" Opacity="0.5" VerticalAlignment="Center" />
                    <Button Grid.Column="5" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.OpenHtmlCommand}" Style="{x:Bind local:MainWindow.StepButtonStyle(ViewModel.NextStep, 3), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                            <TextBlock Text="3. Mở file HTML" />
                        </StackPanel>
                    </Button>
                </Grid>
                <!-- Xuất thêm từ cùng file .db (bật khi đã đọc database) -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Xuất thêm:" VerticalAlignment="Center" Opacity="0.7" FontSize="12" />
                    <Button Command="{x:Bind ViewModel.ExportTableDefinitionCommand}" Padding="10,4"
                            ToolTipService.ToolTip="Excel định nghĩa bảng (テーブル定義書, tiêu đề tiếng Nhật): sheet テーブル一覧 + mỗi bảng 1 sheet - cột, kiểu, 桁数, NOT NULL, PK, mặc định, mô tả, index, khoá ngoại, ràng buộc">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE9F9;" FontSize="12" />
                            <TextBlock Text="Excel định nghĩa bảng" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.CheckQualityCommand}" Padding="10,4"
                            ToolTipService.ToolTip="Trang HTML liệt kê chỗ thiết kế đáng để ý: bảng không có khoá chính, khoá ngoại khác kiểu / không có index, index trùng, thiếu thống kê, thiếu mô tả, tên không theo quy ước">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE9D5;" FontSize="12" />
                            <TextBlock Text="Kiểm tra chất lượng" FontSize="12" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <ProgressBar IsIndeterminate="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" TextWrapping="Wrap" />
                <!-- Chỉ hiện khi Lịch sử có bản đọc trước của file .db đang chọn -->
                <HyperlinkButton x:Name="CompareWithPreviousButton" Padding="0" Margin="0,-4,0,0"
                                 Command="{x:Bind ViewModel.CompareWithPreviousCommand}"
                                 Visibility="{x:Bind ViewModel.HasPreviousRead, Mode=OneWay}"
                                 ToolTipService.ToolTip="So sánh bản đọc trước (trong Data\Database\Lịch sử) với bản đang dùng: bảng / cột / kiểu / khoá / index thêm, bớt, đổi">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE81C;" FontSize="12" />
                        <TextBlock Text="{x:Bind ViewModel.PreviousReadText, Mode=OneWay}" FontSize="12" />
                    </StackPanel>
                </HyperlinkButton>
            </StackPanel>
        </Border>

        <!-- Nhật ký: tiêu đề + nút Copy, chiếm phần còn lại -->
        <Grid Grid.Row="3" RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid>
                <TextBlock Text="Nhật ký" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                <Button HorizontalAlignment="Right" Padding="8,3" Click="CopyLog_Click" ToolTipService.ToolTip="Copy toàn bộ nhật ký">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                        <TextBlock Text="Copy" FontSize="12" />
                    </StackPanel>
                </Button>
            </Grid>
            <Border Grid.Row="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                <ListView ItemsSource="{x:Bind ViewModel.LogLines}" SelectionMode="None" Padding="0,6">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{x:Bind}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </Grid>

        <!-- "Thiết lập kết nối database" dialog -->
        <ContentDialog x:Name="DatabaseSettingsDialog"
                       Title="Thiết lập kết nối database"
                       PrimaryButtonText="Lưu"
                       SecondaryButtonText="Thử kết nối"
                       CloseButtonText="Huỷ"
                       DefaultButton="Primary"
                       PrimaryButtonClick="DatabaseSettingsDialog_PrimaryButtonClick"
                       SecondaryButtonClick="TestConnection_Click"
                       Closed="DatabaseSettingsDialog_Closed">
          <StackPanel Spacing="8">
            <!-- Kết quả "Thử kết nối" (thông tin đang nhập ở tab hiện tại, chưa cần Lưu) - đặt trên cùng để luôn thấy -->
            <InfoBar x:Name="TestConnectionInfoBar" IsOpen="False" IsClosable="False" MaxWidth="460" HorizontalAlignment="Stretch">
                <ProgressBar x:Name="TestConnectionProgress" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,8" />
            </InfoBar>
            <Pivot x:Name="SettingsPivot" MinWidth="420" SelectionChanged="SettingsPivot_SelectionChanged">
                <PivotItem Header="PostgreSQL">
                    <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="10" Margin="0,12,0,0">
                            <TextBox x:Name="PgHostBox" Header="Host" PlaceholderText="vd: localhost" />
                            <TextBox x:Name="PgPortBox" Header="Port" PlaceholderText="5432" />
                            <TextBox x:Name="PgDatabaseBox" Header="Database" />
                            <TextBox x:Name="PgUsernameBox" Header="Username" />
                            <PasswordBox x:Name="PgPasswordBox" Header="Password" />
                            <TextBox x:Name="PgSchemaBox" Header="Schema (tuỳ chọn, để trống = tất cả schema)" />
                        </StackPanel>
                    </ScrollViewer>
                </PivotItem>
                <PivotItem Header="Oracle">
                    <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="10" Margin="0,12,0,0">
                            <TextBox x:Name="OraHostBox" Header="Host" PlaceholderText="vd: localhost" />
                            <TextBox x:Name="OraPortBox" Header="Port" PlaceholderText="1521" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Kết nối bằng:" VerticalAlignment="Center" Opacity="0.7" />
                                <RadioButton x:Name="OraByServiceNameRadio" Content="Service Name" GroupName="OraConnectType" IsChecked="True" Checked="OraConnectType_Checked" />
                                <RadioButton x:Name="OraBySidRadio" Content="SID" GroupName="OraConnectType" Checked="OraConnectType_Checked" />
                            </StackPanel>
                            <TextBox x:Name="OraServiceNameBox" Header="Service Name" PlaceholderText="vd: ORCLPDB1" />
                            <TextBox x:Name="OraSidBox" Header="SID" PlaceholderText="vd: ORCL" IsEnabled="False" />
                            <TextBox x:Name="OraUsernameBox" Header="Username" />
                            <PasswordBox x:Name="OraPasswordBox" Header="Password" />
                            <TextBox x:Name="OraSchemaBox" Header="Schema (tuỳ chọn, để trống = mặc định theo Username)" />
                        </StackPanel>
                    </ScrollViewer>
                </PivotItem>
                <PivotItem Header="MySQL">
                    <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="10" Margin="0,12,0,0">
                            <TextBox x:Name="MyHostBox" Header="Host" PlaceholderText="vd: localhost" />
                            <TextBox x:Name="MyPortBox" Header="Port" PlaceholderText="3306" />
                            <TextBox x:Name="MyDatabaseBox" Header="Database (= schema trong MySQL)" />
                            <TextBox x:Name="MyUsernameBox" Header="Username" />
                            <PasswordBox x:Name="MyPasswordBox" Header="Password" />
                        </StackPanel>
                    </ScrollViewer>
                </PivotItem>
                <PivotItem Header="SQL Server">
                    <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="10" Margin="0,12,0,0">
                            <TextBox x:Name="MsHostBox" Header="Host (hoặc Host\TênInstance)" PlaceholderText="vd: localhost hoặc MAYCHU\SQLEXPRESS" />
                            <TextBox x:Name="MsPortBox" Header="Port (bỏ qua khi nhập tên instance)" PlaceholderText="1433" />
                            <TextBox x:Name="MsDatabaseBox" Header="Database" />
                            <CheckBox x:Name="MsWindowsAuthCheckBox" Content="Dùng Windows Authentication (tài khoản Windows đang đăng nhập)"
                                      Checked="MsWindowsAuth_Changed" Unchecked="MsWindowsAuth_Changed" />
                            <TextBox x:Name="MsUsernameBox" Header="Username" />
                            <PasswordBox x:Name="MsPasswordBox" Header="Password" />
                            <TextBox x:Name="MsSchemaBox" Header="Schema (tuỳ chọn, vd dbo; để trống = tất cả schema)" />
                        </StackPanel>
                    </ScrollViewer>
                </PivotItem>
            </Pivot>
          </StackPanel>
        </ContentDialog>

        <!-- So sánh schema: chọn 2 file .db đã đọc -->
        <ContentDialog x:Name="CompareDialog"
                       Title="So sánh schema"
                       PrimaryButtonText="So sánh"
                       CloseButtonText="Huỷ"
                       DefaultButton="Primary"
                       PrimaryButtonClick="CompareDialog_PrimaryButtonClick">
            <StackPanel Spacing="10" MinWidth="440">
                <TextBlock TextWrapping="Wrap" Opacity="0.8"
                           Text="Chọn 2 lần đọc database (mỗi lần bấm &quot;1. Đọc database&quot; của 1 hồ sơ / nguồn tạo 1 file). Kết quả: trang HTML liệt kê bảng / cột / kiểu / khoá / index thêm, bớt, đổi của B so với A." />
                <ComboBox x:Name="CompareAComboBox" Header="A - gốc (vd dev, hoặc bản cũ)" HorizontalAlignment="Stretch"
                          AutomationProperties.Name="So sánh A" />
                <Grid>
                    <Button HorizontalAlignment="Center" Padding="10,4" Click="CompareSwap_Click" ToolTipService.ToolTip="Đổi chỗ A và B">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8CB;" FontSize="12" />
                            <TextBlock Text="Đổi chỗ A ↔ B" FontSize="12" />
                        </StackPanel>
                    </Button>
                </Grid>
                <ComboBox x:Name="CompareBComboBox" Header="B - so với (vd prod, hoặc bản mới)" HorizontalAlignment="Stretch"
                          AutomationProperties.Name="So sánh B" />
                <TextBlock x:Name="CompareError" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                           Visibility="Collapsed" AutomationProperties.AutomationId="CompareError" />
            </StackPanel>
        </ContentDialog>

        <!-- Tên hồ sơ (Thêm / Đổi tên) -->
        <ContentDialog x:Name="ProfileNameDialog"
                       PrimaryButtonText="Lưu"
                       CloseButtonText="Huỷ"
                       DefaultButton="Primary"
                       PrimaryButtonClick="ProfileNameDialog_PrimaryButtonClick">
            <StackPanel Spacing="8" MinWidth="360">
                <TextBox x:Name="ProfileNameBox" Header="Tên hồ sơ" PlaceholderText="vd: dev, test, prod" MaxLength="40"
                         AutomationProperties.Name="Tên hồ sơ" />
                <TextBlock x:Name="ProfileNameHint" TextWrapping="Wrap" Opacity="0.7" FontSize="12" />
                <TextBlock x:Name="ProfileNameError" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                           Visibility="Collapsed" AutomationProperties.AutomationId="ProfileNameError" />
            </StackPanel>
        </ContentDialog>

        <!-- "Cài đặt" dialog -->
        <ContentDialog x:Name="OptionsDialog"
                       Title="Cài đặt"
                       PrimaryButtonText="Lưu"
                       SecondaryButtonText="Mặc định"
                       CloseButtonText="Huỷ"
                       DefaultButton="Primary"
                       PrimaryButtonClick="OptionsDialog_PrimaryButtonClick"
                       SecondaryButtonClick="OptionsDialog_SecondaryButtonClick">
            <!-- ContentDialog tắt cuộn dọc của chính nó → nội dung dài hơn cửa sổ bị cắt mất (ô cuối không thấy). Tự cuộn;
                 MaxHeight đặt theo cửa sổ lúc mở (OpenOptionsDialog_Click). Mô tả là TextBlock riêng để xuống dòng
                 (Description của NumberBox không xuống dòng, bị cắt). -->
            <ScrollViewer x:Name="OptionsScroller" VerticalScrollBarVisibility="Auto" MaxHeight="440" Padding="0,0,16,0">
            <StackPanel Spacing="14" Width="440">
                <NumberBox x:Name="ConnectTimeoutBox" Header="Giới hạn thời gian kết nối (giây)"
                           Minimum="1" Maximum="600" SmallChange="5" LargeChange="30" SpinButtonPlacementMode="Inline" />
                <TextBlock Margin="0,-10,0,0" TextWrapping="Wrap" Opacity="0.7" FontSize="12" Text="Quá thời gian này mà chưa kết nối được (sai IP, chưa bật VPN, firewall chặn...) thì báo lỗi. Mạng chậm thì tăng lên." />
                <NumberBox x:Name="CommandTimeoutBox" Header="Giới hạn thời gian truy vấn (giây)"
                           Minimum="1" Maximum="3600" SmallChange="30" LargeChange="300" SpinButtonPlacementMode="Inline" />
                <TextBlock Margin="0,-10,0,0" TextWrapping="Wrap" Opacity="0.7" FontSize="12" Text="Cho mỗi câu truy vấn đọc schema. Database rất nhiều bảng / máy chủ chậm thì tăng lên." />
                <ToggleSwitch x:Name="OpenHtmlAfterExportSwitch" Header="Tự mở file HTML sau khi xuất" OffContent="Tắt" OnContent="Bật" />
                <ToggleSwitch x:Name="OpenFolderAfterExportSwitch" Header="Tự mở thư mục chứa file HTML sau khi xuất" OffContent="Tắt" OnContent="Bật" />
                <NumberBox x:Name="HistoryCountBox" Header="Giữ lại số bản đọc cũ (mỗi database)"
                           Minimum="0" Maximum="50" SmallChange="1" LargeChange="5" SpinButtonPlacementMode="Inline" />
                <TextBlock Margin="0,-10,0,0" TextWrapping="Wrap" Opacity="0.7" FontSize="12" Text="Trước khi đọc lại, bản cũ được chép vào Data\Database\Lịch sử để so sánh bản cũ ↔ bản mới. Lần đọc không có thay đổi thì không giữ thêm bản. 0 = không giữ." />
                <!-- Trống = đọc hết; có mẫu thì bỏ bảng / view khớp (Services\TableNameFilter) -->
                <StackPanel Spacing="4">
                    <TextBox x:Name="ExcludeTablePatternsBox" Header="Bỏ qua bảng / view khi đọc (để trống = đọc hết)"
                             PlaceholderText="vd: tmp_%, %_bk, %_old" AutomationProperties.Name="Bỏ qua bảng / view khi đọc" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="12"

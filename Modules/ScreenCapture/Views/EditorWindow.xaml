<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ScreenCapture.Views.EditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ScreenCapture.Views"
    xmlns:skia="using:SkiaSharp.Views.Windows"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="ScreenCapture - Editor">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!-- Kéo-thả file ảnh vào bất kỳ đâu trong Editor → mở thành tab mới. -->
    <Grid Padding="8" RowSpacing="0" Background="Transparent" AllowDrop="True" DragOver="Root_DragOver" Drop="Root_Drop">
        <Grid.Resources>
            <!-- Icon-on-top + small label toolbar button, dùng chung cho mọi nút trong toolbar
                 (ButtonBase để áp được cho cả Button lẫn ToggleButton). -->
            <Style x:Key="ToolButtonStyle" TargetType="ButtonBase">
                <Setter Property="Padding" Value="3,4" />
                <Setter Property="MinWidth" Value="40" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
            </Style>
            <!-- Nút cố định góc phải hàng tab (Lưu, Copy, Hoàn tác, Làm lại, Hướng dẫn): luôn thấy ở mọi tab ribbon. -->
            <Style x:Key="QuickButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="30" />
                <Setter Property="MinWidth" Value="34" />
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <!-- Nút nhỏ 1 hàng (icon + chữ), xếp 3 nút chồng nhau trong 1 cột như ribbon Office/PicPick - cho
                 các lệnh phụ (Xoá / Lên trên / Xuống dưới). -->
            <Style x:Key="SmallToolButtonStyle" TargetType="Button">
                <Setter Property="Padding" Value="6,0" />
                <Setter Property="Height" Value="21" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
            </Style>
            <Style x:Key="SmallToolButtonContentStyle" TargetType="StackPanel">
                <Setter Property="Orientation" Value="Horizontal" />
                <Setter Property="Spacing" Value="6" />
            </Style>
            <!-- Nút -/+ nhỏ hai bên ô số (Stamp Format), cao bằng NumberBox. -->
            <Style x:Key="StepperButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="26" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="ToolButtonContentStyle" TargetType="StackPanel">
                <Setter Property="Spacing" Value="2" />
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>
            <!-- Tab header ribbon (Trang chủ/Tệp) - ToggleButton phẳng, chỉ đổi nền lúc Checked
                 (theme resource mặc định), không cần ControlTemplate riêng. -->
            <Style x:Key="RibbonTabHeaderStyle" TargetType="ToggleButton">
                <Setter Property="Padding" Value="16,6" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="4,4,0,0" />
            </Style>
            <!-- Khung 1 nhóm nút trong ribbon content, có nhãn nhóm phía dưới giống PicPick. -->
            <Style x:Key="RibbonGroupStyle" TargetType="Border">
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="6,4" />
                <Setter Property="Margin" Value="0,0,4,0" />
            </Style>
            <Style x:Key="RibbonGroupLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Opacity" Value="0.65" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,2,0,0" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: tab header -->
        <StackPanel Orientation="Horizontal" Spacing="2" Grid.Row="0">
            <ToggleButton x:Name="HomeTabHeader" Content="Trang chủ" Style="{StaticResource RibbonTabHeaderStyle}"
                          IsChecked="True" Click="RibbonTabHeader_Click" />
            <ToggleButton x:Name="FileTabHeader" Content="Tệp" Style="{StaticResource RibbonTabHeaderStyle}"
                          Click="RibbonTabHeader_Click" />
            <ToggleButton x:Name="NumberStampTabHeader" Content="Dấu số" Style="{StaticResource RibbonTabHeaderStyle}"
                          Click="RibbonTabHeader_Click" Visibility="Collapsed" />
            <ToggleButton x:Name="RegionTabHeader" Content="Vùng chọn" Style="{StaticResource RibbonTabHeaderStyle}"
                          Click="RibbonTabHeader_Click" Visibility="Collapsed" />
            <ToggleButton x:Name="FormatTabHeader" Content="Định dạng" Style="{StaticResource RibbonTabHeaderStyle}"
                          Click="RibbonTabHeader_Click" Visibility="Collapsed" />
        </StackPanel>
        <!-- Việc làm nhiều nhất sau khi ghi chú: luôn thấy, không phải đổi tab ribbon. -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button x:Name="QuickSaveButton" Style="{StaticResource QuickButtonStyle}" Click="SaveButton_Click"
                    AutomationProperties.Name="Lưu" ToolTipService.ToolTip="Lưu (Ctrl+S)">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE74E;" FontSize="16" />
                    <TextBlock Text="Lưu" />
                </StackPanel>
            </Button>
            <Button x:Name="QuickCopyButton" Style="{StaticResource QuickButtonStyle}" Click="CopyButton_Click"
                    AutomationProperties.Name="Copy" ToolTipService.ToolTip="Copy ảnh (Ctrl+C)">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE8C8;" FontSize="16" />
                    <TextBlock Text="Copy" />
                </StackPanel>
            </Button>
            <Button x:Name="UndoButton" Style="{StaticResource QuickButtonStyle}" Click="UndoButton_Click"
                    AutomationProperties.Name="Hoàn tác" ToolTipService.ToolTip="Hoàn tác (Ctrl+Z)">
                <FontIcon Glyph="&#xE7A7;" FontSize="16" />
            </Button>
            <Button x:Name="RedoButton" Style="{StaticResource QuickButtonStyle}" Click="RedoButton_Click"
                    AutomationProperties.Name="Làm lại" ToolTipService.ToolTip="Làm lại (Ctrl+Y / Ctrl+Shift+Z)">
                <FontIcon Glyph="&#xE7A6;" FontSize="16" />
            </Button>
            <Button x:Name="HelpHeaderButton" Style="{StaticResource QuickButtonStyle}" Click="HelpButton_Click"
                    AutomationProperties.Name="Hướng dẫn" ToolTipService.ToolTip="Hướng dẫn: tất cả tính năng và phím tắt (F1)">
                <FontIcon Glyph="&#xE897;" FontSize="16" />
            </Button>
        </StackPanel>

        <!-- Row 1: ribbon content, đổi theo tab đang chọn -->
        <Border x:Name="RibbonBorder" Grid.Row="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,6"
                SizeChanged="RibbonBorder_SizeChanged">
            <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- Cửa sổ hẹp: các nhóm bên phải chuyển vào nút Thêm (EditorWindow.Ribbon.cs); cuộn ngang chỉ còn cho cửa sổ rất hẹp.
                 Bảng con trong ribbon đều ShouldConstrainToRootBounds=False: không thì nằm dưới khung Thêm, không thấy.
                 Cao cố định: đổi tab ribbon thì ảnh bên dưới không nhảy. -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled"
                          VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled">
            <Grid Height="91">
                <StackPanel x:Name="HomeRibbonPanel" Orientation="Horizontal">

                    <Border Style="{StaticResource RibbonGroupStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <ToggleButton x:Name="MoveToolButton" Style="{StaticResource ToolButtonStyle}" Click="MoveToolButton_Click" ToolTipService.ToolTip="Di chuyển: chọn và kéo hình đã vẽ (kéo góc để đổi cỡ). Bấm vùng trống / Esc = bỏ chọn">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <!-- Icon con trỏ chuột (như PicPick) - Segoe Fluent Icons không có glyph
                                             mũi tên con trỏ phù hợp nên vẽ bằng PathIcon. -->
                                        <Viewbox Width="16" Height="16" HorizontalAlignment="Center">
                                            <PathIcon Data="M0,0 L0,17 L4.2,13 L7.2,20 L10,18.8 L7,12 L12.5,12 Z" />
                                        </Viewbox>
                                        <TextBlock Text="Di chuyển" FontSize="12" />
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton x:Name="SelectToolButton" Style="{StaticResource ToolButtonStyle}" Click="SelectToolButton_Click"
                                              ToolTipService.ToolTip="Kéo chọn 1 vùng để Cắt ảnh / Copy / Cắt vùng / Xoá">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE8B3;" />
                                        <TextBlock Text="Chọn vùng" FontSize="12" />
                                    </StackPanel>
                                </ToggleButton>
                                <StackPanel Spacing="1" VerticalAlignment="Center">
                                    <Button x:Name="DeleteButton" Style="{StaticResource SmallToolButtonStyle}" Click="DeleteButton_Click" IsEnabled="False"
                                            ToolTipService.ToolTip="Xoá hình đang chọn (Delete)">
                                        <StackPanel Style="{StaticResource SmallToolButtonContentStyle}">
                                            <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                            <TextBlock Text="Xoá" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="BringToFrontButton" Style="{StaticResource SmallToolButtonStyle}" Click="BringToFrontButton_Click" IsEnabled="False" ToolTipService.ToolTip="Đưa hình đang chọn lên trên các hình khác">
                                        <StackPanel Style="{StaticResource SmallToolButtonContentStyle}">
                                            <Viewbox Width="12" Height="12"><PathIcon Data="F1 M0,0 H10 V10 H0 Z M1.5,1.5 V8.5 H8.5 V1.5 Z M6,6 H16 V16 H6 Z" /></Viewbox>
                                            <TextBlock Text="Lên trên" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="SendToBackButton" Style="{StaticResource SmallToolButtonStyle}" Click="SendToBackButton_Click" IsEnabled="False" ToolTipService.ToolTip="Đưa hình đang chọn xuống dưới các hình khác">
                                        <StackPanel Style="{StaticResource SmallToolButtonContentStyle}">
                                            <Viewbox Width="12" Height="12"><PathIcon Data="F1 M0,0 H10 V10 H0 Z M1.5,1.5 V8.5 H8.5 V1.5 Z M11.5,6 H16 V16 H6 V11.5 H11.5 Z" /></Viewbox>
                                            <TextBlock Text="Xuống dưới" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Text="Chọn" Style="{StaticResource RibbonGroupLabelStyle}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource RibbonGroupStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <ToggleButton x:Name="RectangleToolButton" Style="{StaticResource ToolButtonStyle}" Click="RectangleToolButton_Click" ToolTipService.ToolTip="Chữ nhật: kéo để vẽ khung (giữ Shift: hình vuông). Viền theo Màu nét và Cỡ nét">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE739;" />
                                        <TextBlock Text="Chữ nhật" FontSize="12" />
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton x:Name="FilledRectangleToolButton" Style="{StaticResource ToolButtonStyle}" Click="FilledRectangleToolButton_Click"
                                              ToolTipService.ToolTip="Chữ nhật tô nền trong mờ: viền Màu nét, nền Màu nền (chữ bên dưới vẫn đọc được). Màu nền đang là trắng thì tự đổi sang vàng.">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <Rectangle Width="20" Height="16" Margin="0,1" HorizontalAlignment="Center" Fill="#99FFC107"
                                                   Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="1.5" />
                                        <TextBlock Text="Chữ nhật tô" FontSize="12" />
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton x:Name="EllipseToolButton" Style="{StaticResource ToolButtonStyle}" Click="EllipseToolButton_Click" ToolTipService.ToolTip="Elip: kéo để vẽ (giữ Shift: hình tròn). Viền theo Màu nét và Cỡ nét">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xEA3A;" />
                                        <TextBlock Text="Elip" FontSize="12" />
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton x:Name="LineToolButton" Style="{StaticResource ToolButtonStyle}" Click="LineToolButton_Click"
                                              ToolTipService.ToolTip="Đường thẳng (giữ Shift: khoá góc 45°)">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <TextBlock Text="&#x2571;" FontSize="16" HorizontalAlignment="Center" />
                                        <TextBlock Text="Đường" FontSize="12" />
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton x:Name="ArrowToolButton" Style="{StaticResource ToolButtonStyle}" Click="ArrowToolButton_Click" ToolTipService.ToolTip="Mũi tên: kéo từ chỗ bắt đầu tới chỗ cần chỉ (giữ Shift: khoá góc 45°). Kiểu đầu mũi tên ở tab Định dạng">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE72A;" />
                                        <TextBlock Text="Mũi tên" FontSize="12" />
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton x:Name="PenToolButton" Style="{StaticResource ToolButtonStyle}" Click="PenToolButton_Click"
                                              ToolTipService.ToolTip="Bút vẽ tự do - theo Màu nét và Cỡ nét. Sửa nét đã vẽ bằng công cụ Di chuyển.">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xEE56;" />
                                        <TextBlock Text="Bút" FontSize="12" />
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton x:Name="HighlightToolButton" Style="{StaticResource ToolButtonStyle}" Click="HighlightToolButton_Click" ToolTipService.ToolTip="Tô sáng: kéo để tô 1 vùng màu trong mờ như bút dạ quang (màu theo Màu nền)">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE7E6;" />
                                        <TextBlock Text="Tô sáng" FontSize="12" />
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton x:Name="TextToolButton" Style="{StaticResource ToolButtonStyle}" Click="TextToolButton_Click"
                                              ToolTipService.ToolTip="Bấm lên ảnh rồi gõ chữ ngay tại chỗ (Enter = xuống dòng, Esc / bấm ra ngoài = xong). Nhấp đúp chữ đã có để sửa. Phông, cỡ, đậm / nghiêng, nền, viền chữ ở tab Định dạng.">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE8D2;" />
                                        <TextBlock Text="Chữ" FontSize="12" />
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton x:Name="CalloutToolButton" Style="{StaticResource ToolButtonStyle}" Click="CalloutToolButton_Click"
                                              ToolTipService.ToolTip="Khung chú thích (bong bóng lời nói): kéo khung (hoặc bấm 1 cái) rồi gõ chữ; kéo chấm tròn ở đầu đuôi để chỉ vào chỗ cần chú thích. Viền và chữ theo Màu nét, nền theo Màu nền.">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE90A;" />
                                        <TextBlock Text="Chú thích" FontSize="12" />
                                    </StackPanel>
                                </ToggleButton>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Text="Vẽ hình" Style="{StaticResource RibbonGroupLabelStyle}" />
                        </Grid>
                    </Border>

                    <!-- Dùng chung cho tab Trang chủ và Định dạng: code chuyển nhóm này sang tab đang mở (SelectRibbonTab). -->
                    <Border x:Name="ColorSizeGroup" Style="{StaticResource RibbonGroupStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Màu nét" FontSize="12" HorizontalAlignment="Center" />
                                    <Button x:Name="Color1Button" Width="32" Height="32" Padding="0">
                                        <Rectangle x:Name="Color1Swatch" Width="22" Height="22" Fill="#E74C3C" Stroke="Gray" StrokeThickness="1" />
                                        <Button.Flyout>
                                            <Flyout ShouldConstrainToRootBounds="False">
                                                <ColorPicker x:Name="Color1ColorPicker" ColorChanged="Color1ColorPicker_ColorChanged"
                                                             IsMoreButtonVisible="False" IsAlphaEnabled="False" />
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                                <!-- Tab Định dạng ẩn cột Màu nền / Cỡ nét khi không áp dụng (UpdateColorSizeColumns). -->
                                <StackPanel x:Name="Color2Column" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Màu nền" FontSize="12" HorizontalAlignment="Center" />
                                    <Button x:Name="Color2Button" Width="32" Height="32" Padding="0">
                                        <Rectangle x:Name="Color2Swatch" Width="22" Height="22" Fill="White" Stroke="Gray" StrokeThickness="1" />
                                        <Button.Flyout>
                                            <Flyout ShouldConstrainToRootBounds="False">
                                                <ColorPicker x:Name="Color2ColorPicker" ColorChanged="Color2ColorPicker_ColorChanged"
                                                             IsMoreButtonVisible="False" IsAlphaEnabled="False" />
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                                <StackPanel x:Name="SizeColumn" VerticalAlignment="Center" Width="84">
                                    <TextBlock Text="Cỡ nét" FontSize="12" />
                                    <Slider x:Name="SizeSlider" ValueChanged="SizeSlider_ValueChanged" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Text="Màu &amp; Cỡ nét" Style="{StaticResource RibbonGroupLabelStyle}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource RibbonGroupStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <ToggleButton x:Name="FillToolButton" Style="{StaticResource ToolButtonStyle}" Click="FillToolButton_Click" ToolTipService.ToolTip="Tô màu: bấm lên ảnh để đổ Màu nét vào vùng cùng màu quanh chỗ bấm">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE8D3;" />
                                        <TextBlock Text="Tô màu" FontSize="12" />
                                    </StackPanel>
                                </ToggleButton>
                                <Button x:Name="StampsToolButton" Style="{StaticResource ToolButtonStyle}" ToolTipService.ToolTip="Con dấu: chọn dấu số 1, 2, 3… hoặc dấu hình (mũi tên, cờ, cảnh báo…), rồi bấm lên ảnh để đặt">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <!-- Dấu số "1" trong vòng tròn: dấu hay dùng nhất (icon dấu tick cũ dễ hiểu nhầm là "xong"). -->
                                        <Grid Width="20" Height="20" HorizontalAlignment="Center">
                                            <Ellipse Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                                            <TextBlock Text="1" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBlock Text="Con dấu" FontSize="12" />
                                    </StackPanel>
                                    <Button.Flyout>
                                        <Flyout x:Name="StampsFlyout" Placement="Bottom" ShouldConstrainToRootBounds="False">
                                            <ScrollViewer MaxHeight="360" MaxWidth="340">
                                                <StackPanel Spacing="8">
                                                    <TextBlock Text="Dấu số" FontWeight="SemiBold" />
                                                    <ItemsControl x:Name="NumberStampsList" ItemsSource="{x:Bind NumberStamps}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" Spacing="6" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="local:StampPickerItem">
                                                                <Button Padding="0" CornerRadius="16" Click="NumberStampItem_Click" Tag="{x:Bind Brush}">
                                                                    <Grid>
                                                                        <Ellipse Width="32" Height="32" Fill="{x:Bind Brush}" Stroke="White" StrokeThickness="2" />
                                                                        <TextBlock Text="1" Foreground="White" FontWeight="Bold"
                                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Grid>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <TextBlock Text="Dấu hình" FontWeight="SemiBold" />
                                                    <ItemsControl x:Name="GeneralStampsList" ItemsSource="{x:Bind GeneralStamps}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="44" ItemHeight="44" MaximumRowsOrColumns="6" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="local:StampPickerItem">
                                                                <Button Width="40" Height="40" Padding="0" Click="StampItem_Click" Tag="{x:Bind Kind}">
                                                                    <FontIcon Glyph="{x:Bind Glyph}" Foreground="{x:Bind Brush}" RenderTransformOrigin="0.5,0.5">
                                                                        <FontIcon.RenderTransform>
                                                                            <RotateTransform Angle="{x:Bind Rotation}" />
                                                                        </FontIcon.RenderTransform>
                                                                    </FontIcon>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Text="Tô &amp; Dấu" Style="{StaticResource RibbonGroupLabelStyle}" />
                        </Grid>
                    </Border>

                    <!-- Che thông tin nhạy cảm (RedactAnnotation): kéo khung lên vùng cần che; Size = mức độ che. -->
                    <Border Style="{StaticResource RibbonGroupStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <ToggleButton x:Name="MosaicToolButton" Style="{StaticResource ToolButtonStyle}" Click="MosaicToolButton_Click"
                                              ToolTipService.ToolTip="Che bằng ô vuông pixel - kéo khung lên vùng cần che (mật khẩu, email...). Cỡ nét = cỡ ô.">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE80A;" />
                                        <TextBlock Text="Mosaic" FontSize="12" />
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton x:Name="BlurToolButton" Style="{StaticResource ToolButtonStyle}" Click="BlurToolButton_Click"
                                              ToolTipService.ToolTip="Che bằng cách làm mờ - kéo khung lên vùng cần che. Cỡ nét = độ mờ (chữ nhỏ nên để Cỡ nét cao hoặc dùng Mosaic).">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xED1A;" />
                                        <TextBlock Text="Làm mờ" FontSize="12" />
                                    </StackPanel>
                                </ToggleButton>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Text="Che" Style="{StaticResource RibbonGroupLabelStyle}" />
                        </Grid>
                    </Border>

                    <!-- Đọc chữ trong ảnh (OCR, thư viện Common.Ocr dùng chung với ImageCompare): khung Tìm chữ bên phải ảnh. -->
                    <Border Style="{StaticResource RibbonGroupStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <ToggleButton x:Name="TextSearchButton" Style="{StaticResource ToolButtonStyle}" Click="TextSearchButton_Click"
                                          ToolTipService.ToolTip="Tìm chữ trong ảnh (Ctrl+F): đọc chữ (tiếng Nhật / Việt / Anh), tô các chỗ khớp, copy toàn bộ chữ, biến chỗ khớp thành hình Tô sáng">
                                <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                    <FontIcon Glyph="&#xE721;" />
                                    <TextBlock Text="Tìm chữ" FontSize="12" />
                                </StackPanel>
                            </ToggleButton>
                            <TextBlock Grid.Row="1" Text="Chữ" Style="{StaticResource RibbonGroupLabelStyle}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource RibbonGroupStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <ToggleButton x:Name="CropToolButton" Style="{StaticResource ToolButtonStyle}" Click="CropToolButton_Click" ToolTipService.ToolTip="Cắt: kéo khung phần cần giữ, thả chuột là cắt. Kéo cạnh khung ảnh ra để lấy lại phần đã cắt">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE7A8;" />
                                        <TextBlock Text="Cắt" FontSize="12" />
                                    </StackPanel>
                                </ToggleButton>
                                <!-- Xoay / lật / co giãn cả ảnh (cùng các shape) - khác kéo khung ảnh (chỉ nới / cắt khung). -->
                                <Button x:Name="TransformButton" Style="{StaticResource ToolButtonStyle}"
                                        ToolTipService.ToolTip="Xoay, lật, đổi cỡ ảnh">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE7AD;" />
                                        <TextBlock Text="Xoay" FontSize="12" />
                                    </StackPanel>
                                    <Button.Flyout>
                                        <MenuFlyout Placement="Bottom" ShouldConstrainToRootBounds="False" Opening="TransformFlyout_Opening">
                                            <MenuFlyoutItem x:Name="RotateRightItem" Text="Xoay phải 90°" Tag="RotateRight"
                                                            KeyboardAcceleratorTextOverride="Ctrl+R" Click="TransformItem_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE7AD;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem x:Name="RotateLeftItem" Text="Xoay trái 90°" Tag="RotateLeft"
                                                            KeyboardAcceleratorTextOverride="Ctrl+Shift+R" Click="TransformItem_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE7AD;" RenderTransformOrigin="0.5,0.5">
                                                        <FontIcon.RenderTransform>
                                                            <ScaleTransform ScaleX="-1" />
                                                        </FontIcon.RenderTransform>
                                                    </FontIcon>
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem x:Name="Rotate180Item" Text="Xoay 180°" Tag="Rotate180" Click="TransformItem_Click" />
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem x:Name="FlipHorizontalItem" Text="Lật ngang" Tag="FlipHorizontal" Click="TransformItem_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE8AB;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem x:Name="FlipVerticalItem" Text="Lật dọc" Tag="FlipVertical" Click="TransformItem_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE8AB;" RenderTransformOrigin="0.5,0.5">
                                                        <FontIcon.RenderTransform>
                                                            <RotateTransform Angle="90" />
                                                        </FontIcon.RenderTransform>
                                                    </FontIcon>
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem x:Name="ResetOrientationItem" Text="Về hướng ban đầu" Click="ResetOrientationItem_Click"
                                                            ToolTipService.ToolTip="Xoay / lật ngược lại mọi lần Xoay / Lật trước đó (hình vẽ đi theo ảnh)">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE777;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem x:Name="ResizeImageItem" Text="Đổi cỡ ảnh…"
                                                            KeyboardAcceleratorTextOverride="Ctrl+E" Click="ResizeImageItem_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE740;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                                <!-- Hiệu ứng ảnh (áp lên ảnh nền, các hình đã vẽ giữ nguyên): mục có "…" mở hộp thoại xem trước. -->
                                <Button x:Name="EffectsButton" Style="{StaticResource ToolButtonStyle}"
                                        ToolTipService.ToolTip="Hiệu ứng ảnh: viền, đổ bóng, mép rách, độ sáng / tương phản, làm xám, sepia, đảo màu, làm nét, watermark">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE790;" />
                                        <TextBlock Text="Hiệu ứng" FontSize="12" />
                                    </StackPanel>
                                    <Button.Flyout>
                                        <MenuFlyout Placement="Bottom" ShouldConstrainToRootBounds="False">
                                            <MenuFlyoutItem Text="Viền ảnh…" Tag="Border" Click="EffectItem_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE739;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Đổ bóng…" Tag="Shadow" Click="EffectItem_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE81E;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Mép rách…" Tag="Torn" Click="EffectItem_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE8C6;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="Độ sáng / tương phản…" Tag="Brightness" Click="EffectItem_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE706;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Làm xám" Tag="Grayscale" Click="EffectItem_Click" />
                                            <MenuFlyoutItem Text="Sepia (ảnh cũ)" Tag="Sepia" Click="EffectItem_Click" />
                                            <MenuFlyoutItem Text="Đảo màu" Tag="Invert" Click="EffectItem_Click" />
                                            <MenuFlyoutItem Text="Làm nét" Tag="Sharpen" Click="EffectItem_Click" />
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="Watermark…" Tag="Watermark" Click="EffectItem_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE8D4;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                                <Button x:Name="PasteButton" Style="{StaticResource ToolButtonStyle}" Click="PasteButton_Click" ToolTipService.ToolTip="Dán ảnh từ clipboard (Ctrl+V)">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE77F;" />
                                        <TextBlock Text="Dán" FontSize="12" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Text="Cắt &amp; Sửa" Style="{StaticResource RibbonGroupLabelStyle}" />
                        </Grid>
                    </Border>

                </StackPanel>

                <StackPanel x:Name="FileRibbonPanel" Orientation="Horizontal" Visibility="Collapsed">

                    <Border Style="{StaticResource RibbonGroupStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <Button x:Name="OpenImageButton" Style="{StaticResource ToolButtonStyle}" Click="OpenImageButton_Click"
                                        ToolTipService.ToolTip="Mở ảnh có sẵn (PNG, JPG, BMP, GIF, WEBP) thành tab mới để ghi chú - chọn được nhiều file, hoặc kéo-thả file vào Editor (Ctrl+O)">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE8E5;" />
                                        <TextBlock Text="Mở" FontSize="12" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="NewImageButton" Style="{StaticResource ToolButtonStyle}" Click="NewImageButton_Click"
                                        ToolTipService.ToolTip="Tạo ảnh trống thành tab mới - chọn cỡ (ảnh trong clipboard, ảnh đang mở, màn hình…) và màu nền (Ctrl+N)">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE8A5;" />
                                        <TextBlock Text="Ảnh mới" FontSize="12" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Text="Mở &amp; Tạo" Style="{StaticResource RibbonGroupLabelStyle}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource RibbonGroupStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <Button x:Name="SaveButton" Style="{StaticResource ToolButtonStyle}" Click="SaveButton_Click"
                                        ToolTipService.ToolTip="Lưu (Ctrl+S): ảnh đã gắn với 1 file (đã lưu trước đó, hoặc mở từ PNG / JPG / BMP) thì ghi đè file đó, chưa có thì hỏi nơi lưu như Lưu thành">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE74E;" />
                                        <TextBlock Text="Lưu" FontSize="12" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="SaveAsButton" Style="{StaticResource ToolButtonStyle}" Click="SaveAsButton_Click"
                                        ToolTipService.ToolTip="Lưu thành file mới: chọn nơi lưu và định dạng PNG / JPG / BMP (Ctrl+Shift+S). Chất lượng JPG chỉnh trong Cài đặt">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE792;" />
                                        <TextBlock Text="Lưu thành…" FontSize="12" />
                                    </StackPanel>
                                </Button>
                                <!-- Mở thư mục chứa ảnh đang mở (Explorer chọn sẵn file); tooltip = đường dẫn (UpdateOpenFolderButton). -->
                                <Button x:Name="OpenFolderButton" Style="{StaticResource ToolButtonStyle}" Click="OpenFolderButton_Click"
                                        AutomationProperties.Name="Mở thư mục">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE838;" />
                                        <TextBlock Text="Mở thư mục" FontSize="12" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ToolButtonStyle}" Click="CopyButton_Click" ToolTipService.ToolTip="Copy ảnh (Ctrl+C)">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE8C8;" />
                                        <TextBlock Text="Copy" FontSize="12" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Text="Lưu" Style="{StaticResource RibbonGroupLabelStyle}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource RibbonGroupStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <Button Style="{StaticResource ToolButtonStyle}" Click="SettingsButton_Click" ToolTipService.ToolTip="Phím tắt, hẹn giờ, tự động lưu, phiên làm việc...">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE713;" />
                                        <TextBlock Text="Cài đặt" FontSize="12" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ToolButtonStyle}" Click="HelpButton_Click" ToolTipService.ToolTip="Tất cả tính năng và phím tắt (F1)">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE897;" />
                                        <TextBlock Text="Hướng dẫn" FontSize="12" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ToolButtonStyle}" Click="CloseButton_Click" ToolTipService.ToolTip="Đóng cửa sổ Editor">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE711;" />
                                        <TextBlock Text="Đóng" FontSize="12" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Text="Cửa sổ" Style="{StaticResource RibbonGroupLabelStyle}" />
                        </Grid>
                    </Border>

                </StackPanel>

                <!-- Tab contextual "Định dạng": hiện khi đang chọn / đang vẽ chữ, khung chú thích, hình, đường, bút. Đổi gì
                     cũng áp cho shape đang chọn (nếu có) và cho các shape vẽ tiếp bằng công cụ đang dùng. Mỗi nhóm chỉ hiện
                     khi hợp với loại shape (UpdateFormatTab). Nhóm Màu & Cỡ nét được chuyển sang đầu tab này khi mở. -->
                <StackPanel x:Name="FormatRibbonPanel" Orientation="Horizontal" Visibility="Collapsed">

                    <Border x:Name="FontGroup" Style="{StaticResource RibbonGroupStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel Spacing="4">
                                <ComboBox x:Name="FontFamilyBox" Width="176" Height="30" SelectionChanged="FontFamilyBox_SelectionChanged"
                                          ToolTipService.ToolTip="Phông chữ (gõ vài chữ đầu để nhảy tới phông)" />
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <ComboBox x:Name="FontSizeBox" Width="84" IsEditable="True" MaxDropDownHeight="320"
                                              SelectionChanged="FontSizeBox_SelectionChanged" TextSubmitted="FontSizeBox_TextSubmitted"
                                              ToolTipService.ToolTip="Cỡ chữ (px) - chọn trong danh sách hoặc gõ số rồi Enter" />
                                    <ToggleButton x:Name="BoldButton" Width="36" Height="32" Padding="0" Click="BoldButton_Click"
                                                  ToolTipService.ToolTip="Chữ đậm">
                                        <TextBlock Text="B" FontWeight="Bold" />
                                    </ToggleButton>
                                    <ToggleButton x:Name="ItalicButton" Width="36" Height="32" Padding="0" Click="ItalicButton_Click"
                                                  ToolTipService.ToolTip="Chữ nghiêng">
                                        <TextBlock Text="I" FontStyle="Italic" FontFamily="Times New Roman" FontSize="16" />
                                    </ToggleButton>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Text="Phông chữ" Style="{StaticResource RibbonGroupLabelStyle}" />
                        </Grid>
                    </Border>

                    <Border x:Name="TextDecorGroup" Style="{StaticResource RibbonGroupStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel Spacing="2">
                                <CheckBox x:Name="TextBackgroundCheck" Content="Nền ô chữ" MinWidth="0"
                                          Click="TextBackgroundCheck_Click" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <CheckBox x:Name="TextOutlineCheck" Content="Viền chữ" MinWidth="0" Click="TextOutlineCheck_Click"
                                              ToolTipService.ToolTip="Viền quanh từng nét chữ - chữ dễ đọc trên ảnh nhiều màu" />
                                    <Button x:Name="TextOutlineColorButton" Width="28" Height="28" Padding="0" VerticalAlignment="Center"
                                            ToolTipService.ToolTip="Màu viền chữ">
                                        <Rectangle x:Name="TextOutlineSwatch" Width="18" Height="18" Fill="White" Stroke="Gray" StrokeThickness="1" />
                                        <Button.Flyout>
                                            <Flyout ShouldConstrainToRootBounds="False">
                                                <ColorPicker x:Name="TextOutlineColorPicker" ColorChanged="TextOutlineColorPicker_ColorChanged"
                                                             IsMoreButtonVisible="False" IsAlphaEnabled="False" />
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Text="Nền &amp; viền chữ" Style="{StaticResource RibbonGroupLabelStyle}" />
                        </Grid>
                    </Border>

                    <Border x:Name="ShapeFillGroup" Style="{StaticResource RibbonGroupStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel Spacing="2">
                                <CheckBox x:Name="ShapeFillCheck" Content="Tô nền" MinWidth="0" Click="ShapeFillCheck_Click" />
                                <StackPanel x:Name="CornerRadiusRow" Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="Bo góc" FontSize="12" VerticalAlignment="Center" />
                                    <Slider x:Name="CornerRadiusSlider" Width="96" ValueChanged="CornerRadiusSlider_ValueChanged" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Text="Hình" Style="{StaticResource RibbonGroupLabelStyle}" />
                        </Grid>
                    </Border>

                    <Border x:Name="StrokeStyleGroup" Style="{StaticResource RibbonGroupStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel Spacing="2">
                                <ComboBox x:Name="DashBox" Width="172" Height="30" SelectionChanged="DashBox_SelectionChanged"
                                          ToolTipService.ToolTip="Kiểu nét">
                                    <ComboBoxItem Content="━━━  Nét liền" />
                                    <ComboBoxItem Content="╍╍╍  Nét đứt" />
                                    <ComboBoxItem Content="┅┅┅  Nét chấm" />
                                </ComboBox>
                                <StackPanel Orientation="Horizontal" Spacing="6" ToolTipService.ToolTip="Độ đục: 100% = không trong suốt">
                                    <TextBlock Text="Độ đục" FontSize="12" VerticalAlignment="Center" />
                                    <Slider x:Name="OpacitySlider" Width="116" ValueChanged="OpacitySlider_ValueChanged" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Text="Nét &amp; độ trong suốt" Style="{StaticResource RibbonGroupLabelStyle}" />
                        </Grid>
                    </Border>

                    <Border x:Name="ArrowHeadGroup" Style="{StaticResource RibbonGroupStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid RowSpacing="4" ColumnSpacing="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Đầu" FontSize="12" VerticalAlignment="Center" />
                                <ComboBox x:Name="StartHeadBox" Grid.Column="1" Width="164" Height="30" SelectionChanged="ArrowHeadBox_SelectionChanged">
                                    <ComboBoxItem Content="Không" />
                                    <ComboBoxItem Content="◀  Tam giác" />
                                    <ComboBoxItem Content="&lt;  Chữ V" />
                                    <ComboBoxItem Content="●  Chấm tròn" />
                                </ComboBox>
                                <TextBlock Grid.Row="1" Text="Cuối" FontSize="12" VerticalAlignment="Center" />
                                <ComboBox x:Name="EndHeadBox" Grid.Row="1" Grid.Column="1" Width="164" Height="30" SelectionChanged="ArrowHeadBox_SelectionChanged">
                                    <ComboBoxItem Content="Không" />
                                    <ComboBoxItem Content="▶  Tam giác" />
                                    <ComboBoxItem Content="&gt;  Chữ V" />
                                    <ComboBoxItem Content="●  Chấm tròn" />
                                </ComboBox>
                            </Grid>
                            <TextBlock Grid.Row="1" Text="Đầu mũi tên" Style="{StaticResource RibbonGroupLabelStyle}" />
                        </Grid>
                    </Border>

                </StackPanel>

                <!-- Tab contextual "Vùng chọn": hiện khi tool Select đã kéo chọn 1 vùng. -->
                <StackPanel x:Name="RegionRibbonPanel" Orientation="Horizontal" Visibility="Collapsed">
                    <Border Style="{StaticResource RibbonGroupStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <Button Style="{StaticResource ToolButtonStyle}" Click="RegionCropButton_Click"
                                        ToolTipService.ToolTip="Cắt ảnh theo vùng chọn (Enter)">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE7A8;" />
                                        <TextBlock Text="Cắt ảnh" FontSize="12" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ToolButtonStyle}" Click="RegionCopyButton_Click"
                                        ToolTipService.ToolTip="Copy vùng chọn (Ctrl+C)">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE8C8;" />
                                        <TextBlock Text="Copy" FontSize="12" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="RegionCopyTextButton" Style="{StaticResource ToolButtonStyle}" Click="RegionCopyTextButton_Click"
                                        ToolTipService.ToolTip="Đọc chữ trong vùng chọn và copy vào clipboard (ngôn ngữ theo khung Tìm chữ)">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE8E9;" />
                                        <TextBlock Text="Copy chữ" FontSize="12" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ToolButtonStyle}" Click="RegionCutButton_Click"
                                        ToolTipService.ToolTip="Copy rồi xoá trắng vùng chọn (Ctrl+X)">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE8C6;" />
                                        <TextBlock Text="Cắt vùng" FontSize="12" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ToolButtonStyle}" Click="RegionEraseButton_Click"
                                        ToolTipService.ToolTip="Xoá trắng vùng chọn (Delete)">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE75C;" />
                                        <TextBlock Text="Xoá vùng" FontSize="12" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Text="Vùng chọn" Style="{StaticResource RibbonGroupLabelStyle}" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource RibbonGroupStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Button Style="{StaticResource ToolButtonStyle}" Click="RegionClearButton_Click"
                                    ToolTipService.ToolTip="Bỏ chọn vùng (Esc)">
                                <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                    <FontIcon Glyph="&#xE711;" />
                                    <TextBlock Text="Bỏ chọn" FontSize="12" />
                                </StackPanel>
                            </Button>
                            <TextBlock Grid.Row="1" Text="Đóng" Style="{StaticResource RibbonGroupLabelStyle}" />
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="NumberStampRibbonPanel" Orientation="Horizontal" Visibility="Collapsed">

                    <Border Style="{StaticResource RibbonGroupStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <Button x:Name="FlattenButton" Style="{StaticResource ToolButtonStyle}" Click="FlattenButton_Click" ToolTipService.ToolTip="Gộp dấu số vào ảnh (không sửa được nữa)">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE73D;" />
                                        <TextBlock Text="Gộp vào ảnh" FontSize="12" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ToolButtonStyle}" Click="DeleteButton_Click">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <FontIcon Glyph="&#xE74D;" />
                                        <TextBlock Text="Xoá" FontSize="12" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Text="Sửa" Style="{StaticResource RibbonGroupLabelStyle}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource RibbonGroupStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <ItemsControl ItemsSource="{x:Bind NumberStamps}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:StampPickerItem">
                                        <Button Padding="0" Width="26" Height="26" CornerRadius="13"
                                                Click="StampStyleSwatch_Click" Tag="{x:Bind Brush}">
                                            <Ellipse Width="20" Height="20" Fill="{x:Bind Brush}" Stroke="White" StrokeThickness="1.5" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Grid.Row="1" Text="Mẫu màu" Style="{StaticResource RibbonGroupLabelStyle}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource RibbonGroupStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Số này" FontSize="12" HorizontalAlignment="Center" />
                                    <!-- Nút +/- tự dựng thay cho spin button Inline của NumberBox: bản gốc xếp
                                         Up trước Down (ngược thói quen trái=giảm, phải=tăng) và chèn lên chữ số khi
                                         box hẹp. -->
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <Button Style="{StaticResource StepperButtonStyle}" Click="CurrentDecrement_Click">
                                            <FontIcon Glyph="&#xE738;" FontSize="10" />
                                        </Button>
                                        <NumberBox x:Name="CurrentNumberBox" Width="48" SpinButtonPlacementMode="Hidden"
                                                   ValueChanged="CurrentNumberBox_ValueChanged">
                                            <NumberBox.Resources>
                                                <x:Double x:Key="TextControlThemeMinWidth">0</x:Double>
                                            </NumberBox.Resources>
                                        </NumberBox>
                                        <Button Style="{StaticResource StepperButtonStyle}" Click="CurrentIncrement_Click">
                                            <FontIcon Glyph="&#xE710;" FontSize="10" />
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Số tiếp" FontSize="12" HorizontalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <Button Style="{StaticResource StepperButtonStyle}" Click="NextDecrement_Click">
                                            <FontIcon Glyph="&#xE738;" FontSize="10" />
                                        </Button>
                                        <NumberBox x:Name="NextNumberBox" Width="48" SpinButtonPlacementMode="Hidden"
                                                   ValueChanged="NextNumberBox_ValueChanged">
                                            <NumberBox.Resources>
                                                <x:Double x:Key="TextControlThemeMinWidth">0</x:Double>
                                            </NumberBox.Resources>
                                        </NumberBox>
                                        <Button Style="{StaticResource StepperButtonStyle}" Click="NextIncrement_Click">
                                            <FontIcon Glyph="&#xE710;" FontSize="10" />
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Text="Số" Style="{StaticResource RibbonGroupLabelStyle}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource RibbonGroupStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Viền" FontSize="12" HorizontalAlignment="Center" />
                                    <Button x:Name="StampOutlineButton" Width="32" Height="32" Padding="0">
                                        <Rectangle x:Name="StampOutlineSwatch" Width="22" Height="22" Fill="White" Stroke="Gray" StrokeThickness="1" />
                                        <Button.Flyout>
                                            <Flyout ShouldConstrainToRootBounds="False">
                                                <ColorPicker x:Name="StampOutlineColorPicker" ColorChanged="StampOutlineColorPicker_ColorChanged"
                                                             IsMoreButtonVisible="False" IsAlphaEnabled="False" />
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Nền" FontSize="12" HorizontalAlignment="Center" />
                                    <Button x:Name="StampFillButton" Width="32" Height="32" Padding="0">
                                        <Rectangle x:Name="StampFillSwatch" Width="22" Height="22" Fill="#D86445" Stroke="Gray" StrokeThickness="1" />
                                        <Button.Flyout>
                                            <Flyout ShouldConstrainToRootBounds="False">
                                                <ColorPicker x:Name="StampFillColorPicker" ColorChanged="StampFillColorPicker_ColorChanged"
                                                             IsMoreButtonVisible="False" IsAlphaEnabled="False" />
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Text="Màu" Style="{StaticResource RibbonGroupLabelStyle}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource RibbonGroupStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <Button Style="{StaticResource ToolButtonStyle}" Click="BringToFrontButton_Click">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <Viewbox Width="16" Height="16" HorizontalAlignment="Center"><PathIcon Data="F1 M0,0 H10 V10 H0 Z M1.5,1.5 V8.5 H8.5 V1.5 Z M6,6 H16 V16 H6 Z" /></Viewbox>
                                        <TextBlock Text="Lên trên" FontSize="12" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ToolButtonStyle}" Click="SendToBackButton_Click">
                                    <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                                        <Viewbox Width="16" Height="16" HorizontalAlignment="Center"><PathIcon Data="F1 M0,0 H10 V10 H0 Z M1.5,1.5 V8.5 H8.5 V1.5 Z M11.5,6 H16 V16 H6 V11.5 H11.5 Z" /></Viewbox>
                                        <TextBlock Text="Xuống dưới" FontSize="12" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Text="Thứ tự" Style="{StaticResource RibbonGroupLabelStyle}" />
                        </Grid>
                    </Border>

                </StackPanel>
            </Grid>
            </ScrollViewer>
            <Button x:Name="RibbonMoreButton" Grid.Column="1" Style="{StaticResource ToolButtonStyle}" Visibility="Collapsed"
                    AutomationProperties.Name="Thêm công cụ" ToolTipService.ToolTip="Các nhóm không đủ chỗ trên ribbon">
                <StackPanel Style="{StaticResource ToolButtonContentStyle}">
                    <FontIcon Glyph="&#xE712;" />
                    <TextBlock Text="Thêm" FontSize="12" />
                </StackPanel>
                <Button.Flyout>
                    <Flyout x:Name="RibbonMoreFlyout" Placement="BottomEdgeAlignedRight" ShouldConstrainToRootBounds="False">
                        <Flyout.FlyoutPresenterStyle>
                            <Style TargetType="FlyoutPresenter">
                                <Setter Property="MaxWidth" Value="1000" />
                            </Style>
                        </Flyout.FlyoutPresenterStyle>
                        <StackPanel x:Name="RibbonMoreHost" Spacing="8" />
                    </Flyout>
                </Button.Flyout>
            </Button>
            </Grid>
        </Border>

        <!-- Row 2: mỗi lần chụp là 1 tab (giống PicPick) - tab chỉ dùng làm thanh chuyển ảnh, nội dung
             luôn vẽ trên cùng 1 Canvas bên dưới (đổi EditorViewModel khi đổi tab). -->
        <TabView x:Name="DocumentTabs" Grid.Row="2" Margin="0,6,0,0"
                 IsAddTabButtonVisible="False" TabWidthMode="SizeToContent" CanReorderTabs="True" CanDragTabs="True"
                 SelectionChanged="DocumentTabs_SelectionChanged" TabCloseRequested="DocumentTabs_TabCloseRequested"
                 TabDragCompleted="DocumentTabs_TabDragCompleted">
            <!-- Tab đang chọn (2026-10-16): nền màu chủ đạo như nút Trang chủ, chữ trắng (đậm: RefreshTabHeaders) - mặc định
                 chỉ trắng hơn chút, nhiều tab thì khó thấy. -->
            <TabView.Resources>
                <StaticResource x:Key="TabViewItemHeaderBackgroundSelected" ResourceKey="AccentFillColorDefaultBrush" />
                <StaticResource x:Key="TabViewItemHeaderForegroundSelected" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
                <StaticResource x:Key="TabViewItemIconForegroundSelected" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
                <StaticResource x:Key="TabViewItemHeaderSelectedCloseButtonForeground" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
                <StaticResource x:Key="TabViewButtonForegroundActiveTab" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
            </TabView.Resources>
            <TabView.TabStripFooter>
                <StackPanel Orientation="Horizontal">
                <!-- Danh sách mọi ảnh (ảnh thu nhỏ + ô lọc) để nhảy nhanh khi có nhiều tab; Ctrl+Shift+A hoặc bấm "Ảnh x / n". -->
                <Button x:Name="TabListButton" Margin="8,0,0,0" Padding="10,4" VerticalAlignment="Center" Background="Transparent" BorderThickness="0"
                        AutomationProperties.Name="Danh sách ảnh" ToolTipService.ToolTip="Danh sách ảnh: chọn nhanh 1 tab (Ctrl+Shift+A)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8FD;" FontSize="12" />
                        <TextBlock Text="Danh sách ảnh" FontSize="12" />
                        <FontIcon Glyph="&#xE70D;" FontSize="10" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout x:Name="TabListFlyout" Placement="BottomEdgeAlignedRight" Opening="TabListFlyout_Opening" Opened="TabListFlyout_Opened">
                            <StackPanel Width="380" Spacing="8">
                                <TextBox x:Name="TabListFilter" PlaceholderText="Lọc theo tên / giờ chụp, vd 10:01 hoặc 15/10"
                                         AutomationProperties.Name="Lọc danh sách ảnh" TextChanged="TabListFilter_TextChanged" KeyDown="TabListFilter_KeyDown" />
                                <ListView x:Name="TabList" MaxHeight="520" SelectionMode="Single" IsItemClickEnabled="True"
                                          ItemClick="TabList_ItemClick" KeyDown="TabList_KeyDown" AutomationProperties.Name="Các ảnh đang mở" />
                                <!-- Mở lại tab vừa đóng (Ctrl+Shift+T) - mờ khi không còn tab nào; tên = tab sẽ mở lại (UpdateReopenTabButton). -->
                                <Button x:Name="ReopenTabButton" Click="ReopenTabButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        AutomationProperties.Name="Mở lại tab vừa đóng" ToolTipService.ToolTip="Mở lại tab vừa đóng, đúng vị trí cũ, còn nguyên hình vẽ và lịch sử Hoàn tác (Ctrl+Shift+T)">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE7A7;" FontSize="14" />
                                        <TextBlock x:Name="ReopenTabText" Text="Mở lại tab vừa đóng" />
                                        <TextBlock Text="Ctrl+Shift+T" Opacity="0.6" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button x:Name="CloseAllTabsButton" Click="CloseAllTabsButton_Click" Margin="8,0,0,0" Padding="10,4"
                        VerticalAlignment="Center" Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="Đóng tất cả ảnh (hỏi lưu tất cả vào 1 thư mục nếu còn ảnh chưa lưu)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8BB;" FontSize="12" />
                        <TextBlock Text="Đóng tất cả" FontSize="12" />
                    </StackPanel>
                </Button>
                </StackPanel>
            </TabView.TabStripFooter>
        </TabView>

        <!-- Row 3: ảnh (trái) + khung Tìm chữ (phải, ẩn cho tới khi bấm Tìm chữ / Ctrl+F). -->
        <Grid Grid.Row="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
        <!-- IsTabStop: nhận lại focus khi đóng ô gõ chữ trên ảnh, để phím tắt của Editor vẫn chạy. -->
        <ScrollViewer x:Name="CanvasScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      Background="{ThemeResource CanvasAreaBackgroundBrush}" CornerRadius="4"
                      IsTabStop="True" UseSystemFocusVisuals="False"
                      HorizontalContentAlignment="Left" VerticalContentAlignment="Top" Margin="0,0,0,8">
            <!-- Viền ảnh + 8 handle khung ảnh vẽ trong Skia (có lề CanvasPad), không dùng viền Border. -->
            <Grid HorizontalAlignment="Left" VerticalAlignment="Top">
                <skia:SKXamlCanvas x:Name="Canvas"
                                    PaintSurface="Canvas_PaintSurface"
                                    PointerPressed="Canvas_PointerPressed"
                                    PointerMoved="Canvas_PointerMoved"
                                    PointerReleased="Canvas_PointerReleased"
                                    DoubleTapped="Canvas_DoubleTapped" />
                <!-- Ô gõ chữ ngay trên ảnh (Text / Khung chú thích) được thêm vào đây khi đang gõ. Không có Background nên
                     phần trống không chặn chuột của Canvas. -->
                <Grid x:Name="InlineEditorHost" />
            </Grid>
        </ScrollViewer>

        <!-- Khung Tìm chữ (EditorWindow.TextSearch.cs): đọc chữ ảnh của tab đang mở 1 lần (nhớ theo ảnh + ngôn ngữ), tìm
             không phân biệt dấu / hoa thường (+ gần đúng ≈), chỗ khớp tô vàng đè lên ảnh (không vẽ vào ảnh). -->
        <Border x:Name="TextSearchPanel" Grid.Column="1" Width="320" Margin="0,0,0,8" Padding="12,10" Visibility="Collapsed"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="6">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE721;" FontSize="16" />
                        <TextBlock Text="Tìm chữ" FontWeight="SemiBold" FontSize="15" />
                    </StackPanel>
                    <Button x:Name="TextSearchCloseButton" HorizontalAlignment="Right" Padding="6" Background="Transparent" BorderThickness="0"
                            Click="TextSearchCloseButton_Click" ToolTipService.ToolTip="Đóng (Esc)" AutomationProperties.Name="Đóng Tìm chữ">
                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                    </Button>
                </Grid>
                <Grid Grid.Row="1" ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="OcrLanguageBox" HorizontalAlignment="Stretch" SelectionChanged="OcrLanguageBox_SelectionChanged"
                              AutomationProperties.Name="Ngôn ngữ chữ"
                              ToolTipService.ToolTip="Ngôn ngữ chữ trong ảnh - chọn đúng thì đọc chính xác hơn (chọn sai: danh sách toàn ký tự rác)">
                        <ComboBoxItem Content="Tiếng Nhật" Tag="Japanese"
                                      ToolTipService.ToolTip="Windows OCR (tiếng Nhật); máy chưa có gói OCR tiếng Nhật của Windows thì dùng Tesseract" />
                        <ComboBoxItem Content="Tiếng Việt / English" Tag="VietnameseEnglish" ToolTipService.ToolTip="Tesseract - đọc cả tiếng Việt lẫn tiếng Anh" />
                    </ComboBox>
                    <!-- Đọc kỹ (TextRecognizer.RecognizeCarefully): đọc lại từng dải dòng chữ - bắt chữ đọc thường bỏ sót -->
                    <Button x:Name="CarefulReadButton" Grid.Column="1" Click="CarefulReadButton_Click" IsEnabled="False"
                            AutomationProperties.Name="Đọc kỹ"
                            ToolTipService.ToolTip="Đọc kỹ cả ảnh (chậm hơn 1,5–3 lần): đọc lại riêng từng dòng chữ - tìm được chữ mà lần đọc thường bỏ sót (dòng đang chọn có nền màu / viền chấm, chữ nhỏ trong giao diện rối). Chỉ cho Tiếng Việt / English">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE890;" FontSize="14" />
                            <TextBlock Text="Đọc kỹ" />
                        </StackPanel>
                    </Button>
                </Grid>
                <!-- Phân biệt dấu / hoa thường: 2 nút bật tắt nhỏ cạnh ô tìm (như ô tìm của VS Code) thay 2 ô tick 1 hàng riêng -
                     cửa sổ thấp còn thêm chỗ cho danh sách kết quả. -->
                <Grid Grid.Row="2" ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TextSearchBox" PlaceholderText="Chữ cần tìm (trống: xem mọi dòng)"
                             AutomationProperties.Name="Chữ cần tìm" TextChanged="TextSearchBox_TextChanged" KeyDown="TextSearchBox_KeyDown"
                             ToolTipService.ToolTip="Enter: chỗ khớp kế tiếp · Shift+Enter: chỗ trước · Esc: đóng" />
                    <ToggleButton x:Name="TextMatchDiacriticsBox" Grid.Column="1" Width="34" Padding="0" VerticalAlignment="Stretch" Click="TextSearchOption_Click"
                                  AutomationProperties.Name="Phân biệt dấu" ToolTipService.ToolTip="Phân biệt dấu (bật: &quot;khach&quot; không khớp &quot;khách&quot;)">
                        <TextBlock Text="Ấ" FontSize="14" />
                    </ToggleButton>
                    <ToggleButton x:Name="TextMatchCaseBox" Grid.Column="2" Width="34" Padding="0" VerticalAlignment="Stretch" Click="TextSearchOption_Click"
                                  AutomationProperties.Name="Phân biệt hoa / thường" ToolTipService.ToolTip="Phân biệt hoa / thường">
                        <TextBlock Text="Aa" FontSize="14" />
                    </ToggleButton>
                </Grid>
                <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
                    <ProgressRing x:Name="TextSearchProgress" Width="16" Height="16" IsActive="False" Visibility="Collapsed" />
                    <!-- Tối đa 2 dòng (đủ câu đầy đủ ở tooltip): cửa sổ thấp vẫn còn chỗ cho danh sách kết quả. -->
                    <TextBlock x:Name="TextSearchStatus" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" Opacity="0.75" FontSize="12" MaxWidth="290"
                               ToolTipService.ToolTip="{x:Bind TextSearchStatus.Text, Mode=OneWay}" />
                </StackPanel>
                <!-- 1 hàng 4 nút (icon trên, chữ dưới) thay 2 hàng: tiết kiệm chỗ cho danh sách kết quả khi cửa sổ thấp. -->
                <Grid Grid.Row="4" ColumnSpacing="4">
                    <Grid.Resources>
                        <Style x:Key="SearchActionButtonStyle" TargetType="Button" BasedOn="{StaticResource CompactButtonStyle}">
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="2,4" />
                        </Style>
                    </Grid.Resources>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="CopyAllTextButton" Style="{StaticResource SearchActionButtonStyle}" Click="CopyAllTextButton_Click" IsEnabled="False"
                            ToolTipService.ToolTip="Copy toàn bộ chữ đọc được của ảnh, mỗi dòng 1 dòng">
                        <StackPanel Spacing="2" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE8C8;" FontSize="16" />
                            <TextBlock Text="Copy chữ" FontSize="12" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="HighlightMatchesButton" Grid.Column="1" Style="{StaticResource SearchActionButtonStyle}" Click="HighlightMatchesButton_Click" IsEnabled="False"
                            ToolTipService.ToolTip="Tô sáng vàng lên mọi chỗ khớp (thành hình Tô sáng thật trên ảnh, 1 bước Hoàn tác)">
                        <StackPanel Spacing="2" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE7E6;" FontSize="16" />
                            <TextBlock Text="Tô sáng" FontSize="12" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <!-- Che mọi chỗ khớp (số điện thoại, tên khách, mã đơn...) trước khi gửi ảnh: thành hình Mosaic / Làm mờ thật -->
                    <Button x:Name="MosaicMatchesButton" Grid.Column="2" Style="{StaticResource SearchActionButtonStyle}" Click="MosaicMatchesButton_Click" IsEnabled="False"
                            ToolTipService.ToolTip="Che Mosaic lên mọi chỗ khớp - vd tìm tên khách / số điện thoại rồi che hết trước khi gửi ảnh (thành hình Mosaic thật, 1 bước Hoàn tác)">
                        <StackPanel Spacing="2" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE80A;" FontSize="16" />
                            <TextBlock Text="Mosaic" FontSize="12" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="BlurMatchesButton" Grid.Column="3" Style="{StaticResource SearchActionButtonStyle}" Click="BlurMatchesButton_Click" IsEnabled="False"
                            ToolTipService.ToolTip="Làm mờ mọi chỗ khớp (thành hình Làm mờ thật, 1 bước Hoàn tác)">
                        <StackPanel Spacing="2" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xED1A;" FontSize="16" />
                            <TextBlock Text="Làm mờ" FontSize="12" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
                <ListView x:Name="TextResultList" Grid.Row="5" SelectionMode="Single" SelectionChanged="TextResultList_SelectionChanged"
                          AutomationProperties.Name="Kết quả tìm chữ" Margin="-12,0" />
            </Grid>
        </Border>
        </Grid>

        <!-- Row 4: thanh trạng thái - trái: thông báo; phải: zoom của ảnh đang mở (kiểu PicPick).
             Ctrl + lăn chuột trên ảnh, Ctrl + '+' / '-' / '0' cũng zoom. -->
        <Grid Grid.Row="4" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Opacity="0.7" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <!-- Thứ tự tab ảnh đang mở / tổng số tab (UpdateTabPosition). -->
                <!-- Bấm vào = mở Danh sách ảnh (chọn nhanh tab). -->
                <HyperlinkButton x:Name="TabPositionButton" Padding="6,2" Margin="0,0,8,0" Click="TabPositionButton_Click"
                                 Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.Name="Vị trí ảnh"
                                 ToolTipService.ToolTip="Ảnh đang mở / tổng số ảnh (tab) - bấm để chọn nhanh ảnh khác (Ctrl+Shift+A)">
                    <TextBlock x:Name="TabPositionText" />
                </HyperlinkButton>
                <Button x:Name="ZoomFitButton" Style="{StaticResource SmallToolButtonStyle}" Click="ZoomFitButton_Click"
                        ToolTipService.ToolTip="Vừa cửa sổ">
                    <FontIcon Glyph="&#xE9A6;" FontSize="14" />
                </Button>
                <Button x:Name="ZoomOutButton" Style="{StaticResource SmallToolButtonStyle}" Click="ZoomOutButton_Click"
                        ToolTipService.ToolTip="Thu nhỏ (Ctrl + -)">
                    <FontIcon Glyph="&#xE71F;" FontSize="14" />
                </Button>
                <DropDownButton x:Name="ZoomLevelButton" Content="100%" MinWidth="72" Padding="8,2"
                                ToolTipService.ToolTip="Mức zoom (Ctrl + 0 = 100%)">
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="ZoomLevelFlyout" Placement="Top" />
                    </DropDownButton.Flyout>
                </DropDownButton>
                <Button x:Name="ZoomInButton" Style="{StaticResource SmallToolButtonStyle}" Click="ZoomInButton_Click"
                        ToolTipService.ToolTip="Phóng to (Ctrl + +)">
                    <FontIcon Glyph="&#xE8A3;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
